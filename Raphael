local LastItemScan = 0
local LastMobRescan = 0
local LastInfoRefresh = 0
local LastVisionApply = 0
local LastNoVoidCheck = 0
local LastESPUpdate = 0

connect(RunService.Stepped, function()
    if not State.Running then
        return
    end
    local character, humanoid, root = getCharacter()
    if not character or not humanoid or not root then
        return
    end
    rememberHumanoid(humanoid)

    if State.Noclip then
        local function disableCollision(part)
            if part and part:IsA("BasePart") then
                if OriginalCollision[part] == nil then
                    OriginalCollision[part] = part.CanCollide
                end
                part.CanCollide = false
            end
        end

        if State.NoclipMethod == "Chỉ Root" then
            disableCollision(root)
        else
            for _, descendant in ipairs(character:GetDescendants()) do
                if descendant:IsA("BasePart") then
                    disableCollision(descendant)
                end
            end
            if State.NoclipMethod == "State + Parts" then
                pcall(function()
                    humanoid:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
                end)
            end
        end
    end

    if State.AntiRagdoll then
        pcall(function()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            if humanoid:GetState() == Enum.HumanoidStateType.FallingDown or humanoid:GetState() == Enum.HumanoidStateType.Ragdoll then
                humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
        for _, descendant in ipairs(character:GetDescendants()) do
            if descendant:IsA("Motor6D") then
                descendant.Enabled = true
            end
        end
    end
end)

connect(RunService.Heartbeat, function(deltaTime)
    if not State.Running then
        return
    end
    local character, humanoid, root = getCharacter()
    if not character or not humanoid or not root then
        return
    end
    local original = rememberHumanoid(humanoid)

    if State.SpeedMethod == "WalkSpeed" then
        humanoid.WalkSpeed = State.SpeedValue
    elseif State.SpeedMethod == "Velocity" then
        humanoid.WalkSpeed = 0
        local direction = humanoid.MoveDirection
        local currentVelocity = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(direction.X * State.SpeedValue, currentVelocity.Y, direction.Z * State.SpeedValue)
    elseif State.SpeedMethod == "CFrame" then
        local baseSpeed = original and original.WalkSpeed or 16
        humanoid.WalkSpeed = math.min(State.SpeedValue, baseSpeed)
        local extraSpeed = math.max(State.SpeedValue - baseSpeed, 0)
        if extraSpeed > 0 and humanoid.MoveDirection.Magnitude > 0 then
            root.CFrame = root.CFrame + humanoid.MoveDirection.Unit * extraSpeed * deltaTime
        end
    end

    if State.JumpMethod == "JumpPower" then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = State.JumpValue
    elseif State.JumpMethod == "JumpHeight" then
        humanoid.UseJumpPower = false
        humanoid.JumpHeight = State.JumpValue
    end

    Workspace.Gravity = State.GravityValue
    Camera = Workspace.CurrentCamera or Camera
    Camera.FieldOfView = State.CameraFov

    local now = os.clock()
    if now - LastNoVoidCheck >= 0.1 then
        LastNoVoidCheck = now
        local threshold = Workspace.FallenPartsDestroyHeight + State.NoVoidMargin
        if root.Position.Y > threshold + 8 and humanoid.FloorMaterial ~= Enum.Material.Air then
            State.LastSafeCFrame = root.CFrame
        end
        if State.NoVoid and root.Position.Y <= threshold then
            local rescueCFrame = State.LastSafeCFrame
            if not rescueCFrame then
                local parameters = RaycastParams.new()
                parameters.FilterType = Enum.RaycastFilterType.Exclude
                parameters.FilterDescendantsInstances = {character}
                local rayOrigin = Vector3.new(root.Position.X, math.max(root.Position.Y + 1000, 2000), root.Position.Z)
                local result = Workspace:Raycast(rayOrigin, Vector3.new(0, -5000, 0), parameters)
                if result then
                    rescueCFrame = CFrame.new(result.Position + Vector3.new(0, 4, 0))
                end
            end
            if rescueCFrame then
                safeTeleport(rescueCFrame + Vector3.new(0, 3, 0))
                notify("No Void đã đưa Ngài về vị trí an toàn.", Theme.Warning)
            end
        end
    end

    if now - LastVisionApply >= 0.2 then
        LastVisionApply = now
        if State.ClockTime then
            Lighting.ClockTime = State.ClockTime
        end
        if State.RemoveEffects then
            applyNoEffects()
        end
        if State.FullBrightLevel ~= nil then
            applyFullBright()
        end
    end

    if now - LastItemScan >= 0.65 then
        LastItemScan = now
        if State.ItemESP.Enabled then
            scanItems(false)
        end
    end

    if now - LastMobRescan >= 8 then
        LastMobRescan = now
        if State.MobESP.Enabled then
            task.spawn(rescanMobs)
        end
    end

    if now - LastInfoRefresh >= 1 then
        LastInfoRefresh = now
        refreshInfo()
    end
end)

connect(RunService.RenderStepped, function()
    if not State.Running then
        return
    end
    local now = os.clock()
    if now - LastESPUpdate < 0.04 then
        return
    end
    LastESPUpdate = now

    Camera = Workspace.CurrentCamera or Camera
    local _, _, localRoot = getCharacter()
    if not localRoot then
        return
    end

    if State.PlayerESP.Enabled then
        local seen = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local root = character and getAdorneeRoot(character)
                if character and root and humanoid and humanoid.Health > 0 then
                    seen[player] = true
                    local distance = (root.Position - localRoot.Position).Magnitude
                    updateVisual("Player", player, character, root, player.DisplayName .. " (@" .. player.Name .. ")", getHealthText(humanoid), distance)
                end
            end
        end
        for player, visual in pairs(Visuals.Player) do
            if not seen[player] then
                destroyVisual(visual)
                Visuals.Player[player] = nil
            end
        end
    end

    if State.MobESP.Enabled then
        local seen = {}
        for model in pairs(MobCache) do
            if model and model.Parent and isMobModel(model) then
                local root = getAdorneeRoot(model)
                if root then
                    local humanoid = model:FindFirstChildOfClass("Humanoid")
                    local healthText = getHealthText(humanoid)
                    if not healthText then
                        local health = model:GetAttribute("Health") or model:GetAttribute("HP")
                        local maximum = model:GetAttribute("MaxHealth") or model:GetAttribute("MaxHP")
                        if type(health) == "number" then
                            healthText = maximum and string.format("HP %d/%d", health, maximum) or string.format("HP %d", health)
                        end
                    end
                    seen[model] = true
                    updateVisual("Mob", model, model, root, model.Name, healthText, (root.Position - localRoot.Position).Magnitude)
                end
            else
                MobCache[model] = nil
            end
        end
        for model, visual in pairs(Visuals.Mob) do
            if not seen[model] then
                destroyVisual(visual)
                Visuals.Mob[model] = nil
            end
        end
    end

    if State.ItemESP.Enabled then
        local seen = {}
        for item in pairs(ItemCache) do
            if item and item.Parent and item:IsDescendantOf(Workspace) then
                local root = getAdorneeRoot(item)
                if root then
                    seen[item] = true
                    updateVisual("Item", item, item, root, item.Name, getItemHealthText(item), (root.Position - localRoot.Position).Magnitude)
                end
            else
                ItemCache[item] = nil
            end
        end
        for item, visual in pairs(Visuals.Item) do
            if not seen[item] then
                destroyVisual(visual)
                Visuals.Item[item] = nil
            end
        end
    end
end)

