            break
        end
        local valueObject = item:FindFirstChild(name, true)
        if valueObject and (valueObject:IsA("NumberValue") or valueObject:IsA("IntValue")) then
            current = valueObject.Value
            break
        end
    end

    for _, name in ipairs(State.ItemHealthMaximumNames) do
        local attribute = item:GetAttribute(name)
        if type(attribute) == "number" then
            maximum = attribute
            break
        end
        local valueObject = item:FindFirstChild(name, true)
        if valueObject and (valueObject:IsA("NumberValue") or valueObject:IsA("IntValue")) then
            maximum = valueObject.Value
            break
        end
    end

    if current and maximum then
        return string.format("HP %d/%d", math.floor(current + 0.5), math.floor(maximum + 0.5))
    elseif current then
        return string.format("Giá trị %d", math.floor(current + 0.5))
    end
    return nil
end

local function updateVisual(category, key, target, root, displayName, healthText, distanceStuds)
    local config = getCategoryConfig(category)
    local espEnabled = config.Enabled
    local xrayEnabled = State.XRay
    if (not espEnabled and not xrayEnabled) or not target or not root then
        local existing = Visuals[category][key]
        if existing then
            hideVisual(existing)
        end
        return
    end

    local distanceMeters = distanceStuds * 0.28
    local exactItemGlobal = category == "Item" and State.ItemESP.ExactName ~= ""
    local maximumMeters = category == "Item" and (exactItemGlobal and math.huge or config.RadiusMeters) or config.MaxDistanceMeters
    if distanceMeters > maximumMeters then
        local existing = Visuals[category][key]
        if existing then
            hideVisual(existing)
        end
        return
    end

    local visual = Visuals[category][key] or createVisual(category, key)
    local outlineXRay = xrayEnabled and State.XRayMethod ~= "Wall Transparency"
    local highlightEnabled = (espEnabled and config.Box and config.BoxMode == "Skin") or outlineXRay or (espEnabled and not DrawingSupported)
    local highlightTarget = target
    if not target:IsA("Model") and not target:IsA("BasePart") then
        highlightTarget = root
    end
    if visual.Highlight.Parent ~= Workspace then
        visual.Highlight.Parent = Workspace
    end
    visual.Highlight.Adornee = highlightTarget
    visual.Highlight.FillColor = config.Color
    visual.Highlight.OutlineColor = config.Color
    visual.Highlight.DepthMode = outlineXRay and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    visual.Highlight.FillTransparency = outlineXRay and 0.68 or 1
    visual.Highlight.OutlineTransparency = (espEnabled and config.Box or outlineXRay) and 0 or 1
    visual.Highlight.Enabled = highlightEnabled

    if visual.Billboard then
        visual.Billboard.Adornee = root
        local lines = {}
        if espEnabled and config.Name then
            table.insert(lines, displayName)
        end
        if espEnabled and config.Health and healthText then
            table.insert(lines, healthText)
        end
        if espEnabled and config.Distance then
            table.insert(lines, string.format("%.1f m", distanceMeters))
        end
        visual.BillboardText.Text = table.concat(lines, "\n")
        visual.Billboard.Enabled = espEnabled and #lines > 0
        return
    end

    local needsScreenDrawing = espEnabled and ((config.Box and config.BoxMode == "2D") or config.Tracer or config.Name or (config.Health and healthText ~= nil) or config.Distance)
    if not needsScreenDrawing then
        setDrawingVisible(visual.Box, false)
        setDrawingVisible(visual.Tracer, false)
        setDrawingVisible(visual.Name, false)
        setDrawingVisible(visual.Health, false)
        setDrawingVisible(visual.Distance, false)
        return
    end

    local topLeft, boxSize = getScreenBounds(target)
    if not topLeft or not boxSize then
        setDrawingVisible(visual.Box, false)
        setDrawingVisible(visual.Tracer, false)
        setDrawingVisible(visual.Name, false)
        setDrawingVisible(visual.Health, false)
        setDrawingVisible(visual.Distance, false)
        return
    end

    local centerX = topLeft.X + boxSize.X * 0.5
    local topY = topLeft.Y
    local bottomY = topLeft.Y + boxSize.Y

    if visual.Box then
        visual.Box.Color = config.Color
        visual.Box.Position = topLeft
        visual.Box.Size = boxSize
        visual.Box.Visible = espEnabled and config.Box and config.BoxMode == "2D"
    end

    if visual.Tracer then
        visual.Tracer.Color = config.Color
        visual.Tracer.From = Camera.ViewportSize * 0.5
        visual.Tracer.To = Vector2.new(centerX, topLeft.Y + boxSize.Y * 0.5)
        visual.Tracer.Visible = espEnabled and config.Tracer
    end

    if visual.Name then
        visual.Name.Color = config.Color
        visual.Name.Text = displayName
        visual.Name.Position = Vector2.new(centerX, topY - 17)
        visual.Name.Visible = espEnabled and config.Name
    end

    if visual.Health then
        visual.Health.Color = config.Color
        visual.Health.Text = healthText or ""
        visual.Health.Position = Vector2.new(centerX, bottomY + 2)
        visual.Health.Visible = espEnabled and config.Health and healthText ~= nil
    end

    if visual.Distance then
        visual.Distance.Color = config.Color
        visual.Distance.Text = string.format("[ %.1f m ]", distanceMeters)
        visual.Distance.Position = Vector2.new(centerX, bottomY + (config.Health and healthText and 17 or 2))
        visual.Distance.Visible = espEnabled and config.Distance
    end
end

local function restoreXRayOccluders(keepSet)
    for part, originalTransparency in pairs(XRayOccluders) do
        if not keepSet or not keepSet[part] then
            if part and part.Parent then
                pcall(function()
                    part.LocalTransparencyModifier = originalTransparency
                end)
            end
            XRayOccluders[part] = nil
        end
    end
end

local function updateXRayOcclusion()
    if not State.XRay or State.XRayMethod == "Outline" then
        restoreXRayOccluders()
        return
    end

    Camera = Workspace.CurrentCamera or Camera
    local cameraPosition = Camera.CFrame.Position
    local candidates = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local root = getAdorneeRoot(player.Character)
            if root then
                local offset = root.Position - cameraPosition
                table.insert(candidates, {Target = player.Character, Root = root, DistanceSquared = offset:Dot(offset)})
            end
        end
    end

    for model, classification in pairs(MobCache) do
        if model and model.Parent and type(classification) == "table" then
            local root = classification.Root
            if root and root.Parent then
                local offset = root.Position - cameraPosition
                table.insert(candidates, {Target = model, Root = root, DistanceSquared = offset:Dot(offset)})
            end
        end
    end

    for item in pairs(ItemCache) do
        if item and item.Parent then
            local root = getAdorneeRoot(item)
            if root then
                local offset = root.Position - cameraPosition
                table.insert(candidates, {Target = item, Root = root, DistanceSquared = offset:Dot(offset)})
            end
        end
    end

    table.sort(candidates, function(left, right)
        return left.DistanceSquared < right.DistanceSquared
    end)

    local castPoints = {}
    local ignored = {}
    local localCharacter = LocalPlayer.Character
    if localCharacter then
        table.insert(ignored, localCharacter)
    end
    local candidateLimit = math.min(#candidates, 24)
    for index = 1, candidateLimit do
        local candidate = candidates[index]
        table.insert(castPoints, candidate.Root.Position)
        table.insert(ignored, candidate.Target)
    end

    local currentOccluders = {}
    if #castPoints > 0 then
        local success, obscuringParts = pcall(function()
            return Camera:GetPartsObscuringTarget(castPoints, ignored)
        end)
        if success and type(obscuringParts) == "table" then
            for _, part in ipairs(obscuringParts) do
                if part and part:IsA("BasePart") then
                    if XRayOccluders[part] == nil then
                        XRayOccluders[part] = part.LocalTransparencyModifier
                    end
                    currentOccluders[part] = true
                    part.LocalTransparencyModifier = State.XRayWallTransparency
                end
            end
        end
    end

    restoreXRayOccluders(currentOccluders)
end

local EnemyHints = {"enemy", "enemies", "mob", "mobs", "monster", "monsters", "npc", "boss", "zombie", "creature", "bot", "hostile", "wave"}
EnemyHints.Attributes = {"Enemy", "IsEnemy", "Mob", "IsMob", "NPC", "IsNPC", "Monster", "Hostile", "IsHostile", "EntityType", "Faction", "Team"}
local GenericMobNames = {model = true, npc = true, enemy = true, mob = true, rig = true, dummy = true}

local function textHasHint(text, hints)
    local lower = string.lower(tostring(text or ""))
    for _, hint in ipairs(hints) do
        if string.find(lower, hint, 1, true) then
            return true
        end
    end
    return false
end

local function hasEnemyMetadata(model)
    if textHasHint(model.Name, EnemyHints) then
        return true
    end
    local ancestor = model.Parent
    local depth = 0
    while ancestor and ancestor ~= Workspace and depth < 5 do
        if textHasHint(ancestor.Name, EnemyHints) then
            return true
        end
        ancestor = ancestor.Parent
        depth = depth + 1
    end
    for _, attributeName in ipairs(EnemyHints.Attributes) do
        local value = model:GetAttribute(attributeName)
        if value == true or type(value) == "string" and textHasHint(value, EnemyHints) then
            return true
        end
    end
    for _, tag in ipairs(CollectionService:GetTags(model)) do
        if textHasHint(tag, EnemyHints) then
            return true
        end
    end
    return false
end

local function belongsToPlayerCharacter(model)
    local current = model
    local depth = 0
    while current and current ~= Workspace and depth < 12 do
        if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then
            return true
        end
        current = current.Parent
        depth = depth + 1
    end
    return false
end

local function getMobDisplayName(model, humanoid)
    for _, attributeName in ipairs(State.MobDisplayAttributeNames) do
        local value = model:GetAttribute(attributeName)
        if type(value) == "string" and value ~= "" then
            return value
        end
    end

    if humanoid and humanoid.DisplayName and humanoid.DisplayName ~= "" then
        local lowerDisplayName = string.lower(humanoid.DisplayName)
        if lowerDisplayName ~= "humanoid" and not GenericMobNames[lowerDisplayName] then
            return humanoid.DisplayName
        end
    end

    if not GenericMobNames[string.lower(model.Name)] then
        return model.Name
    end

    local ancestor = model.Parent
    local depth = 0
    while ancestor and ancestor ~= Workspace and depth < 4 do
        local lowerName = string.lower(ancestor.Name)
        local genericContainer = lowerName == "workspace" or lowerName == "folder" or lowerName == "entities" or lowerName == "characters" or lowerName == "map"
        if not GenericMobNames[lowerName] and not genericContainer then
            return ancestor.Name
        end
        ancestor = ancestor.Parent
        depth = depth + 1
    end
    return model.Name
end

local function classifyMob(model)
    if not model or not model:IsA("Model") or not model:IsDescendantOf(Workspace) then
        return nil
    end
    if belongsToPlayerCharacter(model) then
        return nil
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local metadata = not humanoid and hasEnemyMetadata(model)
    if not humanoid and not metadata then
        return nil
    end
    if humanoid and humanoid.Health <= 0 then
        return nil
    end

    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or getAdorneeRoot(model)
    if not root then
        return nil
    end

    return {
        Humanoid = humanoid,
        Root = root,
        DisplayName = getMobDisplayName(model, humanoid),
        LastValidated = os.clock()
    }
end

local function parseMobManualNames(text)
    local parsed = {}
    local count = 0
    for entry in string.gmatch(tostring(text or ""), "[^,]+") do
        local trimmed = string.gsub(entry, "^%s*(.-)%s*$", "%1")
        if trimmed ~= "" then
            local key = string.lower(trimmed)
            if not parsed[key] then
                parsed[key] = true
                count = count + 1
            end
        end
    end
    State.MobManualNames = parsed
    State.MobFilterText = tostring(text or "")
    return count
end

local function isMobAllowedByManualFilter(model, classification)
    if not State.MobManualFilterEnabled then
        return true
    end
    local names = State.MobManualNames
    if names[string.lower(model.Name)] then
        return true
    end
    if classification and classification.DisplayName and names[string.lower(classification.DisplayName)] then
        return true
    end
    local humanoid = classification and classification.Humanoid
    if humanoid and humanoid.DisplayName and names[string.lower(humanoid.DisplayName)] then
        return true
    end
    return false
end

local function collectMobNamesInRadius()
    local _, _, localRoot = getCharacter()
    if not localRoot then
        return {}, 0
    end
    local maximumStuds = State.MobFilterScanRadiusMeters / 0.28
    local uniqueNames = {}
    local names = {}
    for model, classification in pairs(MobCache) do
        if model and model.Parent and type(classification) == "table" then
            local root = classification.Root
            if root and root.Parent and (root.Position - localRoot.Position).Magnitude <= maximumStuds then
                local displayName = classification.DisplayName or model.Name
                local key = string.lower(displayName)
                if displayName ~= "" and not uniqueNames[key] then
                    uniqueNames[key] = true
                    table.insert(names, displayName)
                end
            end
        end
    end
    table.sort(names, function(left, right)
        return string.lower(left) < string.lower(right)
    end)
    return names, #names
end

local function removeMobFromCache(model)
