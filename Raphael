cleanup = function()
    if not State.Running then
        return
    end
    State.Running = false
    State.TouchTeleportArmed = false
    cancelActiveTravel()

    restoreCollisions()
    restoreXRayOccluders()
    removeAllVisuals()
    restoreEffects()
    restoreLightingVisuals()
    Lighting.ClockTime = OriginalLighting.ClockTime
    Workspace.Gravity = OriginalGravity
    Camera = Workspace.CurrentCamera or Camera
    Camera.FieldOfView = OriginalCamera.FieldOfView
    LocalPlayer.CameraMinZoomDistance = OriginalCamera.MinZoom
    LocalPlayer.CameraMaxZoomDistance = OriginalCamera.MaxZoom

    local _, humanoid = getCharacter()
    State.SpectatingPlayer = nil
    Camera.CameraType = OriginalCamera.Type
    Camera.CameraSubject = humanoid or OriginalCamera.Subject
    restoreHumanoid(humanoid)

    if State.FPSBoostApplied then
        setFPSBoost(false, true)
    end

    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(Connections)

    RuntimeEnvironment.RaphaelSovereignCleanup = nil
    if ScreenGui then
        ScreenGui:Destroy()
    end
end

RuntimeEnvironment.RaphaelSovereignCleanup = cleanup

task.spawn(function()
    local imageObjects = {}
    for _, instance in ipairs(ScreenGui:GetDescendants()) do
        if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
            if instance.Image ~= "" then
                table.insert(imageObjects, instance)
            end
        end
    end
    pcall(function()
        ContentProvider:PreloadAsync(imageObjects)
    end)
end)

