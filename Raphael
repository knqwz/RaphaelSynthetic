end

local function safeTeleport(targetCFrame)
    local character, _, root = getCharacter()
    if not character or not root or not targetCFrame then
        notify("Không thể dịch chuyển: nhân vật chưa sẵn sàng.", Theme.Danger)
        return false
    end
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        character:PivotTo(targetCFrame)
    end)
    return true
end

local function cancelActiveTravel()
    local activeTween = State.ActiveTravelTween
    State.ActiveTravelTween = nil
    if activeTween then
        pcall(function()
            activeTween:Cancel()
        end)
    end
end

local function travelToCFrame(targetCFrame, mode)
    if mode ~= "Fly" then
        cancelActiveTravel()
        return safeTeleport(targetCFrame)
    end

    local character, humanoid, root = getCharacter()
    if not character or not humanoid or not root then
        notify("Không thể bay: nhân vật chưa sẵn sàng.", Theme.Danger)
        return false
    end

    cancelActiveTravel()
    local collisionBackup = {}
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            collisionBackup[descendant] = descendant.CanCollide
            descendant.CanCollide = false
        end
    end

    local originalAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false
    humanoid.PlatformStand = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local distance = (root.Position - targetCFrame.Position).Magnitude
    local duration = math.clamp(distance / math.max(State.TravelSpeed, 1), 0.15, 35)
    local travelTween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    State.ActiveTravelTween = travelTween
    local completedConnection
    completedConnection = travelTween.Completed:Connect(function()
        if completedConnection then
            completedConnection:Disconnect()
        end
        if State.ActiveTravelTween == travelTween then
            State.ActiveTravelTween = nil
        end
        for part, canCollide in pairs(collisionBackup) do
            if part and part.Parent then
                part.CanCollide = canCollide
            end
        end
        if humanoid and humanoid.Parent then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = originalAutoRotate
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
    travelTween:Play()
    notify(string.format("Đang bay %.1f m với tốc độ %.0f stud/s.", distance * 0.28, State.TravelSpeed), Theme.Warning)
    return true
end

local function findPlayer(query)
    local normalized = string.lower(tostring(query or ""))
    if normalized == "" then
        return nil
    end
    local partialMatch
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local username = string.lower(player.Name)
            local displayName = string.lower(player.DisplayName)
            if username == normalized or displayName == normalized then
                return player
            end
            if not partialMatch and (string.find(username, normalized, 1, true) or string.find(displayName, normalized, 1, true)) then
                partialMatch = player
            end
        end
    end
    return partialMatch
end

local function setSpectating(player)
    Camera = Workspace.CurrentCamera or Camera
    if not player then
        State.SpectatingPlayer = nil
        local _, localHumanoid = getCharacter()
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = localHumanoid or OriginalCamera.Subject
        if State.SpectateButton and State.SpectateButton.Parent then
            State.SpectateButton.Text = "Bắt đầu theo dõi"
        end
        return true
    end

    local targetHumanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not targetHumanoid then
        notify("Nhân vật cần theo dõi chưa sẵn sàng.", Theme.Warning)
        return false
    end

    State.SpectatingPlayer = player
    Camera.CameraType = Enum.CameraType.Custom
    Camera.CameraSubject = targetHumanoid
    if State.SpectateButton and State.SpectateButton.Parent then
        State.SpectateButton.Text = "Huỷ theo dõi " .. player.Name
    end
    return true
end

