    local index = table.find(options, defaultValue) or 1
    button.Text = options[index]

    connect(button.Activated, function()
        index = index % #options + 1
        button.Text = options[index]
        chevronIcon.Rotation = 180
        tween(chevronIcon, {Rotation = 0}, 0.2)
        tween(button, {BackgroundColor3 = Theme.SurfaceLight}, 0.08)
        task.delay(0.09, function()
            if button.Parent then
                tween(button, {BackgroundColor3 = Theme.Input}, 0.12)
            end
        end)
        if callback then
            callback(options[index])
        end
    end)

    return {
        Get = function()
            return options[index]
        end,
        Set = function(value, invoke)
            local found = table.find(options, value)
            if found then
                index = found
                button.Text = options[index]
