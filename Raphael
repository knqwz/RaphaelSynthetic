    knob.BackgroundColor3 = Theme.Text
    knob.BorderSizePixel = 0
    knob.Parent = button
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local value = defaultValue
    local function setValue(newValue, invoke)
        value = not not newValue
        tween(button, {BackgroundColor3 = value and Theme.Accent or Color3.fromRGB(54, 59, 76)})
        tween(knob, {Position = value and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)})
        if invoke ~= false and callback then
            callback(value)
        end
    end

    connect(button.Activated, function()
        setValue(not value, true)
    end)

    return {
        Set = setValue,
        Get = function()
            return value
        end,
        Instance = row
    }
end

