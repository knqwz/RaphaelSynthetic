function Extensions.ApplyConfig(config, silent)
    if type(config) ~= "table" then
        if not silent then notify("Config không hợp lệ.", Theme.Danger) end
        return false
    end

    local function booleanValue(source, key, fallback)
        if type(source[key]) == "boolean" then
            return source[key]
        end
        return fallback
    end
    local function allowed(value, options, fallback)
        return table.find(options, value) and value or fallback
    end

    local movement = type(config.Movement) == "table" and config.Movement or {}
    State.SpeedValue = math.clamp(tonumber(movement.SpeedValue) or State.SpeedValue, 0, 1000)
    State.SpeedMethod = allowed(movement.SpeedMethod, {"WalkSpeed", "Velocity", "CFrame"}, State.SpeedMethod)
    State.JumpValue = math.clamp(tonumber(movement.JumpValue) or State.JumpValue, 0, 1000)
    State.JumpMethod = allowed(movement.JumpMethod, {"JumpPower", "JumpHeight", "Velocity"}, State.JumpMethod)
    State.InfiniteJump = booleanValue(movement, "InfiniteJump", State.InfiniteJump)
    State.Noclip = booleanValue(movement, "Noclip", State.Noclip)
    State.NoclipMethod = allowed(movement.NoclipMethod, {"Toàn thân", "Chỉ Root", "State + Parts"}, State.NoclipMethod)
    State.GravityValue = math.clamp(tonumber(movement.GravityValue) or State.GravityValue, 0, 1000)

    local function applyESP(target, source, includeRadius)
        if type(source) ~= "table" then return end
        target.Enabled = booleanValue(source, "Enabled", target.Enabled)
        target.Tracer = booleanValue(source, "Tracer", target.Tracer)
        target.Box = booleanValue(source, "Box", target.Box)
        target.BoxMode = allowed(source.BoxMode, {"2D", "Skin"}, target.BoxMode)
        target.Name = booleanValue(source, "Name", target.Name)
        target.Health = booleanValue(source, "Health", target.Health)
        target.Distance = booleanValue(source, "Distance", target.Distance)
        if source.MaxDistanceMeters ~= nil then
            target.MaxDistanceMeters = math.clamp(tonumber(source.MaxDistanceMeters) or target.MaxDistanceMeters, 1, 10000)
        end
        if includeRadius and source.RadiusMeters ~= nil then
            target.RadiusMeters = math.clamp(tonumber(source.RadiusMeters) or target.RadiusMeters, 1, 10000)
        end
    end
    applyESP(State.PlayerESP, config.PlayerESP, false)
    applyESP(State.MobESP, config.MobESP, false)
    applyESP(State.ItemESP, config.ItemESP, true)
    if type(config.MobESP) == "table" then
        State.MobESP.MaxTargets = math.clamp(tonumber(config.MobESP.MaxTargets) or State.MobESP.MaxTargets, 1, 150)
    end
    if type(config.ItemESP) == "table" then
        State.ItemESP.ExactName = tostring(config.ItemESP.ExactName or "")
    end

    local vision = type(config.Vision) == "table" and config.Vision or {}
    State.ClockTime = type(vision.ClockTime) == "number" and math.clamp(vision.ClockTime, 1, 24) or nil
    State.RemoveEffects = booleanValue(vision, "FullBrightEnabled", State.RemoveEffects)
    State.FullBrightLevel = State.RemoveEffects and math.clamp(tonumber(vision.FullBrightLevel) or 0, 0, 20) or nil
    State.XRay = booleanValue(vision, "XRay", State.XRay)
    State.XRayMethod = allowed(vision.XRayMethod, {"Hybrid", "Outline", "Wall Transparency"}, State.XRayMethod)
    State.XRayWallTransparency = math.clamp(tonumber(vision.XRayWallTransparency) or State.XRayWallTransparency, 0.1, 0.95)
    State.CameraFov = math.clamp(tonumber(vision.CameraFov) or State.CameraFov, 1, 120)
    State.UnlockZoom = booleanValue(vision, "UnlockZoom", State.UnlockZoom)

    local travel = type(config.Travel) == "table" and config.Travel or {}
    State.TelePlayerMode = allowed(travel.TelePlayerMode, {"Instant", "Fly"}, State.TelePlayerMode)
    State.TeleItemMode = allowed(travel.TeleItemMode, {"Instant", "Fly"}, State.TeleItemMode)
    State.TravelSpeed = math.clamp(tonumber(travel.TravelSpeed) or State.TravelSpeed, 10, 1000)
    State.SavedButtonName = tostring(travel.SavedButtonName or State.SavedButtonName)

    local filter = type(config.MobFilter) == "table" and config.MobFilter or {}
    State.MobManualFilterEnabled = booleanValue(filter, "Enabled", State.MobManualFilterEnabled)
    State.MobFilterText = tostring(filter.Text or State.MobFilterText or "")
    State.MobFilterScanRadiusMeters = math.clamp(tonumber(filter.ScanRadiusMeters) or State.MobFilterScanRadiusMeters, 10, 5000)
    parseMobManualNames(State.MobFilterText)

    local misc = type(config.Misc) == "table" and config.Misc or {}
    local previousFPSBoost = State.FPSBoost
    State.NoVoid = booleanValue(misc, "NoVoid", State.NoVoid)
    State.NoVoidMargin = math.clamp(tonumber(misc.NoVoidMargin) or State.NoVoidMargin, 5, 200)
    State.AntiAFK = booleanValue(misc, "AntiAFK", State.AntiAFK)
    State.AntiRagdoll = booleanValue(misc, "AntiRagdoll", State.AntiRagdoll)
    State.FPSBoost = booleanValue(misc, "FPSBoost", State.FPSBoost)
    State.ESPRefreshMode = allowed(misc.ESPRefreshMode, {"Adaptive", "25 FPS", "15 FPS", "10 FPS"}, State.ESPRefreshMode)
    if type(config.AutoLoad) == "boolean" then
        State.ConfigAutoLoad = config.AutoLoad
    end

    Extensions.SyncConfigControls()
    if not State.Noclip then
        restoreCollisions()
    end
    LocalPlayer.CameraMinZoomDistance = State.UnlockZoom and 0.5 or OriginalCamera.MinZoom
    LocalPlayer.CameraMaxZoomDistance = State.UnlockZoom and 10000 or OriginalCamera.MaxZoom
    if not State.AntiRagdoll then
        local _, humanoid = getCharacter()
        if humanoid then
            pcall(function()
                humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            end)
        end
    end
    Workspace.Gravity = State.GravityValue
    Camera = Workspace.CurrentCamera or Camera
    Camera.FieldOfView = State.CameraFov
    removeAllVisuals()
    if State.RemoveEffects then
        applyNoEffects()
        applyFullBright()
    else
        restoreEffects()
        restoreLightingVisuals()
    end
    if not State.XRay then
        restoreXRayOccluders()
    end
    if previousFPSBoost ~= State.FPSBoost then
        setFPSBoost(State.FPSBoost, true)
    elseif State.FPSBoostApplied then
        Lighting.GlobalShadows = false
    end
    if State.MobESP.Enabled or State.XRay then
        if next(MobCache) == nil then
            task.spawn(rescanMobs)
        end
    end
    if State.ItemESP.Enabled or State.XRay then
        task.spawn(function()
            scanItems(false)
        end)
    end
    if not silent then
        notify("Đã áp dụng config V6.4.", Theme.Success)
    end
    return true
end

function Extensions.ReadConfig(silent)
    if not readfile or not isfile then
        if not silent then notify("DeltaX không cung cấp readfile/isfile.", Theme.Danger) end
        return nil
    end
    if not isfile(Extensions.ConfigPath) then
        if not silent then notify("Chưa có config đã lưu.", Theme.Warning) end
        return nil
    end
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(Extensions.ConfigPath))
    end)
    if not success or type(result) ~= "table" then
        if not silent then notify("Không đọc được config: " .. tostring(result), Theme.Danger) end
        return nil
    end
    return result
end

function Extensions.SaveConfig()
    if not writefile then
        notify("DeltaX không cung cấp writefile.", Theme.Danger)
        return false
    end
    local success, result = pcall(function()
        if makefolder and (not isfolder or not isfolder(Extensions.ConfigFolder)) then
            makefolder(Extensions.ConfigFolder)
        end
        writefile(Extensions.ConfigPath, HttpService:JSONEncode(Extensions.BuildConfig()))
    end)
    if success then
        notify("Đã lưu config vào " .. Extensions.ConfigPath, Theme.Success)
        return true
    end
    notify("Lưu config thất bại: " .. tostring(result), Theme.Danger)
    return false
end

function Extensions.LoadConfig(silent)
    local config = Extensions.ReadConfig(silent)
    if not config then return false end
    return Extensions.ApplyConfig(config, silent)
end

function Extensions.DeleteConfig()
    if not delfile or not isfile then
        notify("DeltaX không cung cấp delfile/isfile.", Theme.Danger)
        return false
    end
    local success, result = pcall(function()
        if isfile(Extensions.ConfigPath) then
            delfile(Extensions.ConfigPath)
        end
    end)
    if success then
        notify("Đã xoá config V6.4.", Theme.Success)
        return true
    end
    notify("Xoá config thất bại: " .. tostring(result), Theme.Danger)
    return false
end

