local function fetchServerCandidates(sortOrder)
    local servers = {}
    local cursor = nil
    for _ = 1, 4 do
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=" .. sortOrder .. "&excludeFullGames=true&limit=100"
        if cursor then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end
        local success, response = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        if not success or type(response) ~= "table" then
            break
        end
        for _, server in ipairs(response.data or {}) do
            if server.id ~= game.JobId and server.playing < server.maxPlayers then
                table.insert(servers, server)
            end
        end
        cursor = response.nextPageCursor
        if not cursor then
            break
        end
    end
    return servers
end

local function hopServer(preferFew)
    task.spawn(function()
        notify(preferFew and "Đang tìm server ít người..." or "Đang tìm server đông người...", Theme.Warning)
        local servers = fetchServerCandidates(preferFew and "Asc" or "Desc")
        if #servers == 0 then
            notify("Không tìm thấy server phù hợp.", Theme.Danger)
            return
        end
        table.sort(servers, function(left, right)
            if preferFew then
                return left.playing < right.playing
            end
            return left.playing > right.playing
        end)
        local chosen = servers[1]
        notify("Đang vào server " .. chosen.playing .. "/" .. chosen.maxPlayers .. " người.", Theme.Success)
        TeleportService:TeleportToPlaceInstance(game.PlaceId, chosen.id, LocalPlayer)
    end)
end

local function setFPSBoost(enabled, silent)
    State.FPSBoost = enabled
    if enabled then
        if State.FPSBoostApplied then
            return
        end
        State.FPSBoostApplied = true
        pcall(function()
            State.RenderQualityBackup = settings().Rendering.QualityLevel
        end)
        if gethiddenproperty then
            pcall(function()
                State.TerrainDecorationBackup = gethiddenproperty(Workspace.Terrain, "Decoration")
            end)
        end

        local descendants = Workspace:GetDescendants()
        for index, instance in ipairs(descendants) do
            if instance:IsA("ParticleEmitter") or instance:IsA("Trail") or instance:IsA("Beam") or instance:IsA("Smoke") or instance:IsA("Fire") or instance:IsA("Sparkles") then
                if FPSBackup[instance] == nil then
                    FPSBackup[instance] = instance.Enabled
                end
                instance.Enabled = false
            end
            if index % 1200 == 0 then
                task.wait()
            end
        end
        Lighting.GlobalShadows = false
        pcall(function()
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        end)
        pcall(function()
            sethiddenproperty(Workspace.Terrain, "Decoration", false)
        end)
        if not silent then
            notify("FPS Boost đã bật.", Theme.Success)
        end
    else
        if not State.FPSBoostApplied then
            return
        end
        State.FPSBoostApplied = false
        for instance, enabledValue in pairs(FPSBackup) do
            if instance and instance.Parent then
                pcall(function()
                    instance.Enabled = enabledValue
                end)
            end
        end
        table.clear(FPSBackup)
        if State.FullBrightLevel == nil then
            Lighting.GlobalShadows = OriginalLighting.GlobalShadows
        end
        if State.RenderQualityBackup ~= nil then
            pcall(function()
                settings().Rendering.QualityLevel = State.RenderQualityBackup
            end)
        end
        pcall(function()
            local decoration = State.TerrainDecorationBackup
            sethiddenproperty(Workspace.Terrain, "Decoration", decoration == nil and true or decoration)
        end)
        State.RenderQualityBackup = nil
        State.TerrainDecorationBackup = nil
        if not silent then
            notify("FPS Boost đã tắt.", Theme.Success)
        end
    end
end

