local function getCharacter()
    local character = LocalPlayer.Character
    if not character then
        return nil, nil, nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
    return character, humanoid, root
end

local function rememberHumanoid(humanoid)
    if humanoid and not HumanoidOriginals[humanoid] then
        HumanoidOriginals[humanoid] = {
            WalkSpeed = humanoid.WalkSpeed,
            UseJumpPower = humanoid.UseJumpPower,
            JumpPower = humanoid.JumpPower,
            JumpHeight = humanoid.JumpHeight
        }
    end
    return humanoid and HumanoidOriginals[humanoid] or nil
end

local function restoreHumanoid(humanoid)
    local original = humanoid and HumanoidOriginals[humanoid]
    if humanoid and original then
        pcall(function()
            humanoid.WalkSpeed = original.WalkSpeed
            humanoid.UseJumpPower = original.UseJumpPower
            humanoid.JumpPower = original.JumpPower
            humanoid.JumpHeight = original.JumpHeight
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        end)
    end
end

local function resetSpeedSideEffects()
    local _, humanoid = getCharacter()
    local original = rememberHumanoid(humanoid)
    if humanoid and original then
        humanoid.WalkSpeed = original.WalkSpeed
    end
end

local function restoreCollisions()
    for part, canCollide in pairs(OriginalCollision) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = canCollide
            end)
        end
    end
    table.clear(OriginalCollision)
end

local function safeTeleport(targetCFrame)
    local character, _, root = getCharacter()
    if not character or not root or not targetCFrame then
        notify("Không thể dịch chuyển: nhân vật chưa sẵn sàng.", Theme.Danger)
        return false
    end
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        character:PivotTo(targetCFrame)
    end)
    return true
end

local function findPlayer(query)
    local normalized = string.lower(tostring(query or ""))
    if normalized == "" then
        return nil
    end
    local partialMatch
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local username = string.lower(player.Name)
            local displayName = string.lower(player.DisplayName)
            if username == normalized or displayName == normalized then
                return player
            end
            if not partialMatch and (string.find(username, normalized, 1, true) or string.find(displayName, normalized, 1, true)) then
                partialMatch = player
            end
        end
    end
    return partialMatch
end

local function resolveGuiParent()
