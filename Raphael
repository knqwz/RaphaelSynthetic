local function getCharacter()
    local character = LocalPlayer.Character
    if not character then
        return nil, nil, nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
    return character, humanoid, root
end

local function rememberHumanoid(humanoid)
    if humanoid and not HumanoidOriginals[humanoid] then
        HumanoidOriginals[humanoid] = {
            WalkSpeed = humanoid.WalkSpeed,
            UseJumpPower = humanoid.UseJumpPower,
            JumpPower = humanoid.JumpPower,
            JumpHeight = humanoid.JumpHeight
        }
    end
    return humanoid and HumanoidOriginals[humanoid] or nil
end

local function restoreHumanoid(humanoid)
    local original = humanoid and HumanoidOriginals[humanoid]
    if humanoid and original then
        pcall(function()
            humanoid.WalkSpeed = original.WalkSpeed
            humanoid.UseJumpPower = original.UseJumpPower
            humanoid.JumpPower = original.JumpPower
            humanoid.JumpHeight = original.JumpHeight
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        end)
    end
end

local function resetSpeedSideEffects()
    local _, humanoid = getCharacter()
    local original = rememberHumanoid(humanoid)
    if humanoid and original then
        humanoid.WalkSpeed = original.WalkSpeed
    end
end

