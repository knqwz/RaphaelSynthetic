local ItemHints = {"item", "pickup", "drop", "loot", "collect", "coin", "chest", "fruit", "weapon", "key", "potion", "gem", "ore", "crate"}

local function isCharacterDescendant(instance)
    local model = instance:FindFirstAncestorOfClass("Model")
    if not model then
        return false
    end
    if Players:GetPlayerFromCharacter(model) then
        return true
    end
    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function hasItemMetadata(instance)
    for _, tag in ipairs(CollectionService:GetTags(instance)) do
        if textHasHint(tag, ItemHints) then
            return true
        end
    end
    local attributes = {"Item", "IsItem", "Pickup", "IsPickup", "Collectible", "Loot", "Drop"}
    for _, name in ipairs(attributes) do
        local value = instance:GetAttribute(name)
        if value == true or type(value) == "string" and textHasHint(value, ItemHints) then
            return true
        end
    end
    return textHasHint(instance.Name, ItemHints)
end

local function findExactAncestor(part, exactLower)
    local current = part
    local depth = 0
    while current and current ~= Workspace and depth < 8 do
        if string.lower(current.Name) == exactLower and (current:IsA("Model") or current:IsA("Tool") or current:IsA("BasePart")) then
            return current
        end
        current = current.Parent
        depth = depth + 1
    end
    return nil
end

local function findAutomaticItem(part)
    local tool = part:FindFirstAncestorOfClass("Tool")
    if tool and tool:IsDescendantOf(Workspace) then
        return tool
    end

    if isCharacterDescendant(part) then
        return nil
    end

    local current = part
    local best
    local depth = 0
    while current and current ~= Workspace and depth < 6 do
        if current:IsA("Model") or current:IsA("BasePart") then
            if hasItemMetadata(current) then
                best = current
            end
            if current:FindFirstChildWhichIsA("ProximityPrompt", false) or current:FindFirstChildWhichIsA("ClickDetector", false) then
                best = current:IsA("BasePart") and (current:FindFirstAncestorOfClass("Model") or current) or current
            end
        end
        current = current.Parent
        depth = depth + 1
    end
    return best
end

scanItems = function(forceNotification)
    local character, _, root = getCharacter()
    if not root then
        if forceNotification then
            notify("Không thể quét item: nhân vật chưa sẵn sàng.", Theme.Danger)
        end
        return 0
    end

    local radiusStuds = State.ItemESP.RadiusMeters / 0.28
    local overlap = OverlapParams.new()
    overlap.FilterType = Enum.RaycastFilterType.Exclude
    overlap.FilterDescendantsInstances = character and {character} or {}
    overlap.MaxParts = 600

    local success, parts = pcall(function()
        return Workspace:GetPartBoundsInRadius(root.Position, radiusStuds, overlap)
    end)
    if not success then
        parts = {}
    end

    local exactLower = string.lower(State.ItemESP.ExactName)
    local found = {}
    for _, part in ipairs(parts) do
        local item
        if exactLower ~= "" then
            item = findExactAncestor(part, exactLower)
        else
            item = findAutomaticItem(part)
        end
        if item and item:IsDescendantOf(Workspace) and not isCharacterDescendant(item) then
            found[item] = true
        end
    end

    for item in pairs(ItemCache) do
        if not found[item] then
            ItemCache[item] = nil
            local visual = Visuals.Item[item]
            if visual then
                destroyVisual(visual)
                Visuals.Item[item] = nil
            end
        end
    end
    for item in pairs(found) do
        ItemCache[item] = true
    end

    local count = 0
    for _ in pairs(found) do
        count = count + 1
    end
    if forceNotification then
        local filterText = State.ItemESP.ExactName ~= "" and (" tên chính xác “" .. State.ItemESP.ExactName .. "”") or ""
        notify("Đã phát hiện " .. count .. " item" .. filterText .. " trong " .. State.ItemESP.RadiusMeters .. " m.", count > 0 and Theme.Success or Theme.Warning)
    end
    return count
end

