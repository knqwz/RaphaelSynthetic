local DrawingLibrary = rawget(RuntimeEnvironment, "Drawing") or rawget(_G, "Drawing")
local DrawingSupported = DrawingLibrary and type(DrawingLibrary.new) == "function"

local function newDrawing(className)
    if not DrawingSupported then
        return nil
    end
    local success, object = pcall(function()
        return DrawingLibrary.new(className)
    end)
    if success then
        return object
    end
    DrawingSupported = false
    return nil
end

local function destroyDrawing(object)
    if object then
        pcall(function()
            object:Remove()
        end)
    end
end

local function setDrawingVisible(object, visible)
    if object then
        pcall(function()
            object.Visible = visible
        end)
    end
end

local function getCategoryConfig(category)
    if category == "Player" then
        return State.PlayerESP
    elseif category == "Mob" then
        return State.MobESP
    end
    return State.ItemESP
end

local function createVisual(category, key)
    local config = getCategoryConfig(category)
    local visual = {
        Key = key,
        Category = category
    }

    if DrawingSupported then
        visual.Box = newDrawing("Square")
        visual.Tracer = newDrawing("Line")
        visual.Name = newDrawing("Text")
        visual.Health = newDrawing("Text")
        visual.Distance = newDrawing("Text")

        if visual.Box then
            visual.Box.Color = config.Color
            visual.Box.Thickness = 1.5
            visual.Box.Filled = false
            visual.Box.Transparency = 1
        end
        if visual.Tracer then
            visual.Tracer.Color = config.Color
            visual.Tracer.Thickness = 1.2
            visual.Tracer.Transparency = 0.9
        end
        for _, textObject in ipairs({visual.Name, visual.Health, visual.Distance}) do
            if textObject then
                textObject.Center = true
                textObject.Outline = true
                textObject.OutlineColor = Color3.fromRGB(0, 0, 0)
                textObject.Font = 2
                textObject.Size = 13
                textObject.Color = config.Color
                textObject.Transparency = 1
            end
        end
    end

    visual.Highlight = Instance.new("Highlight")
    visual.Highlight.Name = "Raphael_" .. category
    visual.Highlight.FillColor = config.Color
    visual.Highlight.OutlineColor = config.Color
    visual.Highlight.FillTransparency = 1
    visual.Highlight.OutlineTransparency = 0
    visual.Highlight.Enabled = false
    visual.Highlight.Parent = ScreenGui

    if not DrawingSupported then
        visual.Billboard = Instance.new("BillboardGui")
        visual.Billboard.Name = "Raphael_Label_" .. category
        visual.Billboard.Size = UDim2.fromOffset(210, 72)
        visual.Billboard.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
        visual.Billboard.AlwaysOnTop = true
        visual.Billboard.Enabled = false
        visual.Billboard.Parent = ScreenGui

        visual.BillboardText = Instance.new("TextLabel")
        visual.BillboardText.Size = UDim2.fromScale(1, 1)
        visual.BillboardText.BackgroundTransparency = 1
        visual.BillboardText.TextColor3 = config.Color
        visual.BillboardText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        visual.BillboardText.TextStrokeTransparency = 0
        visual.BillboardText.Font = Enum.Font.GothamBold
        visual.BillboardText.TextSize = 13
        visual.BillboardText.TextWrapped = true
        visual.BillboardText.Parent = visual.Billboard
    end

    Visuals[category][key] = visual
    return visual
end

local function hideVisual(visual)
    setDrawingVisible(visual.Box, false)
    setDrawingVisible(visual.Tracer, false)
    setDrawingVisible(visual.Name, false)
    setDrawingVisible(visual.Health, false)
    setDrawingVisible(visual.Distance, false)
    if visual.Highlight then
        visual.Highlight.Enabled = false
    end
    if visual.Billboard then
        visual.Billboard.Enabled = false
    end
end

local function destroyVisual(visual)
    if not visual then
        return
    end
    destroyDrawing(visual.Box)
    destroyDrawing(visual.Tracer)
    destroyDrawing(visual.Name)
    destroyDrawing(visual.Health)
    destroyDrawing(visual.Distance)
    if visual.Highlight then
        visual.Highlight:Destroy()
    end
    if visual.Billboard then
        visual.Billboard:Destroy()
    end
end

removeAllVisuals = function(category)
    local categories = category and {category} or {"Player", "Mob", "Item"}
    for _, categoryName in ipairs(categories) do
        for key, visual in pairs(Visuals[categoryName]) do
            destroyVisual(visual)
            Visuals[categoryName][key] = nil
        end
    end
end

local function getAdorneeRoot(instance)
    if not instance or not instance.Parent then
        return nil
    end
    if instance:IsA("BasePart") then
        return instance
    end
    if instance:IsA("Tool") then
        return instance:FindFirstChild("Handle") or instance:FindFirstChildWhichIsA("BasePart", true)
    end
    if instance:IsA("Model") then
        return instance:FindFirstChild("HumanoidRootPart")
            or instance:FindFirstChild("UpperTorso")
            or instance:FindFirstChild("Torso")
            or instance:FindFirstChild("Head")
            or instance.PrimaryPart
            or instance:FindFirstChildWhichIsA("BasePart", true)
    end
    return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function getBoundingData(instance)
    if not instance or not instance.Parent then
        return nil, nil
    end
    if instance:IsA("Model") then
        local success, boundingCFrame, boundingSize = pcall(instance.GetBoundingBox, instance)
        if success then
            return boundingCFrame, boundingSize
        end
    elseif instance:IsA("BasePart") then
        return instance.CFrame, instance.Size
    elseif instance:IsA("Tool") then
        local handle = instance:FindFirstChild("Handle") or instance:FindFirstChildWhichIsA("BasePart", true)
        if handle then
            return handle.CFrame, handle.Size
        end
    end
    local root = getAdorneeRoot(instance)
    if root then
        return root.CFrame, root.Size
    end
    return nil, nil
end

local function getScreenBounds(instance)
    local boundingCFrame, size = getBoundingData(instance)
    if not boundingCFrame or not size then
        return nil
    end

    size = Vector3.new(math.max(size.X, 1), math.max(size.Y, 1), math.max(size.Z, 1))
    local minimumX = math.huge
    local minimumY = math.huge
    local maximumX = -math.huge
    local maximumY = -math.huge
    local positiveDepth = 0

    for x = -1, 1, 2 do
        for y = -1, 1, 2 do
            for z = -1, 1, 2 do
                local worldPoint = (boundingCFrame * CFrame.new(size.X * x * 0.5, size.Y * y * 0.5, size.Z * z * 0.5)).Position
                local screenPoint = Camera:WorldToViewportPoint(worldPoint)
                if screenPoint.Z > 0 then
                    positiveDepth = positiveDepth + 1
                    minimumX = math.min(minimumX, screenPoint.X)
                    minimumY = math.min(minimumY, screenPoint.Y)
                    maximumX = math.max(maximumX, screenPoint.X)
                    maximumY = math.max(maximumY, screenPoint.Y)
                end
            end
        end
    end

    if positiveDepth == 0 then
        return nil
    end

    local viewport = Camera.ViewportSize
    if maximumX < 0 or minimumX > viewport.X or maximumY < 0 or minimumY > viewport.Y then
        return nil
    end

    local width = math.clamp(maximumX - minimumX, 8, viewport.X * 1.5)
    local height = math.clamp(maximumY - minimumY, 12, viewport.Y * 1.5)
    return Vector2.new(minimumX, minimumY), Vector2.new(width, height)
end

local function getHealthText(humanoid)
    if humanoid and humanoid.Health > 0 then
        return string.format("HP %d/%d", math.floor(humanoid.Health + 0.5), math.floor(humanoid.MaxHealth + 0.5))
    end
    return nil
end

local function getItemHealthText(item)
    local currentNames = {"Health", "HP", "Durability", "Amount"}
    local maximumNames = {"MaxHealth", "MaxHP", "MaxDurability", "MaxAmount"}
    local current
    local maximum

    for _, name in ipairs(currentNames) do
        local attribute = item:GetAttribute(name)
        if type(attribute) == "number" then
            current = attribute
            break
        end
        local valueObject = item:FindFirstChild(name, true)
        if valueObject and (valueObject:IsA("NumberValue") or valueObject:IsA("IntValue")) then
            current = valueObject.Value
            break
        end
    end

    for _, name in ipairs(maximumNames) do
        local attribute = item:GetAttribute(name)
        if type(attribute) == "number" then
            maximum = attribute
            break
        end
        local valueObject = item:FindFirstChild(name, true)
        if valueObject and (valueObject:IsA("NumberValue") or valueObject:IsA("IntValue")) then
            maximum = valueObject.Value
            break
        end
    end

    if current and maximum then
        return string.format("HP %d/%d", math.floor(current + 0.5), math.floor(maximum + 0.5))
    elseif current then
        return string.format("Giá trị %d", math.floor(current + 0.5))
    end
    return nil
end

local function updateVisual(category, key, target, root, displayName, healthText, distanceStuds)
    local config = getCategoryConfig(category)
    if not config.Enabled or not target or not root then
        local existing = Visuals[category][key]
        if existing then
            hideVisual(existing)
        end
        return
    end

    local distanceMeters = distanceStuds * 0.28
    local maximumMeters = category == "Item" and config.RadiusMeters or config.MaxDistanceMeters
    if distanceMeters > maximumMeters then
        local existing = Visuals[category][key]
        if existing then
            hideVisual(existing)
        end
        return
    end

    local visual = Visuals[category][key] or createVisual(category, key)
    local highlightEnabled = (config.Box and config.BoxMode == "Skin") or State.XRay or not DrawingSupported
    local highlightTarget = target
    if not target:IsA("Model") and not target:IsA("BasePart") then
        highlightTarget = root
    end
    visual.Highlight.Adornee = highlightTarget
    visual.Highlight.FillColor = config.Color
    visual.Highlight.OutlineColor = config.Color
    visual.Highlight.DepthMode = State.XRay and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    visual.Highlight.FillTransparency = State.XRay and 0.82 or 1
    visual.Highlight.OutlineTransparency = (config.Box or State.XRay) and 0 or 1
    visual.Highlight.Enabled = highlightEnabled

    if visual.Billboard then
        visual.Billboard.Adornee = root
        local lines = {}
        if config.Name then
            table.insert(lines, displayName)
        end
        if config.Health and healthText then
            table.insert(lines, healthText)
        end
        if config.Distance then
            table.insert(lines, string.format("%.1f m", distanceMeters))
        end
        visual.BillboardText.Text = table.concat(lines, "\n")
        visual.Billboard.Enabled = #lines > 0
        return
    end

    local topLeft, boxSize = getScreenBounds(target)
    if not topLeft or not boxSize then
        setDrawingVisible(visual.Box, false)
        setDrawingVisible(visual.Tracer, false)
        setDrawingVisible(visual.Name, false)
        setDrawingVisible(visual.Health, false)
        setDrawingVisible(visual.Distance, false)
        return
    end

    local centerX = topLeft.X + boxSize.X * 0.5
    local topY = topLeft.Y
    local bottomY = topLeft.Y + boxSize.Y

    if visual.Box then
        visual.Box.Color = config.Color
        visual.Box.Position = topLeft
        visual.Box.Size = boxSize
        visual.Box.Visible = config.Box and config.BoxMode == "2D"
    end

    if visual.Tracer then
        visual.Tracer.Color = config.Color
        visual.Tracer.From = Camera.ViewportSize * 0.5
        visual.Tracer.To = Vector2.new(centerX, topLeft.Y + boxSize.Y * 0.5)
        visual.Tracer.Visible = config.Tracer
    end

    if visual.Name then
        visual.Name.Color = config.Color
        visual.Name.Text = displayName
        visual.Name.Position = Vector2.new(centerX, topY - 17)
        visual.Name.Visible = config.Name
    end

    if visual.Health then
        visual.Health.Color = config.Color
        visual.Health.Text = healthText or ""
        visual.Health.Position = Vector2.new(centerX, bottomY + 2)
        visual.Health.Visible = config.Health and healthText ~= nil
    end

    if visual.Distance then
        visual.Distance.Color = config.Color
        visual.Distance.Text = string.format("[ %.1f m ]", distanceMeters)
        visual.Distance.Position = Vector2.new(centerX, bottomY + (config.Health and healthText and 17 or 2))
        visual.Distance.Visible = config.Distance
    end
end

local EnemyHints = {"enemy", "enemies", "mob", "mobs", "monster", "monsters", "npc", "boss", "zombie", "creature", "bot"}

local function textHasHint(text, hints)
    local lower = string.lower(tostring(text or ""))
    for _, hint in ipairs(hints) do
        if string.find(lower, hint, 1, true) then
            return true
        end
    end
    return false
end

local function hasEnemyMetadata(model)
    for _, tag in ipairs(CollectionService:GetTags(model)) do
        if textHasHint(tag, EnemyHints) then
            return true
        end
    end
    local attributes = {"Enemy", "IsEnemy", "Mob", "IsMob", "NPC", "IsNPC", "Monster", "EntityType", "Faction"}
    for _, attributeName in ipairs(attributes) do
        local value = model:GetAttribute(attributeName)
        if value == true or type(value) == "string" and textHasHint(value, EnemyHints) then
            return true
        end
    end
    local ancestor = model.Parent
    local depth = 0
    while ancestor and ancestor ~= Workspace and depth < 4 do
        if textHasHint(ancestor.Name, EnemyHints) then
            return true
        end
        ancestor = ancestor.Parent
        depth = depth + 1
    end
    return textHasHint(model.Name, EnemyHints)
end

local function isMobModel(model)
    if not model or not model:IsA("Model") or not model:IsDescendantOf(Workspace) then
        return false
    end
    if Players:GetPlayerFromCharacter(model) or model == LocalPlayer.Character then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid then
        return humanoid.Health > 0 and getAdorneeRoot(model) ~= nil
    end

    local controller = model:FindFirstChildOfClass("AnimationController")
    if controller and hasEnemyMetadata(model) then
        return getAdorneeRoot(model) ~= nil
    end

    if hasEnemyMetadata(model) then
        local health = model:GetAttribute("Health") or model:GetAttribute("HP")
        return getAdorneeRoot(model) ~= nil and (health == nil or type(health) ~= "number" or health > 0)
    end

    return false
end

local function considerMob(instance)
    local model
    if instance:IsA("Model") then
        model = instance
    elseif instance:IsA("Humanoid") or instance:IsA("AnimationController") then
        model = instance.Parent
    else
        model = instance:FindFirstAncestorOfClass("Model")
    end
    if model and isMobModel(model) then
        MobCache[model] = true
    end
end

local function rescanMobs()
    local descendants = Workspace:GetDescendants()
    for index, instance in ipairs(descendants) do
        if instance:IsA("Model") then
            considerMob(instance)
        end
        if index % 1200 == 0 then
            task.wait()
        end
    end
end

connect(Workspace.DescendantAdded, function(instance)
    task.defer(function()
        if instance.Parent then
            considerMob(instance)
        end
    end)
end)
connect(Workspace.DescendantRemoving, function(instance)
    if MobCache[instance] then
        MobCache[instance] = nil
        local visual = Visuals.Mob[instance]
