function Extensions.UpdateFlantPlatform(root)
    if not State.FlantEnabled or not root or not root.Parent then
        return
    end
    local platform = Extensions.EnsureFlantPlatform()
    platform.CFrame = CFrame.new(root.Position.X, State.FlantY, root.Position.Z)
    if root.Position.Y < State.FlantY + 2.4 then
        local velocity = root.AssemblyLinearVelocity
        root.CFrame = CFrame.new(root.Position.X, State.FlantY + 3.5, root.Position.Z) * (root.CFrame - root.Position)
        root.AssemblyLinearVelocity = Vector3.new(velocity.X, math.max(0, velocity.Y), velocity.Z)
    end
end

