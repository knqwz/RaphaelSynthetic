function Extensions.NeedsVisualRuntime(runtimeState: any): boolean
    if runtimeState.Inspector.Enabled then return true end
    if runtimeState.PlayerESP.Enabled then return true end
    if runtimeState.MobESP.Enabled then return true end
    if runtimeState.ItemESP.Enabled then return true end
    if runtimeState.UniversalScan.Active then return true end
    if runtimeState.XRay then return true end
    return runtimeState.Aimbot.Enabled == true
end

function Extensions.NeedsWorldVisualRefresh(runtimeState: any): boolean
    if runtimeState.PlayerESP.Enabled then return true end
    if runtimeState.MobESP.Enabled then return true end
    if runtimeState.ItemESP.Enabled then return true end
    if runtimeState.UniversalScan.Active then return true end
    return runtimeState.XRay == true
end

function Extensions.NeedsFPSSample(runtimeState: any): boolean
    if runtimeState.PlayerESP.Enabled then return true end
    if runtimeState.MobESP.Enabled then return true end
    if runtimeState.ItemESP.Enabled then return true end
    if runtimeState.UniversalScan.Active then return true end
    if runtimeState.Inspector.Enabled then return true end
    return runtimeState.XRay == true
end

function Extensions.UpdateVisualFPSSample(runtimeState: any, now: number)
    if not Extensions.NeedsFPSSample(runtimeState) then
        FrameCounter = 0
        FrameTimer = now
        MeasuredFPS = 0
        return
    end
    FrameCounter = FrameCounter + 1
    if now - FrameTimer >= 0.5 then
        MeasuredFPS = math.floor(FrameCounter / math.max(now - FrameTimer, 0.001) + 0.5)
        FrameCounter = 0
        FrameTimer = now
    end
end

function Extensions.HideRuntimeVisuals(runtimeState: any)
    local visuals: any = Visuals
    local hideFunction: any = hideVisual
    local categoryKey: any, categoryVisuals: any = next(visuals)
    while categoryKey do
        local visualKey: any, visual: any = next(categoryVisuals)
        while visualKey do
            hideFunction(visual)
            visualKey, visual = next(categoryVisuals, visualKey)
        end
        categoryKey, categoryVisuals = next(visuals, categoryKey)
    end
    local inspector: any = runtimeState.Inspector
    if inspector.CrosshairFrame then inspector.CrosshairFrame.Visible = false end
    if inspector.Highlight then inspector.Highlight.Enabled = false end
    if inspector.NameLabel then inspector.NameLabel.Visible = false end
end

function Extensions.UpdateVisualOverlays(runtimeState: any, now: number)
    Extensions.UpdateInspector(now)
    Extensions.RefreshDynamicESP()
    local aimbot: any = runtimeState.Aimbot
    if not aimbot.Enabled then return end
    if aimbot.RenderBound then return end
    local updateAimbot: any = rawget(Extensions, "UpdateAimbotFrame")
    if updateAimbot then updateAimbot(now) end
end

function Extensions.GetVisualRefreshInterval(runtimeState: any): number
    local mode: string = tostring(runtimeState.ESPRefreshMode or "")
    if mode == "25 FPS" then return 0.04 end
    if mode == "15 FPS" then return 0.067 end
    if mode == "10 FPS" then return 0.1 end
    if MeasuredFPS > 0 and MeasuredFPS < 30 then return 0.14 end
    if MeasuredFPS > 0 and MeasuredFPS < 45 then return 0.11 end
    return 0.08
end

function Extensions.IsVisualWorkEnabled(runtimeState: any, category: string): boolean
    if category == "Mob" then return runtimeState.MobESP.Enabled or runtimeState.XRay end
    if category == "Item" then return runtimeState.ItemESP.Enabled or runtimeState.XRay end
    if category == "Scan" then return runtimeState.UniversalScan.Active == true end
    return false
end

function Extensions.RefreshVisualWork(runtimeState: any, now: number, localRoot: any, refreshInterval: number)
    if (runtimeState.PlayerESP.Enabled or runtimeState.XRay) and now - ESPLastUpdate.Player >= refreshInterval then
        ESPLastUpdate.Player = now
        Extensions.RefreshPlayerESPWork(now, localRoot)
    end
    for _ = 1, #ESPWorkOrder do
        local category: string = tostring(ESPWorkOrder[ESPWorkPhase])
        ESPWorkPhase = ESPWorkPhase % #ESPWorkOrder + 1
        if Extensions.IsVisualWorkEnabled(runtimeState, category) and now - ESPLastUpdate[category] >= refreshInterval then
            ESPLastUpdate[category] = now
            if category == "Mob" then
                Extensions.RefreshMobESPWork(now, localRoot)
            elseif category == "Item" then
                Extensions.RefreshItemESPWork(now, localRoot)
            else
                Extensions.RefreshUniversalScanWork(now, localRoot)
            end
            break
        end
    end
end

function Extensions.UpdateVisualRuntime(deltaTime: number)
    local runtimeState: any = State
    if not runtimeState.Running then return end
    local flight: any = runtimeState.Flight
    if flight.CharacterEnabled or flight.CameraEnabled then
        Extensions.UpdateFlight(deltaTime)
    end
    if not Extensions.NeedsVisualRuntime(runtimeState) then
        if FrameCounter ~= 0 or MeasuredFPS ~= 0 then
            FrameCounter = 0
            FrameTimer = os.clock()
            MeasuredFPS = 0
        end
        return
    end
    local now: number = os.clock()
    Extensions.UpdateVisualFPSSample(runtimeState, now)
    if runtimeState.ScreenBlankEnabled then
        Extensions.HideRuntimeVisuals(runtimeState)
        return
    end
    Extensions.UpdateVisualOverlays(runtimeState, now)
    if not Extensions.NeedsWorldVisualRefresh(runtimeState) then return end
    Camera = Workspace.CurrentCamera or Camera
    local _, _, localRoot: any = getCharacter()
    if not localRoot then return end
    Extensions.RefreshVisualWork(runtimeState, now, localRoot, Extensions.GetVisualRefreshInterval(runtimeState))
end
