function Extensions.SelectServerBrowserServer(server, card)
    local browser = State.ServerBrowser
    browser.SelectedServer = server
    for _, candidate in ipairs(browser.ServerCards) do
        if candidate and candidate.Parent then
            local selected = candidate == card
            tween(candidate, {
                BackgroundColor3 = selected and Luxury.Palette.CellRaised or Luxury.Palette.Cell,
                BackgroundTransparency = selected and 0.08 or 0.28
            }, 0.16)
            local stroke = candidate:FindFirstChild("SelectionStroke")
            if stroke then
                stroke.Color = selected and Luxury.Palette.AccentSoft or Luxury.Palette.Hairline
                stroke.Transparency = selected and 0.24 or 0.9
                stroke.Thickness = selected and 1.4 or 0.7
            end
            local badge = candidate:FindFirstChild("SelectionBadge")
            if badge then badge.Visible = selected end
        end
    end
    local playing = tonumber(server.playing) or 0
    local maximum = tonumber(server.maxPlayers) or 0
    local ping = tonumber(server.ping)
    local fps = tonumber(server.fps)
    if browser.SelectionTitle then browser.SelectionTitle.Text = string.format("Đã chọn · %d/%d người", playing, maximum) end
    if browser.SelectionMeta then
        browser.SelectionMeta.Text = (ping and (math.floor(ping + 0.5) .. " ms") or "Ping N/A")
            .. "  ·  " .. (fps and (math.floor(fps + 0.5) .. " FPS") or "FPS N/A")
            .. "  ·  " .. string.sub(tostring(server.id), 1, 18) .. "…"
    end
    if browser.JoinButton then
        browser.JoinButton.Text = "Tham gia server"
        browser.JoinButton.BackgroundTransparency = 0.08
    end
end

function Extensions.PopulateServerBrowser(servers)
    local browser = State.ServerBrowser
    local list = browser.ServerList
    if not list then return end
