    body.BackgroundTransparency = 1
    body.ClipsDescendants = true
    body.ZIndex = baseZ + 4
    body.Parent = surface

    local sheet = {Backdrop = backdrop, Card = holder, Surface = surface, Header = header, Body = body, Title = title, Subtitle = subtitle, Close = close, Emblem = emblem, BaseZ = baseZ, IsCompact = compact, HeaderHeight = headerHeight, GuardUntil = 0}
    local function closeSheet()
        if config.OnClose then config.OnClose() else Luxury.Hide(sheet) end
    end
    local function isPress(input)
        return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
    end
    local pressedInside = false
    local dismissArmed = false
    connect(close.Activated, closeSheet)
    connect(surface.InputBegan, function(input)
        if isPress(input) then
            pressedInside = true
            dismissArmed = false
        end
    end)
    connect(dismiss.InputBegan, function(input)
        if isPress(input) and not pressedInside then dismissArmed = true end
    end)
    connect(UserInputService.InputEnded, function(input)
        if isPress(input) and pressedInside then
            pressedInside = false
            sheet.GuardUntil = os.clock() + 0.6
        end
    end)
    connect(dismiss.Activated, function()
        local armed = dismissArmed
        dismissArmed = false
        if armed and not pressedInside and os.clock() >= sheet.GuardUntil then closeSheet() end
    end)
    return sheet
end

function Luxury.Show(sheet)
    if not sheet then return end
    sheet.Backdrop.Visible = true
    sheet.Backdrop.BackgroundTransparency = 1
    sheet.Card.Visible = true
    UI.Motion.Reset(sheet.Card)
    UI.Motion.Pop(sheet.Card)
    tween(sheet.Backdrop, {BackgroundTransparency = 0.34}, 0.22)
end

function Luxury.Hide(sheet, immediate)
    if not sheet or not sheet.Backdrop then return end
    if immediate then
        sheet.Backdrop.Visible = false
        sheet.Card.Visible = true
        return
    end
    if not sheet.Backdrop.Visible then return end
    tween(sheet.Backdrop, {BackgroundTransparency = 1}, 0.14)
    UI.Motion.Hide(sheet.Card, function()
        if sheet.Backdrop then
            sheet.Backdrop.Visible = false
            sheet.Card.Visible = true
        end
    end)
end

function Luxury.Segmented(parent, options, selected, callback, zIndex)
    local palette = Luxury.Palette
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 40)
    holder.BackgroundColor3 = palette.SheetDeep
    holder.BackgroundTransparency = 0.1
    holder.BorderSizePixel = 0
    holder.ZIndex = zIndex or (parent.ZIndex + 1)
    holder.Parent = parent
    Luxury.Corner(holder, 14)
    Luxury.Stroke(holder, 0.88, 1)
    local count = #options
    local thumb = Instance.new("Frame")
    thumb.Size = UDim2.new(1 / count, -6, 1, -6)
    thumb.BackgroundColor3 = palette.Accent
    thumb.BackgroundTransparency = 0.18
    thumb.BorderSizePixel = 0
    thumb.ZIndex = holder.ZIndex + 1
    thumb.Parent = holder
    Luxury.Corner(thumb, 11)
    Luxury.AccentGradient(thumb, 20, 0.06)
    local control = {Instance = holder, Buttons = {}, Index = selected or 1}
    local function paint(animated)
        local goal = UDim2.new((control.Index - 1) / count, 3, 0, 3)
        if animated then tween(thumb, {Position = goal}, 0.18) else thumb.Position = goal end
        for index, button in ipairs(control.Buttons) do
            button.TextColor3 = index == control.Index and palette.Text or palette.Secondary
        end
    end
    for index, text in ipairs(options) do
        local button = Instance.new("TextButton")
        button:SetAttribute("RaphaelButtonArtworkExempt", true)
        button.Position = UDim2.new((index - 1) / count, 0, 0, 0)
        button.Size = UDim2.new(1 / count, 0, 1, 0)
        button.BackgroundTransparency = 1
        button.BorderSizePixel = 0
        button.Text = text
        button.TextColor3 = palette.Secondary
        button.Font = Enum.Font.GothamSemibold
        button.TextSize = 12
        button.TextTruncate = Enum.TextTruncate.AtEnd
        button.AutoButtonColor = false
        button.ZIndex = holder.ZIndex + 2
        button.Parent = holder
        control.Buttons[index] = button
        connect(button.Activated, function() control.Set(index, true) end)
    end
    function control.Set(index, invoke)
        index = math.floor(math.clamp(tonumber(index) or 1, 1, count))
        local changed = index ~= control.Index
        control.Index = index
        if changed then paint(true) end
        if invoke and changed and callback then callback(index) end
    end
    function control.Get() return control.Index end
    paint(false)
    return control
end

function Luxury.Switch(parent, value, callback, zIndex)
    local palette = Luxury.Palette
    local track = Instance.new("TextButton")
    track:SetAttribute("RaphaelButtonArtworkExempt", true)
    track.AnchorPoint = Vector2.new(1, 0.5)
    track.Position = UDim2.new(1, -14, 0.5, 0)
    track.Size = UDim2.fromOffset(52, 30)
    track.BackgroundColor3 = palette.CellRaised
    track.BackgroundTransparency = 0.2
    track.BorderSizePixel = 0
    track.Text = ""
    track.AutoButtonColor = false
    track.ZIndex = zIndex or (parent.ZIndex + 2)
    track.Parent = parent
    Luxury.Corner(track, 15)
    local trackStroke = Luxury.Stroke(track, 0.86, 1)
    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0, 0.5)
    knob.Size = UDim2.fromOffset(24, 24)
    knob.BackgroundColor3 = palette.Text
    knob.BorderSizePixel = 0
    knob.ZIndex = track.ZIndex + 1
    knob.Parent = track
    Luxury.Corner(knob, 12)
    local control = {Instance = track, Value = not not value}
    local function paint(animated)
        local trackGoal = {BackgroundColor3 = control.Value and palette.Accent or palette.CellRaised, BackgroundTransparency = control.Value and 0.04 or 0.2}
        local knobGoal = {Position = UDim2.new(0, control.Value and 25 or 3, 0.5, 0)}
        trackStroke.Color = control.Value and palette.AccentSoft or palette.Hairline
        trackStroke.Transparency = control.Value and 0.55 or 0.86
        if animated then
            tween(track, trackGoal, 0.17)
            tween(knob, knobGoal, 0.17)
        else
            track.BackgroundColor3 = trackGoal.BackgroundColor3
            track.BackgroundTransparency = trackGoal.BackgroundTransparency
            knob.Position = knobGoal.Position
        end
    end
    function control.Set(newValue, invoke)
        newValue = not not newValue
        local changed = newValue ~= control.Value
        control.Value = newValue
        if changed then paint(true) end
        if invoke and changed and callback then callback(control.Value) end
    end
    function control.Get() return control.Value end
    connect(track.Activated, function() control.Set(not control.Value, true) end)
    paint(false)
    return control
end

function Luxury.NumberField(parent, options)
    local palette = Luxury.Palette
    local zIndex = options.ZIndex or (parent.ZIndex + 2)
    local width = options.Width or 156
    local height = options.Height or 38
    local minimum = options.Min or 0
    local maximum = options.Max or 100
    local step = options.Step or 1
    local holder = Instance.new("Frame")
    holder.Name = "NumberField"
    holder.AnchorPoint = Vector2.new(1, 0.5)
    holder.Position = UDim2.new(1, -12, 0.5, 0)
    holder.Size = UDim2.fromOffset(width, height)
    holder.BackgroundColor3 = palette.SheetDeep
    holder.BackgroundTransparency = 0.06
    holder.BorderSizePixel = 0
    holder.ZIndex = zIndex
    holder.Parent = parent
    Luxury.Corner(holder, 13)
    local holderStroke = Luxury.Stroke(holder, 0.84, 1)
    local function stepper(text, position)
        local button = Instance.new("TextButton")
        button:SetAttribute("RaphaelButtonArtworkExempt", true)
        button.Position = position
        button.Size = UDim2.fromOffset(height, height)
        button.BackgroundTransparency = 1
        button.BorderSizePixel = 0
        button.Text = text
        button.TextColor3 = palette.AccentSoft
        button.Font = Enum.Font.GothamBold
        button.TextSize = 20
        button.AutoButtonColor = false
        button.ZIndex = zIndex + 1
        button.Parent = holder
        return button
    end
    local minus = stepper("−", UDim2.fromOffset(0, 0))
    local plus = stepper("+", UDim2.new(1, -height, 0, 0))
    local box = Instance.new("TextBox")
    box.Name = "Value"
    box.Position = UDim2.fromOffset(height, 0)
    box.Size = UDim2.new(1, -height * 2, 1, 0)
    box.BackgroundTransparency = 1
    box.BorderSizePixel = 0
    box.ClearTextOnFocus = false
    box.TextColor3 = palette.Text
    box.PlaceholderColor3 = palette.Tertiary
    box.Font = Enum.Font.GothamBold
    box.TextSize = 14
    box.TextXAlignment = Enum.TextXAlignment.Center
    box.ZIndex = zIndex + 1
    box.Parent = holder
    local control = {Instance = holder, Box = box, Value = options.Value or minimum}
    local function format(value)
        if options.Integer then return tostring(math.floor(value + 0.5)) end
        local text = string.format("%." .. tostring(options.Decimals or 2) .. "f", value)
        text = string.gsub(text, "0+$", "")
        text = string.gsub(text, "%.$", "")
        return text .. (options.Suffix or "")
    end
    function control.Set(value, invoke)
        local numeric = tonumber(value)
        if not numeric then return end
        numeric = math.clamp(numeric, minimum, maximum)
        if options.Integer then numeric = math.floor(numeric + 0.5) end
        control.Value = numeric
        box.Text = format(numeric)
        if invoke and options.Callback then options.Callback(numeric) end
    end
    function control.Get() return control.Value end
    connect(minus.Activated, function() control.Set(control.Value - step, true) end)
    connect(plus.Activated, function() control.Set(control.Value + step, true) end)
    connect(box.Focused, function()
        tween(holderStroke, {Color = palette.Accent, Transparency = 0.2}, 0.12)
    end)
    connect(box.FocusLost, function()
        tween(holderStroke, {Color = palette.Hairline, Transparency = 0.84}, 0.12)
        local numeric = tonumber((string.gsub(box.Text, "[^%d%.%-]", "")))
        if numeric then control.Set(numeric, true) else box.Text = format(control.Value) end
    end)
    control.Set(control.Value, false)
    return control
end

