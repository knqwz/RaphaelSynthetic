function Extensions.GetAimbotPart(model)
    if not model or not model.Parent then
        return nil
    end
    if State.Aimbot.AimPart == "Đầu" then
        local head = model:FindFirstChild("Head")
        return head and head:IsA("BasePart") and head or nil
    end
    local body = model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("LowerTorso")
    return body and body:IsA("BasePart") and body or nil
end

