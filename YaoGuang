function Extensions.ScoreInspectorCandidate(instance, center, maximumDepth)
    if not instance or not instance.Parent or instance:GetAttribute("RaphaelOwned") then
        return nil
    end
    local preliminaryRoot = getAdorneeRoot(instance)
    if not preliminaryRoot or not preliminaryRoot.Parent then
        return nil
    end
    local preliminaryPoint, preliminaryVisible = Camera:WorldToViewportPoint(preliminaryRoot.Position)
    if not preliminaryVisible or preliminaryPoint.Z <= 0 or (Vector2.new(preliminaryPoint.X, preliminaryPoint.Y) - center).Magnitude > math.max(State.Inspector.ScreenRadius * 4, 220) then
        return nil
    end
    local target, displayName, color, priority = Extensions.ResolveInspectorTarget(instance)
    if not target or priority < 2 then
        return nil
    end
    local root = getAdorneeRoot(target)
    if not root or not root.Parent then
        return nil
    end
    local projected, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen or projected.Z <= 0 or projected.Z > State.Inspector.MaxDistance then
        return nil
    end
    if maximumDepth and projected.Z > maximumDepth + math.max(6, maximumDepth * 0.015) then
        return nil
    end

    local distance = (Vector2.new(projected.X, projected.Y) - center).Magnitude
    local topLeft, boxSize = getScreenBounds(target)
    local containsCenter = false
    if topLeft and boxSize then
        containsCenter = center.X >= topLeft.X - 4
            and center.X <= topLeft.X + boxSize.X + 4
            and center.Y >= topLeft.Y - 4
            and center.Y <= topLeft.Y + boxSize.Y + 4
    end
    if not containsCenter and distance > State.Inspector.ScreenRadius then
        return nil
    end
    local score = (containsCenter and 0 or distance + 8) * 10000 + projected.Z - priority * 100
    return {
        Target = target,
        Root = root,
        DisplayName = displayName,
        Color = color,
        Priority = priority,
        Depth = projected.Z,
        Score = score,
        Position = root.Position
    }
end

function Extensions.FindInspectorScreenCandidate(center, rayDepth)
    local best
    State.Inspector.ScreenGeneration = State.Inspector.ScreenGeneration + 1
    local generation = State.Inspector.ScreenGeneration
    local seen = State.Inspector.ScreenSeen
    local checked = 0
    local function consider(instance)
        if checked >= 280 or not instance or seen[instance] == generation then
            return
        end
        seen[instance] = generation
        checked = checked + 1
        local candidate = Extensions.ScoreInspectorCandidate(instance, center, rayDepth)
        if candidate and (not best or candidate.Score < best.Score) then
            best = candidate
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            consider(player.Character)
        end
    end
    local mobChecked = 0
    for model in pairs(MobCache) do
        consider(model)
        mobChecked = mobChecked + 1
        if mobChecked >= 140 then
            break
        end
    end
    local itemChecked = 0
    for item in pairs(ItemCache) do
        consider(item)
        itemChecked = itemChecked + 1
        if itemChecked >= 80 then
            break
        end
    end
    for _, tag in ipairs(State.Inspector.Tags) do
        for _, instance in ipairs(CollectionService:GetTagged(tag)) do
            consider(instance)
            if checked >= 240 then
                break
            end
        end
        if checked >= 240 then
            break
        end
    end

    if checked < 280 then
        local character = LocalPlayer.Character
        local filter = State.Inspector.FilterBuffer
        table.clear(filter)
        if character then
            filter[1] = character
        end
        State.Inspector.OverlapParams.FilterType = Enum.RaycastFilterType.Exclude
        State.Inspector.OverlapParams.FilterDescendantsInstances = filter
        State.Inspector.OverlapParams.MaxParts = math.min(80, 280 - checked)
        local corridorDepth = math.min(rayDepth or State.Inspector.MaxDistance, 1200)
        local corridor = Camera.CFrame * CFrame.new(0, 0, -corridorDepth * 0.5)
        local success, parts = pcall(Workspace.GetPartBoundsInBox, Workspace, corridor, Vector3.new(30, 30, corridorDepth), State.Inspector.OverlapParams)
        if success then
            for _, part in ipairs(parts) do
                consider(part)
            end
            table.clear(parts)
        end
    end
    return best
end

function Extensions.ScanInspector(now)
    if now - State.Inspector.LastScan < 0.08 then
        return
    end
    State.Inspector.LastScan = now
    Camera = Workspace.CurrentCamera or Camera
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    local ray = Camera:ViewportPointToRay(center.X, center.Y)
    local character = LocalPlayer.Character
    local filter = State.Inspector.FilterBuffer
    table.clear(filter)
    if character then
        filter[1] = character
    end
    State.Inspector.RaycastParams.FilterType = Enum.RaycastFilterType.Exclude
    State.Inspector.RaycastParams.FilterDescendantsInstances = filter
    State.Inspector.RaycastParams.IgnoreWater = false
    local result = Workspace:Raycast(ray.Origin, ray.Direction * State.Inspector.MaxDistance, State.Inspector.RaycastParams)
    local rayDepth = result and (result.Position - ray.Origin).Magnitude or State.Inspector.MaxDistance
    local screenCandidate = Extensions.FindInspectorScreenCandidate(center, rayDepth)
    local target
    local displayName = ""
    local color = Theme.Accent
    local priority = 0
    local hitPosition
    local root

    if result then
        target, displayName, color, priority = Extensions.ResolveInspectorTarget(result.Instance)
        root = result.Instance
        hitPosition = result.Position
    end
    if screenCandidate and (not target or priority < 2 and screenCandidate.Priority >= 2 or screenCandidate.Depth + 2 < rayDepth) then
        target = screenCandidate.Target
        root = screenCandidate.Root
        displayName = screenCandidate.DisplayName
        color = screenCandidate.Color
        priority = screenCandidate.Priority
        hitPosition = screenCandidate.Position
    end

    State.Inspector.Target = target
    State.Inspector.Root = root
    State.Inspector.DisplayName = displayName
    State.Inspector.CopyName = Extensions.GetInspectorCopyName(target, displayName)
    State.Inspector.Color = color
    State.Inspector.Priority = priority
    State.Inspector.HitPosition = hitPosition
end

function Extensions.UpdateInspector(now)
    if not State.Inspector.Enabled then
        return
    end
    Extensions.CreateInspectorVisuals()
    Camera = Workspace.CurrentCamera or Camera
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    if State.Inspector.CrosshairFrame then
        State.Inspector.CrosshairFrame.Position = UDim2.fromOffset(center.X, center.Y)
        State.Inspector.CrosshairFrame.Visible = true
    end

    Extensions.ScanInspector(now)
    local target = State.Inspector.Target
    local color = State.Inspector.Color or Theme.Accent
    local valid = target and target.Parent and State.Inspector.HitPosition ~= nil
    if State.Inspector.NameLabel then
        State.Inspector.NameLabel.Position = UDim2.fromOffset(center.X, center.Y + 12)
        State.Inspector.NameLabel.Text = valid and State.Inspector.DisplayName or ""
        State.Inspector.NameLabel.TextColor3 = color:Lerp(Theme.Text, 0.35)
        State.Inspector.NameLabel.Visible = not not valid
    end

    local highlightTarget
    if valid then
        if target:IsA("Model") or target:IsA("BasePart") then
            highlightTarget = target
        elseif target:IsA("Tool") then
            highlightTarget = getAdorneeRoot(target)
        else
            highlightTarget = State.Inspector.Root and State.Inspector.Root:IsA("BasePart") and State.Inspector.Root or getAdorneeRoot(target)
        end
    end
    if State.Inspector.Highlight then
        State.Inspector.Highlight.Adornee = highlightTarget
        State.Inspector.Highlight.FillColor = color
        State.Inspector.Highlight.OutlineColor = color:Lerp(Theme.Text, 0.25)
        State.Inspector.Highlight.Enabled = highlightTarget ~= nil
    end
end

function Extensions.SetInspectorEnabled(enabled, silent)
    State.Inspector.Enabled = not not enabled
    State.Inspector.LastScan = 0
    if State.Inspector.Enabled then
        Extensions.CreateInspectorVisuals()
        task.spawn(rescanMobs)
        task.spawn(function()
            scanItems(false)
        end)
    else
        Extensions.DestroyInspectorVisuals()
    end
    local control = State.ConfigControls.InspectorEnabled
    if control and control.Set then
        control.Set(State.Inspector.Enabled, false)
    end
    if not silent then
        notify(State.Inspector.Enabled and "Nhận diện tâm 3D đã bật." or "Nhận diện tâm đã tắt và toàn bộ visual đã được xoá.", State.Inspector.Enabled and Theme.Success or Theme.Warning)
    end
end

local function getHealthText(humanoid)
    if humanoid and humanoid.Health > 0 then
        return string.format("HP %d/%d", math.floor(humanoid.Health + 0.5), math.floor(humanoid.MaxHealth + 0.5))
    end
    return nil
end

local function getItemHealthText(item)
    local current
    local maximum

    for _, name in ipairs(State.ItemHealthCurrentNames) do
        local attribute = item:GetAttribute(name)
        if type(attribute) == "number" then
            current = attribute
            break
        end
        local valueObject = item:FindFirstChild(name, true)
        if valueObject and (valueObject:IsA("NumberValue") or valueObject:IsA("IntValue")) then
            current = valueObject.Value
            break
        end
    end

    for _, name in ipairs(State.ItemHealthMaximumNames) do
        local attribute = item:GetAttribute(name)
        if type(attribute) == "number" then
            maximum = attribute
            break
        end
        local valueObject = item:FindFirstChild(name, true)
        if valueObject and (valueObject:IsA("NumberValue") or valueObject:IsA("IntValue")) then
            maximum = valueObject.Value
            break
        end
    end

    if current and maximum then
        return string.format("HP %d/%d", math.floor(current + 0.5), math.floor(maximum + 0.5))
    elseif current then
        return string.format("Giá trị %d", math.floor(current + 0.5))
    end
    return nil
end

function Extensions.GetCachedItemHealthText(item, now)
    local cache = State.ItemHealthCache[item]
    if cache and now < cache.NextUpdate then
        return cache.Text
    end
    local text = getItemHealthText(item)
    if cache then
        cache.Text = text
        cache.NextUpdate = now + 0.5
    else
        State.ItemHealthCache[item] = {Text = text, NextUpdate = now + 0.5}
    end
    return text
end

function Extensions.GetTracerOriginPoint(config)
    local viewport = Camera.ViewportSize
    local origin = config.TracerOrigin
    if origin == "Trên" then
        return Vector2.new(viewport.X * 0.5, 0)
    elseif origin == "Giữa" then
        return Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    end
    return Vector2.new(viewport.X * 0.5, viewport.Y)
end

function Extensions.UpdateDynamicVisual(visual)
    if not visual.Active then
        setDrawingVisible(visual.Box, false)
        setDrawingVisible(visual.Tracer, false)
            if visual.InfoBillboard and visual.InfoBillboard.Enabled then
            visual.InfoBillboard.Enabled = false
        end
        if visual.LookBeam and visual.LookBeam.Enabled then
            visual.LookBeam.Enabled = false
        end
        return
    end

    local target = visual.Target
    local root = visual.Root
    if not target or not target.Parent or not root or not root.Parent then
        visual.Active = false
        hideVisual(visual)
        return
    end

    local config = getCategoryConfig(visual.Category)
    local espEnabled = config.Enabled and visual.ESPPermitted ~= false
    Camera = Workspace.CurrentCamera or Camera
    local projected, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen or projected.Z <= 0 then
        setDrawingVisible(visual.Box, false)
        setDrawingVisible(visual.Tracer, false)
            if visual.InfoBillboard and visual.InfoBillboard.Enabled then
            visual.InfoBillboard.Enabled = false
        end
        if visual.LookBeam and visual.LookBeam.Enabled then
            visual.LookBeam.Enabled = false
        end
        return
    end

    if visual.InfoBillboard then
        local infoAnchor = visual.InfoAnchor
        local infoVisible = visual.InfoEnabled and infoAnchor and infoAnchor.Parent ~= nil
        if infoVisible and visual.InfoBillboard.Adornee ~= infoAnchor then
            visual.InfoBillboard.Adornee = infoAnchor
        end
        if visual.InfoBillboard.Enabled ~= not not infoVisible then
            visual.InfoBillboard.Enabled = not not infoVisible
        end
    end

    local screenPosition = Vector2.new(projected.X, projected.Y)
    local boxVisible = visual.Box ~= nil and espEnabled and config.Box and config.BoxMode == "2D"
    if boxVisible then
        local cameraDistance = math.max(projected.Z, 1)
        local scale = visual.Category == "Item" and 850 or 1200
        local width = math.clamp(scale / cameraDistance, 12, 320)
        local height = visual.Category == "Item" and width or width * 1.4
        local centerY = root.Name == "Head" and visual.Category ~= "Item" and screenPosition.Y + height * 0.34 or screenPosition.Y
        visual.Box.Size = Vector2.new(width, height)
        visual.Box.Position = Vector2.new(screenPosition.X - width * 0.5, centerY - height * 0.5)
    end
    setDrawingVisible(visual.Box, boxVisible)

    local tracerVisible = visual.Tracer ~= nil and espEnabled and config.Tracer
    if tracerVisible then
        visual.Tracer.From = Extensions.GetTracerOriginPoint(config)
        visual.Tracer.To = screenPosition
    end
    setDrawingVisible(visual.Tracer, tracerVisible)

    local lookPart = visual.InfoAnchor or root
    local lookEnabled = espEnabled and visual.Category ~= "Item" and config.LookDirection and lookPart and lookPart:IsA("BasePart")
    local beamVisible = false
    if lookEnabled then
        if visual.LookAdornee ~= lookPart or not visual.LookBeam or not visual.LookBeam.Parent then
            if visual.LookBeam then visual.LookBeam:Destroy() end
            if visual.LookStart then visual.LookStart:Destroy() end
            if visual.LookEnd then visual.LookEnd:Destroy() end
            visual.LookStart = Instance.new("Attachment")
            visual.LookEnd = Instance.new("Attachment")
            visual.LookBeam = Instance.new("Beam")
            visual.LookStart.Name = "RaphaelLookStart"
            visual.LookEnd.Name = "RaphaelLookEnd"
            visual.LookBeam.Name = "RaphaelLookDirection"
            visual.LookStart:SetAttribute("RaphaelOwned", true)
            visual.LookEnd:SetAttribute("RaphaelOwned", true)
            visual.LookBeam:SetAttribute("RaphaelOwned", true)
            visual.LookStart.Parent = lookPart
            visual.LookEnd.Parent = lookPart
            visual.LookBeam.Attachment0 = visual.LookStart
            visual.LookBeam.Attachment1 = visual.LookEnd
            visual.LookBeam.FaceCamera = true
            visual.LookBeam.Width0 = 0.07
            visual.LookBeam.Width1 = 0.035
            visual.LookBeam.LightEmission = 1
            visual.LookBeam.Segments = 1
            visual.LookBeam.Parent = lookPart
            visual.LookAdornee = lookPart
        end
        local faceOffset = lookPart.Size.Z * 0.5
        visual.LookStart.Position = Vector3.new(0, 0, -faceOffset)
        visual.LookEnd.Position = Vector3.new(0, 0, -faceOffset - config.LookLength)
        visual.LookBeam.Color = ColorSequence.new(config.Color)
        beamVisible = true
    end
    if visual.LookBeam and visual.LookBeam.Enabled ~= beamVisible then
        visual.LookBeam.Enabled = beamVisible
    end
end

function Extensions.RefreshDynamicESP()
    for category, categoryVisuals in pairs(Visuals) do
        local config = getCategoryConfig(category)
        local needsDynamicUpdate = config.Enabled and (config.Tracer or config.Box and config.BoxMode == "2D")
        if needsDynamicUpdate then
            for _, visual in pairs(categoryVisuals) do
                Extensions.UpdateDynamicVisual(visual)
            end
        end
    end
end

local function updateVisual(category, key, target, root, displayName, healthText, distanceStuds)
    local config = getCategoryConfig(category)
    local playerPermitted = category ~= "Player" or Extensions.IsPlayerESPAllowed(key)
    local espEnabled = config.Enabled and playerPermitted
    local xrayEnabled = State.XRay and playerPermitted
    local existing = Visuals[category][key]
    if (not espEnabled and not xrayEnabled) or not target or not root then
        if existing then
            existing.Active = false
            hideVisual(existing)
        end
        return
    end

    local distanceMeters = distanceStuds * 0.28
    local maximumMeters = config.MaxDistanceMeters or math.huge
    if distanceMeters > maximumMeters then
        if existing then
            existing.Active = false
            hideVisual(existing)
        end
        return
    end

    local visual = existing or createVisual(category, key)
    visual.Active = true
    visual.ESPPermitted = espEnabled
    local targetChanged = visual.Target ~= target
    visual.Target = target
    visual.Root = root
    if targetChanged or not visual.InfoAnchor or not visual.InfoAnchor.Parent then
        visual.InfoAnchor = target:IsA("Model") and (target:FindFirstChild("Head") or root) or root
    end
    visual.DisplayName = displayName
    visual.HealthText = healthText
    visual.DistanceStuds = distanceStuds

    if config.DerivedColorSource ~= config.Color then
        config.DerivedColorSource = config.Color
        config.OutlineColor = config.Color:Lerp(Color3.fromRGB(255, 255, 255), 0.12)
        config.DistanceColor = config.Color:Lerp(Color3.fromRGB(255, 255, 255), 0.58)
    end
    local outlineXRay = xrayEnabled and State.XRayMethod ~= "Wall Transparency"
    local skinEnabled = espEnabled and config.Box and config.BoxMode == "Skin"
    local threeDBox = espEnabled and config.Box and config.BoxMode == "3D"
    local highlightEnabled = skinEnabled or threeDBox or outlineXRay or (espEnabled and config.Box and not DrawingSupported)
    local highlightTarget = target
    if not target:IsA("Model") and not target:IsA("BasePart") then
        highlightTarget = root
    end
    local highlightDepthMode = (skinEnabled or threeDBox or outlineXRay) and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    local fillTransparency = skinEnabled and 0.65 or (outlineXRay and not threeDBox and 0.72 or 1)
    local outlineTransparency = highlightEnabled and 0 or 1
    if visual.Highlight.Parent ~= Workspace then
        visual.Highlight.Parent = Workspace
    end
    if visual.Highlight.Adornee ~= highlightTarget then visual.Highlight.Adornee = highlightTarget end
    if visual.Highlight.FillColor ~= config.Color then visual.Highlight.FillColor = config.Color end
    if visual.Highlight.OutlineColor ~= config.OutlineColor then visual.Highlight.OutlineColor = config.OutlineColor end
    if visual.Highlight.DepthMode ~= highlightDepthMode then visual.Highlight.DepthMode = highlightDepthMode end
    if visual.Highlight.FillTransparency ~= fillTransparency then visual.Highlight.FillTransparency = fillTransparency end
    if visual.Highlight.OutlineTransparency ~= outlineTransparency then visual.Highlight.OutlineTransparency = outlineTransparency end
    if visual.Highlight.Enabled ~= highlightEnabled then visual.Highlight.Enabled = highlightEnabled end

    local lineCount = 0
    local showName = espEnabled and config.Name
    local showHealth = espEnabled and config.Health and healthText ~= nil
    local showDistance = espEnabled and config.Distance

    if visual.InfoName.Text ~= displayName then visual.InfoName.Text = displayName end
    if visual.InfoName.TextStrokeColor3 ~= config.Color then visual.InfoName.TextStrokeColor3 = config.Color end
    if visual.InfoName.Visible ~= showName then visual.InfoName.Visible = showName end
    if showName then
        local namePosition = UDim2.fromOffset(0, lineCount * 19)
        if visual.InfoName.Position ~= namePosition then visual.InfoName.Position = namePosition end
        lineCount = lineCount + 1
    end

    local currentHealthText = healthText or ""
    if visual.InfoHealth.Text ~= currentHealthText then visual.InfoHealth.Text = currentHealthText end
    if visual.InfoHealth.TextStrokeColor3 ~= config.Color then visual.InfoHealth.TextStrokeColor3 = config.Color end
    if visual.InfoHealth.Visible ~= showHealth then visual.InfoHealth.Visible = showHealth end
    if showHealth then
        local healthPosition = UDim2.fromOffset(0, lineCount * 19)
        if visual.InfoHealth.Position ~= healthPosition then visual.InfoHealth.Position = healthPosition end
        lineCount = lineCount + 1
    end

    if showDistance then
        local distanceText = string.format("[ %d studs | %.1f m ]", math.floor(distanceStuds + 0.5), distanceMeters)
        if visual.InfoDistance.Text ~= distanceText then visual.InfoDistance.Text = distanceText end
        if visual.InfoDistance.Position ~= UDim2.fromOffset(0, lineCount * 19) then
            visual.InfoDistance.Position = UDim2.fromOffset(0, lineCount * 19)
        end
        lineCount = lineCount + 1
    elseif visual.InfoDistance.Text ~= "" then
        visual.InfoDistance.Text = ""
    end
    if visual.InfoDistance.TextColor3 ~= config.DistanceColor then visual.InfoDistance.TextColor3 = config.DistanceColor end
    if visual.InfoDistance.TextStrokeColor3 ~= config.Color then visual.InfoDistance.TextStrokeColor3 = config.Color end
    if visual.InfoDistance.Visible ~= showDistance then visual.InfoDistance.Visible = showDistance end

    local billboardSize = UDim2.fromOffset(230, math.max(24, lineCount * 19))
    if visual.InfoBillboard.Size ~= billboardSize then visual.InfoBillboard.Size = billboardSize end
    if visual.InfoBillboard.Adornee ~= visual.InfoAnchor then visual.InfoBillboard.Adornee = visual.InfoAnchor end
    visual.InfoEnabled = espEnabled and lineCount > 0

    Extensions.UpdateDynamicVisual(visual)
end

function Extensions.ResetXRayCandidateBuffer()
    local candidates = State.XRayCandidateBuffer
    local pool = State.XRayCandidatePool
    for index = #candidates, 1, -1 do
        local candidate = candidates[index]
        candidate.Target = nil
        candidate.Root = nil
        candidates[index] = nil
        pool[#pool + 1] = candidate
    end
end

function Extensions.InsertXRayCandidate(target, root, distanceSquared)
    local candidates = State.XRayCandidateBuffer
    local count = #candidates
    local limit = 24
    if count >= limit and distanceSquared >= candidates[count].DistanceSquared then
        return
    end
    local candidate
    if count >= limit then
        candidate = candidates[count]
    else
        local pool = State.XRayCandidatePool
        candidate = pool[#pool]
        if candidate then
            pool[#pool] = nil
        else
            candidate = {}
        end
        count = count + 1
    end
    local insertIndex = count
    while insertIndex > 1 and candidates[insertIndex - 1].DistanceSquared > distanceSquared do
        candidates[insertIndex] = candidates[insertIndex - 1]
        insertIndex = insertIndex - 1
    end
    candidate.Target = target
    candidate.Root = root
    candidate.DistanceSquared = distanceSquared
    candidates[insertIndex] = candidate
end

local function restoreXRayOccluders(keepGeneration)
    for part, originalTransparency in pairs(XRayOccluders) do
        if not keepGeneration or State.XRayOccluderSeen[part] ~= keepGeneration then
            if part and part.Parent and part.LocalTransparencyModifier ~= originalTransparency then
                part.LocalTransparencyModifier = originalTransparency
            end
            XRayOccluders[part] = nil
            State.XRayOccluderSeen[part] = nil
        end
    end
end

local function updateXRayOcclusion()
    if not State.XRay or State.XRayMethod == "Outline" then
        restoreXRayOccluders()
        Extensions.ResetXRayCandidateBuffer()
        State.XRayBatchIndex = 1
        return
    end

    Camera = Workspace.CurrentCamera or Camera
    local candidates = State.XRayCandidateBuffer
    if State.XRayBatchIndex == 1 then
        Extensions.ResetXRayCandidateBuffer()
        candidates = State.XRayCandidateBuffer
        State.XRayOccluderGeneration = State.XRayOccluderGeneration + 1
        local cameraPosition = Camera.CFrame.Position
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character and Extensions.IsPlayerESPAllowed(player) then
                local root = getAdorneeRoot(player.Character)
                if root then
                    local offset = root.Position - cameraPosition
                    Extensions.InsertXRayCandidate(player.Character, root, offset:Dot(offset))
                end
            end
        end
        for model, classification in pairs(MobCache) do
            if model and model.Parent and type(classification) == "table" then
                local visualAnchor = Extensions.GetCachedMobVisualAnchor(model, classification)
                local worldPosition = Extensions.GetMobWorldPosition(model, visualAnchor)
                if visualAnchor and visualAnchor.Parent and worldPosition then
                    local offset = worldPosition - cameraPosition
                    Extensions.InsertXRayCandidate(model, visualAnchor, offset:Dot(offset))
                end
            end
        end
        for item in pairs(ItemCache) do
            if item and item.Parent then
                local root = getAdorneeRoot(item)
                if root then
                    local offset = root.Position - cameraPosition
                    Extensions.InsertXRayCandidate(item, root, offset:Dot(offset))
                end
            end
        end
    end

    local generation = State.XRayOccluderGeneration
    local castPoints = State.XRayCastPoints
    local ignored = State.XRayIgnoredTargets
    table.clear(castPoints)
    table.clear(ignored)
    local localCharacter = LocalPlayer.Character
    if localCharacter then
        ignored[1] = localCharacter
    end
    local firstIndex = State.XRayBatchIndex
    local lastIndex = math.min(firstIndex + State.XRayBatchSize - 1, #candidates)
    for index = firstIndex, lastIndex do
        local candidate = candidates[index]
        if candidate and candidate.Target and candidate.Target.Parent and candidate.Root and candidate.Root.Parent then
            castPoints[#castPoints + 1] = candidate.Root.Position
            ignored[#ignored + 1] = candidate.Target
        end
    end

    if #castPoints > 0 then
        local success, obscuringParts = pcall(Camera.GetPartsObscuringTarget, Camera, castPoints, ignored)
        if success and type(obscuringParts) == "table" then
            for _, part in ipairs(obscuringParts) do
                if part and part:IsA("BasePart") then
                    if XRayOccluders[part] == nil then
                        XRayOccluders[part] = part.LocalTransparencyModifier
                    end
                    State.XRayOccluderSeen[part] = generation
                    if part.LocalTransparencyModifier ~= State.XRayWallTransparency then
                        part.LocalTransparencyModifier = State.XRayWallTransparency
                    end
                end
            end
            table.clear(obscuringParts)
        end
    end

    if lastIndex >= #candidates then
        restoreXRayOccluders(generation)
        Extensions.ResetXRayCandidateBuffer()
        State.XRayBatchIndex = 1
    else
        State.XRayBatchIndex = lastIndex + 1
    end
    table.clear(castPoints)
    table.clear(ignored)
end

local GenericMobNames = {model = true, npc = true, enemy = true, mob = true, rig = true, dummy = true}

local function belongsToPlayerCharacter(model)
    local current = model
    local depth = 0
    while current and current ~= Workspace and depth < 12 do
        if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then
            return true
        end
        current = current.Parent
        depth = depth + 1
    end
    return false
end

local function getMobDisplayName(model, humanoid)
    for _, attributeName in ipairs(State.MobDisplayAttributeNames) do
        local value = model:GetAttribute(attributeName)
        if type(value) == "string" and value ~= "" then
            return value
        end
    end

    if humanoid and humanoid.DisplayName and humanoid.DisplayName ~= "" then
        local lowerDisplayName = string.lower(humanoid.DisplayName)
        if lowerDisplayName ~= "humanoid" and not GenericMobNames[lowerDisplayName] then
            return humanoid.DisplayName
        end
    end

    if not GenericMobNames[string.lower(model.Name)] then
        return model.Name
    end

    local ancestor = model.Parent
    local depth = 0
    while ancestor and ancestor ~= Workspace and depth < 4 do
        local lowerName = string.lower(ancestor.Name)
        local genericContainer = lowerName == "workspace" or lowerName == "folder" or lowerName == "entities" or lowerName == "characters" or lowerName == "map"
        if not GenericMobNames[lowerName] and not genericContainer then
            return ancestor.Name
        end
        ancestor = ancestor.Parent
        depth = depth + 1
    end
    return model.Name
end

local function classifyMob(model)
    if not model or not model:IsA("Model") or not model:IsDescendantOf(Workspace) then
        return nil
    end
    if model == LocalPlayer.Character or belongsToPlayerCharacter(model) then
        return nil
    end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 or humanoid.MaxHealth <= 0 then
        return nil
    end
    local root = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
    if not root or not root:IsA("BasePart") then
        return nil
    end
    return {
        Humanoid = humanoid,
        Root = root,
        VisualAnchor = Extensions.GetMobVisualAnchor(model, root) or root,
        DisplayName = getMobDisplayName(model, humanoid),
        HealthText = getHealthText(humanoid),
        LastValidated = os.clock()
    }
end

local function parseMobManualNames(text)
    local parsed = {}
    local completed = {}
    local count = 0
    local ambiguous = 0
    for entry in string.gmatch(tostring(text or ""), "[^,;\n]+") do
        local trimmed = string.gsub(entry, "^%s*(.-)%s*$", "%1")
        if trimmed ~= "" then
            local resolved = trimmed
            if State.SmartSearchEnabled then
                local normalized = string.lower(trimmed)
                local exact
                local prefixMatches = {}
                local partialMatches = {}
                for model, classification in pairs(MobCache) do
                    if model and model.Parent then
                        local candidateName = classification and classification.DisplayName or model.Name
                        local names = {model.Name, candidateName}
                        for _, candidate in ipairs(names) do
                            local lowerCandidate = string.lower(candidate)
                            if lowerCandidate == normalized then
                                exact = candidate
                                break
                            elseif string.sub(lowerCandidate, 1, #normalized) == normalized then
                                prefixMatches[lowerCandidate] = candidate
                            elseif string.find(lowerCandidate, normalized, 1, true) then
                                partialMatches[lowerCandidate] = candidate
                            end
                        end
                        if exact then
                            break
                        end
                    end
                end
                if exact then
                    resolved = exact
                else
                    local matches = next(prefixMatches) and prefixMatches or partialMatches
                    local uniqueName
                    local uniqueCount = 0
                    for _, candidate in pairs(matches) do
                        uniqueName = candidate
                        uniqueCount = uniqueCount + 1
                    end
                    if uniqueCount == 1 then
                        resolved = uniqueName
                    elseif uniqueCount > 1 then
                        ambiguous = ambiguous + 1
                    end
                end
            end
            local key = string.lower(resolved)
            if not parsed[key] then
                parsed[key] = true
                table.insert(completed, resolved)
                count = count + 1
            end
        end
    end
    State.MobManualNames = parsed
    State.MobFilterText = table.concat(completed, ", ")
    return count, State.MobFilterText, ambiguous
end

local function isMobAllowedByManualFilter(model, classification)
    if not State.MobManualFilterEnabled then
        return true
    end
    local names = State.MobManualNames
    if names[string.lower(model.Name)] then
        return true
    end
    if classification and classification.DisplayName and names[string.lower(classification.DisplayName)] then
        return true
    end
    local humanoid = classification and classification.Humanoid
    if humanoid and humanoid.DisplayName and names[string.lower(humanoid.DisplayName)] then
        return true
    end
    return false
end

local function removeMobFromCache(model)
    MobCache[model] = nil
    local visual = Visuals.Mob[model]
    if visual then
        Extensions.ReleaseVisual("Mob", model, visual)
    end
end

local function considerMob(instance)
    local model
    if instance:IsA("Model") then
        model = instance
    elseif instance:IsA("Humanoid") or instance:IsA("AnimationController") then
        model = instance.Parent
    else
        model = instance:FindFirstAncestorOfClass("Model")
    end
    if not model or not model:IsA("Model") then
        return
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid and not State.MobHumanoidConnections[humanoid] then
        local function queueRefresh()
            if State.MobRefreshPending[humanoid] then
                return
            end
            State.MobRefreshPending[humanoid] = true
            task.defer(function()
                State.MobRefreshPending[humanoid] = nil
                if State.Running and model.Parent then
                    considerMob(model)
                end
            end)
        end
        State.MobHumanoidConnections[humanoid] = {
            Health = connect(humanoid.HealthChanged, queueRefresh),
            Maximum = connect(humanoid:GetPropertyChangedSignal("MaxHealth"), queueRefresh)
        }
    end

    local classification = classifyMob(model)
    if classification then
        MobCache[model] = classification
    elseif MobCache[model] then
        removeMobFromCache(model)
    end
end

