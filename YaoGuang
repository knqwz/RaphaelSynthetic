function Extensions.DecodeBase64(data)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for index = 1, #alphabet do
        lookup[string.byte(alphabet, index)] = index - 1
    end
    local output = {}
    local chunk = {}
    local buffer = 0
    local bits = 0
    for index = 1, #data do
        local value = lookup[string.byte(data, index)]
        if value then
            buffer = buffer * 64 + value
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local divisor = 2 ^ bits
                table.insert(chunk, string.char(math.floor(buffer / divisor) % 256))
                buffer = buffer % divisor
                if #chunk >= 4096 then
                    table.insert(output, table.concat(chunk))
                    table.clear(chunk)
                end
            end
        end
    end
    if #chunk > 0 then
        table.insert(output, table.concat(chunk))
    end
    return table.concat(output)
end

function Extensions.ResolveActionButtonArtwork()
    local customAsset = getcustomasset or getsynasset
    if not customAsset or not writefile then
        return ""
    end
    local folder = "Raphael_Assets"
    local path = folder .. "/Yaoguang_Action_Buttons_FMRG93.jpg"
    if isfolder and makefolder and not isfolder(folder) then
        pcall(makefolder, folder)
    end
    if isfile and isfile(path) then
        local validCache = true
        if readfile then
            local readSuccess, cachedData = pcall(readfile, path)
            validCache = readSuccess and type(cachedData) == "string" and #cachedData >= 128
        end
        if validCache then
            local cachedSuccess, cachedAsset = pcall(customAsset, path)
            if cachedSuccess and cachedAsset then
                return cachedAsset
            end
        end
    end
    local downloadSuccess, imageData = pcall(function()
        return game:HttpGet(State.ActionButtonImageURL, true)
    end)
    if not downloadSuccess or type(imageData) ~= "string" or #imageData < 128 then
        imageData = Extensions.DecodeBase64(Extensions.ActionButtonFallbackBase64)
    end
    if type(imageData) ~= "string" or #imageData < 128 then
        return ""
    end
    local writeSuccess = pcall(writefile, path, imageData)
    if not writeSuccess then
        return ""
    end
    local assetSuccess, assetPath = pcall(customAsset, path)
    if assetSuccess and assetPath then
        return assetPath
    end
    return ""
end

