function Extensions.ScanPlayerAnomalies(manual)
    local monitor = State.AnomalyMonitor
    if monitor.ScanRunning then return end
    monitor.ScanRunning = true
    Extensions.ApplySentinelSensitivity()
    Extensions.RebuildSentinelFilters()
    local engine = Extensions.SentinelEngine
    local hooks = {WallBetween = Extensions.SentinelWallBetween, NearClimbable = Extensions.SentinelNearClimbable}
    local now = os.clock()
    local suspiciousCount = 0
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player.Character
        if character then
            local entry = monitor.Trackers[player]
            if not entry or entry.Character ~= character then
                entry = {Tracker = engine.NewTracker(now), Ground = nil, Character = character}
                monitor.Trackers[player] = entry
            end
            local sample = Extensions.BuildSentinelSample(entry, player, now)
            if sample then
                local events = engine.Step(entry.Tracker, sample, hooks)
                local active = engine.GetActive(entry.Tracker, now)
                local history = engine.GetHistory(entry.Tracker, now)
                local parts = {}
                local topScore = 0
                local totalCount = 0
                for index, finding in ipairs(active) do
                    if index <= 3 then
                        parts[#parts + 1] = (engine.Names[finding.Name] or finding.Name) .. " · " .. finding.Label .. " · " .. finding.Reason
                    end
                    topScore = math.max(topScore, finding.Score)
                    totalCount = totalCount + finding.Count
                end
                local confidence = math.clamp(topScore / engine.Config.SureLevel * 100, 0, 100)
                local signature = table.concat(parts, " | ")
                monitor.Findings[player] = {
                    Signature = signature,
                    Time = now,
                    Confidence = confidence,
                    Strikes = totalCount,
                    History = history,
                }
                if signature ~= "" then suspiciousCount = suspiciousCount + 1 end
                for _, name in ipairs(events) do
                    local flag = entry.Tracker.Flags[name]
                    local label = engine.Names[name] or name
                    local reason = flag and flag.Reason or "bằng chứng lặp lại"
                    if player == LocalPlayer then
                        if State.ActivityLog.Enabled then Extensions.PushActivityLog("[SELF SENTINEL] " .. label .. " · " .. reason, "warn", true) end
                    else
                        if State.ActivityLog.Enabled then Extensions.PushActivityLog("[SENTINEL] " .. player.DisplayName .. " (@" .. player.Name .. ") · " .. label .. " · " .. reason, "alert", false) end
                        if now - (monitor.LastNotification or 0) >= 3 then
                            monitor.LastNotification = now
                            notify("Sentinel: " .. player.Name .. " · " .. label, Theme.Warning)
                        end
                    end
                end
            end
        else
            monitor.Trackers[player] = nil
            monitor.Findings[player] = nil
        end
    end
    for player in pairs(monitor.Trackers) do
        if not player.Parent then
            monitor.Trackers[player] = nil
            monitor.Findings[player] = nil
        end
    end
    monitor.LastScan = now
    monitor.ScanRunning = false
    Extensions.RefreshAnomalyPanel()
    if manual then
        notify("Sentinel đã lấy mẫu replicate · " .. suspiciousCount .. " player đang vượt ngưỡng.", suspiciousCount > 0 and Theme.Warning or Theme.Success)
    end
end

