function Extensions.ParseAimbotBlacklist(text)
    State.Aimbot.BlacklistText = tostring(text or "")
    table.clear(State.Aimbot.BlacklistNames)
    for entry in string.gmatch(State.Aimbot.BlacklistText, "[^,;\n]+") do
        local normalized = string.lower((string.gsub(entry, "^%s*@?%s*(.-)%s*$", "%1")))
        if normalized ~= "" then
            State.Aimbot.BlacklistNames[normalized] = true
        end
    end
end

function Extensions.IsAimbotPlayerBlacklisted(player)
    return player ~= nil and State.Aimbot.BlacklistNames[string.lower(player.Name)] == true
end

function Extensions.IsAimbotTeammate(player)
    if not State.Aimbot.TeamCheck or not player or player == LocalPlayer then
        return false
    end
    local localTeam = LocalPlayer.Team
    if localTeam then
        return not LocalPlayer.Neutral and not player.Neutral and player.Team == localTeam
    end
    return not LocalPlayer.Neutral and not player.Neutral and player.TeamColor == LocalPlayer.TeamColor
end

function Extensions.RefreshAimbotTeamStatus(showNotification)
    local localTeam = LocalPlayer.Team
    local teamName = localTeam and localTeam.Name or (LocalPlayer.Neutral and "Neutral / FFA" or tostring(LocalPlayer.TeamColor))
    local memberCount = 0
    local teammateCount = 0
    local opponentCount = 0
    for _, player in ipairs(Players:GetPlayers()) do
        local sameTeam
        if localTeam then
            sameTeam = not LocalPlayer.Neutral and not player.Neutral and player.Team == localTeam
        else
            sameTeam = not LocalPlayer.Neutral and not player.Neutral and player.TeamColor == LocalPlayer.TeamColor
        end
        if sameTeam then
            memberCount = memberCount + 1
            if player ~= LocalPlayer then
                teammateCount = teammateCount + 1
            end
        elseif player ~= LocalPlayer then
            opponentCount = opponentCount + 1
        end
    end
    local summary = string.format("%s · %d thành viên · %d đồng đội · %d team khác", teamName, memberCount, teammateCount, opponentCount)
    local statusValue = State.Aimbot.TeamStatusValue
    if statusValue and statusValue.Parent then
        statusValue.Text = summary
        statusValue.TextColor3 = State.Aimbot.TeamCheck and Theme.Success or Theme.SubText
    end
    if showNotification then
        notify(summary, State.Aimbot.TeamCheck and Theme.Success or Theme.Warning)
    end
    return memberCount, teammateCount, opponentCount
end

function Extensions.ResolveStickyPlayer()
    local normalized = string.lower((string.gsub(State.Aimbot.StickyUsername or "", "^%s*@?%s*(.-)%s*$", "%1")))
    if normalized == "" then
        State.Aimbot.StickyPlayer = nil
        return nil
    end
    local cached = State.Aimbot.StickyPlayer
    if cached and cached.Parent == Players and string.lower(cached.Name) == normalized then
        return cached
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and string.lower(player.Name) == normalized then
            State.Aimbot.StickyPlayer = player
            return player
        end
    end
    State.Aimbot.StickyPlayer = nil
    return nil
end

function Extensions.IsAimbotPartInFOV(aimPart)
    if not aimPart or not aimPart.Parent then
        return false, math.huge
    end
    Camera = Workspace.CurrentCamera or Camera
    local viewportPoint, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
    if not onScreen or viewportPoint.Z <= 0 then
        return false, math.huge
    end
    local difference = Vector2.new(viewportPoint.X, viewportPoint.Y) - Camera.ViewportSize * 0.5
    local distanceSquared = difference:Dot(difference)
    return distanceSquared <= State.Aimbot.FOVRadius * State.Aimbot.FOVRadius, distanceSquared
end

function Extensions.HasAimbotLineOfSight(model, aimPart)
    if not State.Aimbot.WallCheck then
        return true
    end
    if not model or not aimPart or not aimPart.Parent then
        return false
    end
    Camera = Workspace.CurrentCamera or Camera
    local origin = Camera.CFrame.Position
    local direction = aimPart.Position - origin
    if direction.Magnitude <= 0.05 then
        return true
    end
    local parameters = State.Aimbot.RaycastParams
    parameters.FilterType = Enum.RaycastFilterType.Exclude
    parameters.FilterDescendantsInstances = LocalPlayer.Character and {LocalPlayer.Character} or {}
    parameters.IgnoreWater = false
    local result = Workspace:Raycast(origin, direction, parameters)
    return result == nil or result.Instance and result.Instance:IsDescendantOf(model)
end

function Extensions.FindAimbotTarget()
    local bestModel
    local bestPlayer
    local bestHumanoid
    local bestPart
    local bestLabel
    local bestDistanceSquared = math.huge

    local function consider(model, player, humanoid, label)
        if not model or not humanoid or humanoid.Health <= 0 then
            return
        end
        if player and (Extensions.IsAimbotPlayerBlacklisted(player) or Extensions.IsAimbotTeammate(player)) then
            return
        end
        if model == State.Aimbot.ReleasedModel or player == State.Aimbot.ReleasedPlayer then
            return
        end
        local aimPart = Extensions.GetAimbotPart(model)
        if not aimPart then
            return
        end
        local insideFOV, distanceSquared = Extensions.IsAimbotPartInFOV(aimPart)
        if not insideFOV or not Extensions.HasAimbotLineOfSight(model, aimPart) then
            return
        end
        if distanceSquared < bestDistanceSquared then
            bestDistanceSquared = distanceSquared
            bestModel = model
            bestPlayer = player
            bestHumanoid = humanoid
            bestPart = aimPart
            bestLabel = label
        end
    end

    if State.Aimbot.TargetType == "Player" then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                consider(character, player, humanoid, player.DisplayName .. " (@" .. player.Name .. ")")
            end
        end
    else
        for model, classification in pairs(MobCache) do
            if model and model.Parent and type(classification) == "table" and isMobAllowedByManualFilter(model, classification) then
                local humanoid = classification.Humanoid
                if not humanoid or not humanoid.Parent then
                    humanoid = model:FindFirstChildOfClass("Humanoid")
                end
                if humanoid and not belongsToPlayerCharacter(model) then
                    consider(model, nil, humanoid, classification.DisplayName or model.Name)
                end
            end
        end
    end

    return bestModel, bestPlayer, bestHumanoid, bestPart, bestLabel
end

function Extensions.AcquireAimbotTarget()
    local model, player, humanoid, aimPart, label = Extensions.FindAimbotTarget()
    if not model then
        return false
    end
    State.Aimbot.TargetModel = model
    State.Aimbot.TargetPlayer = player
    State.Aimbot.TargetHumanoid = humanoid
    State.Aimbot.TargetPart = aimPart
    Extensions.UpdateAimbotStatus("Đã khóa: " .. tostring(label or model.Name), Theme.Success)
    return true
end

function Extensions.ReleaseAimbotTarget(silent)
    if not State.Aimbot.Enabled then
        if not silent then
            notify("Aimbot hiện không hoạt động.", Theme.Warning)
        end
        return false
    end
    if not State.Aimbot.TargetModel then
        if not silent then
            notify("Aimbot đang chờ mục tiêu khác trong FOV.", Theme.Warning)
        end
        return false
    end
    State.Aimbot.ReleasedModel = State.Aimbot.TargetModel
    State.Aimbot.ReleasedPlayer = State.Aimbot.TargetPlayer
    Extensions.ClearAimbotTarget(false)
    Extensions.UpdateAimbotStatus("Đã bỏ mục tiêu; đang chờ mục tiêu khác", Theme.Warning)
    if not silent then
        notify("Đã bỏ mục tiêu hiện tại. Aimbot tiếp tục chờ mục tiêu khác.", Theme.Success)
    end
    return true
end

function Extensions.TryStickyAimbotOverride(now)
    if not State.Aimbot.StickyEnabled or State.Aimbot.TargetType ~= "Player" or now - State.Aimbot.LastStickyCheck < 0.08 then
        return false
    end
    State.Aimbot.LastStickyCheck = now
    local player = Extensions.ResolveStickyPlayer()
    if not player or player == State.Aimbot.TargetPlayer or Extensions.IsAimbotPlayerBlacklisted(player) or Extensions.IsAimbotTeammate(player) or player == State.Aimbot.ReleasedPlayer then
        return false
    end
    local character = player.Character
    if not character or character == State.Aimbot.ReleasedModel then
        return false
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local aimPart = Extensions.GetAimbotPart(character)
    if not humanoid or humanoid.Health <= 0 or not aimPart then
        return false
    end
    local insideFOV = Extensions.IsAimbotPartInFOV(aimPart)
    if not insideFOV or not Extensions.HasAimbotLineOfSight(character, aimPart) then
        return false
    end
    Extensions.ClearAimbotTarget(false)
    State.Aimbot.TargetModel = character
    State.Aimbot.TargetPlayer = player
    State.Aimbot.TargetHumanoid = humanoid
    State.Aimbot.TargetPart = aimPart
    Extensions.UpdateAimbotStatus("Aim Dính: " .. player.DisplayName .. " (@" .. player.Name .. ")", Theme.Success)
    return true
end

function Extensions.IsAimbotTargetValid()
    local model = State.Aimbot.TargetModel
    local humanoid = State.Aimbot.TargetHumanoid
    local aimPart = State.Aimbot.TargetPart
    return model ~= nil
        and model.Parent ~= nil
        and model:IsDescendantOf(Workspace)
        and humanoid ~= nil
        and humanoid.Parent ~= nil
        and humanoid.Health > 0
        and aimPart ~= nil
        and aimPart.Parent ~= nil
        and aimPart:IsDescendantOf(model)
        and not (State.Aimbot.TargetPlayer and Extensions.IsAimbotTeammate(State.Aimbot.TargetPlayer))
end

