    marker = {Root = root, Dot = dot, Name = name, Kind = kind, Seen = 0}
    minimap.Markers[key] = marker
    return marker
end

local function placeMarker(marker, worldPosition, color, label, showLabel)
    local built = minimap.BuiltPlan
    local root = minimapRoot()
    if not built or not root or not minimap.CellPixels then
        marker.Root.Visible = false
        return
    end
    local deltaX = (worldPosition.X - root.Position.X) / built.CellSize * minimap.CellPixels
    local deltaY = (worldPosition.Z - root.Position.Z) / built.CellSize * minimap.CellPixels
    local rotation = built.Rotate and -minimap.CameraYaw or 0
    local rotatedX, rotatedY = rotateVector(deltaX, deltaY, rotation)
    local half = effectiveSide() * 0.5 - 6
    local outside = math.abs(rotatedX) > half or math.abs(rotatedY) > half
    if outside then
        local scale = half / math.max(math.abs(rotatedX), math.abs(rotatedY))
        rotatedX, rotatedY = rotatedX * scale, rotatedY * scale
    end
    marker.Root.Position = UDim2.new(0.5, rotatedX, 0.5, rotatedY)
    marker.Root.Visible = true
    marker.Dot.BackgroundColor3 = color
    marker.Dot.BackgroundTransparency = outside and 0.5 or 0
    marker.Name.Visible = showLabel and not outside
    if showLabel then marker.Name.Text = label end
end

function Extensions.UpdateMinimapMarkers()
    if not minimap.Ready or not minimap.BuiltPlan then return end
    local stamp = os.clock()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local root = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            local marker = markerFor(player, "Player")
            if marker then
                marker.Seen = stamp
                if minimap.ShowPlayers and root and (not humanoid or humanoid.Health > 0) then
                    local sameTeam, known = Extensions.ComparePlayerTeams(LocalPlayer, player)
                    local color = known and sameTeam and Color3.fromRGB(80, 220, 130) or Color3.fromRGB(255, 92, 120)
                    placeMarker(marker, root.Position, color, string.sub(player.DisplayName, 1, 14), minimap.ShowNames)
                else
                    marker.Root.Visible = false
                end
            end
        end
    end
    if minimap.ShowMobs then
        local count = 0
        for model, classification in pairs(MobCache) do
            if count >= 40 then break end
            local root = type(classification) == "table" and classification.Root
            if model and model.Parent and root and root.Parent then
                local marker = markerFor(model, "Mob")
                if marker then
                    marker.Seen = stamp
                    count = count + 1
                    placeMarker(marker, root.Position, Color3.fromRGB(238, 72, 88), tostring(classification.DisplayName or model.Name), false)
                end
            end
        end
    end
    if minimap.ShowItems then
        local count = 0
        for item in pairs(ItemCache) do
            if count >= 40 then break end
            if typeof(item) == "Instance" and item.Parent then
                local success, pivot = pcall(function() return item:GetPivot().Position end)
                if success and pivot then
                    local marker = markerFor(item, "Item")
                    if marker then
                        marker.Seen = stamp
                        count = count + 1
                        placeMarker(marker, pivot, Color3.fromRGB(178, 78, 232), "", false)
                    end
                end
            end
        end
    end
    for key, marker in pairs(minimap.Markers) do
        local expired = marker.Seen < stamp
        local disabledKind = marker.Kind == "Mob" and not minimap.ShowMobs or marker.Kind == "Item" and not minimap.ShowItems
        if expired or disabledKind then
            if marker.Root then marker.Root:Destroy() end
            minimap.Markers[key] = nil
        end
    end
end

