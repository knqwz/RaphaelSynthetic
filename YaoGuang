Extensions.TabOrder = {Movement = 1, Player = 2, ESP = 3, Info = 4, Misc = 5, World = 6}

function Extensions.SortToggleRegistry()
    local registry = State.ToggleRegistry
    local function sectionRank(entry)
        local current = entry.Source
        while current and current ~= MainFrame do
            local title = current:GetAttribute("RaphaelSearchSection")
            if title then return UI.SectionOrder[title] or 500 end
            current = current.Parent
        end
        return 500
    end
    for _, entry in ipairs(registry) do
        entry.Page = Extensions.GetControlPageName(entry.Source)
        entry.SortPage = Extensions.TabOrder[entry.Page] or 99
        entry.SortSection = sectionRank(entry)
    end
    table.sort(registry, function(left, right)
        if left.SortPage ~= right.SortPage then return left.SortPage < right.SortPage end
        if left.SortSection ~= right.SortSection then return left.SortSection < right.SortSection end
        return left.Order < right.Order
    end)
    for index, entry in ipairs(registry) do
        entry.Order = index
    end
end

