    if label.TextStrokeTransparency ~= strokeValue then label.TextStrokeTransparency = strokeValue end
    if label.TextTransparency ~= fadeAlpha then label.TextTransparency = fadeAlpha end
    if label.TextStrokeColor3 ~= outlineColor then label.TextStrokeColor3 = outlineColor end
    if label.TextColor3 ~= Theme.Text then label.TextColor3 = Theme.Text end
end

