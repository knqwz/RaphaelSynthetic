function Extensions.ApplyFPSOptimization(instance)
    if not State.FPSBoostApplied or not instance or instance:GetAttribute("RaphaelOwned") then
        return
    end
    local characterModel = instance:FindFirstAncestorOfClass("Model")
    if characterModel and characterModel:FindFirstChildOfClass("Humanoid") then
        return
    end
    local basePart = instance:IsA("BasePart")
    local surfaceImage = instance:IsA("Decal") or instance:IsA("Texture")
    local meshPart = instance:IsA("MeshPart")
    local specialMesh = instance:IsA("SpecialMesh")
    local surfaceAppearance = instance:IsA("SurfaceAppearance")
    if not basePart and not surfaceImage and not meshPart and not specialMesh and not surfaceAppearance then
        return
    end

    local backup = FPSBackup[instance]
    if not backup then
        backup = {}
        FPSBackup[instance] = backup
    end

    if basePart then
        if backup.CastShadow == nil then
            backup.CastShadow = instance.CastShadow
            backup.Material = instance.Material
            backup.Reflectance = instance.Reflectance
            backup.MaterialVariant = instance.MaterialVariant
            backup.TopSurface = instance.TopSurface
            backup.BottomSurface = instance.BottomSurface
        end
        pcall(function()
            instance.CastShadow = false
            instance.Material = Enum.Material.SmoothPlastic
            instance.MaterialVariant = ""
            instance.Reflectance = 0
            instance.TopSurface = Enum.SurfaceType.Smooth
            instance.BottomSurface = Enum.SurfaceType.Smooth
        end)
    end

    if surfaceImage then
        if backup.Transparency == nil then
            backup.Transparency = instance.Transparency
        end
        pcall(function()
            instance.Transparency = 1
        end)
    end

    if meshPart then
        if backup.RenderFidelity == nil then
            pcall(function()
                backup.RenderFidelity = instance.RenderFidelity
                backup.TextureID = instance.TextureID
                backup.DoubleSided = instance.DoubleSided
            end)
        end
        pcall(function()
            instance.RenderFidelity = Enum.RenderFidelity.Performance
            instance.TextureID = ""
            instance.DoubleSided = false
        end)
    end

    if specialMesh then
        if backup.TextureId == nil then
            backup.TextureId = instance.TextureId
        end
        pcall(function()
            instance.TextureId = ""
        end)
    end

    if surfaceAppearance then
        if backup.ColorMap == nil then
            backup.ColorMap = instance.ColorMap
            backup.MetalnessMap = instance.MetalnessMap
            backup.NormalMap = instance.NormalMap
            backup.RoughnessMap = instance.RoughnessMap
        end
        pcall(function()
            instance.ColorMap = ""
            instance.MetalnessMap = ""
            instance.NormalMap = ""
            instance.RoughnessMap = ""
        end)
    end
end

function Extensions.RestoreFPSOptimizations()
    for instance, values in pairs(FPSBackup) do
        if instance and instance.Parent then
            for property, value in pairs(values) do
                pcall(function()
                    instance[property] = value
                end)
            end
        end
    end
    table.clear(FPSBackup)
end

