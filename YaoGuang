local function restoreEffects()
    for instance, values in pairs(EffectBackup) do
        if instance and instance.Parent then
            pcall(function()
                if values.Type == "PostEffect" then
                    instance.Enabled = values.Enabled
                elseif values.Type == "Atmosphere" then
                    instance.Density = values.Density
                    instance.Haze = values.Haze
                    instance.Glare = values.Glare
                    instance.Offset = values.Offset
                    instance.Color = values.Color
                    instance.Decay = values.Decay
                elseif values.Type == "Clouds" then
                    instance.Cover = values.Cover
                    instance.Density = values.Density
                    instance.Color = values.Color
                elseif values.Type == "EnabledEffect" then
                    instance.Enabled = values.Enabled
                elseif values.Type == "LayerCollector" then
                    instance.Enabled = values.Enabled
                elseif values.Type == "GuiObject" then
                    instance.Visible = values.Visible
                end
            end)
            if State.FPSBoostApplied then
                Extensions.ApplyFPSOptimization(instance)
            end
        end
    end
    table.clear(EffectBackup)
    Lighting.FogStart = OriginalLighting.FogStart
    Lighting.FogEnd = OriginalLighting.FogEnd
    Lighting.FogColor = OriginalLighting.FogColor
end

