local function latticeKey(indexX, indexZ)
    return (indexX + 50000) * 100000 + (indexZ + 50000)
end

local function quantizeChannel(value, step)
    local snapped = math.floor(value / step + 0.5) * step
    if snapped < 0 then return 0 end
    if snapped > 255 then return 255 end
    return snapped
end

local lightLength = math.sqrt(0.16 + 0.6724 + 0.16)
local lightX, lightY, lightZ = -0.4 / lightLength, 0.82 / lightLength, -0.4 / lightLength

local function shadeFactor(height, heightLeft, heightRight, heightUp, heightDown, cellSize, relief, outline, edgeLimit)
    local slopeX = (heightRight - heightLeft) / (2 * cellSize)
    local slopeZ = (heightDown - heightUp) / (2 * cellSize)
    local normalLength = math.sqrt(slopeX * slopeX + 1 + slopeZ * slopeZ)
    local normalX = -slopeX / normalLength
    local normalY = 1 / normalLength
    local normalZ = -slopeZ / normalLength
    local light = normalX * lightX + normalY * lightY + normalZ * lightZ
    if light < 0 then light = 0 end
    local shade = 0.8 + relief * (light - 0.8) * 1.1
    if outline then
        local edge = math.max(math.abs(height - heightLeft), math.abs(height - heightRight), math.abs(height - heightUp), math.abs(height - heightDown))
        if edge > edgeLimit then
            shade = shade * (edge > edgeLimit * 3 and 0.5 or 0.68)
        end
    end
    if shade < 0.25 then shade = 0.25 end
    if shade > 1.12 then shade = 1.12 end
    return shade
end

local function buildRectangles(packed, columns, rows, yieldCheck)
    local rectangles = {}
    local previous = {}
    for row = 1, rows do
        local current = {}
        local base = (row - 1) * columns
        local column = 1
        while column <= columns do
            local value = packed[base + column]
            if value >= 0 then
                local stop = column
                while stop < columns and packed[base + stop + 1] == value do stop = stop + 1 end
                local length = stop - column + 1
                local key = (column * 1024 + length) * 16777216 + value
                local rectangle = previous[key]
                if rectangle then
                    rectangle.Height = rectangle.Height + 1
                else
                    rectangle = {X = column, Y = row, Width = length, Height = 1, Value = value}
                    rectangles[#rectangles + 1] = rectangle
                end
                current[key] = rectangle
                column = stop + 1
            else
                column = column + 1
            end
        end
        previous = current
        if yieldCheck and row % 6 == 0 and not yieldCheck() then return nil end
    end
    return rectangles
end

