function Extensions.UpdateAimbotFrame(now)
    if not State.Aimbot.Enabled then
        return
    end
    Extensions.UpdateAimbotFOV()

    if State.Aimbot.TargetPlayer and Extensions.IsAimbotTeammate(State.Aimbot.TargetPlayer) then
        Extensions.ClearAimbotTarget(false)
        Extensions.UpdateAimbotStatus("Đã bỏ qua đồng đội; đang tìm team địch", Theme.Warning)
    end

    if State.Aimbot.TargetModel and not Extensions.IsAimbotTargetValid() then
        Extensions.SetAimbotEnabled(false, "Mục tiêu đã chết hoặc không còn hợp lệ; Aimbot đã dừng.", false)
        return
    end

    if State.Aimbot.TargetPlayer and Extensions.IsAimbotPlayerBlacklisted(State.Aimbot.TargetPlayer) then
        Extensions.ClearAimbotTarget(false)
        Extensions.UpdateAimbotStatus("Mục tiêu thuộc blacklist; đang chờ mục tiêu khác", Theme.Warning)
    end

    Extensions.TryStickyAimbotOverride(now)

    if State.Aimbot.TargetModel and State.Aimbot.WallCheck and not Extensions.HasAimbotLineOfSight(State.Aimbot.TargetModel, State.Aimbot.TargetPart) then
        Extensions.ClearAimbotTarget(false)
        Extensions.UpdateAimbotStatus("Mục tiêu đã khuất tường; đang chờ mục tiêu nhìn thấy", Theme.Warning)
    end

    if not State.Aimbot.TargetModel and now - State.Aimbot.LastScan >= 0.12 then
        State.Aimbot.LastScan = now
        Extensions.AcquireAimbotTarget()
    end

    local targetPart = State.Aimbot.TargetPart
    if not targetPart then
        return
    end
    local _, localHumanoid, localRoot = getCharacter()
    if not localHumanoid or not localRoot or localHumanoid.Health <= 0 then
        return
    end

    if State.Aimbot.Mode == "Silent Aim (Góc 3)" then
        if State.Aimbot.AutoRotateBackup[localHumanoid] == nil then
            State.Aimbot.AutoRotateBackup[localHumanoid] = localHumanoid.AutoRotate
        end
        localHumanoid.AutoRotate = false
        local rootPosition = localRoot.Position
        local targetPosition = targetPart.Position
        local flatTarget = Vector3.new(targetPosition.X, rootPosition.Y, targetPosition.Z)
        if (flatTarget - rootPosition).Magnitude > 0.05 then
            localRoot.CFrame = CFrame.lookAt(rootPosition, flatTarget)
        end
    else
        Extensions.RestoreAimbotCharacterRotation()
        if State.Aimbot.CameraModeBackup == nil then
            Camera = Workspace.CurrentCamera or Camera
            State.Aimbot.CameraModeBackup = LocalPlayer.CameraMode
            State.Aimbot.CameraTypeBackup = Camera.CameraType
            State.Aimbot.CameraSubjectBackup = Camera.CameraSubject
        end
        pcall(function()
            LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        end)
        Camera = Workspace.CurrentCamera or Camera
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = localHumanoid
        local cameraPosition = Camera.CFrame.Position
        local targetPosition = targetPart.Position
        if (targetPosition - cameraPosition).Magnitude > 0.05 then
            Camera.CFrame = CFrame.lookAt(cameraPosition, targetPosition)
            Camera.Focus = CFrame.new(targetPosition)
        end
    end
end

