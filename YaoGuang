rebuildPlayerList = function()
    for _, child in ipairs(PlayerListContainer:GetChildren()) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end

    local playerArray = Players:GetPlayers()
    table.sort(playerArray, function(left, right)
        if left == LocalPlayer then
            return true
        elseif right == LocalPlayer then
            return false
        end
        return string.lower(left.Name) < string.lower(right.Name)
    end)

    for index, player in ipairs(playerArray) do
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, 0, 0, 38)
        row.BackgroundColor3 = Theme.Input
        row.BackgroundTransparency = player == LocalPlayer and 0.1 or 0.22
        row.BorderSizePixel = 0
        row.Text = ""
        row.AutoButtonColor = false
        row.LayoutOrder = index
        row.Parent = PlayerListContainer
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 8)
        UI.AddSmoothGradient(row, player == LocalPlayer and Theme.Accent:Lerp(Theme.Background, 0.35) or Theme.Input, player == LocalPlayer and Theme.AccentSoft or Theme.SurfaceLight, 0)

        local image = Instance.new("ImageLabel")
        image.Size = UDim2.fromOffset(30, 30)
        image.Position = UDim2.fromOffset(4, 4)
        image.BackgroundTransparency = 1
        image.Image = "rbxthumb://type=AvatarHeadShot&id=" .. player.UserId .. "&w=48&h=48"
        image.Parent = row
        Instance.new("UICorner", image).CornerRadius = UDim.new(1, 0)

        local name = Instance.new("TextLabel")
        name.Position = UDim2.fromOffset(40, 3)
        name.Size = UDim2.new(1, -125, 0, 17)
        name.BackgroundTransparency = 1
        name.Text = player.DisplayName .. (player == LocalPlayer and "  [Ngài]" or "")
        name.TextColor3 = player == LocalPlayer and Theme.Accent or Theme.Text
        name.Font = Enum.Font.GothamBold
        name.TextSize = 10
        name.TextXAlignment = Enum.TextXAlignment.Left
        name.TextTruncate = Enum.TextTruncate.AtEnd
        name.Parent = row

        local username = Instance.new("TextLabel")
        username.Position = UDim2.fromOffset(40, 19)
        username.Size = UDim2.new(1, -125, 0, 15)
        username.BackgroundTransparency = 1
        username.Text = "@" .. player.Name
        username.TextColor3 = Theme.SubText
        username.Font = Enum.Font.Gotham
        username.TextSize = 9
        username.TextXAlignment = Enum.TextXAlignment.Left
        username.TextTruncate = Enum.TextTruncate.AtEnd
        username.Parent = row

        local team = Instance.new("TextLabel")
        team.Position = UDim2.new(1, -82, 0, 0)
        team.Size = UDim2.new(0, 76, 1, 0)
        team.BackgroundTransparency = 1
        team.Text = player.Team and player.Team.Name or "No Team"
        team.TextColor3 = player.TeamColor and player.TeamColor.Color or Theme.SubText
        team.Font = Enum.Font.GothamMedium
        team.TextSize = 9
        team.TextXAlignment = Enum.TextXAlignment.Right
        team.TextTruncate = Enum.TextTruncate.AtEnd
        team.Parent = row

        local lastActivation = 0
        row.Activated:Connect(function()
            local now = os.clock()
            if now - lastActivation <= 0.38 then
                local copied = false
                if setclipboard then
                    copied = pcall(setclipboard, player.Name)
                end
                notify(copied and ("Đã copy tên " .. player.Name .. ".") or ("Username: " .. player.Name), copied and Theme.Success or Theme.Warning)
                lastActivation = 0
            else
                lastActivation = now
                tween(row, {BackgroundColor3 = Theme.SurfaceLight}, 0.1)
                task.delay(0.2, function()
                    if row.Parent then
                        tween(row, {BackgroundColor3 = Theme.Input}, 0.15)
                    end
                end)
            end
        end)
    end
end

