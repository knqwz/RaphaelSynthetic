Extensions.NamecallHandlers = {}
Extensions.NamecallState = {Installed = false, Original = nil, Failure = nil}

function Extensions.InstallNamecallHook()
    local hookState = Extensions.NamecallState
    if hookState.Installed then return true end
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
        hookState.Failure = "Executor thiếu hookmetamethod/getnamecallmethod"
        return false
    end
    local existing = RuntimeEnvironment.RaphaelNamecallSlot
    if type(existing) == "table" and type(existing.Original) == "function" then
        existing.Handlers = Extensions.NamecallHandlers
        hookState.Installed = true
        hookState.Reused = true
        return true
    end
    local readCaller = type(checkcaller) == "function" and checkcaller or function() return false end
    local wrapClosure = type(newcclosure) == "function" and newcclosure or function(callback) return callback end
    local restoreMethod = type(setnamecallmethod) == "function" and setnamecallmethod or nil
    local slot = {Handlers = Extensions.NamecallHandlers, Original = nil}
    local success, failure = pcall(function()
        slot.Original = hookmetamethod(game, "__namecall", wrapClosure(function(self, ...)
            local method = getnamecallmethod()
            local handler = slot.Handlers[method]
            if handler then
                local completed, intercepted, result = pcall(handler, self, method, readCaller(), ...)
                if completed and intercepted then return result end
                if restoreMethod then restoreMethod(method) end
            end
            return slot.Original(self, ...)
        end))
    end)
    if not success or type(slot.Original) ~= "function" then
        hookState.Failure = tostring(failure or "hookmetamethod không trả về hàm gốc")
        return false
    end
    RuntimeEnvironment.RaphaelNamecallSlot = slot
    hookState.Installed = true
    return true
end

function Extensions.ReleaseNamecallHandlers()
    local handlers = Extensions.NamecallHandlers
    for key in pairs(handlers) do
        handlers[key] = nil
    end
end

