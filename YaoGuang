function Extensions.UpdateAimbotFrame(now)
    local aimbot = State.Aimbot
    if not aimbot.Enabled then
        return
    end
    local deltaTime = math.clamp(now - (aimbot.LastFrameTime or now - 1 / 60), 1 / 240, 0.1)
    aimbot.LastFrameTime = now
    Extensions.UpdateAimbotFOV()

    if aimbot.HoldMode ~= "Luôn bật" and State.IsDesktop and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        if aimbot.TargetModel then
            Extensions.ClearAimbotTarget(true, nil, true)
        end
        return
    end

    if aimbot.TargetPlayer and Extensions.IsAimbotTeammate(aimbot.TargetPlayer) then
        Extensions.ClearAimbotTarget(false, "mục tiêu là đồng đội", false)
        Extensions.UpdateAimbotStatus("Đã bỏ qua đồng đội; đang tìm team địch", Theme.Warning)
    end

    if aimbot.TargetModel and not Extensions.IsAimbotTargetValid() then
        Extensions.ClearAimbotTarget(true, "đã chết hoặc không còn hợp lệ", false)
        aimbot.LastScan = 0
        aimbot.OccludedSince = 0
        Extensions.UpdateAimbotStatus("Mục tiêu không còn hợp lệ; Aimbot vẫn bật và đang tìm lại", Theme.Warning)
    end

    if aimbot.TargetPlayer and Extensions.IsAimbotPlayerBlacklisted(aimbot.TargetPlayer) then
        Extensions.ClearAimbotTarget(false, "thuộc blacklist", false)
        Extensions.UpdateAimbotStatus("Mục tiêu thuộc blacklist; đang chờ mục tiêu khác", Theme.Warning)
    end

    Extensions.TryStickyAimbotOverride(now)

    if aimbot.DropOutsideFOV and aimbot.TargetPart and not Extensions.IsAimbotPartInFOV(aimbot.TargetPart, 1.35) then
        Extensions.ClearAimbotTarget(true, "đã ra khỏi FOV", false)
        aimbot.LastScan = 0
        Extensions.UpdateAimbotStatus("Mục tiêu ra khỏi FOV; đang tìm lại", Theme.Warning)
    end

    if aimbot.TargetModel and aimbot.WallCheck then
        if Extensions.HasAimbotLineOfSight(aimbot.TargetModel, aimbot.TargetPart) then
            aimbot.OccludedSince = 0
        elseif aimbot.OccludedSince == 0 then
            aimbot.OccludedSince = now
        elseif now - aimbot.OccludedSince >= 0.16 then
            Extensions.ClearAimbotTarget(true, "đã khuất tường", false)
            aimbot.LastScan = 0
            aimbot.OccludedSince = 0
            Extensions.UpdateAimbotStatus("Mục tiêu đã khuất tường; đang tìm mục tiêu nhìn thấy", Theme.Warning)
        end
    else
        aimbot.OccludedSince = 0
    end

    local scanInterval = State.IsDesktop and 0.06 or 0.1
    if not aimbot.TargetModel and now - aimbot.LastScan >= scanInterval then
        aimbot.LastScan = now
        Extensions.AcquireAimbotTarget()
    end

    local targetPart = aimbot.TargetPart
    if targetPart and aimbot.AimPart == "Gần tâm" and now - (aimbot.LastPartRefresh or 0) > 0.15 then
        aimbot.LastPartRefresh = now
        local refreshed = Extensions.GetAimbotPart(aimbot.TargetModel)
        if refreshed then
            aimbot.TargetPart = refreshed
            targetPart = refreshed
        end
    end
    Extensions.UpdateAimbotTargetESP()
    if not targetPart then return end
    local _, localHumanoid, localRoot = getCharacter()
    if not localHumanoid or not localRoot or localHumanoid.Health <= 0 then
        return
    end

    local targetPosition = targetPart.Position
    if aimbot.Prediction then
        local velocity = targetPart.AssemblyLinearVelocity
        targetPosition = targetPosition + velocity * aimbot.PredictionTime
    end
    local alpha = 1
    if aimbot.Smoothing > 0 then
        local speed = 60 - 56 * (aimbot.Smoothing / 100)
        alpha = 1 - math.exp(-speed * deltaTime)
    end

    if aimbot.Mode == "Silent Aim (Góc 3)" then
        if aimbot.AutoRotateBackup[localHumanoid] == nil then
            aimbot.AutoRotateBackup[localHumanoid] = localHumanoid.AutoRotate
        end
        localHumanoid.AutoRotate = false
        local rootPosition = localRoot.Position
        local flatTarget = Vector3.new(targetPosition.X, rootPosition.Y, targetPosition.Z)
        if (flatTarget - rootPosition).Magnitude > 0.05 then
            local desired = CFrame.lookAt(rootPosition, flatTarget)
            localRoot.CFrame = alpha >= 1 and desired or localRoot.CFrame:Lerp(desired, alpha)
        end
    else
        Extensions.RestoreAimbotCharacterRotation()
        if aimbot.CameraModeBackup == nil then
            Camera = Workspace.CurrentCamera or Camera
            aimbot.CameraModeBackup = LocalPlayer.CameraMode
            aimbot.CameraTypeBackup = Camera.CameraType
            aimbot.CameraSubjectBackup = Camera.CameraSubject
        end
        pcall(function()
            LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
        end)
        Camera = Workspace.CurrentCamera or Camera
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = localHumanoid
        local cameraPosition = Camera.CFrame.Position
        if (targetPosition - cameraPosition).Magnitude > 0.05 then
            local desired = CFrame.lookAt(cameraPosition, targetPosition)
            Camera.CFrame = alpha >= 1 and desired or Camera.CFrame:Lerp(desired, alpha)
            Camera.Focus = CFrame.new(targetPosition)
        end
    end
end

