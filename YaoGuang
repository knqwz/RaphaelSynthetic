function Extensions.ApplyWalkSpeedRuntime(humanoid: any, speed: number)
    if math.abs((tonumber(humanoid.WalkSpeed) or 0) - speed) > 0.05 then
        humanoid.WalkSpeed = speed
    end
end

function Extensions.ApplyVelocitySpeedRuntime(humanoid: any, root: any, original: any, speed: number)
    local baseSpeed: number = tonumber(original and original.WalkSpeed) or 16
    local controllerSpeed: number = math.min(speed, baseSpeed)
    if math.abs((tonumber(humanoid.WalkSpeed) or 0) - controllerSpeed) > 0.05 then humanoid.WalkSpeed = controllerSpeed end
    local direction: any = humanoid.MoveDirection
    if (tonumber(direction.Magnitude) or 0) <= 0.02 then return end
    local currentVelocity: any = root.AssemblyLinearVelocity
    local targetVelocity = Vector3.new((tonumber(direction.X) or 0) * speed, tonumber(currentVelocity.Y) or 0, (tonumber(direction.Z) or 0) * speed)
    if (targetVelocity - currentVelocity).Magnitude > 0.25 then root.AssemblyLinearVelocity = targetVelocity end
end

function Extensions.ApplyCFrameSpeedRuntime(humanoid: any, root: any, original: any, speed: number, deltaTime: number)
    local baseSpeed: number = tonumber(original and original.WalkSpeed) or 16
    local targetWalkSpeed: number = math.min(speed, baseSpeed)
    if math.abs((tonumber(humanoid.WalkSpeed) or 0) - targetWalkSpeed) > 0.05 then humanoid.WalkSpeed = targetWalkSpeed end
    local extraSpeed: number = math.max(speed - baseSpeed, 0)
    local direction: any = humanoid.MoveDirection
    if extraSpeed > 0 and (tonumber(direction.Magnitude) or 0) > 0 then
        root.CFrame = root.CFrame + direction.Unit * extraSpeed * math.clamp(deltaTime, 0, 0.05)
    end
end

function Extensions.ApplyRuntimeSpeed(humanoid: any, root: any, original: any, deltaTime: number, _now: number)
    if not State.SpeedEnabled then return end
    local speed: number = math.max(tonumber(State.SpeedValue) or 16, 0)
    local method: string = table.find(Extensions.SpeedMethodOrder, State.SpeedMethod) and State.SpeedMethod or "WalkSpeed"
    if method == "Velocity" then
        Extensions.ApplyVelocitySpeedRuntime(humanoid, root, original, speed)
    elseif method == "CFrame" then
        Extensions.ApplyCFrameSpeedRuntime(humanoid, root, original, speed, deltaTime)
    else
        Extensions.ApplyWalkSpeedRuntime(humanoid, speed)
    end
end

function Extensions.UpdateRuntimeHeartbeat(deltaTime: number)
    if not State.Running then return end
    local needsRuntime = State.GodMode or State.SpeedEnabled or State.JumpEnabled or State.FlantEnabled or State.GravityEnabled or State.NoVoid or State.SpectatingPlayer ~= nil or State.XRay and State.XRayMethod ~= "Outline" or State.ClockTime ~= nil or Camera.FieldOfView ~= State.CameraFov
    local monitor = State.AnomalyMonitor
    local activity = State.ActivityLog
    local needsHousekeeping = State.AntiAFK or monitor.Enabled or activity.Enabled or monitor.Panel and monitor.Expanded and (activity.Dirty or activity.SelfDirty)
    if not needsRuntime and not needsHousekeeping then return end

    local antiAFKNow = os.clock()
    if needsHousekeeping and antiAFKNow - LastRuntimeHousekeeping >= 0.1 then
        LastRuntimeHousekeeping = antiAFKNow
        if State.AntiAFK and antiAFKNow - State.LastAntiAFKPulse >= State.AntiAFKPulseInterval then
            State.LastAntiAFKPulse = antiAFKNow
            task.spawn(Extensions.PulseAntiAFK)
        end
        if monitor.Enabled and antiAFKNow - monitor.LastScan >= monitor.Interval then
            monitor.LastScan = antiAFKNow
            task.spawn(Extensions.ScanPlayerAnomalies, false)
        end
        if activity.Enabled then Extensions.CheckSelfActivity() end
        if monitor.Panel and monitor.Expanded and (activity.Dirty or activity.SelfDirty) then
            Extensions.RefreshAnomalyPanel()
        end
    end
    if not needsRuntime then return end

    Camera = Workspace.CurrentCamera or Camera
    local character: any, humanoid: any, root: any = getCharacter()
    if not character or not humanoid or not root then
        return
    end
    local rememberFunction: any = rememberHumanoid
    local original: any = rememberFunction(humanoid)
    if State.GodMode then
        Extensions.ApplyGodMode(humanoid)
    end

    Extensions.ApplyRuntimeSpeed(humanoid, root, original, deltaTime, antiAFKNow)

    if State.JumpEnabled then
        if State.JumpMethod == "JumpPower" then
            if not humanoid.UseJumpPower then humanoid.UseJumpPower = true end
            if humanoid.JumpPower ~= State.JumpValue then humanoid.JumpPower = State.JumpValue end
        elseif State.JumpMethod == "JumpHeight" then
            if humanoid.UseJumpPower then humanoid.UseJumpPower = false end
            if humanoid.JumpHeight ~= State.JumpValue then humanoid.JumpHeight = State.JumpValue end
        end
    end

    Extensions.UpdateFlantPlatform(root)

    if State.GravityEnabled and Workspace.Gravity ~= State.GravityValue then
        Workspace.Gravity = State.GravityValue
    end
    Camera = Workspace.CurrentCamera or Camera
    if Camera.FieldOfView ~= State.CameraFov then
        Camera.FieldOfView = State.CameraFov
    end
    if State.SpectatingPlayer then
        local targetHumanoid = State.SpectatingPlayer.Character and State.SpectatingPlayer.Character:FindFirstChildOfClass("Humanoid")
        if targetHumanoid and Camera.CameraSubject ~= targetHumanoid then
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CameraSubject = targetHumanoid
        end
    end

    local now = os.clock()
    local xrayInterval = MeasuredFPS > 0 and MeasuredFPS < 35 and 0.12 or 0.08
    if State.XRay and State.XRayMethod ~= "Outline" and now - LastXRayUpdate >= xrayInterval then
        LastXRayUpdate = now
        updateXRayOcclusion()
    end
    if State.NoVoid and now - LastNoVoidCheck >= 0.2 then
        LastNoVoidCheck = now
        local threshold = Workspace.FallenPartsDestroyHeight + State.NoVoidMargin
        if root.Position.Y > threshold + 8 and humanoid.FloorMaterial ~= Enum.Material.Air then
            State.LastSafeCFrame = root.CFrame
        end
        if root.Position.Y <= threshold then
            local rescueCFrame = State.LastSafeCFrame
            if not rescueCFrame then
                local parameters = RaycastParams.new()
                parameters.FilterType = Enum.RaycastFilterType.Exclude
                parameters.FilterDescendantsInstances = {character}
                local rayOrigin = Vector3.new(root.Position.X, math.max(root.Position.Y + 1000, 2000), root.Position.Z)
                local result = Workspace:Raycast(rayOrigin, Vector3.new(0, -5000, 0), parameters)
                if result then
                    rescueCFrame = CFrame.new(result.Position + Vector3.new(0, 4, 0))
                end
            end
            if rescueCFrame then
                safeTeleport(rescueCFrame + Vector3.new(0, 3, 0))
                notify("No Void đã đưa Ngài về vị trí an toàn.", Theme.Warning)
            end
        end
    end

    if State.ClockTime and now - LastVisionApply >= 0.5 then
        LastVisionApply = now
        if Lighting.ClockTime ~= State.ClockTime then
            Lighting.ClockTime = State.ClockTime
        end
    end

end
