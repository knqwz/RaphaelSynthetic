connect(RunService.Stepped, function()
    if not State.Running or not State.Noclip and not State.AntiStun then
        return
    end
    local character, humanoid, root = getCharacter()
    if not character or not humanoid or not root then
        return
    end
    rememberHumanoid(humanoid)

    if State.Noclip then
        if State.NoclipMethod == "Chỉ Root" then
            if OriginalCollision[root] == nil then
                OriginalCollision[root] = root.CanCollide
            end
            root.CanCollide = false
        else
            for _, descendant in ipairs(character:GetDescendants()) do
                if descendant:IsA("BasePart") then
                    if OriginalCollision[descendant] == nil then
                        OriginalCollision[descendant] = descendant.CanCollide
                    end
                    descendant.CanCollide = false
                end
            end
            if State.NoclipMethod == "State + Parts" then
                pcall(function()
                    humanoid:ChangeState(Enum.HumanoidStateType.RunningNoPhysics)
                end)
            end
        end
    end

    if State.AntiStun then
        Extensions.MaintainAntiStun(character, humanoid, root)
    end
end)

connect(RunService.Heartbeat, function(deltaTime)
    if not State.Running then
        return
    end
    local antiAFKNow = os.clock()
    if State.AntiAFK and antiAFKNow - State.LastAntiAFKPulse >= State.AntiAFKPulseInterval then
        State.LastAntiAFKPulse = antiAFKNow
        task.spawn(Extensions.PulseAntiAFK)
    end
    if ActiveTab == "Info" and State.InterfaceVisible and antiAFKNow - LastInfoRefresh >= 1 then
        LastInfoRefresh = antiAFKNow
        refreshInfo()
    end
    local character, humanoid, root = getCharacter()
    if not character or not humanoid or not root then
        return
    end
    local original = rememberHumanoid(humanoid)
    if State.GodMode then
        Extensions.ApplyGodMode(humanoid)
    end

    if State.SpeedEnabled then
        if State.SpeedMethod == "WalkSpeed" then
            if humanoid.WalkSpeed ~= State.SpeedValue then
                humanoid.WalkSpeed = State.SpeedValue
            end
        elseif State.SpeedMethod == "Velocity" then
            if humanoid.WalkSpeed ~= 0 then
                humanoid.WalkSpeed = 0
            end
            local direction = humanoid.MoveDirection
            local currentVelocity = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(direction.X * State.SpeedValue, currentVelocity.Y, direction.Z * State.SpeedValue)
        elseif State.SpeedMethod == "CFrame" then
            local baseSpeed = original and original.WalkSpeed or 16
            local targetWalkSpeed = math.min(State.SpeedValue, baseSpeed)
            if humanoid.WalkSpeed ~= targetWalkSpeed then
                humanoid.WalkSpeed = targetWalkSpeed
            end
            local extraSpeed = math.max(State.SpeedValue - baseSpeed, 0)
            if extraSpeed > 0 and humanoid.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + humanoid.MoveDirection.Unit * extraSpeed * deltaTime
            end
        end
    end

    if State.JumpEnabled then
        if State.JumpMethod == "JumpPower" then
            if not humanoid.UseJumpPower then humanoid.UseJumpPower = true end
            if humanoid.JumpPower ~= State.JumpValue then humanoid.JumpPower = State.JumpValue end
        elseif State.JumpMethod == "JumpHeight" then
            if humanoid.UseJumpPower then humanoid.UseJumpPower = false end
            if humanoid.JumpHeight ~= State.JumpValue then humanoid.JumpHeight = State.JumpValue end
        end
    end

    Extensions.UpdateFlantPlatform(root)

    if Workspace.Gravity ~= State.GravityValue then
        Workspace.Gravity = State.GravityValue
    end
    if State.AntiStun then
        Extensions.MaintainAntiStun(character, humanoid, root)
    end
    Camera = Workspace.CurrentCamera or Camera
    if Camera.FieldOfView ~= State.CameraFov then
        Camera.FieldOfView = State.CameraFov
    end
    if State.SpectatingPlayer then
        local targetHumanoid = State.SpectatingPlayer.Character and State.SpectatingPlayer.Character:FindFirstChildOfClass("Humanoid")
        if targetHumanoid and Camera.CameraSubject ~= targetHumanoid then
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CameraSubject = targetHumanoid
        end
    end

    local now = os.clock()
    local xrayInterval = MeasuredFPS > 0 and MeasuredFPS < 35 and 0.4 or 0.28
    if State.XRay and State.XRayMethod ~= "Outline" and now - LastXRayUpdate >= xrayInterval then
        LastXRayUpdate = now
        updateXRayOcclusion()
    end
    if now - LastNoVoidCheck >= 0.2 then
        LastNoVoidCheck = now
        local threshold = Workspace.FallenPartsDestroyHeight + State.NoVoidMargin
        if root.Position.Y > threshold + 8 and humanoid.FloorMaterial ~= Enum.Material.Air then
            State.LastSafeCFrame = root.CFrame
        end
        if State.NoVoid and root.Position.Y <= threshold then
            local rescueCFrame = State.LastSafeCFrame
            if not rescueCFrame then
                local parameters = RaycastParams.new()
                parameters.FilterType = Enum.RaycastFilterType.Exclude
                parameters.FilterDescendantsInstances = {character}
                local rayOrigin = Vector3.new(root.Position.X, math.max(root.Position.Y + 1000, 2000), root.Position.Z)
                local result = Workspace:Raycast(rayOrigin, Vector3.new(0, -5000, 0), parameters)
                if result then
                    rescueCFrame = CFrame.new(result.Position + Vector3.new(0, 4, 0))
                end
            end
            if rescueCFrame then
                safeTeleport(rescueCFrame + Vector3.new(0, 3, 0))
                notify("No Void đã đưa Ngài về vị trí an toàn.", Theme.Warning)
            end
        end
    end

    if now - LastVisionApply >= 0.5 then
        LastVisionApply = now
        if State.ClockTime then
            Lighting.ClockTime = State.ClockTime
        end
        if State.RemoveEffects then
            applyNoEffects()
        end
        if State.FullBrightLevel ~= nil then
            applyFullBright()
        end
    end

    local itemScanInterval = State.ItemESP.ExactName ~= "" and 15 or 1.5
    if now - LastItemScan >= itemScanInterval then
        LastItemScan = now
        if State.ItemESP.Enabled or State.XRay or State.Inspector.Enabled then
            task.spawn(function()
                scanItems(false)
            end)
        end
    end

    if now - LastMobRescan >= 120 then
        LastMobRescan = now
        if State.MobESP.Enabled or State.XRay or State.Inspector.Enabled or (State.Aimbot.Enabled and State.Aimbot.TargetType == "NPC") then
            task.spawn(rescanMobs)
        end
    end

end)

connect(RunService.RenderStepped, function()
    local now = os.clock()
    local needsFPSSample = ActiveTab == "Info" and State.InterfaceVisible or State.PlayerESP.Enabled or State.MobESP.Enabled or State.ItemESP.Enabled or State.Inspector.Enabled or State.XRay
    if needsFPSSample then
        FrameCounter = FrameCounter + 1
        if now - FrameTimer >= 0.5 then
            MeasuredFPS = math.floor(FrameCounter / (now - FrameTimer) + 0.5)
            FrameCounter = 0
            FrameTimer = now
        end
    else
        FrameCounter = 0
        FrameTimer = now
        MeasuredFPS = 0
    end

    if not State.Running then
        return
    end
    if State.ScreenBlankEnabled then
        for _, categoryVisuals in pairs(Visuals) do
            for _, visual in pairs(categoryVisuals) do
                hideVisual(visual)
            end
        end
        if State.Inspector.CrosshairFrame then State.Inspector.CrosshairFrame.Visible = false end
        if State.Inspector.Highlight then State.Inspector.Highlight.Enabled = false end
        if State.Inspector.NameLabel then State.Inspector.NameLabel.Visible = false end
        return
    end
    Extensions.UpdateInspector(now)
    Extensions.RefreshDynamicESP()
    if State.Aimbot.Enabled and not State.Aimbot.RenderBound then
        Extensions.UpdateAimbotFrame(now)
    end
    if not State.PlayerESP.Enabled and not State.MobESP.Enabled and not State.ItemESP.Enabled and not State.XRay then
        return
    end

    local refreshInterval
    if State.ESPRefreshMode == "25 FPS" then
        refreshInterval = 0.04
    elseif State.ESPRefreshMode == "15 FPS" then
        refreshInterval = 0.067
    elseif State.ESPRefreshMode == "10 FPS" then
        refreshInterval = 0.1
    elseif MeasuredFPS > 0 and MeasuredFPS < 30 then
        refreshInterval = 0.14
    elseif MeasuredFPS > 0 and MeasuredFPS < 45 then
        refreshInterval = 0.11
    else
        refreshInterval = 0.08
    end
    if now - LastESPUpdate < refreshInterval then
        return
    end
    LastESPUpdate = now

    Camera = Workspace.CurrentCamera or Camera
    local _, _, localRoot = getCharacter()
    if not localRoot then
        return
    end

    if State.PlayerESP.Enabled or State.XRay then
        local seen = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and (State.XRay or Extensions.IsPlayerESPAllowed(player)) then
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local root = character and getAdorneeRoot(character)
                if character and root and humanoid and humanoid.Health > 0 then
                    seen[player] = true
                    local distance = (root.Position - localRoot.Position).Magnitude
                    local healthText = State.PlayerESP.Enabled and State.PlayerESP.Health and getHealthText(humanoid) or nil
                    updateVisual("Player", player, character, root, player.DisplayName .. " (@" .. player.Name .. ")", healthText, distance)
                end
            end
        end
        for player, visual in pairs(Visuals.Player) do
            if not seen[player] then
                destroyVisual(visual)
                Visuals.Player[player] = nil
            end
        end
    end

    if State.MobESP.Enabled or State.XRay then
        local seen = {}
        local mobCandidates = {}
        local maximumStuds = State.MobESP.MaxDistanceMeters / 0.28
        local maximumDistanceSquared = maximumStuds * maximumStuds
        for model, classification in pairs(MobCache) do
            if model and model.Parent and type(classification) == "table" then
                local detectorRoot = classification.Root
                local humanoid = classification.Humanoid
                local visualAnchor = Extensions.GetMobVisualAnchor(model, detectorRoot)
                local worldPosition = Extensions.GetMobWorldPosition(model, visualAnchor)
                local alive = detectorRoot and detectorRoot.Parent == model and humanoid and humanoid.Parent == model and humanoid.Health > 0 and humanoid.MaxHealth > 0 and visualAnchor and visualAnchor.Parent and worldPosition
                if alive then
                    if isMobAllowedByManualFilter(model, classification) then
                        local offset = worldPosition - localRoot.Position
                        local distanceSquared = offset:Dot(offset)
                        if distanceSquared <= maximumDistanceSquared then
                            table.insert(mobCandidates, {
                                Model = model,
                                Data = classification,
                                Root = visualAnchor,
                                DistanceSquared = distanceSquared
                            })
                        end
                    end
                else
                    removeMobFromCache(model)
                end
            else
                removeMobFromCache(model)
            end
        end

        table.sort(mobCandidates, function(left, right)
            return left.DistanceSquared < right.DistanceSquared
        end)

        local targetLimit = math.min(#mobCandidates, State.MobESP.MaxTargets)
        for index = 1, targetLimit do
            local candidate = mobCandidates[index]
            local model = candidate.Model
            local classification = candidate.Data
            seen[model] = true
            updateVisual("Mob", model, model, candidate.Root, classification.DisplayName, nil, math.sqrt(candidate.DistanceSquared))
        end

        for model, visual in pairs(Visuals.Mob) do
            if not seen[model] then
                destroyVisual(visual)
                Visuals.Mob[model] = nil
            end
        end
    end

    if State.ItemESP.Enabled or State.XRay then
        local seen = {}
        for item in pairs(ItemCache) do
            if item and item.Parent and item:IsDescendantOf(Workspace) then
                local root = getAdorneeRoot(item)
                if root then
                    seen[item] = true
                    local healthText = State.ItemESP.Enabled and State.ItemESP.Health and getItemHealthText(item) or nil
                    updateVisual("Item", item, item, root, item.Name, healthText, (root.Position - localRoot.Position).Magnitude)
                end
            else
                ItemCache[item] = nil
            end
        end
        for item, visual in pairs(Visuals.Item) do
            if not seen[item] then
                destroyVisual(visual)
                Visuals.Item[item] = nil
            end
        end
    end
end)

