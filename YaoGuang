function Extensions.SetAimbotEnabled(enabled, reason, silent)
    enabled = not not enabled
    if State.Aimbot.RenderBound then
        pcall(function()
            RunService:UnbindFromRenderStep("RaphaelAimbotLock")
        end)
        State.Aimbot.RenderBound = false
    end
    if enabled then
        Extensions.ClearAimbotTarget(true)
        State.Aimbot.ReleasedModel = nil
        State.Aimbot.ReleasedPlayer = nil
        State.Aimbot.LastStickyCheck = 0
        State.Aimbot.Enabled = true
        if State.Aimbot.Mode == "Aim truyền thống (Góc 1)" and State.SpectatingPlayer then
            setSpectating(nil)
        end
        if State.Aimbot.TargetType == "NPC" and next(MobCache) == nil then
            task.spawn(rescanMobs)
        end
        Extensions.UpdateAimbotStatus("Đang chờ mục tiêu trong FOV", Theme.Warning)
        Extensions.UpdateAimbotFOV()
        State.Aimbot.RenderBound = pcall(function()
            RunService:BindToRenderStep("RaphaelAimbotLock", Enum.RenderPriority.Camera.Value + 1, function()
                Extensions.UpdateAimbotFrame(os.clock())
            end)
        end)
    else
        State.Aimbot.Enabled = false
        State.Aimbot.ReleasedModel = nil
        State.Aimbot.ReleasedPlayer = nil
        Extensions.ClearAimbotTarget(true)
        Extensions.UpdateAimbotFOV()
    end
    local control = State.ConfigControls.AimbotEnabled
    if control and control.Set then
        control.Set(enabled, false)
    end
    if not silent then
        notify(reason or (enabled and "Aimbot đã bật; đang tìm mục tiêu trong FOV." or "Aimbot đã dừng."), enabled and Theme.Success or Theme.Warning)
    end
end

