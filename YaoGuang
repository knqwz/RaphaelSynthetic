function Extensions.BuildBoneRigCache(visual, model)
    local cache = {Model = model, Parts = {}, Motors = {}, Kind = "Generic"}
    local names = {
        "Head", "Torso", "HumanoidRootPart", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
        "UpperTorso", "LowerTorso", "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm",
        "RightLowerArm", "RightHand", "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg",
        "RightLowerLeg", "RightFoot"
    }
    for _, name in ipairs(names) do
        local part = model:FindFirstChild(name)
        if part and part:IsA("BasePart") then cache.Parts[name] = part end
    end
    if cache.Parts.Torso and (cache.Parts["Left Arm"] or cache.Parts["Right Arm"]) then
        cache.Kind = "R6"
        for _, motorName in ipairs({"Neck", "RootJoint", "Left Shoulder", "Right Shoulder", "Left Hip", "Right Hip"}) do
            local motor = model:FindFirstChild(motorName, true)
            if motor and motor:IsA("Motor6D") then cache.Motors[motorName] = motor end
        end
    elseif cache.Parts.UpperTorso or cache.Parts.LowerTorso then
        cache.Kind = "R15"
    else
        cache.Motors.Generic = {}
        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("Motor6D") and descendant.Part0 and descendant.Part1 then
                cache.Motors.Generic[#cache.Motors.Generic + 1] = descendant
                if #cache.Motors.Generic >= MaximumBoneLines - 1 then break end
            end
        end
    end
    visual.BoneRigCache = cache
    return cache
end

function Extensions.GetBoneMotorPoint(motor, fallback)
    if motor and motor.Part0 and motor.Part0:IsA("BasePart") then
        return (motor.Part0.CFrame * motor.C0).Position
    end
    return fallback
end

function Extensions.GetBonePartEnd(part, bottom)
    if not part or not part:IsA("BasePart") then return nil end
    local sign = bottom == false and 0.5 or -0.5
    return part.CFrame:PointToWorldSpace(Vector3.new(0, part.Size.Y * sign, 0))
end

function Extensions.AppendBoneSegment(buffer, first, second)
    if not first or not second or #buffer >= MaximumBoneLines * 2 then return end
    buffer[#buffer + 1] = first
    buffer[#buffer + 1] = second
end

function Extensions.BuildBoneSegments(visual, model)
    local cache = visual.BoneRigCache
    local cacheAnchor = cache and (cache.Parts.Torso or cache.Parts.UpperTorso or cache.Parts.LowerTorso or cache.Parts.Head)
    if not cache or cache.Model ~= model or not cacheAnchor or not cacheAnchor.Parent then
        cache = Extensions.BuildBoneRigCache(visual, model)
    end
    local buffer = visual.BoneSegmentBuffer or {}
    visual.BoneSegmentBuffer = buffer
    table.clear(buffer)
    local parts = cache.Parts

    if cache.Kind == "R6" then
        local torso = parts.Torso
        if torso and torso.Parent then
            local center = torso.Position
            local neck = Extensions.GetBoneMotorPoint(cache.Motors.Neck, Extensions.GetBonePartEnd(torso, false))
            local pelvis = Extensions.GetBoneMotorPoint(cache.Motors.RootJoint, Extensions.GetBonePartEnd(torso, true))
            if parts.Head and parts.Head.Parent then Extensions.AppendBoneSegment(buffer, parts.Head.Position, neck) end
            Extensions.AppendBoneSegment(buffer, neck, center)
            Extensions.AppendBoneSegment(buffer, center, pelvis)
            for _, side in ipairs({"Left", "Right"}) do
                local arm = parts[side .. " Arm"]
                local shoulder = Extensions.GetBoneMotorPoint(cache.Motors[side .. " Shoulder"], center)
                if arm and arm.Parent then
                    Extensions.AppendBoneSegment(buffer, center, shoulder)
                    Extensions.AppendBoneSegment(buffer, shoulder, Extensions.GetBonePartEnd(arm, true))
                end
                local leg = parts[side .. " Leg"]
                local hip = Extensions.GetBoneMotorPoint(cache.Motors[side .. " Hip"], pelvis)
                if leg and leg.Parent then
                    Extensions.AppendBoneSegment(buffer, pelvis, hip)
                    Extensions.AppendBoneSegment(buffer, hip, Extensions.GetBonePartEnd(leg, true))
                end
            end
        end
    elseif cache.Kind == "R15" then
        for _, pair in ipairs(BonePairsR15) do
            local first = parts[pair[1]]
            local second = parts[pair[2]]
            if first and first.Parent and second and second.Parent then
                Extensions.AppendBoneSegment(buffer, first.Position, second.Position)
            end
        end
    else
        for _, motor in ipairs(cache.Motors.Generic or {}) do
            if motor.Parent and motor.Part0 and motor.Part1 then
                Extensions.AppendBoneSegment(buffer, motor.Part0.Position, motor.Part1.Position)
            end
        end
    end

    local tool = model:FindFirstChildOfClass("Tool")
    local handle = tool and tool:FindFirstChild("Handle")
    if handle and handle:IsA("BasePart") then
        local leftHand = parts.LeftHand or parts["Left Arm"]
        local rightHand = parts.RightHand or parts["Right Arm"]
        local anchor = rightHand or leftHand
        if leftHand and rightHand then
            anchor = (leftHand.Position - handle.Position).Magnitude < (rightHand.Position - handle.Position).Magnitude and leftHand or rightHand
        end
        if anchor then Extensions.AppendBoneSegment(buffer, anchor.Position, handle.Position) end
    end
    return buffer, parts.Head or model:FindFirstChild("Head")
end

function Extensions.UpdateBoneVisual(visual, color, visible)
    if not visible or not visual.Target or not visual.Target:IsA("Model") then
        Extensions.HideBoneVisual(visual)
        return
    end
    Extensions.EnsureBoneVisual(visual)
    local model = visual.Target
    local segments, head = Extensions.BuildBoneSegments(visual, model)
    local lineCount = math.floor(#segments / 2)
    local shown = 0
    for index = 1, math.min(lineCount, #(visual.BoneLines or {})) do
        local firstPoint, firstVisible = Camera:WorldToViewportPoint(segments[index * 2 - 1])
        local secondPoint, secondVisible = Camera:WorldToViewportPoint(segments[index * 2])
        local line = visual.BoneLines[index]
        local lineVisible = false
        if firstVisible and secondVisible and firstPoint.Z > 0 and secondPoint.Z > 0 then
            local first2D = Vector2.new(firstPoint.X, firstPoint.Y)
            local second2D = Vector2.new(secondPoint.X, secondPoint.Y)
            local delta = second2D - first2D
            local length = delta.Magnitude
            if length > 1 then
                line.Position = UDim2.fromOffset((first2D.X + second2D.X) * 0.5, (first2D.Y + second2D.Y) * 0.5)
                line.Size = UDim2.fromOffset(length, State.ESPStyle.BoxThickness + 0.3)
                line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
                line.BackgroundColor3 = color
                line.Visible = true
                lineVisible = true
                shown = shown + 1
            end
        end
        if not lineVisible then line.Visible = false end
    end
    for index = lineCount + 1, #(visual.BoneLines or {}) do visual.BoneLines[index].Visible = false end

    if head and head:IsA("BasePart") then
        local point, onScreen = Camera:WorldToViewportPoint(head.Position)
        if onScreen and point.Z > 0 then
            local diameter = math.clamp((head.Size.Y * 520) / math.max(point.Z, 1), 7, 46)
            visual.BoneHead.Position = UDim2.fromOffset(point.X, point.Y)
            visual.BoneHead.Size = UDim2.fromOffset(diameter, diameter)
            visual.BoneHeadStroke.Color = color
            visual.BoneHead.Visible = true
            shown = shown + 1
        else
            visual.BoneHead.Visible = false
        end
    else
        visual.BoneHead.Visible = false
    end
    visual.BoneGui.Visible = shown > 0
end

