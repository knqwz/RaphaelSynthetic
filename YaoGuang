        local mouse = UserInputService:GetMouseLocation()
        local origin = panel.AbsolutePosition
        local size = panel.AbsoluteSize
        if mouse.X >= origin.X and mouse.X <= origin.X + size.X and mouse.Y >= origin.Y and mouse.Y <= origin.Y + size.Y + 36 then
            Extensions.WriteSetting("MinimapRadius", math.floor(minimap.ViewRadius * (input.Position.Z > 0 and 0.85 or 1.18) + 0.5), false)
        end
    end)

    minimap.Panel = panel
    minimap.Inner = inner
    minimap.CanvasBackdrop = backdrop
    minimap.MapClip = inner
    minimap.Canvas = canvas
    minimap.MapCanvas = canvas
    minimap.GridLayer = gridLayer
    minimap.MarkerLayer = markerLayer
    minimap.PlayerLayer = markerLayer
    minimap.SelfArrow = selfArrow
    minimap.CompassLabel = compassLabel
    minimap.InfoLabel = infoLabel
    minimap.ZoomHolder = zoomHolder
    minimap.Status = status
    minimap.EditOverlay = editOverlay
    Extensions.LayoutMinimap()
    Extensions.UpdateMinimapEditorState()
    return panel
end

function Extensions.SetMinimapEnabled(enabled, silent)
    minimap.Enabled = not not enabled
    if minimap.Enabled then
        Extensions.EnsureMinimap()
        minimap.Panel.Visible = true
        if not minimap.Ready and not minimap.Scanning then Extensions.StartMinimapScan(false) end
    else
        minimap.ScanToken = minimap.ScanToken + 1
        minimap.Scanning = false
        minimap.Editing = false
        if minimap.Panel then minimap.Panel.Visible = false end
        if minimap.SettingsSheet then Luxury.Hide(minimap.SettingsSheet, true) end
        minimap.Drag = nil
    end
    local control = State.ConfigControls.MinimapEnabled
    if control and control.Set then control.Set(minimap.Enabled, false) end
    Extensions.UpdateMinimapEditorState()
    if not silent then notify(minimap.Enabled and "Mini Map Raphael đã bật." or "Mini Map đã tắt.", minimap.Enabled and Theme.Success or Theme.Warning) end
end

function Extensions.UpdateMinimapRuntime(deltaTime)
    if not minimap.Enabled then return end
    minimap.FrameEMA = minimap.FrameEMA * 0.94 + math.clamp(deltaTime, 0, 0.2) * 0.06
    local now = os.clock()
    Extensions.EnsureMinimap()
    if now - (minimap.LastViewApply or 0) >= 0.025 then
        minimap.LastViewApply = now
        Extensions.ApplyMinimapView(false)
    end
    if now - minimap.LastMarkerUpdate >= 0.1 then
        minimap.LastMarkerUpdate = now
        Extensions.UpdateMinimapMarkers()
    end
    if minimap.Scanning then return end
    if not minimap.Ready then
        Extensions.StartMinimapScan(false)
        return
    end
    local built = minimap.BuiltPlan
    local root = minimapRoot()
    if not built or not root then return end
    local drifted = false
    if minimap.BuiltAnchor then
        local limit = math.max(built.Half - (built.Rotate and built.Resolution * 0.7072 or built.Resolution * 0.5) - 3, 4) * built.CellSize * 0.8
        local delta = root.Position - minimap.BuiltAnchor
        drifted = math.max(math.abs(delta.X), math.abs(delta.Z)) > limit
    end
    local stale = minimap.RefreshSeconds > 0 and now - minimap.LastBuildAt > math.max(minimap.RefreshSeconds, minimap.LastBuildDuration * 3)
    if (drifted or stale) and now - minimap.LastBuildAt >= 1.2 then
        minimap.ForceFresh = stale
        Extensions.StartMinimapScan(false)
    end
end

