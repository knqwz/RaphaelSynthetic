function Extensions.RefreshMobESPWork(now: number, localRoot: any)
    local shardCount = State.MobESP.RenderShardCount
    local shard = State.MobESP.RenderShard % shardCount + 1
    State.MobESP.RenderShard = shard
    if shard == 1 then
        Extensions.ResetMobCandidateBuffer()
    end
    local maximumStuds = State.MobESP.MaxDistanceMeters / 0.28
    local maximumDistanceSquared = maximumStuds * maximumStuds
    local targetLimit = State.MobESP.MaxTargets
    local anchorResolver: any = Extensions.GetCachedMobVisualAnchor
    local positionResolver: any = Extensions.GetMobWorldPosition
    local cacheIndex = 0
    for model, classification in pairs(MobCache) do
        cacheIndex = cacheIndex + 1
        if (cacheIndex - 1) % shardCount + 1 == shard then
            if model and model.Parent and type(classification) == "table" then
                local detectorRoot: any = classification.Root
                local humanoid: any = classification.Humanoid
                local visualAnchor: any = anchorResolver(model, classification)
                local worldPosition: any = positionResolver(model, visualAnchor)
                local alive: boolean = detectorRoot ~= nil and detectorRoot.Parent == model
                alive = alive and humanoid ~= nil and humanoid.Parent == model
                alive = alive and (tonumber(humanoid and humanoid.Health) or 0) > 0
                alive = alive and (tonumber(humanoid and humanoid.MaxHealth) or 0) > 0
                alive = alive and visualAnchor ~= nil and visualAnchor.Parent ~= nil and worldPosition ~= nil
                if alive then
                    if isMobAllowedByManualFilter(model, classification) then
                        local offset = worldPosition - localRoot.Position
                        local distanceSquared = offset:Dot(offset)
                        if distanceSquared <= maximumDistanceSquared then
                            Extensions.InsertMobCandidate(model, classification, visualAnchor, distanceSquared, targetLimit)
                        end
                    end
                else
                    removeMobFromCache(model)
                end
            else
                removeMobFromCache(model)
            end
        end
    end
    if shard ~= shardCount then
        return
    end
    State.ESPGeneration.Mob = State.ESPGeneration.Mob + 1
    local generation = State.ESPGeneration.Mob
    local seen = State.ESPSeen.Mob
    local mobCandidates = State.MobCandidateBuffer
    for index = 1, #mobCandidates do
        local candidate = mobCandidates[index]
        local model = candidate.Model
        local classification = candidate.Data
        seen[model] = generation
        local healthText, healthRatio
        if State.MobESP.Enabled and State.MobESP.Health then
            healthText, healthRatio = getHealthText(classification.Humanoid)
            classification.HealthText = healthText
            classification.HealthRatio = healthRatio
        end
        updateVisual("Mob", model, model, candidate.Root, tostring(classification.DisplayName), healthText, healthRatio, math.sqrt(tonumber(candidate.DistanceSquared) or 0))
    end
    for model, visual in pairs(Visuals.Mob) do
        if seen[model] ~= generation then
            Extensions.ReleaseVisual("Mob", model, visual)
        end
    end
    Extensions.ResetMobCandidateBuffer()
end

function Extensions.RefreshItemESPWork(now, localRoot)
