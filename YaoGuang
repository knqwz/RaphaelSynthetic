function Extensions.MoveFunctionSearchSelection(delta)
    local count = #State.FunctionSearchMatches
    if count == 0 then
        return
    end
    local index = (State.FunctionSearchSelected or 1) + delta
    if index < 1 then
        index = count
    elseif index > count then
        index = 1
    end
    State.FunctionSearchSelected = index
    Extensions.PaintFunctionSearchSelection()
end

