function Extensions.ScoreInspectorCandidate(instance, center, maximumDepth)
    if not instance or not instance.Parent or instance:GetAttribute("RaphaelOwned") then
        return nil
    end
    local preliminaryRoot = getAdorneeRoot(instance)
    if not preliminaryRoot or not preliminaryRoot.Parent then
        return nil
    end
    local preliminaryPoint, preliminaryVisible = Camera:WorldToViewportPoint(preliminaryRoot.Position)
    if not preliminaryVisible or preliminaryPoint.Z <= 0 or (Vector2.new(preliminaryPoint.X, preliminaryPoint.Y) - center).Magnitude > math.max(State.Inspector.ScreenRadius * 4, 220) then
        return nil
    end
    local target, displayName, color, priority = Extensions.ResolveInspectorTarget(instance)
    if not target or priority < 2 then
        return nil
    end
    local root = getAdorneeRoot(target)
    if not root or not root.Parent then
        return nil
    end
    local projected, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen or projected.Z <= 0 or projected.Z > State.Inspector.MaxDistance then
        return nil
    end
    if maximumDepth and projected.Z > maximumDepth + math.max(6, maximumDepth * 0.015) then
        return nil
    end

    local distance = (Vector2.new(projected.X, projected.Y) - center).Magnitude
    local topLeft, boxSize = getScreenBounds(target)
    local containsCenter = false
    if topLeft and boxSize then
        containsCenter = center.X >= topLeft.X - 4
            and center.X <= topLeft.X + boxSize.X + 4
            and center.Y >= topLeft.Y - 4
            and center.Y <= topLeft.Y + boxSize.Y + 4
    end
    if not containsCenter and distance > State.Inspector.ScreenRadius then
        return nil
    end
    local score = (containsCenter and 0 or distance + 8) * 10000 + projected.Z - priority * 100
    return {
        Target = target,
        Root = root,
        DisplayName = displayName,
        Color = color,
        Priority = priority,
        Depth = projected.Z,
        Score = score,
        Position = root.Position
    }
end

function Extensions.FindInspectorScreenCandidate(center, rayDepth)
    local best
    local seen = {}
    local checked = 0
    local function consider(instance)
        if checked >= 280 or not instance or seen[instance] then
            return
        end
        seen[instance] = true
        checked = checked + 1
        local candidate = Extensions.ScoreInspectorCandidate(instance, center, rayDepth)
        if candidate and (not best or candidate.Score < best.Score) then
            best = candidate
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            consider(player.Character)
        end
    end
    local mobChecked = 0
    for model in pairs(MobCache) do
        consider(model)
        mobChecked = mobChecked + 1
        if mobChecked >= 140 then
            break
        end
    end
    local itemChecked = 0
    for item in pairs(ItemCache) do
        consider(item)
        itemChecked = itemChecked + 1
        if itemChecked >= 80 then
            break
        end
    end
    for _, tag in ipairs(State.Inspector.Tags) do
        for _, instance in ipairs(CollectionService:GetTagged(tag)) do
            consider(instance)
            if checked >= 240 then
                break
            end
        end
        if checked >= 240 then
            break
        end
    end

    if checked < 280 then
        local character = LocalPlayer.Character
        State.Inspector.OverlapParams.FilterType = Enum.RaycastFilterType.Exclude
        State.Inspector.OverlapParams.FilterDescendantsInstances = character and {character} or {}
        State.Inspector.OverlapParams.MaxParts = math.min(80, 280 - checked)
        local corridorDepth = math.min(rayDepth or State.Inspector.MaxDistance, 1200)
        local corridor = Camera.CFrame * CFrame.new(0, 0, -corridorDepth * 0.5)
        local success, parts = pcall(function()
            return Workspace:GetPartBoundsInBox(corridor, Vector3.new(30, 30, corridorDepth), State.Inspector.OverlapParams)
        end)
        if success then
            for _, part in ipairs(parts) do
                consider(part)
            end
        end
    end
    return best
end

function Extensions.ScanInspector(now)
    if now - State.Inspector.LastScan < 0.08 then
        return
    end
    State.Inspector.LastScan = now
    Camera = Workspace.CurrentCamera or Camera
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    local ray = Camera:ViewportPointToRay(center.X, center.Y)
    local character = LocalPlayer.Character
    State.Inspector.RaycastParams.FilterType = Enum.RaycastFilterType.Exclude
    State.Inspector.RaycastParams.FilterDescendantsInstances = character and {character} or {}
    State.Inspector.RaycastParams.IgnoreWater = false
    local result = Workspace:Raycast(ray.Origin, ray.Direction * State.Inspector.MaxDistance, State.Inspector.RaycastParams)
    local rayDepth = result and (result.Position - ray.Origin).Magnitude or State.Inspector.MaxDistance
    local screenCandidate = Extensions.FindInspectorScreenCandidate(center, rayDepth)
    local target
    local displayName = ""
    local color = Theme.Accent
    local priority = 0
    local hitPosition
    local root

    if result then
        target, displayName, color, priority = Extensions.ResolveInspectorTarget(result.Instance)
        root = result.Instance
        hitPosition = result.Position
    end
    if screenCandidate and (not target or priority < 2 and screenCandidate.Priority >= 2 or screenCandidate.Depth + 2 < rayDepth) then
        target = screenCandidate.Target
        root = screenCandidate.Root
        displayName = screenCandidate.DisplayName
        color = screenCandidate.Color
        priority = screenCandidate.Priority
        hitPosition = screenCandidate.Position
    end

    State.Inspector.Target = target
    State.Inspector.Root = root
    State.Inspector.DisplayName = displayName
    State.Inspector.Color = color
    State.Inspector.Priority = priority
    State.Inspector.HitPosition = hitPosition
end

function Extensions.UpdateInspector(now)
    if not State.Inspector.Enabled then
        return
    end
    Extensions.CreateInspectorVisuals()
    Camera = Workspace.CurrentCamera or Camera
    local viewport = Camera.ViewportSize
    local center = Vector2.new(viewport.X * 0.5, viewport.Y * 0.5)
    if State.Inspector.CrosshairFrame then
        State.Inspector.CrosshairFrame.Position = UDim2.fromOffset(center.X, center.Y)
        State.Inspector.CrosshairFrame.Visible = true
    end

    Extensions.ScanInspector(now)
    local target = State.Inspector.Target
    local color = State.Inspector.Color or Theme.Accent
    local valid = target and target.Parent and State.Inspector.HitPosition ~= nil
    if State.Inspector.NameLabel then
        State.Inspector.NameLabel.Position = UDim2.fromOffset(center.X, center.Y + 12)
        State.Inspector.NameLabel.Text = valid and State.Inspector.DisplayName or ""
        State.Inspector.NameLabel.TextColor3 = color:Lerp(Theme.Text, 0.35)
        State.Inspector.NameLabel.Visible = not not valid
    end

    local highlightTarget
    if valid then
        if target:IsA("Model") or target:IsA("BasePart") then
            highlightTarget = target
        elseif target:IsA("Tool") then
            highlightTarget = getAdorneeRoot(target)
        else
            highlightTarget = State.Inspector.Root and State.Inspector.Root:IsA("BasePart") and State.Inspector.Root or getAdorneeRoot(target)
        end
    end
    if State.Inspector.Highlight then
        State.Inspector.Highlight.Adornee = highlightTarget
        State.Inspector.Highlight.FillColor = color
        State.Inspector.Highlight.OutlineColor = color:Lerp(Theme.Text, 0.25)
        State.Inspector.Highlight.Enabled = highlightTarget ~= nil
    end
end

function Extensions.SetInspectorEnabled(enabled, silent)
    State.Inspector.Enabled = not not enabled
    State.Inspector.LastScan = 0
    if State.Inspector.Enabled then
        Extensions.CreateInspectorVisuals()
        task.spawn(rescanMobs)
