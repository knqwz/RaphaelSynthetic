    function Island.Push(text, color, options)
        if not Island.IsActive() then return false end
        text = tostring(text or "")
        if text == "" then return false end
        local now = os.clock()
        if Island.LastPushText == text and now - Island.LastPushAt < 0.6 then return true end
        Island.LastPushText = text
        Island.LastPushAt = now
        local title, subtitle = splitMessage(text)
        local resolvedColor = color or Theme.Success
        local priority = 1
        if resolvedColor == Theme.Danger then priority = 3 elseif resolvedColor == Theme.Warning then priority = 2 end
        local duration = islandState.Duration + math.clamp((#text - 40) * 0.035, 0, 2.5)
        local entry = {
            Title = title,
            Subtitle = subtitle,
            Color = resolvedColor,
            Icon = pickIcon(text, resolvedColor),
            Tag = pickTag(text),
            Duration = duration,
            Priority = priority
        }
        if type(options) == "table" then
            entry.Title = options.Title or entry.Title
            entry.Subtitle = options.Subtitle or entry.Subtitle
            entry.Duration = options.Duration or entry.Duration
            entry.Icon = options.Icon or entry.Icon
            entry.Tag = options.Tag or entry.Tag
        end
        if Island.Mode == "List" then
            Island.HideList(true)
        end
        if Island.Mode == "Notice" and Island.Current then
            local elapsed = now - Island.NoticeStarted
            if priority > Island.Current.Priority or elapsed >= 1.1 then
                Island.ShowNotice(entry)
            else
                if #Island.Queue >= 4 then table.remove(Island.Queue, 1) end
                Island.Queue[#Island.Queue + 1] = entry
            end
        else
            Island.ShowNotice(entry)
        end
        return true
    end

    function Island.PushRoblox(title, text, duration)
        if not Island.IsActive() then return false end
        local entry = {
            Title = tostring(title or "Roblox"),
            Subtitle = tostring(text or ""),
            Color = Theme.Accent2,
            Icon = "info",
            Tag = "ROBLOX",
            Duration = math.clamp(tonumber(duration) or 5, 2, 8),
            Priority = 2
        }
        if Island.Mode == "Notice" then
            if #Island.Queue >= 4 then table.remove(Island.Queue, 1) end
            Island.Queue[#Island.Queue + 1] = entry
        else
            if Island.Mode == "List" then Island.HideList(true) end
            Island.ShowNotice(entry)
        end
        return true
    end

    function Island.SetStatus(text, color)
        Island.StatusText = tostring(text or "")
        Island.StatusColor = color or Theme.Success
        Island.StatusUntil = os.clock() + 2.6
        if Island.Mode == "Compact" then Island.RenderCompact(true) end
    end

    local function rebuildChips()
        for _, child in ipairs(listScroll:GetChildren()) do
            if child:IsA("GuiObject") then child:Destroy() end
        end
        local activities = Island.Activities
        local width = math.min(State.IsDesktop and 410 or 350, getMaxWidth() + 40)
        local columns = width >= 380 and 3 or 2
        local gap = 6
        local chipWidth = math.floor((width - 26 - (columns - 1) * gap) / columns)
        listGrid.CellSize = UDim2.fromOffset(chipWidth, 40)
        listGrid.CellPadding = UDim2.fromOffset(gap, gap)
        for index, activity in ipairs(activities) do
            local chip = Instance.new("TextButton")
            chip.Name = "Chip"
            chip:SetAttribute("RaphaelButtonArtworkExempt", true)
            chip.LayoutOrder = index
            chip.BackgroundColor3 = Color3.fromRGB(26, 24, 34)
            chip.BackgroundTransparency = 0.05
            chip.BorderSizePixel = 0
            chip.AutoButtonColor = false
            chip.Text = ""
            chip.ZIndex = 907
            chip.Parent = listScroll
            Instance.new("UICorner", chip).CornerRadius = UDim.new(0, 13)
            local chipStroke = Instance.new("UIStroke")
            chipStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            chipStroke.Color = Theme.Accent
            chipStroke.Transparency = 0.6
            chipStroke.Thickness = 1
            chipStroke.Parent = chip
            local icon = UI.CreateIcon(chip, activity.Icon, 17, Theme.AccentSoft)
            icon.AnchorPoint = Vector2.new(0, 0.5)
            icon.Position = UDim2.new(0, 11, 0.5, 0)
            icon.ZIndex = 908
            local label = Instance.new("TextLabel")
            label.BackgroundTransparency = 1
            label.Position = UDim2.fromOffset(36, 0)
            label.Size = UDim2.new(1, -52, 1, 0)
            label.Text = activity.Name
            label.TextColor3 = textColor
            label.Font = Enum.Font.GothamSemibold
            label.TextSize = 12
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.TextTruncate = Enum.TextTruncate.AtEnd
            label.ZIndex = 908
            label.Parent = chip
            local led = Instance.new("Frame")
            led.AnchorPoint = Vector2.new(1, 0.5)
            led.Position = UDim2.new(1, -10, 0.5, 0)
            led.Size = UDim2.fromOffset(7, 7)
            led.BackgroundColor3 = Theme.Success
            led.BorderSizePixel = 0
            led.ZIndex = 908
            led.Parent = chip
            Instance.new("UICorner", led).CornerRadius = UDim.new(1, 0)
            local activityId = activity.Id
            local customToggle = activity.Toggle
            chip.Activated:Connect(function()
                UI.Motion.Press(chip)
                if customToggle then
                    pcall(customToggle)
                else
                    Extensions.ActivateRegisteredToggle(activityId)
                end
                task.defer(function()
                    Island.Activities = Island.CollectActivities()
                    Island.ActivitySignature = activitySignature(Island.Activities)
                    if Island.Mode == "List" then Island.ShowList() end
                end)
            end)
        end
        return width, columns
    end

    function Island.ShowList()
        Island.Activities = Island.CollectActivities()
        Island.ActivitySignature = activitySignature(Island.Activities)
        local width, columns = rebuildChips()
        local count = #Island.Activities
        local rows = math.max(1, math.ceil(count / columns))
        local visibleRows = math.min(rows, 4)
        local height
        if count == 0 then
            height = listHeaderHeight + 66
        else
            height = listHeaderHeight + visibleRows * 46 + 8
        end
        listEmpty.Visible = count == 0
        listScroll.Visible = count > 0
        listTitle.Text = count > 0 and ("Đang hoạt động · " .. tostring(count)) or "Đang hoạt động"
        menuButton.Text = State.InterfaceVisible and "Ẩn menu" or "Mở menu"
        Island.ListOpenedAt = os.clock()
        Island.NoticeToken = Island.NoticeToken + 1
        setMode("List")
        rootStroke.Color = Theme.Accent
        rootStroke.Transparency = 0.7
        tweenRoot(width, height, 24, 0.4)
        pop()
    end

    function Island.HideList(skipRender)
        if Island.Mode ~= "List" then return end
        Island.ShowCompact()
    end

    hit.Activated:Connect(function()
        if Island.Mode == "Compact" then
            Island.ShowList()
        elseif Island.Mode == "List" then
            Island.HideList()
        elseif Island.Mode == "Notice" then
            Island.NoticeToken = Island.NoticeToken + 1
            Island.Queue = {}
            Island.ShowCompact()
        end
    end)

    menuButton.Activated:Connect(function()
        UI.Motion.Press(menuButton)
        Extensions.SetInterfaceVisible(not State.InterfaceVisible)
        Island.HideList()
    end)

    function Island.Refresh()
        local enabled = islandState.Enabled == true
        root.Visible = enabled
        rootScale.Scale = getScale()
        root.Position = UDim2.new(0.5, 0, 0, islandState.OffsetY)
        if StatusBar then StatusBar.Visible = not enabled end
        Island.CompactSignature = ""
        if enabled then
            if Island.Mode == "Compact" then Island.RenderCompact(false) end
        end
    end

    function Island.Tick(now)
        if not islandState.Enabled then return end
        if Island.Mode == "Compact" then
            if islandState.ShowStats and now - Island.LastPingRead >= 1 then
                Island.LastPingRead = now
                pcall(function()
                    Island.Ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                end)
            end
            if now - Island.LastStatsRender >= 0.5 then
                Island.LastStatsRender = now
                Island.DisplayFrameRate = Island.FrameRate
            end
            Island.RenderCompact(false)
        elseif Island.Mode == "List" then
            if now - Island.LastActivityScan >= 0.5 then
                Island.LastActivityScan = now
                local activities = Island.CollectActivities()
                local signature = activitySignature(activities)
                if signature ~= Island.ActivitySignature then
                    Island.Activities = activities
                    Island.ActivitySignature = signature
                    Island.ShowList()
                end
            end
            if now - Island.ListOpenedAt > 10 then
                Island.HideList()
            end
        end
    end

    connect(Workspace:GetPropertyChangedSignal("CurrentCamera"), function()
        Island.CompactSignature = ""
    end)
    connect(RunService.Heartbeat, function(deltaTime)
        if deltaTime > 0 then
            Island.FrameRate = Island.FrameRate * 0.93 + (1 / deltaTime) * 0.07
        end
    end)
    task.spawn(function()
        while State.Running and root.Parent do
            local success, failure = pcall(Island.Tick, os.clock())
            if not success then warn("[Raphael Island] " .. tostring(failure)) end
            task.wait(0.25)
        end
    end)

    Extensions.NamecallHandlers.SetCore = function(self, method, fromExecutor, name, payload)
        if fromExecutor or not State.Running or not root.Parent then return false end
        if name ~= "SendNotification" or not islandState.MergeRoblox or not islandState.Enabled then return false end
        if self ~= StarterGui then return false end
        if type(payload) ~= "table" or payload.Callback ~= nil or payload.Button1 ~= nil or payload.Button2 ~= nil then return false end
        local title = payload.Title
        local text = payload.Text
        local duration = payload.Duration
        task.defer(function()
            pcall(Island.PushRoblox, title, text, duration)
        end)
        return true, nil
    end

    Island.Refresh()
    Island.ShowCompact()
end

