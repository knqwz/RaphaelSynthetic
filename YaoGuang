function UI.ApplyUnifiedButtonArtwork(button)
    if not button or not button:IsA("TextButton") or button:GetAttribute("RaphaelButtonArtworkEnabled") ~= true or button:GetAttribute("RaphaelButtonArtworkExempt") then
        return nil
    end
    button.ClipsDescendants = true
    button.Font = Enum.Font.Gotham
    button.TextColor3 = Theme.Text
    local artwork = button:FindFirstChild("RaphaelActionArtwork")
    if not artwork then
        artwork = Instance.new("ImageLabel")
        artwork.Name = "RaphaelActionArtwork"
        artwork.Size = UDim2.fromScale(1, 1)
        artwork.BackgroundTransparency = 1
        artwork.BorderSizePixel = 0
        artwork.ImageColor3 = Color3.fromRGB(255, 255, 255)
        artwork.ImageTransparency = 0.08
        artwork.ScaleType = Enum.ScaleType.Crop
        artwork.Active = false
        artwork.ZIndex = button.ZIndex
        artwork.Parent = button
        Instance.new("UICorner", artwork).CornerRadius = UDim.new(0, 8)
    end
    artwork.Image = State.ActionButtonImage or ""

    local shade = button:FindFirstChild("RaphaelActionShade")
    if not shade then
        shade = Instance.new("Frame")
        shade.Name = "RaphaelActionShade"
        shade.Size = UDim2.fromScale(1, 1)
        shade.BackgroundColor3 = Theme.Background
        shade.BackgroundTransparency = 0.68
        shade.BorderSizePixel = 0
        shade.Active = false
        shade.ZIndex = button.ZIndex + 1
        shade.Parent = button
        Instance.new("UICorner", shade).CornerRadius = UDim.new(0, 8)
    end

    local protectedText = UI.ProtectButtonText(button, button:GetAttribute("RaphaelTextInset") or 0)
    if protectedText then
        protectedText.Font = Enum.Font.Gotham
        protectedText.TextColor3 = Theme.Text
        protectedText.TextStrokeTransparency = 0.72
        protectedText.ZIndex = button.ZIndex + 3
    end
    for _, child in ipairs(button:GetChildren()) do
        if child:IsA("ImageLabel") and child ~= artwork then
            child.ZIndex = math.max(child.ZIndex, button.ZIndex + 3)
            child.ImageColor3 = Theme.Text
        elseif child:IsA("TextLabel") then
            child.ZIndex = math.max(child.ZIndex, button.ZIndex + 3)
            child.Font = Enum.Font.Gotham
        end
    end
    return artwork
end

