    {"DiamondPlate", 150, 156, 164}, {"Snow", 236, 240, 246}, {"Ice", 172, 212, 232}, {"Glacier", 190, 224, 240},
    {"Mud", 92, 72, 52}, {"Ground", 112, 96, 72}, {"Salt", 226, 222, 214}, {"Limestone", 208, 200, 180},
    {"Granite", 130, 126, 124}, {"Marble", 220, 218, 214}, {"Pebble", 130, 122, 112}, {"Fabric", 150, 130, 120},
    {"Glass", 172, 202, 216}, {"ForceField", 90, 160, 220}
}) do
    local success, material = pcall(function() return Enum.Material[entry[1]] end)
    if success and material then materialTone[material] = {entry[2], entry[3], entry[4]} end
end
local waterMaterial = Enum.Material.Water
local neonMaterial = Enum.Material.Neon
local terrainColors = {}
local instanceInfo = setmetatable({}, {__mode = "k"})

local function describeInstance(instance)
    local info = instanceInfo[instance]
    if info then return info end
    info = {Skip = false, Model = nil, R = 130, G = 130, B = 130}
    local success = pcall(function()
        if instance.Transparency >= 0.6 then
            info.Skip = true
        else
            local model = instance:FindFirstAncestorOfClass("Model")
            if model and model:FindFirstChildOfClass("Humanoid") then
                info.Skip = true
                info.Model = model
            end
        end
        local color = instance.Color
        local red, green, blue = color.R * 255, color.G * 255, color.B * 255
        local tone = materialTone[instance.Material]
        if tone then
            local textured = instance:IsA("MeshPart") and instance.TextureID ~= ""
            local weight = textured and 0.7 or 0.18
            red = red * (1 - weight) + tone[1] * weight
            green = green * (1 - weight) + tone[2] * weight
            blue = blue * (1 - weight) + tone[3] * weight
        end
        if instance.Material == neonMaterial then
            red = math.min(red * 1.15 + 20, 255)
            green = math.min(green * 1.15 + 20, 255)
            blue = math.min(blue * 1.15 + 20, 255)
        end
        info.R, info.G, info.B = red, green, blue
    end)
    if not success then info.Skip = false end
    instanceInfo[instance] = info
    return info
end

local function terrainColor(material)
    local cached = terrainColors[material]
    if cached then return cached end
    local success, color = pcall(Workspace.Terrain.GetMaterialColor, Workspace.Terrain, material)
    local resolved = success and color or Color3.fromRGB(104, 145, 92)
    cached = {resolved.R * 255, resolved.G * 255, resolved.B * 255}
    terrainColors[material] = cached
    return cached
end

local function sampleCell(worldX, worldZ, topY, depth, params, ignored)
    local origin = Vector3.new(worldX, topY, worldZ)
    local remaining = depth
    local terrain = Workspace.Terrain
    for _ = 1, 4 do
        local result = Workspace:Raycast(origin, Vector3.new(0, -remaining, 0), params)
        if not result then return nil end
        local instance = result.Instance
        if instance == terrain then
            if result.Material == waterMaterial then
                return {52, 128, 196, result.Position.Y, 1}
            end
            local tone = terrainColor(result.Material)
            return {tone[1], tone[2], tone[3], result.Position.Y, 2}
        end
        local info = describeInstance(instance)
        if not info.Skip or #ignored >= 160 then
            return {info.R, info.G, info.B, result.Position.Y, 0}
        end
        ignored[#ignored + 1] = info.Model or instance
        params.FilterDescendantsInstances = ignored
        local drop = origin.Y - result.Position.Y + 0.05
        origin = Vector3.new(worldX, result.Position.Y - 0.05, worldZ)
        remaining = remaining - drop
        if remaining <= 0 then return nil end
    end
    return nil
end

local function minimapRoot()
    local character = LocalPlayer.Character
    return character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart) or nil
end

local function effectiveSide()
    Camera = Workspace.CurrentCamera or Camera
    local viewport = Camera.ViewportSize
    local requested = minimap.Side
    if isDesktop then
        return math.floor(math.clamp(requested, 96, math.max(96, viewport.Y * 0.72)))
    end
    return math.floor(math.clamp(requested, 96, math.max(96, math.min(viewport.X * 0.46, viewport.Y * 0.66))))
end

local function computePlan()
    local rotate = minimap.Rotate == "Theo camera"
    local visibleFactor = rotate and 0.7072 or 0.5
    local budget = isDesktop and 40000 or 22000
    local function windowFor(resolution)
        return 2 * (math.ceil(resolution * visibleFactor) + math.ceil(resolution * 0.25))
    end
    local effective = minimap.Resolution
    while effective > 16 and windowFor(effective) ^ 2 > budget do effective = effective - 2 end
    local window = windowFor(effective)
    return {
        Requested = minimap.Resolution,
        Resolution = effective,
        ViewRadius = minimap.ViewRadius,
        CellSize = (2 * minimap.ViewRadius) / effective,
        Half = window / 2,
        Window = window,
        Rotate = rotate
    }
end
