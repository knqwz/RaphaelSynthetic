local function teleportAtScreenPoint(screenPosition)
    local character = LocalPlayer.Character
    if not character then
        return false
    end
    Camera = Workspace.CurrentCamera or Camera
    local ray = Camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
    local parameters = RaycastParams.new()
    parameters.FilterType = Enum.RaycastFilterType.Exclude
    parameters.FilterDescendantsInstances = {character}
    parameters.IgnoreWater = false
    local result = Workspace:Raycast(ray.Origin, ray.Direction * 5000, parameters)
    if result then
        return safeTeleport(CFrame.new(result.Position + result.Normal * 3))
    end
    notify("Không phát hiện bề mặt tại điểm chạm.", Theme.Warning)
    return false
end

