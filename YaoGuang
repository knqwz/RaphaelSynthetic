Extensions.AimbotPartNames = {"Head", "UpperTorso", "Torso", "HumanoidRootPart", "LowerTorso", "LeftUpperArm", "RightUpperArm", "Left Arm", "Right Arm", "LeftUpperLeg", "RightUpperLeg", "Left Leg", "Right Leg"}
Extensions.AimbotLineNames = {"Head", "UpperTorso", "Torso", "HumanoidRootPart"}

function Extensions.GetAimbotPart(model)
    if not model or not model.Parent then
        return nil
    end
    local mode = State.Aimbot.AimPart
    if mode == "Gần tâm" then
        Camera = Workspace.CurrentCamera or Camera
        local center = Camera.ViewportSize * 0.5
        local bestPart
        local bestDistance = math.huge
        for _, name in ipairs(Extensions.AimbotPartNames) do
            local part = model:FindFirstChild(name)
            if part and part:IsA("BasePart") then
                local point, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen and point.Z > 0 then
                    local distance = (Vector2.new(point.X, point.Y) - center).Magnitude
                    if distance < bestDistance then
                        bestDistance = distance
                        bestPart = part
                    end
                end
            end
        end
        if bestPart then return bestPart end
    elseif mode == "Đầu" then
        local head = model:FindFirstChild("Head")
        if head and head:IsA("BasePart") then return head end
    end
    local body = model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("LowerTorso")
    return body and body:IsA("BasePart") and body or nil
end

