function Extensions.GetActivitySeverityColor(severity)
    if severity == "alert" then return Theme.Danger end
    if severity == "warn" then return Theme.Warning end
    if severity == "chat" then return Color3.fromRGB(74, 184, 255) end
    if severity == "remote" then return Color3.fromRGB(171, 112, 255) end
    if severity == "join" then return Theme.Success end
    if severity == "leave" then return Color3.fromRGB(171, 178, 194) end
    if severity == "system" then return Theme.Accent end
