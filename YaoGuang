local function getGuiRoots()
    local roots = {}
    local seen = {}
    local candidates = {PlayerGui, CoreGui, GuiParent}
    for _, root in ipairs(candidates) do
        if root and not seen[root] then
            seen[root] = true
            table.insert(roots, root)
        end
    end
    return roots
end

local function loadFlyGui()
    local before = {}
    for _, root in ipairs(getGuiRoots()) do
        for _, child in ipairs(root:GetDescendants()) do
            if child:IsA("ScreenGui") then
                before[child] = true
            end
        end
    end

    local success, result = pcall(function()
        return loadstring(game:HttpGet("https://raw.githubusercontent.com/XNEOFF/FlyGuiV3/main/FlyGuiV3.txt"))()
    end)

    if not success then
        notify("FlyGuiV3 lỗi: " .. tostring(result), Theme.Danger)
        return
    end

    task.wait(0.6)
    table.clear(FlyGuiObjects)
    for _, root in ipairs(getGuiRoots()) do
        for _, child in ipairs(root:GetDescendants()) do
            if child:IsA("ScreenGui") and (not before[child] or string.find(string.lower(child.Name), "fly", 1, true)) and child ~= ScreenGui then
                FlyGuiObjects[child] = true
            end
        end
    end
    if typeof(result) == "Instance" then
        FlyGuiObjects[result] = true
    end
    State.FlyLoaded = true
    State.FlyHidden = false
    notify("Đã tải FlyGuiV3.", Theme.Success)
end

local function setFlyHidden(hidden)
    local changed = false
    for instance in pairs(FlyGuiObjects) do
        if instance and instance.Parent then
            changed = true
            pcall(function()
                if instance:IsA("LayerCollector") then
                    instance.Enabled = not hidden
                elseif instance:IsA("GuiObject") then
                    instance.Visible = not hidden
                end
            end)
        end
    end
    State.FlyHidden = hidden
    if changed then
        notify(hidden and "Đã ẩn giao diện Fly." or "Đã hiện giao diện Fly.", Theme.Success)
    else
        notify("Không tìm thấy giao diện Fly đang hoạt động.", Theme.Warning)
    end
end

local function deleteFlyGui()
    local removed = 0
    for instance in pairs(FlyGuiObjects) do
        if instance and instance.Parent then
            removed = removed + 1
            pcall(function()
                instance:Destroy()
            end)
        end
    end
    table.clear(FlyGuiObjects)
    State.FlyLoaded = false
    State.FlyHidden = false
    notify(removed > 0 and "Đã xoá giao diện Fly." or "Không có giao diện Fly để xoá.", removed > 0 and Theme.Success or Theme.Warning)
end

function Extensions.HasVisionObstructionHint(instance)
    local current = instance
    local depth = 0
    while current and depth < 5 do
        local lowerName = string.lower(current.Name)
        for _, hint in ipairs(State.VisionObstructionHints) do
            if string.find(lowerName, hint, 1, true) then
                return true
            end
        end
        current = current.Parent
        depth = depth + 1
    end
    return false
end

local function captureEffect(instance)
    if EffectBackup[instance] then
        return
    end
    if instance:IsA("PostEffect") then
        EffectBackup[instance] = {Type = "PostEffect", Enabled = instance.Enabled}
    elseif instance:IsA("Atmosphere") then
        EffectBackup[instance] = {
            Type = "Atmosphere",
            Density = instance.Density,
            Haze = instance.Haze,
            Glare = instance.Glare,
            Offset = instance.Offset,
            Color = instance.Color,
            Decay = instance.Decay
        }
    elseif instance:IsA("Clouds") then
        EffectBackup[instance] = {
            Type = "Clouds",
            Cover = instance.Cover,
            Density = instance.Density,
            Color = instance.Color
        }
    elseif instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Smoke") then
        EffectBackup[instance] = {Type = "EnabledEffect", Enabled = instance.Enabled}
    elseif instance:IsA("LayerCollector") then
        EffectBackup[instance] = {Type = "LayerCollector", Enabled = instance.Enabled}
    elseif instance:IsA("GuiObject") then
        EffectBackup[instance] = {Type = "GuiObject", Visible = instance.Visible}
    end
end

local function suppressEffect(instance)
    if not instance or instance:GetAttribute("RaphaelOwned") then
        return
    end
    local alwaysSuppress = instance:IsA("PostEffect") or instance:IsA("Atmosphere") or instance:IsA("Clouds")
    local cameraEffect = Camera and instance:IsDescendantOf(Camera) and (instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Smoke"))
    local hinted = Extensions.HasVisionObstructionHint(instance)
    local worldEffect = hinted and (instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Smoke"))
    local guiEffect = hinted and (instance:IsA("LayerCollector") or instance:IsA("GuiObject")) and not instance:IsDescendantOf(ScreenGui)
    if not alwaysSuppress and not cameraEffect and not worldEffect and not guiEffect then
        return
    end
    captureEffect(instance)
    pcall(function()
        if instance:IsA("PostEffect") then
            instance.Enabled = false
        elseif instance:IsA("Atmosphere") then
            instance.Density = 0
            instance.Haze = 0
            instance.Glare = 0
            instance.Offset = 0
            instance.Color = Color3.fromRGB(255, 255, 255)
            instance.Decay = Color3.fromRGB(255, 255, 255)
        elseif instance:IsA("Clouds") then
            instance.Cover = 0
            instance.Density = 0
        elseif instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Smoke") then
            instance.Enabled = false
        elseif instance:IsA("LayerCollector") then
            instance.Enabled = false
        elseif instance:IsA("GuiObject") then
            instance.Visible = false
        end
    end)
end

function Extensions.DeepSuppressVision()
    if State.VisionDeepScanRunning or not State.RemoveEffects then
        return
    end
    State.VisionDeepScanRunning = true
    State.LastVisionDeepScan = os.clock()

    for _, instance in ipairs(Lighting:GetDescendants()) do
        if not State.RemoveEffects then break end
        suppressEffect(instance)
    end

    Camera = Workspace.CurrentCamera or Camera
    if State.RemoveEffects and Camera then
        for _, instance in ipairs(Camera:GetDescendants()) do
            suppressEffect(instance)
        end
    end

    local workspaceDescendants = Workspace:GetDescendants()
    for index, instance in ipairs(workspaceDescendants) do
        if not State.RemoveEffects then
            break
        end
        if instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Smoke") then
            suppressEffect(instance)
        end
        if index % 300 == 0 then
            task.wait()
        end
    end

    local guiDescendants = PlayerGui:GetDescendants()
    for index, instance in ipairs(guiDescendants) do
        if not State.RemoveEffects then
            break
        end
        if instance:IsA("LayerCollector") or instance:IsA("GuiObject") then
            suppressEffect(instance)
        end
        if index % 200 == 0 then
            task.wait()
        end
    end
    State.VisionDeepScanRunning = false
end

