function Extensions.SuppressTransientCorePopup(instance)
    if not instance or not instance.Parent then
        return false
    end
    local lowerName = string.lower(instance.Name)
    if lowerName ~= "networkpause" and lowerName ~= "corescripts/networkpause" and lowerName ~= "gameplaypaused" then
        return false
    end
    return pcall(instance.Destroy, instance)
end

task.defer(function()
    for _, instance in ipairs(CoreGui:GetDescendants()) do
        Extensions.SuppressTransientCorePopup(instance)
    end
end)
connect(CoreGui.DescendantAdded, function(instance)
    task.defer(Extensions.SuppressTransientCorePopup, instance)
end)

function Extensions.RoundMovementNumber(value)
    local number = tonumber(value) or 0
    return math.floor(number * 10 + 0.5) / 10
end

function Extensions.FormatMovementNumber(value)
    local rounded = Extensions.RoundMovementNumber(value)
    if rounded == math.floor(rounded) then
        return tostring(math.floor(rounded))
    end
    return string.format("%.1f", rounded)
end

function Extensions.ResolveInterfaceBackground()
    local customAsset = getcustomasset or getsynasset
    if not customAsset or not writefile then
        return State.InterfaceImageFallback
    end
    local folder = "Raphael_Assets"
    local path = folder .. "/Yaoguang_Interface_A715561.jpg"
    if isfolder and makefolder and not isfolder(folder) then
        pcall(makefolder, folder)
    end
    if isfile and isfile(path) then
        local cachedSuccess, cachedAsset = pcall(customAsset, path)
        if cachedSuccess and cachedAsset then
            return cachedAsset
        end
    end
    local downloadSuccess, imageData = pcall(function()
        return game:HttpGet(State.InterfaceImageURL, true)
    end)
    if not downloadSuccess or type(imageData) ~= "string" or #imageData < 128 then
        return State.InterfaceImageFallback
    end
    local writeSuccess = pcall(writefile, path, imageData)
    if not writeSuccess then
        return State.InterfaceImageFallback
    end
    local assetSuccess, assetPath = pcall(customAsset, path)
    if assetSuccess and assetPath then
        return assetPath
    end
    return State.InterfaceImageFallback
end

function Extensions.ResolveExternalButtonArtwork()
    local customAsset = getcustomasset or getsynasset
    if not customAsset or not writefile then
        return ""
    end
    local folder = "Raphael_Assets"
    local path = folder .. "/Yaoguang_External_Buttons_L25Q2C.jpg"
    if isfolder and makefolder and not isfolder(folder) then
        pcall(makefolder, folder)
    end
    if isfile and isfile(path) then
        local cachedSuccess, cachedAsset = pcall(customAsset, path)
        if cachedSuccess and cachedAsset then
            return cachedAsset
        end
    end
    local downloadSuccess, imageData = pcall(function()
        return game:HttpGet(State.ExternalButtonImageURL, true)
    end)
    if not downloadSuccess or type(imageData) ~= "string" or #imageData < 128 then
        return ""
    end
    local writeSuccess = pcall(writefile, path, imageData)
    if not writeSuccess then
        return ""
    end
    local assetSuccess, assetPath = pcall(customAsset, path)
    if assetSuccess and assetPath then
        return assetPath
    end
    return ""
end

