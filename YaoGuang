local function tween(instance, properties, duration)
    local animation = TweenService:Create(instance, TweenInfo.new(duration or 0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties)
    animation:Play()
    return animation
end

local function createTab(name, order)
    local button = Instance.new("TextButton")
    button.Name = name .. "Tab"
    button.Size = UDim2.new(1, 0, 0, 37)
    button.BackgroundColor3 = Theme.SurfaceLight
    button.BackgroundTransparency = 0.54
    button.BorderSizePixel = 0
    button.Text = name
    button.TextColor3 = Theme.SubText
    button.Font = Enum.Font.GothamMedium
    button.TextSize = 11
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.AutoButtonColor = false
    button.LayoutOrder = order
    button.Parent = Sidebar
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)
    local buttonPadding = Instance.new("UIPadding")
    buttonPadding.PaddingLeft = UDim.new(0, 39)
    buttonPadding.Parent = button

    local tabGradient = Instance.new("UIGradient")
    tabGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.Accent2:Lerp(Theme.Background, 0.12)),
        ColorSequenceKeypoint.new(0.5, Theme.Accent:Lerp(Color3.fromRGB(255, 255, 255), 0.1)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(104, 180, 255))
    })
    tabGradient.Rotation = 15
    tabGradient.Enabled = false
    tabGradient.Parent = button
    UI.ProtectButtonText(button, 0)

    local tabIcon = UI.CreateIcon(button, UI.TabIcons[name] or "sparkles", 17, Theme.SubText)
    tabIcon.AnchorPoint = Vector2.new(0, 0.5)
    tabIcon.Position = UDim2.new(0, -29, 0.5, 0)
    tabIcon.ZIndex = button.ZIndex + 2

    local accent = Instance.new("Frame")
    accent.Size = UDim2.fromOffset(6, 6)
    accent.AnchorPoint = Vector2.new(0.5, 0.5)
    accent.Position = UDim2.new(1, -10, 0.5, 0)
    accent.BackgroundColor3 = Theme.Text
    accent.BackgroundTransparency = 1
    accent.BorderSizePixel = 0
    accent.Parent = button
    Instance.new("UICorner", accent).CornerRadius = UDim.new(1, 0)
    UI.AddRipple(button, Theme.Text)

    local page = Instance.new("ScrollingFrame")
    page.Name = name .. "Page"
    page.Size = UDim2.fromScale(1, 1)
    page.BackgroundTransparency = 1
    page.BorderSizePixel = 0
    page.ScrollBarThickness = 3
    page.ScrollBarImageColor3 = Theme.Accent
    page.ScrollingDirection = Enum.ScrollingDirection.Y
    page.ElasticBehavior = Enum.ElasticBehavior.Never
    page.ClipsDescendants = true
    page.CanvasSize = UDim2.new()
    page.AutomaticCanvasSize = Enum.AutomaticSize.None
    page.Visible = false
    page.Parent = Content

    local pagePadding = Instance.new("UIPadding")
    pagePadding.PaddingRight = UDim.new(0, 7)
    pagePadding.PaddingBottom = UDim.new(0, 8)
    pagePadding.Parent = page

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Padding = UDim.new(0, 10)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Parent = page
    connect(pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"), function()
        page.CanvasSize = UDim2.fromOffset(0, pageLayout.AbsoluteContentSize.Y + 8)
    end)

    Pages[name] = page
    TabButtons[name] = {Button = button, Accent = accent, Icon = tabIcon, Gradient = tabGradient}

    connect(button.Activated, function()
        ActiveTab = name
        for tabName, tabPage in pairs(Pages) do
            tabPage.Visible = tabName == name
        end
        for tabName, data in pairs(TabButtons) do
            local selected = tabName == name
            data.Gradient.Enabled = selected
            tween(data.Button, {
                BackgroundTransparency = selected and 0.1 or 0.54,
                BackgroundColor3 = selected and Theme.Accent or Theme.SurfaceLight,
                TextColor3 = selected and Theme.Text or Theme.SubText
            })
            tween(data.Icon, {ImageColor3 = selected and Theme.Text or Theme.SubText})
            tween(data.Accent, {BackgroundTransparency = selected and 0.16 or 1})
        end
        if name == "Info" and Extensions.RefreshInfoView then
            task.defer(Extensions.RefreshInfoView)
        end
        page.Rotation = 0
        page.ClipsDescendants = true
        local pageScale = page:FindFirstChild("RaphaelMotionScale")
        if pageScale then
            pageScale.Scale = 1
        end
        task.defer(Extensions.RepairInterfaceGeometry)
    end)

    return page
end

