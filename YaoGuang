end)

scanItems = function(forceNotification)
    if State.ItemScanRunning then
        return 0
    end
    State.ItemScanRunning = true

    local character, _, root = getCharacter()
    if not root then
        State.ItemScanRunning = false
        if forceNotification then
            notify("Không thể quét item: nhân vật chưa sẵn sàng.", Theme.Danger)
        end
        return 0
    end

    local exactLower = string.lower(State.ItemESP.ExactName)
    local found = {}

    if exactLower ~= "" then
        local descendants = Workspace:GetDescendants()
        for index, instance in ipairs(descendants) do
            if string.lower(instance.Name) == exactLower and (instance:IsA("Model") or instance:IsA("Tool") or instance:IsA("BasePart")) then
                if instance:IsDescendantOf(Workspace) and not isCharacterDescendant(instance) then
                    found[instance] = true
                end
            end
            if index % 1600 == 0 then
                task.wait()
            end
        end
    else
        local radiusStuds = State.ItemESP.RadiusMeters / 0.28
        local overlap = OverlapParams.new()
        overlap.FilterType = Enum.RaycastFilterType.Exclude
        overlap.FilterDescendantsInstances = character and {character} or {}
        overlap.MaxParts = 600

        local success, parts = pcall(function()
            return Workspace:GetPartBoundsInRadius(root.Position, radiusStuds, overlap)
        end)
        if not success then
            parts = {}
        end

        for _, part in ipairs(parts) do
            local item = findAutomaticItem(part)
            if item and item:IsDescendantOf(Workspace) and not isCharacterDescendant(item) then
                found[item] = true
            end
        end
    end

    for item in pairs(ItemCache) do
        if not found[item] then
            ItemCache[item] = nil
            local visual = Visuals.Item[item]
            if visual then
                destroyVisual(visual)
                Visuals.Item[item] = nil
            end
        end
    end
    for item in pairs(found) do
        ItemCache[item] = true
    end

    local count = 0
    for _ in pairs(found) do
        count = count + 1
    end
    State.ItemScanRunning = false

    if forceNotification then
        if exactLower ~= "" then
            notify("Đã phát hiện " .. count .. " item tên chính xác “" .. State.ItemESP.ExactName .. "” trên toàn bản đồ.", count > 0 and Theme.Success or Theme.Warning)
        else
            notify("Đã phát hiện " .. count .. " item trong " .. State.ItemESP.RadiusMeters .. " m.", count > 0 and Theme.Success or Theme.Warning)
        end
    end
    return count
end

