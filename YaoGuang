    arrow.AnchorPoint = Vector2.new(1, 0.5)
    arrow.Position = UDim2.new(1, -4, 0.5, 0)
    arrow.ZIndex = hit.ZIndex + 1
    function control.Apply()
        arrow.Rotation = control.Collapsed and -90 or 0
        section:SetAttribute("RaphaelCollapsed", control.Collapsed)
        for _, child in ipairs(section:GetChildren()) do
            if not chrome[child] and child:IsA("GuiObject") then
