function Extensions.OpenServerBrowser(preferFew, forceRefresh)
    local browser = State.ServerBrowser
    Extensions.EnsureServerBrowser()
    if State.AvatarViewer.Sheet then Luxury.Hide(State.AvatarViewer.Sheet, true) end
    if State.VisualColor.Sheet then Luxury.Hide(State.VisualColor.Sheet, true) end
    if State.Minimap.SettingsSheet then Luxury.Hide(State.Minimap.SettingsSheet, true) end
    if not browser.Sheet.Backdrop.Visible then Luxury.Show(browser.Sheet) end
    local requestedPreference = not not preferFew
    local preferenceChanged = browser.PreferFew ~= requestedPreference
    browser.PreferFew = requestedPreference
    updateServerBrowserSegment()
    if browser.Loading then notify("Danh sách server đang được làm mới.", Theme.Warning) return end
    if not forceRefresh and not preferenceChanged and #browser.ServerCards > 0 then return end
    browser.SelectedServer = nil
    browser.LoadFailed = false
    table.clear(browser.ServerCards)
    clearGuiChildren(browser.ServerList)
    if browser.SelectionTitle then browser.SelectionTitle.Text = "Đang tìm server phù hợp…" end
    if browser.SelectionMeta then browser.SelectionMeta.Text = "API public Roblox · không dựng roster giả" end
    if browser.JoinButton then
        browser.JoinButton.Text = "Chọn server"
        browser.JoinButton.BackgroundTransparency = 0.48
    end
    browser.Status.Text = requestedPreference and "Đang tải server ít người…" or "Đang tải server đông người…"
    browser.Loading = true
    task.spawn(function()
        local servers, failureReason = fetchServerCandidates(requestedPreference and "Asc" or "Desc", forceRefresh)
        table.sort(servers, function(left, right)
            local leftPlayers = tonumber(left.playing) or 0
            local rightPlayers = tonumber(right.playing) or 0
            return requestedPreference and leftPlayers < rightPlayers or not requestedPreference and leftPlayers > rightPlayers
        end)
        browser.Loading = false
        if not browser.Panel or not browser.Panel.Parent then return end
        if #servers == 0 then
            local message = failureReason and ("Không đọc được API server · " .. failureReason) or "Không tìm thấy server còn chỗ phù hợp."
            browser.Status.Text = message
            browser.LoadFailed = true
            if browser.SelectionTitle then browser.SelectionTitle.Text = "Không có dữ liệu để chọn" end
            if browser.SelectionMeta then browser.SelectionMeta.Text = "Có thể vào server ngẫu nhiên để Roblox tự chọn server khác." end
            if browser.JoinButton then
                browser.JoinButton.Text = "Vào server ngẫu nhiên"
                browser.JoinButton.BackgroundTransparency = 0.2
            end
            notify(message, Theme.Danger)
            return
        end
        Extensions.PopulateServerBrowser(servers)
        browser.Status.Text = string.format("%d server công khai · %s", #servers, requestedPreference and "ưu tiên ít người" or "ưu tiên đông người")
    end)
end

function Extensions.ClearAvatarViewerViewport()
    local viewer = State.AvatarViewer
    if not viewer.Viewport then return end
    for _, child in ipairs(viewer.Viewport:GetChildren()) do
        if child:IsA("WorldModel") or child:IsA("Camera") then child:Destroy() end
    end
    viewer.ViewportModel = nil
    viewer.PreviewCamera = nil
    viewer.PreviewCenter = nil
    viewer.PreviewSize = nil
end

local function computeViewerFrame(model)
    local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
    local origin = root and root.Position or Vector3.new(0, 0, 0)
    local minimum, maximum
    for _, descendant in ipairs(model:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Transparency < 0.95 then
            local position = descendant.Position
            if (position - origin).Magnitude <= 8 then
                local frame = descendant.CFrame
                local size = descendant.Size
                local right = frame.RightVector
                local up = frame.UpVector
                local look = frame.LookVector
                local halfX = (math.abs(right.X) * size.X + math.abs(up.X) * size.Y + math.abs(look.X) * size.Z) * 0.5
                local halfY = (math.abs(right.Y) * size.X + math.abs(up.Y) * size.Y + math.abs(look.Y) * size.Z) * 0.5
                local halfZ = (math.abs(right.Z) * size.X + math.abs(up.Z) * size.Y + math.abs(look.Z) * size.Z) * 0.5
                local low = Vector3.new(position.X - halfX, position.Y - halfY, position.Z - halfZ)
                local high = Vector3.new(position.X + halfX, position.Y + halfY, position.Z + halfZ)
                if not minimum then
                    minimum = low
                    maximum = high
                else
                    minimum = Vector3.new(math.min(minimum.X, low.X), math.min(minimum.Y, low.Y), math.min(minimum.Z, low.Z))
                    maximum = Vector3.new(math.max(maximum.X, high.X), math.max(maximum.Y, high.Y), math.max(maximum.Z, high.Z))
                end
            end
        end
    end
    if not minimum then
        local boundsFrame, boundsSize = model:GetBoundingBox()
        minimum = boundsFrame.Position - boundsSize * 0.5
        maximum = boundsFrame.Position + boundsSize * 0.5
    end
    return (minimum + maximum) * 0.5, maximum - minimum
end

local function fitViewerDistance(size, fieldOfView, aspect)
    local tangent = math.tan(math.rad(fieldOfView) * 0.5)
    local height = math.max(size.Y, 4) * 1.36
    local width = math.max(math.max(size.X, size.Z), 2.5) * 1.55
    local byHeight = (height * 0.5) / tangent
    local byWidth = (width * 0.5) / (tangent * math.max(aspect, 0.3))
    return math.max(byHeight, byWidth)
end

function Extensions.UpdateAvatarViewerCamera()
    local viewer = State.AvatarViewer
    local camera = viewer.PreviewCamera
    if not camera or not camera.Parent or not viewer.PreviewCenter or not viewer.Viewport then return end
    local viewportSize = viewer.Viewport.AbsoluteSize
    local aspect = viewportSize.Y > 0 and viewportSize.X / viewportSize.Y or 1
    local distance = fitViewerDistance(viewer.PreviewSize, camera.FieldOfView, aspect) * viewer.Zoom
    local rotation = CFrame.Angles(0, -viewer.PreviewYaw, 0) * CFrame.Angles(viewer.PreviewPitch, 0, 0)
    local offset = rotation * Vector3.new(0, 0, -distance)
    local focus = viewer.PreviewCenter - Vector3.new(0, viewer.PreviewSize.Y * 0.07, 0)
    camera.CFrame = CFrame.lookAt(focus + offset, focus)
    viewer.Viewport.LightDirection = camera.CFrame:VectorToWorldSpace(Vector3.new(0.38, -0.55, -1)).Unit
end

function Extensions.ResetAvatarViewerView()
    local viewer = State.AvatarViewer
    viewer.PreviewYaw = 0
    viewer.PreviewPitch = 0.08
