local function restoreCollisions()
    for part, canCollide in pairs(OriginalCollision) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = canCollide
            end)
        end
    end
    table.clear(OriginalCollision)
    State.NoclipTrackedCharacter = nil
end

function Extensions.TrackNoclipPart(part)
    if part and part:IsA("BasePart") and OriginalCollision[part] == nil then
        OriginalCollision[part] = part.CanCollide
    end
end

function Extensions.RebuildNoclipTracking(character)
    if State.NoclipTrackedCharacter ~= character then
        table.clear(OriginalCollision)
        State.NoclipTrackedCharacter = character
    end
    if not character then
        return
    end
    for _, descendant in ipairs(character:GetDescendants()) do
        Extensions.TrackNoclipPart(descendant)
    end
end

local function safeTeleport(targetCFrame)
    local character, _, root = getCharacter()
    if not character or not root or not targetCFrame then
        notify("Không thể dịch chuyển: nhân vật chưa sẵn sàng.", Theme.Danger)
        return false
    end
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        character:PivotTo(targetCFrame)
    end)
    return true
end

function Extensions.DestroyFlantPlatform()
    if State.FlantPlatform then
        State.FlantPlatform:Destroy()
        State.FlantPlatform = nil
    end
    local orphan = Workspace:FindFirstChild("Raphael_FlantPlatform")
    while orphan do
        orphan:Destroy()
        orphan = Workspace:FindFirstChild("Raphael_FlantPlatform")
    end
end

function Extensions.EnsureFlantPlatform()
    if State.FlantPlatform and State.FlantPlatform.Parent then
        return State.FlantPlatform
    end
    Extensions.DestroyFlantPlatform()
    local platform = Instance.new("Part")
    platform.Name = "Raphael_FlantPlatform"
    platform.Size = State.FlantSize
    platform.Anchored = true
    platform.CanCollide = true
    platform.CanQuery = false
    platform.CanTouch = false
    platform.CastShadow = false
    platform.Material = Enum.Material.ForceField
    platform.Color = Theme.Success
    platform.Transparency = 0.58
    platform:SetAttribute("RaphaelOwned", true)
    platform.Parent = Workspace
    State.FlantPlatform = platform
    return platform
end

function Extensions.SetFlantEnabled(enabled, silent)
    State.FlantEnabled = not not enabled
    if State.FlantEnabled then
        local _, _, root = getCharacter()
        if root and not State.FlantYConfigured then
            State.FlantY = math.floor((root.Position.Y - 3.5) * 10 + 0.5) / 10
        end
        Extensions.EnsureFlantPlatform()
    else
        Extensions.DestroyFlantPlatform()
    end
    local control = State.ConfigControls.FlantEnabled
    if control and control.Set then
        control.Set(State.FlantEnabled, false)
    end
    local yControl = State.ConfigControls.FlantY
    if yControl and yControl:IsA("TextBox") then
        yControl.Text = Extensions.FormatMovementNumber(State.FlantY)
    end
    if not silent then
        notify(State.FlantEnabled and ("Flant đã khóa sàn tại Y = " .. Extensions.FormatMovementNumber(State.FlantY)) or "Flant đã tắt.", State.FlantEnabled and Theme.Success or Theme.Warning)
    end
end

function Extensions.UpdateFlantPlatform(root)
    if not State.FlantEnabled or not root or not root.Parent then
        return
    end
    local platform = Extensions.EnsureFlantPlatform()
    platform.CFrame = CFrame.new(root.Position.X, State.FlantY, root.Position.Z)
    if root.Position.Y < State.FlantY + 2.4 then
        local velocity = root.AssemblyLinearVelocity
        root.CFrame = CFrame.new(root.Position.X, State.FlantY + 3.5, root.Position.Z) * (root.CFrame - root.Position)
        root.AssemblyLinearVelocity = Vector3.new(velocity.X, math.max(0, velocity.Y), velocity.Z)
    end
end

local function cancelActiveTravel()
    local activeTween = State.ActiveTravelTween
    State.ActiveTravelTween = nil
    if activeTween then
        pcall(function()
            activeTween:Cancel()
        end)
    end
end

local function travelToCFrame(targetCFrame, mode)
    if mode ~= "Fly" then
        cancelActiveTravel()
        return safeTeleport(targetCFrame)
    end

    local character, humanoid, root = getCharacter()
    if not character or not humanoid or not root then
        notify("Không thể bay: nhân vật chưa sẵn sàng.", Theme.Danger)
        return false
    end

    cancelActiveTravel()
    local collisionBackup = {}
    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") then
            collisionBackup[descendant] = descendant.CanCollide
            descendant.CanCollide = false
        end
    end

    local originalAutoRotate = humanoid.AutoRotate
    humanoid.AutoRotate = false
    humanoid.PlatformStand = true
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local distance = (root.Position - targetCFrame.Position).Magnitude
    local duration = math.clamp(distance / math.max(State.TravelSpeed, 1), 0.15, 35)
    local travelTween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})
    State.ActiveTravelTween = travelTween
    local completedConnection
    completedConnection = travelTween.Completed:Connect(function()
        if completedConnection then
            completedConnection:Disconnect()
        end
        if State.ActiveTravelTween == travelTween then
            State.ActiveTravelTween = nil
        end
        for part, canCollide in pairs(collisionBackup) do
            if part and part.Parent then
                part.CanCollide = canCollide
            end
        end
        if humanoid and humanoid.Parent then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = originalAutoRotate
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
    travelTween:Play()
    notify(string.format("Đang bay %.1f m với tốc độ %.0f stud/s.", distance * 0.28, State.TravelSpeed), Theme.Warning)
    return true
end

function Extensions.ResolveUniquePlayer(query, includeLocalPlayer)
    local normalized = string.lower((string.gsub(tostring(query or ""), "^%s*@?%s*(.-)%s*$", "%1")))
    if normalized == "" then
        return nil, "Empty", 0
    end
    local exactDisplayMatches = {}
    local prefixMatches = {}
    local partialMatches = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if includeLocalPlayer or player ~= LocalPlayer then
            local username = string.lower(player.Name)
            local displayName = string.lower(player.DisplayName)
            if username == normalized then
                return player, "Exact", 1
            elseif displayName == normalized then
                table.insert(exactDisplayMatches, player)
            end
            local prefix = string.sub(username, 1, #normalized) == normalized or string.sub(displayName, 1, #normalized) == normalized
            local partial = string.find(username, normalized, 1, true) or string.find(displayName, normalized, 1, true)
            if prefix then
                table.insert(prefixMatches, player)
            elseif partial then
                table.insert(partialMatches, player)
            end
        end
    end
    if #exactDisplayMatches == 1 then
        return exactDisplayMatches[1], "ExactDisplay", 1
    elseif #exactDisplayMatches > 1 then
        return nil, "Ambiguous", #exactDisplayMatches
    end
    local matches = #prefixMatches > 0 and prefixMatches or partialMatches
    if #matches == 1 then
        return matches[1], "Unique", 1
    elseif #matches > 1 then
        return nil, "Ambiguous", #matches
    end
    return nil, "Missing", 0
end

function Extensions.CompletePlayerSearchText(text, includeLocalPlayer)
    local trimmed = string.gsub(tostring(text or ""), "^%s*(.-)%s*$", "%1")
    if not State.SmartSearchEnabled or trimmed == "" then
        return trimmed, nil, "Disabled"
    end
    local player, status, count = Extensions.ResolveUniquePlayer(trimmed, includeLocalPlayer)
    return player and player.Name or trimmed, player, status, count
end

local function findPlayer(query)
    local player = Extensions.ResolveUniquePlayer(query, false)
    return player
end

local function setSpectating(player)
    Camera = Workspace.CurrentCamera or Camera
    if not player then
        State.SpectatingPlayer = nil
        local _, localHumanoid = getCharacter()
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = localHumanoid or OriginalCamera.Subject
        if State.SpectateButton and State.SpectateButton.Parent then
            State.SpectateButton.Text = "Bắt đầu theo dõi"
        end
        return true
    end

    local targetHumanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if not targetHumanoid then
        notify("Nhân vật cần theo dõi chưa sẵn sàng.", Theme.Warning)
        return false
    end

    State.SpectatingPlayer = player
    Camera.CameraType = Enum.CameraType.Custom
    Camera.CameraSubject = targetHumanoid
    if State.SpectateButton and State.SpectateButton.Parent then
        State.SpectateButton.Text = "Huỷ theo dõi " .. player.Name
    end
    return true
end

