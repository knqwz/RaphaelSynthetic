function Extensions.SaveRuntimeNote()
    local box = State.NoteBox
    local noteText = box and string.gsub(box.Text, "^%s*(.-)%s*$", "%1") or ""
    if noteText == "" then
        notify("Ghi chú đang trống.", Theme.Warning)
        return
    end
    if not writefile then
        if setclipboard and pcall(setclipboard, noteText) then
            notify("Executor không hỗ trợ file; nội dung đã được copy.", Theme.Warning)
        else
            notify("Executor không hỗ trợ lưu file hoặc clipboard.", Theme.Danger)
        end
        return
    end
    local mapName = game.Name
    local success, productInfo = pcall(MarketplaceService.GetProductInfo, MarketplaceService, game.PlaceId)
    if success and productInfo and productInfo.Name then
        mapName = productInfo.Name
    end
    mapName = string.gsub(tostring(mapName), "[^%w%-_]", "_")
    mapName = string.gsub(mapName, "_+", "_")
    local now = os.date("*t")
    local jobId = string.gsub(game.JobId ~= "" and game.JobId or "Studio", "[^%w]", "")
    local fileName = string.format("%02d%02d%02d_%02d%02d%04d_%s_P%d_J%s.txt", now.hour, now.min, now.sec, now.day, now.month, now.year, mapName, game.PlaceId, jobId)
    local folder = "Raphael_Notes"
    if isfolder and makefolder and not isfolder(folder) then
        pcall(makefolder, folder)
    end
    local path = folder .. "/" .. fileName
    local saved = pcall(writefile, path, noteText)
    notify(saved and ("Đã lưu ghi chú: " .. fileName) or "Không thể ghi file ghi chú.", saved and Theme.Success or Theme.Danger)
end

