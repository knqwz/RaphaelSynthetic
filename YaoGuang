function Extensions.ResetMobCandidateBuffer()
    local candidates = State.MobCandidateBuffer
    local pool = State.MobCandidatePool
    for index = #candidates, 1, -1 do
        local candidate = candidates[index]
        candidate.Model = nil
        candidate.Data = nil
        candidate.Root = nil
        candidates[index] = nil
        pool[#pool + 1] = candidate
    end
end

function Extensions.InsertMobCandidate(model, classification, root, distanceSquared, limit)
    local candidates = State.MobCandidateBuffer
    local count = #candidates
    if limit <= 0 or count >= limit and distanceSquared >= candidates[count].DistanceSquared then
        return
    end
    local candidate
    if count >= limit then
        candidate = candidates[count]
    else
        local pool = State.MobCandidatePool
        candidate = pool[#pool]
        if candidate then
            pool[#pool] = nil
        else
            candidate = {}
        end
        count = count + 1
    end
    local insertIndex = count
    while insertIndex > 1 and candidates[insertIndex - 1].DistanceSquared > distanceSquared do
        candidates[insertIndex] = candidates[insertIndex - 1]
        insertIndex = insertIndex - 1
    end
    candidate.Model = model
    candidate.Data = classification
    candidate.Root = root
    candidate.DistanceSquared = distanceSquared
    candidates[insertIndex] = candidate
end

