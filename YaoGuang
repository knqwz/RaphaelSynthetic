    connect(UserInputService.InputChanged, function(input)
        local drag = minimap.Drag
        if not drag then return end
        local matches = drag.IsMouse and input.UserInputType == Enum.UserInputType.MouseMovement or (not drag.IsMouse and input == drag.Input)
        if not matches then return end
        local delta = input.Position - drag.StartInput
        local parentSize = Overlay.AbsoluteSize
        local startX = drag.StartPosition.X.Scale * parentSize.X + drag.StartPosition.X.Offset
        local startY = drag.StartPosition.Y.Scale * parentSize.Y + drag.StartPosition.Y.Offset
        local x = math.clamp(startX + delta.X, 0, math.max(parentSize.X - panel.AbsoluteSize.X, 0))
        local y = math.clamp(startY + delta.Y, 0, math.max(parentSize.Y - panel.AbsoluteSize.Y, 0))
        panel.Position = UDim2.fromOffset(x, y)
    end)
    connect(UserInputService.InputEnded, function(input)
        local drag = minimap.Drag
        if not drag then return end
        if (drag.IsMouse and input.UserInputType == Enum.UserInputType.MouseButton1) or (not drag.IsMouse and input == drag.Input) then
            minimap.Position.XScale = panel.Position.X.Scale
            minimap.Position.XOffset = panel.Position.X.Offset
            minimap.Position.YScale = panel.Position.Y.Scale
            minimap.Position.YOffset = panel.Position.Y.Offset
            minimap.Drag = nil
        end
    end)
