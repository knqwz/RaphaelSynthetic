createButton(CoordinateTeleSection, "Tele đến toạ độ", function()
    local coordinates = {}
    for numberText in string.gmatch(CoordinateTeleportText, "[-+]?%d*%.?%d+") do
        table.insert(coordinates, tonumber(numberText))
        if #coordinates >= 3 then
            break
        end
    end
