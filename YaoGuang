function Extensions.ApplyConfig(config, silent)
    if type(config) ~= "table" then
        if not silent then notify("Config không hợp lệ.", Theme.Danger) end
        return false
    end

    Extensions.SetAimbotEnabled(false, nil, true)
    Extensions.SetGodModeEnabled(false, true)
    Extensions.SetFlantEnabled(false, true)
    resetSpeedSideEffects()
    Extensions.ResetJumpSideEffects()

    local function booleanValue(source, key, fallback)
        if type(source[key]) == "boolean" then
            return source[key]
        end
        return fallback
    end
    local function allowed(value, options, fallback)
        return table.find(options, value) and value or fallback
    end

    local movement = type(config.Movement) == "table" and config.Movement or {}
    State.SpeedEnabled = booleanValue(movement, "SpeedEnabled", false)
    State.SpeedValue = math.clamp(tonumber(movement.SpeedValue) or State.SpeedValue, 0, 1000)
    State.SpeedMethod = allowed(movement.SpeedMethod, {"WalkSpeed", "Velocity", "CFrame"}, State.SpeedMethod)
    State.JumpEnabled = booleanValue(movement, "JumpEnabled", false)
    State.JumpValue = math.clamp(tonumber(movement.JumpValue) or State.JumpValue, 0, 1000)
    State.JumpMethod = allowed(movement.JumpMethod, {"JumpPower", "JumpHeight", "Velocity"}, State.JumpMethod)
    State.InfiniteJump = booleanValue(movement, "InfiniteJump", State.InfiniteJump)
    State.FlantEnabled = booleanValue(movement, "FlantEnabled", false)
    State.FlantY = math.clamp(tonumber(movement.FlantY) or State.FlantY, -100000, 100000)
    State.FlantYConfigured = booleanValue(movement, "FlantYConfigured", movement.FlantY ~= nil)
    State.Noclip = booleanValue(movement, "Noclip", State.Noclip)
    State.NoclipMethod = allowed(movement.NoclipMethod, {"Toàn thân", "Chỉ Root", "State + Parts"}, State.NoclipMethod)
    State.GravityEnabled = booleanValue(movement, "GravityEnabled", false)
    State.GravityValue = math.clamp(tonumber(movement.GravityValue) or State.GravityValue, 0, 1000)

    if type(config.Misc) == "table" then
        State.SmartSearchEnabled = booleanValue(config.Misc, "SmartSearch", State.SmartSearchEnabled)
    end

    local function applyESP(target, source, includeRadius)
        if type(source) ~= "table" then return end
        target.Enabled = booleanValue(source, "Enabled", target.Enabled)
        target.Tracer = booleanValue(source, "Tracer", target.Tracer)
        target.TracerOrigin = allowed(source.TracerOrigin, {"Trên", "Giữa", "Dưới"}, target.TracerOrigin)
        target.Box = booleanValue(source, "Box", target.Box)
        target.BoxMode = allowed(source.BoxMode, {"2D", "Skin"}, target.BoxMode)
        target.Name = booleanValue(source, "Name", target.Name)
        if target.Health ~= nil then
            target.Health = booleanValue(source, "Health", target.Health)
        end
        target.Distance = booleanValue(source, "Distance", target.Distance)
        if source.MaxDistanceMeters ~= nil then
            target.MaxDistanceMeters = math.clamp(tonumber(source.MaxDistanceMeters) or target.MaxDistanceMeters, 1, 10000)
        end
        if target.LookDirection ~= nil then
            target.LookDirection = booleanValue(source, "LookDirection", target.LookDirection)
            target.LookLength = math.clamp(tonumber(source.LookLength) or target.LookLength, 1, 500)
        end
        if includeRadius and source.RadiusMeters ~= nil then
            target.RadiusMeters = math.clamp(tonumber(source.RadiusMeters) or target.RadiusMeters, 1, 10000)
        end
    end
    applyESP(State.PlayerESP, config.PlayerESP, false)
    applyESP(State.MobESP, config.MobESP, false)
    applyESP(State.ItemESP, config.ItemESP, true)
    if type(config.PlayerESP) == "table" then
        State.PlayerESP.ManualFilterEnabled = booleanValue(config.PlayerESP, "ManualFilterEnabled", State.PlayerESP.ManualFilterEnabled)
        Extensions.ParsePlayerESPFilter(tostring(config.PlayerESP.ManualFilterText or State.PlayerESP.ManualFilterText or ""))
    end
    if type(config.MobESP) == "table" then
        State.MobESP.MaxTargets = math.clamp(tonumber(config.MobESP.MaxTargets) or State.MobESP.MaxTargets, 1, 150)
    end
    if type(config.ItemESP) == "table" then
        State.ItemESP.ExactName = tostring(config.ItemESP.ExactName or "")
    end
    local inspector = type(config.Inspector) == "table" and config.Inspector or {}
    State.Inspector.Enabled = booleanValue(inspector, "Enabled", State.Inspector.Enabled)
    State.Inspector.ScreenRadius = math.clamp(tonumber(inspector.ScreenRadius) or State.Inspector.ScreenRadius, 12, 120)

    local aimbot = type(config.Aimbot) == "table" and config.Aimbot or {}
    local applySavedAimbot = booleanValue(aimbot, "Enabled", false)
    State.Aimbot.Mode = allowed(aimbot.Mode, {"Silent Aim (Góc 3)", "Aim truyền thống (Góc 1)"}, State.Aimbot.Mode)
    State.Aimbot.TargetType = allowed(aimbot.TargetType, {"Player", "NPC"}, State.Aimbot.TargetType)
    State.Aimbot.FOVRadius = math.floor(math.clamp(tonumber(aimbot.FOVRadius) or State.Aimbot.FOVRadius, 30, 1000))
    State.Aimbot.AimPart = allowed(aimbot.AimPart, {"Đầu", "Thân"}, State.Aimbot.AimPart)
    State.Aimbot.WallCheck = booleanValue(aimbot, "WallCheck", State.Aimbot.WallCheck)
    State.Aimbot.TeamCheck = booleanValue(aimbot, "TeamCheck", State.Aimbot.TeamCheck)
    State.Aimbot.StickyEnabled = booleanValue(aimbot, "StickyEnabled", State.Aimbot.StickyEnabled)
    State.Aimbot.StickyUsername = Extensions.CompletePlayerSearchText(tostring(aimbot.StickyUsername or State.Aimbot.StickyUsername or ""), false)
    State.Aimbot.StickyPlayer = nil
    Extensions.ParseAimbotBlacklist(tostring(aimbot.BlacklistText or State.Aimbot.BlacklistText or ""))
