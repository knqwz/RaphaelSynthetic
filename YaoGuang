function Extensions.RefreshUniversalScanWork(now: number, localRoot: any)
    local runtimeState: any = State
    runtimeState.ESPGeneration.Scan = (tonumber(runtimeState.ESPGeneration.Scan) or 0) + 1
    local generation: number = runtimeState.ESPGeneration.Scan
    local seen: any = runtimeState.ESPSeen.Scan
    local cache: any = runtimeState.UniversalScan.Cache
    local resolveRoot: any = getAdorneeRoot
    local target: any, cachedRoot: any = next(cache)
    while target do
        local nextTarget: any, nextCachedRoot: any = next(cache, target)
        if target.Parent and target:IsDescendantOf(Workspace) then
            local root: any = cachedRoot and cachedRoot.Parent and cachedRoot or resolveRoot(target)
            if root then
                cache[target] = root
                seen[target] = generation
                local rootPosition: any = root.Position
                local localPosition: any = localRoot.Position
                local deltaX: number = (tonumber(rootPosition.X) or 0) - (tonumber(localPosition.X) or 0)
                local deltaY: number = (tonumber(rootPosition.Y) or 0) - (tonumber(localPosition.Y) or 0)
                local deltaZ: number = (tonumber(rootPosition.Z) or 0) - (tonumber(localPosition.Z) or 0)
                local distance: number = math.sqrt(deltaX * deltaX + deltaY * deltaY + deltaZ * deltaZ)
                updateVisual("Scan", target, target, root, tostring(target.Name), nil, nil, distance)
            end
        else
            cache[target] = nil
        end
        target, cachedRoot = nextTarget, nextCachedRoot
    end
    local scanVisuals: any = Visuals.Scan
    local visual: any
    target, visual = next(scanVisuals)
    while target do
        local nextTarget: any, nextVisual: any = next(scanVisuals, target)
        if seen[target] ~= generation then Extensions.ReleaseVisual("Scan", target, visual) end
        target, visual = nextTarget, nextVisual
    end
end

