function Extensions.UpdateDynamicVisual(visual)
    if not visual.Active then
        setDrawingVisible(visual.Box, false)
        setDrawingVisible(visual.Tracer, false)
        setDrawingVisible(visual.LookLine, false)
        if visual.InfoBillboard and visual.InfoBillboard.Enabled then
            visual.InfoBillboard.Enabled = false
        end
        if visual.LookBeam and visual.LookBeam.Enabled then
            visual.LookBeam.Enabled = false
        end
        return
    end

    local target = visual.Target
    local root = visual.Root
    if not target or not target.Parent or not root or not root.Parent then
        visual.Active = false
        hideVisual(visual)
        return
    end

    local config = getCategoryConfig(visual.Category)
    local espEnabled = config.Enabled and visual.ESPPermitted ~= false
    Camera = Workspace.CurrentCamera or Camera
    local projected, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen or projected.Z <= 0 then
        setDrawingVisible(visual.Box, false)
        setDrawingVisible(visual.Tracer, false)
        setDrawingVisible(visual.LookLine, false)
        if visual.InfoBillboard and visual.InfoBillboard.Enabled then
            visual.InfoBillboard.Enabled = false
        end
        if visual.LookBeam and visual.LookBeam.Enabled then
            visual.LookBeam.Enabled = false
        end
        return
    end

    if visual.InfoBillboard then
        local infoAnchor = visual.InfoAnchor
        local infoVisible = visual.InfoEnabled and infoAnchor and infoAnchor.Parent ~= nil
        if infoVisible and visual.InfoBillboard.Adornee ~= infoAnchor then
            visual.InfoBillboard.Adornee = infoAnchor
        end
        if visual.InfoBillboard.Enabled ~= not not infoVisible then
            visual.InfoBillboard.Enabled = not not infoVisible
        end
    end

    local screenPosition = Vector2.new(projected.X, projected.Y)
    local boxVisible = visual.Box ~= nil and espEnabled and config.Box and config.BoxMode == "2D"
    if boxVisible then
        local cameraDistance = math.max(projected.Z, 1)
        local scale = visual.Category == "Item" and 850 or 1200
        local width = math.clamp(scale / cameraDistance, 12, 320)
        local height = visual.Category == "Item" and width or width * 1.4
        local centerY = root.Name == "Head" and visual.Category ~= "Item" and screenPosition.Y + height * 0.34 or screenPosition.Y
        visual.Box.Size = Vector2.new(width, height)
        visual.Box.Position = Vector2.new(screenPosition.X - width * 0.5, centerY - height * 0.5)
    end
    setDrawingVisible(visual.Box, boxVisible)

    local tracerVisible = visual.Tracer ~= nil and espEnabled and config.Tracer
    if tracerVisible then
        visual.Tracer.From = Extensions.GetTracerOriginPoint(config)
        visual.Tracer.To = screenPosition
    end
    setDrawingVisible(visual.Tracer, tracerVisible)

    local lookPart = visual.InfoAnchor or root
    local lookEnabled = espEnabled and visual.Category ~= "Item" and config.LookDirection and lookPart and lookPart:IsA("BasePart")
    local lookLineVisible = false
    if lookEnabled and visual.LookLine then
        local startWorld = lookPart.Position + Vector3.new(0, lookPart.Size.Y * 0.55 + 0.15, 0)
        local endWorld = startWorld + lookPart.CFrame.LookVector * config.LookLength
        local startPoint = Camera:WorldToViewportPoint(startWorld)
        local endPoint = Camera:WorldToViewportPoint(endWorld)
        lookLineVisible = startPoint.Z > 0 and endPoint.Z > 0
        if lookLineVisible then
            visual.LookLine.From = Vector2.new(startPoint.X, startPoint.Y)
            visual.LookLine.To = Vector2.new(endPoint.X, endPoint.Y)
        end
    end
    setDrawingVisible(visual.LookLine, lookLineVisible)

    local beamVisible = false
    if lookEnabled and not visual.LookLine then
        if visual.LookAdornee ~= lookPart or not visual.LookBeam or not visual.LookBeam.Parent then
            if visual.LookBeam then visual.LookBeam:Destroy() end
            if visual.LookStart then visual.LookStart:Destroy() end
            if visual.LookEnd then visual.LookEnd:Destroy() end
            visual.LookStart = Instance.new("Attachment")
            visual.LookEnd = Instance.new("Attachment")
            visual.LookBeam = Instance.new("Beam")
            visual.LookStart.Name = "RaphaelLookStart"
            visual.LookEnd.Name = "RaphaelLookEnd"
            visual.LookBeam.Name = "RaphaelLookDirection"
            visual.LookStart:SetAttribute("RaphaelOwned", true)
            visual.LookEnd:SetAttribute("RaphaelOwned", true)
            visual.LookBeam:SetAttribute("RaphaelOwned", true)
            visual.LookStart.Parent = lookPart
            visual.LookEnd.Parent = lookPart
            visual.LookBeam.Attachment0 = visual.LookStart
            visual.LookBeam.Attachment1 = visual.LookEnd
            visual.LookBeam.FaceCamera = true
            visual.LookBeam.Width0 = 0.07
            visual.LookBeam.Width1 = 0.035
            visual.LookBeam.LightEmission = 1
            visual.LookBeam.Segments = 1
            visual.LookBeam.Parent = lookPart
            visual.LookAdornee = lookPart
        end
        local verticalOffset = lookPart.Size.Y * 0.55 + 0.15
        visual.LookStart.Position = Vector3.new(0, verticalOffset, 0)
        visual.LookEnd.Position = Vector3.new(0, verticalOffset, -config.LookLength)
        visual.LookBeam.Color = ColorSequence.new(config.Color)
        beamVisible = true
    end
    if visual.LookBeam and visual.LookBeam.Enabled ~= beamVisible then
        visual.LookBeam.Enabled = beamVisible
    end
end

