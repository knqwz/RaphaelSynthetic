function Extensions.SetCharacterFlyEnabled(enabled, silent)
    local flight = State.Flight
    enabled = not not enabled
    if enabled and flight.CameraEnabled then
        Extensions.SetFreecamEnabled(false, true)
    end
    local character, humanoid, root = getCharacter()
    if enabled and (not character or not humanoid or not root) then
        if not silent then notify("Không thể bật Fly: nhân vật chưa sẵn sàng.", Theme.Danger) end
        return false
    end
    if enabled == flight.CharacterEnabled then
        Extensions.UpdateFlightControlVisibility()
        return true
    end
    if enabled then
        flight.SavedAutoRotate = humanoid.AutoRotate
        flight.SavedAnchored = root.Anchored
        humanoid.AutoRotate = false
        humanoid.PlatformStand = true
        root.Anchored = false
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        flight.CharacterEnabled = true
    else
        flight.CharacterEnabled = false
        if root then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if flight.SavedAnchored ~= nil then root.Anchored = flight.SavedAnchored end
        end
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = flight.SavedAutoRotate ~= false
            pcall(humanoid.ChangeState, humanoid, Enum.HumanoidStateType.GettingUp)
        end
        flight.SavedAutoRotate = nil
        flight.SavedAnchored = nil
        Extensions.ResetFlightInput()
    end
    Extensions.UpdateFlightControlVisibility()
    local control = State.ConfigControls.CharacterFlyEnabled
    if control and control.Set then control.Set(flight.CharacterEnabled, false) end
    if not silent then
        notify(flight.CharacterEnabled and "Fly đã bật; Fly Cam đã được khóa loại trừ." or "Fly đã tắt và chuyển động được khôi phục.", flight.CharacterEnabled and Theme.Success or Theme.Warning)
    end
    return true
end

function Extensions.SetFreecamEnabled(enabled, silent)
    local flight = State.Flight
    enabled = not not enabled
    if enabled and flight.CharacterEnabled then
        Extensions.SetCharacterFlyEnabled(false, true)
    end
    Camera = Workspace.CurrentCamera or Camera
    local _, humanoid, root = getCharacter()
    if enabled and (not Camera or not humanoid or not root) then
        if not silent then notify("Không thể bật Fly Cam: camera hoặc nhân vật chưa sẵn sàng.", Theme.Danger) end
        return false
    end
    if enabled == flight.CameraEnabled then
        Extensions.UpdateFlightControlVisibility()
        return true
    end
    if enabled then
        flight.SavedCameraType = Camera.CameraType
        flight.SavedCameraSubject = Camera.CameraSubject
        flight.SavedWalkSpeed = humanoid.WalkSpeed
        flight.SavedJumpPower = humanoid.JumpPower
        flight.SavedAutoRotate = humanoid.AutoRotate
        flight.SavedAnchored = root.Anchored
        flight.CameraPosition = Camera.CFrame.Position
        flight.CameraYaw = math.atan2(-Camera.CFrame.LookVector.X, -Camera.CFrame.LookVector.Z)
        flight.CameraPitch = math.asin(math.clamp(Camera.CFrame.LookVector.Y, -1, 1))
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0
        humanoid.AutoRotate = false
        root.Anchored = true
        Camera.CameraType = Enum.CameraType.Scriptable
        Camera.CameraSubject = nil
        flight.CameraEnabled = true
    else
        flight.CameraEnabled = false
        if root and flight.SavedAnchored ~= nil then root.Anchored = flight.SavedAnchored end
        if humanoid then
            if flight.SavedWalkSpeed then humanoid.WalkSpeed = flight.SavedWalkSpeed end
            if flight.SavedJumpPower then humanoid.JumpPower = flight.SavedJumpPower end
            humanoid.AutoRotate = flight.SavedAutoRotate ~= false
        end
        Camera.CameraType = flight.SavedCameraType or Enum.CameraType.Custom
        Camera.CameraSubject = flight.SavedCameraSubject or humanoid
        flight.SavedCameraType = nil
        flight.SavedCameraSubject = nil
        flight.SavedWalkSpeed = nil
        flight.SavedJumpPower = nil
        flight.SavedAutoRotate = nil
        flight.SavedAnchored = nil
        Extensions.ResetFlightInput()
    end
    Extensions.UpdateFlightControlVisibility()
    local control = State.ConfigControls.FreecamEnabled
    if control and control.Set then control.Set(flight.CameraEnabled, false) end
    if not silent then
        notify(flight.CameraEnabled and "Fly Cam đã bật; Fly nhân vật đã được khóa loại trừ." or "Fly Cam đã tắt và camera được khôi phục.", flight.CameraEnabled and Theme.Success or Theme.Warning)
    end
    return true
end

function Extensions.GetFlightMoveInput()
    local flight = State.Flight
    local x = flight.MoveInput.X
    local z = flight.MoveInput.Z
    local y = flight.VerticalInput
    if State.IsDesktop and not UserInputService:GetFocusedTextBox() then
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then x = x - 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then x = x + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then z = z + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then z = z - 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then y = y + 1 end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then y = y - 1 end
    end
    local result = Vector3.new(x, y, z)
    return result.Magnitude > 1 and result.Unit or result
end

function Extensions.UpdateFlight(deltaTime)
    local flight = State.Flight
    if not flight.CharacterEnabled and not flight.CameraEnabled then
        return
    end
    Camera = Workspace.CurrentCamera or Camera
    local input = Extensions.GetFlightMoveInput()
    if flight.CameraEnabled then
        local rotation = CFrame.fromOrientation(flight.CameraPitch, flight.CameraYaw, 0)
        local direction = rotation.LookVector * input.Z + rotation.RightVector * input.X + Vector3.new(0, input.Y, 0)
        if direction.Magnitude > 1 then direction = direction.Unit end
        flight.CameraPosition = flight.CameraPosition + direction * flight.CameraSpeed * math.max(deltaTime, 0)
        Camera.CFrame = CFrame.new(flight.CameraPosition) * rotation
        return
    end
    local _, humanoid, root = getCharacter()
    if not humanoid or not root then
        Extensions.SetCharacterFlyEnabled(false, true)
        return
    end
    local look = Camera.CFrame.LookVector
    if look.Magnitude < 0.001 then look = Vector3.new(0, 0, -1) else look = look.Unit end
    local right = Camera.CFrame.RightVector
    if right.Magnitude < 0.001 then right = Vector3.new(1, 0, 0) else right = right.Unit end
    local direction = look * input.Z + right * input.X + Vector3.new(0, input.Y, 0)
    if direction.Magnitude > 1 then direction = direction.Unit end
    humanoid.PlatformStand = true
    root.CFrame = CFrame.lookAt(root.Position, root.Position + look, Camera.CFrame.UpVector)
    root.AssemblyLinearVelocity = direction * flight.CharacterSpeed
    root.AssemblyAngularVelocity = Vector3.zero
end

connect(UserInputService.InputBegan, function(input, processed)
    local flight = State.Flight
    if not State.Running or not (flight.CharacterEnabled or flight.CameraEnabled) then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        flight.RightMouseDown = true
        return
    end
    if processed or input.UserInputType ~= Enum.UserInputType.Touch or not flight.JoystickBase then return end
    local point = Vector2.new(input.Position.X, input.Position.Y)
    local center = flight.JoystickBase.AbsolutePosition + flight.JoystickBase.AbsoluteSize * 0.5
    if (point - center).Magnitude <= 86 then
        flight.JoystickInput = input
        local offset = point - center
        if offset.Magnitude > 41 then offset = offset.Unit * 41 end
        flight.MoveInput = Vector3.new(offset.X / 41, 0, -offset.Y / 41)
        flight.JoystickThumb.Position = UDim2.new(0.5, offset.X - 25, 0.5, offset.Y - 25)
    elseif flight.CameraEnabled and point.X > Camera.ViewportSize.X * 0.5 then
        flight.LookInput = input
        flight.LookLastPosition = point
    end
end)

connect(UserInputService.InputChanged, function(input)
    local flight = State.Flight
    if not State.Running or not (flight.CharacterEnabled or flight.CameraEnabled) then return end
    if input == flight.JoystickInput then
        local point = Vector2.new(input.Position.X, input.Position.Y)
        local center = flight.JoystickBase.AbsolutePosition + flight.JoystickBase.AbsoluteSize * 0.5
        local offset = point - center
        if offset.Magnitude > 41 then offset = offset.Unit * 41 end
        flight.MoveInput = Vector3.new(offset.X / 41, 0, -offset.Y / 41)
        flight.JoystickThumb.Position = UDim2.new(0.5, offset.X - 25, 0.5, offset.Y - 25)
    elseif input == flight.LookInput and flight.CameraEnabled then
        local point = Vector2.new(input.Position.X, input.Position.Y)
        if flight.LookLastPosition then
            local delta = point - flight.LookLastPosition
            flight.CameraYaw = flight.CameraYaw - math.rad(delta.X * 0.4)
            flight.CameraPitch = math.clamp(flight.CameraPitch - math.rad(delta.Y * 0.4), math.rad(-85), math.rad(85))
        end
        flight.LookLastPosition = point
    elseif input.UserInputType == Enum.UserInputType.MouseMovement and flight.CameraEnabled and flight.RightMouseDown then
        flight.CameraYaw = flight.CameraYaw - input.Delta.X * 0.0035
        flight.CameraPitch = math.clamp(flight.CameraPitch - input.Delta.Y * 0.0035, math.rad(-85), math.rad(85))
    end
end)

connect(UserInputService.InputEnded, function(input)
    local flight = State.Flight
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        flight.RightMouseDown = false
    elseif input == flight.JoystickInput then
        flight.JoystickInput = nil
        flight.MoveInput = Vector3.zero
        if flight.JoystickThumb and flight.JoystickThumb.Parent then
            flight.JoystickThumb.Position = UDim2.new(0.5, -25, 0.5, -25)
        end
    elseif input == flight.LookInput then
        flight.LookInput = nil
        flight.LookLastPosition = nil
    end
end)

function Extensions.HasVisionObstructionHint(instance)
    local current = instance
    local depth = 0
    while current and depth < 5 do
        local lowerName = string.lower(current.Name)
        for _, hint in ipairs(State.VisionObstructionHints) do
            if string.find(lowerName, hint, 1, true) then
                return true
            end
        end
        current = current.Parent
        depth = depth + 1
    end
    return false
end

local function captureEffect(instance)
    if EffectBackup[instance] then
        return
    end
    if instance:IsA("PostEffect") then
        EffectBackup[instance] = {Type = "PostEffect", Enabled = instance.Enabled}
    elseif instance:IsA("Atmosphere") then
        EffectBackup[instance] = {
            Type = "Atmosphere",
            Density = instance.Density,
            Haze = instance.Haze,
            Glare = instance.Glare,
            Offset = instance.Offset,
            Color = instance.Color,
            Decay = instance.Decay
        }
    elseif instance:IsA("Clouds") then
        EffectBackup[instance] = {
            Type = "Clouds",
            Cover = instance.Cover,
            Density = instance.Density,
            Color = instance.Color
        }
    elseif instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Smoke") then
        EffectBackup[instance] = {Type = "EnabledEffect", Enabled = instance.Enabled}
    elseif instance:IsA("LayerCollector") then
        EffectBackup[instance] = {Type = "LayerCollector", Enabled = instance.Enabled}
    elseif instance:IsA("GuiObject") then
        EffectBackup[instance] = {Type = "GuiObject", Visible = instance.Visible}
    end
end

local function suppressEffect(instance)
    if not instance or instance:GetAttribute("RaphaelOwned") then
        return
    end
    local alwaysSuppress = instance:IsA("PostEffect") or instance:IsA("Atmosphere") or instance:IsA("Clouds")
    local cameraEffect = Camera and instance:IsDescendantOf(Camera) and (instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Smoke"))
    local hinted = Extensions.HasVisionObstructionHint(instance)
    local worldEffect = hinted and (instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Smoke"))
    local guiEffect = hinted and (instance:IsA("LayerCollector") or instance:IsA("GuiObject")) and not instance:IsDescendantOf(ScreenGui)
    if not alwaysSuppress and not cameraEffect and not worldEffect and not guiEffect then
        return
    end
    captureEffect(instance)
    pcall(function()
        if instance:IsA("PostEffect") then
            instance.Enabled = false
        elseif instance:IsA("Atmosphere") then
            instance.Density = 0
            instance.Haze = 0
            instance.Glare = 0
            instance.Offset = 0
            instance.Color = Color3.fromRGB(255, 255, 255)
            instance.Decay = Color3.fromRGB(255, 255, 255)
        elseif instance:IsA("Clouds") then
            instance.Cover = 0
            instance.Density = 0
        elseif instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Smoke") then
            instance.Enabled = false
        elseif instance:IsA("LayerCollector") then
            instance.Enabled = false
        elseif instance:IsA("GuiObject") then
            instance.Visible = false
        end
    end)
end

function Extensions.DeepSuppressVision()
    if State.VisionDeepScanRunning or not State.RemoveEffects then
        return
    end
    State.VisionDeepScanRunning = true
    State.LastVisionDeepScan = os.clock()

    for _, instance in ipairs(Lighting:GetDescendants()) do
        if not State.RemoveEffects then break end
        suppressEffect(instance)
    end

    Camera = Workspace.CurrentCamera or Camera
    if State.RemoveEffects and Camera then
        for _, instance in ipairs(Camera:GetDescendants()) do
            suppressEffect(instance)
        end
    end

    local workspaceDescendants = Workspace:GetDescendants()
    for index, instance in ipairs(workspaceDescendants) do
        if not State.RemoveEffects then
            break
        end
        if instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("Smoke") then
            suppressEffect(instance)
        end
        if index % 300 == 0 then
            task.wait()
        end
    end

    local guiDescendants = PlayerGui:GetDescendants()
    for index, instance in ipairs(guiDescendants) do
        if not State.RemoveEffects then
            break
        end
        if instance:IsA("LayerCollector") or instance:IsA("GuiObject") then
            suppressEffect(instance)
        end
        if index % 200 == 0 then
            task.wait()
        end
    end
    State.VisionDeepScanRunning = false
end

local function applyNoEffects()
    if Lighting.FogStart ~= 1000000 then Lighting.FogStart = 1000000 end
    if Lighting.FogEnd ~= 1000000 then Lighting.FogEnd = 1000000 end
    if Lighting.FogColor ~= Color3.fromRGB(255, 255, 255) then Lighting.FogColor = Color3.fromRGB(255, 255, 255) end
    if Lighting.ColorShift_Top ~= Color3.fromRGB(0, 0, 0) then Lighting.ColorShift_Top = Color3.fromRGB(0, 0, 0) end
    if Lighting.ColorShift_Bottom ~= Color3.fromRGB(0, 0, 0) then Lighting.ColorShift_Bottom = Color3.fromRGB(0, 0, 0) end
    if Lighting.ShadowSoftness ~= 0 then Lighting.ShadowSoftness = 0 end
end

local function restoreEffects()
    for instance, values in pairs(EffectBackup) do
        if instance and instance.Parent then
            pcall(function()
                if values.Type == "PostEffect" then
                    instance.Enabled = values.Enabled
                elseif values.Type == "Atmosphere" then
                    instance.Density = values.Density
                    instance.Haze = values.Haze
                    instance.Glare = values.Glare
                    instance.Offset = values.Offset
                    instance.Color = values.Color
                    instance.Decay = values.Decay
                elseif values.Type == "Clouds" then
                    instance.Cover = values.Cover
                    instance.Density = values.Density
                    instance.Color = values.Color
                elseif values.Type == "EnabledEffect" then
                    instance.Enabled = values.Enabled
                elseif values.Type == "LayerCollector" then
                    instance.Enabled = values.Enabled
                elseif values.Type == "GuiObject" then
                    instance.Visible = values.Visible
                end
            end)
            if State.FPSBoostApplied then
                Extensions.ApplyFPSOptimization(instance)
            end
        end
    end
    table.clear(EffectBackup)
    Lighting.FogStart = OriginalLighting.FogStart
    Lighting.FogEnd = OriginalLighting.FogEnd
    Lighting.FogColor = OriginalLighting.FogColor
end

local function applyFullBright()
    if State.FullBrightLevel == nil then
        return
    end
    local exposure = math.clamp(State.FullBrightLevel * 0.2, 0, 5)
    if Lighting.Brightness ~= State.FullBrightLevel then Lighting.Brightness = State.FullBrightLevel end
    if Lighting.Ambient ~= Color3.fromRGB(255, 255, 255) then Lighting.Ambient = Color3.fromRGB(255, 255, 255) end
    if Lighting.OutdoorAmbient ~= Color3.fromRGB(255, 255, 255) then Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255) end
    if Lighting.ColorShift_Top ~= Color3.fromRGB(0, 0, 0) then Lighting.ColorShift_Top = Color3.fromRGB(0, 0, 0) end
    if Lighting.ColorShift_Bottom ~= Color3.fromRGB(0, 0, 0) then Lighting.ColorShift_Bottom = Color3.fromRGB(0, 0, 0) end
    if Lighting.ShadowSoftness ~= 0 then Lighting.ShadowSoftness = 0 end
    if Lighting.GlobalShadows then Lighting.GlobalShadows = false end
    if Lighting.ExposureCompensation ~= exposure then Lighting.ExposureCompensation = exposure end
    if Lighting.EnvironmentDiffuseScale ~= 1 then Lighting.EnvironmentDiffuseScale = 1 end
    if Lighting.EnvironmentSpecularScale ~= 1 then Lighting.EnvironmentSpecularScale = 1 end
end

