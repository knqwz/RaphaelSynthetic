scanItems = function(forceNotification)
    if State.ItemScanRunning then
        return 0
    end
    State.ItemScanRunning = true
    Extensions.ParseItemSearchTerms(State.ItemESP.ExactName)
    local found = State.ItemFoundBuffer
    table.clear(found)
    local foundCount = 0
    local totalMatches = 0

    if #State.ItemESP.SearchTerms > 0 then
        local descendants = Workspace:GetDescendants()
        for index, instance in ipairs(descendants) do
            if Extensions.IsItemSearchMatch(instance) and not isCharacterDescendant(instance) then
                totalMatches = totalMatches + 1
                if foundCount < State.ItemESP.MaxTargets then
                    found[instance] = true
                    foundCount = foundCount + 1
                end
            end
            if index % 180 == 0 then
                RunService.Heartbeat:Wait()
            end
        end
        table.clear(descendants)
    end

    for item in pairs(ItemCache) do
