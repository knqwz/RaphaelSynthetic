function Extensions.DetectSearchKind(name, description, target)
    if description == "Công tắc bật hoặc tắt" then return "toggle" end
    if description == "Nút thực thi" then return "button" end
    if target and target:GetAttribute("RaphaelSearchSection") == name then return "section" end
    if target and (target:IsA("TextBox") or target:FindFirstChildOfClass("TextBox")) then return "input" end
    return "selector"
end

function Extensions.RegisterFunctionSearch(name, description, target)
    if not target then
        return
    end
    local current = target
    local pageName
    local sectionName
    while current do
        if not sectionName then
            sectionName = current:GetAttribute("RaphaelSearchSection")
        end
        if current:IsA("ScrollingFrame") then
            pageName = string.match(current.Name, "^(.-)Page$")
            if pageName then
                break
            end
        end
        current = current.Parent
    end
    if not pageName then
        return
    end
    sectionName = tostring(sectionName or pageName)
    local nameText = Extensions.NormalizeSearchText(name)
    local sectionText = Extensions.NormalizeSearchText(sectionName)
    local haystack = nameText .. " " .. sectionText
    local aliasParts = {}
    for _, rule in ipairs(Extensions.SearchAliasRules) do
        if string.find(haystack, rule[1], 1, true) then
            aliasParts[#aliasParts + 1] = rule[2]
        end
    end
    local kind = Extensions.DetectSearchKind(tostring(name or ""), tostring(description or ""), target)
    table.insert(State.FunctionSearchEntries, {
        Name = tostring(name or "Chức năng"),
        Description = tostring(description or ""),
        Page = pageName,
        Section = sectionName,
        Target = target,
        Kind = kind,
        NameText = nameText,
        SearchText = Extensions.NormalizeSearchText(tostring(description or "")) .. " " .. haystack .. " " .. Extensions.NormalizeSearchText(pageName) .. " " .. table.concat(aliasParts, " ")
    })
end

function Extensions.RankSearchEntries(normalized, limit)
    local tokens = {}
    for token in string.gmatch(normalized, "%S+") do
        tokens[#tokens + 1] = token
    end
    local matches = {}
    for _, entry in ipairs(State.FunctionSearchEntries) do
        local target = entry.Target
        if target and target.Parent then
            local score = 0
            local allFound = true
            for _, token in ipairs(tokens) do
                local inName = string.find(entry.NameText, token, 1, true)
                if inName then
                    if inName == 1 then
                        score = score + 0
                    elseif string.sub(entry.NameText, inName - 1, inName - 1) == " " then
                        score = score + 2
                    else
                        score = score + 4
                    end
                elseif string.find(entry.SearchText, token, 1, true) then
                    score = score + 12
                else
                    allFound = false
                    break
                end
            end
            if allFound then
                if entry.NameText == normalized then score = score - 6 end
                if entry.Kind == "section" then score = score - 0.5 end
                score = score + #entry.NameText * 0.01
                matches[#matches + 1] = {Entry = entry, Score = score}
            end
        end
    end
    table.sort(matches, function(left, right)
        if left.Score == right.Score then
            if left.Entry.Name == right.Entry.Name then
                return (left.Entry.Section or left.Entry.Page) < (right.Entry.Section or right.Entry.Page)
            end
            return left.Entry.Name < right.Entry.Name
        end
        return left.Score < right.Score
    end)
    local result = {}
    for index = 1, math.min(#matches, limit or 8) do
        result[index] = matches[index].Entry
    end
    return result, #matches
end

local function formatDuration(totalSeconds)
    local seconds = math.max(0, math.floor(totalSeconds))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local remaining = seconds % 60
    return string.format("%02d:%02d:%02d", hours, minutes, remaining)
end

