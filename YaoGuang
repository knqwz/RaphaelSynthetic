function Extensions.StopBoombox(silent)
    local boombox = State.Boombox
    boombox.Generation = boombox.Generation + 1
    local sound = boombox.Sound
    boombox.Sound = nil
    boombox.Playing = false
    if sound then
        pcall(function() sound:Stop() end)
        pcall(function() sound:Destroy() end)
    end
    Extensions.RefreshBoomboxButton()
    if not silent then notify("Boombox đã dừng.", Theme.Warning) end
    return true
end

function Extensions.ToggleBoombox()
    local boombox = State.Boombox
    if boombox.Playing then return Extensions.StopBoombox(false) end
    local raw = boombox.Input and boombox.Input.Text or boombox.AssetId
    raw = string.gsub(tostring(raw or ""), "^%s*(.-)%s*$", "%1")
    local assetId = string.match(raw, "%d+")
    if not assetId or (tonumber(assetId) or 0) <= 0 then
        notify("Hãy nhập Asset ID âm thanh hợp lệ.", Theme.Warning)
        return false
    end
    boombox.AssetId = assetId
    if boombox.Input and boombox.Input.Text ~= assetId then boombox.Input.Text = assetId end
    Extensions.StopBoombox(true)
    boombox.Generation = boombox.Generation + 1
    local generation = boombox.Generation
    local sound = Instance.new("Sound")
    sound.Name = "RaphaelBoombox"
    sound.SoundId = "rbxassetid://" .. assetId
    sound.Volume = 0.65
    sound.Looped = false
    sound.Parent = SoundService
    boombox.Sound = sound
    boombox.Playing = true
    Extensions.RefreshBoomboxButton()
    connect(sound.Ended, function()
        if boombox.Sound == sound and boombox.Generation == generation then
            Extensions.StopBoombox(true)
            notify("Boombox đã phát xong.", Theme.Success)
        end
    end)
    local ok, problem = pcall(function() sound:Play() end)
    if not ok then
        Extensions.StopBoombox(true)
        notify("Không thể phát audio: " .. tostring(problem), Theme.Danger)
        return false
    end
    notify("Đang phát Boombox · " .. assetId .. ".", Theme.Success)
    task.delay(4, function()
        if boombox.Sound == sound and boombox.Generation == generation and sound.Parent and not sound.IsLoaded and sound.TimeLength <= 0 then
            notify("Audio chưa tải được; có thể bị giới hạn quyền, kiểm duyệt hoặc chính sách experience.", Theme.Warning)
        end
    end)
    return true
end

function Extensions.RebuildSentinelFilters()
    local monitor = State.AnomalyMonitor
    if not monitor.GroundParams then
        monitor.GroundParams = RaycastParams.new()
        monitor.GroundParams.FilterType = Enum.RaycastFilterType.Exclude
        monitor.GroundParams.IgnoreWater = false
        monitor.WallParams = RaycastParams.new()
        monitor.WallParams.FilterType = Enum.RaycastFilterType.Exclude
        monitor.WallParams.IgnoreWater = true
        pcall(function() monitor.WallParams.RespectCanCollide = true end)
        monitor.OverlapParams = OverlapParams.new()
        monitor.OverlapParams.FilterType = Enum.RaycastFilterType.Exclude
    end
    local characters = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then characters[#characters + 1] = player.Character end
    end
    monitor.GroundParams.FilterDescendantsInstances = characters
    monitor.WallParams.FilterDescendantsInstances = characters
    monitor.OverlapParams.FilterDescendantsInstances = characters
end

function Extensions.GetSentinelJumpHeight(humanoid)
    if humanoid.UseJumpPower then
        local gravity = math.max(Workspace.Gravity, 0.01)
        return humanoid.JumpPower * humanoid.JumpPower / (2 * gravity)
    end
    return humanoid.JumpHeight
end

function Extensions.BuildSentinelSample(entry, player, now)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not humanoid or not root then return nil end
    local position = root.Position
    local velocity = root.AssemblyLinearVelocity
    local sample = {
        t = now, x = position.X, y = position.Y, z = position.Z,
        linSpeed = velocity.Magnitude,
        hSpeed = math.sqrt(velocity.X * velocity.X + velocity.Z * velocity.Z),
        angSpeed = root.AssemblyAngularVelocity.Magnitude,
        walkSpeed = humanoid.WalkSpeed,
        jumpHeight = Extensions.GetSentinelJumpHeight(humanoid),
        dead = humanoid.Health <= 0,
        seated = humanoid.SeatPart ~= nil or humanoid.Sit,
        ragdoll = humanoid.PlatformStand,
    }
    local state = humanoid:GetState()
    sample.dead = sample.dead or state == Enum.HumanoidStateType.Dead
    sample.climbing = state == Enum.HumanoidStateType.Climbing
    sample.ragdoll = sample.ragdoll or state == Enum.HumanoidStateType.Ragdoll or state == Enum.HumanoidStateType.FallingDown or state == Enum.HumanoidStateType.GettingUp
    local result = Workspace:Raycast(position, Vector3.new(0, -200, 0), State.AnomalyMonitor.GroundParams)
    if result then
        sample.groundDist = position.Y - result.Position.Y
        local part = result.Instance
        if part then
            local vx, vz, moved = 0, 0, false
            if part.Anchored then
                local last = entry.Ground
                if last and last.Part == part and now - last.Time > 0.02 and now - last.Time < 0.7 then
                    local delta = part.Position - last.Position
                    local span = now - last.Time
                    vx, vz = delta.X / span, delta.Z / span
                    moved = math.sqrt(vx * vx + vz * vz) > 1.5
                end
                entry.Ground = {Part = part, Position = part.Position, Time = now}
            else
                local partVelocity = part.AssemblyLinearVelocity
                vx, vz = partVelocity.X, partVelocity.Z
                moved = math.sqrt(vx * vx + vz * vz) > 1.5
                entry.Ground = nil
            end
            if moved then sample.groundMoving, sample.groundVx, sample.groundVz = true, vx, vz end
        end
    else
        entry.Ground = nil
    end
    return sample
end

function Extensions.SentinelWallBetween(previous, current)
    local origin = Vector3.new(previous.x, previous.y, previous.z)
    local direction = Vector3.new(current.x - previous.x, current.y - previous.y, current.z - previous.z)
    return Workspace:Raycast(origin, direction, State.AnomalyMonitor.WallParams) ~= nil
end

function Extensions.SentinelNearClimbable(x, y, z)
    local parts = Workspace:GetPartBoundsInRadius(Vector3.new(x, y, z), 3.5, State.AnomalyMonitor.OverlapParams)
    for _, part in ipairs(parts) do
        local lower = string.lower(part.Name)
        if part:IsA("TrussPart") or string.find(lower, "ladder", 1, true) or string.find(lower, "climb", 1, true) or string.find(lower, "truss", 1, true) then return true end
    end
    return false
end

function Extensions.ApplySentinelSensitivity()
    local sensitivity = State.AnomalyMonitor.Sensitivity
    local engine = Extensions.SentinelEngine
    if sensitivity == 1 then
        engine.Config.SpeedFactor, engine.Config.Activate = 1.8, 8
    elseif sensitivity == 3 then
        engine.Config.SpeedFactor, engine.Config.Activate = 1.2, 4.5
    else
        engine.Config.SpeedFactor, engine.Config.Activate = 1.4, 6
    end
end

