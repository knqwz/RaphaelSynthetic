    end)
    connect(UserInputService.InputChanged, function(input)
        local drag = viewer.Drag
        if not drag then return end
        local matches = drag.IsMouse and input.UserInputType == Enum.UserInputType.MouseMovement or (not drag.IsMouse and input == drag.Input)
        if not matches then return end
        local position = Vector2.new(input.Position.X, input.Position.Y)
        local delta = position - drag.Last
        drag.Last = position
        local now = os.clock()
        local elapsed = math.max(now - drag.LastTime, 1 / 240)
        drag.LastTime = now
        viewer.PreviewYaw = viewer.PreviewYaw + delta.X * 0.011
        viewer.PreviewPitch = math.clamp(viewer.PreviewPitch + delta.Y * 0.005, -0.3, 0.75)
        viewer.VelocityYaw = math.clamp(viewer.VelocityYaw * 0.55 + (delta.X * 0.011 / elapsed) * 0.45, -9, 9)
        viewer.LastInteraction = now
        Extensions.UpdateAvatarViewerCamera()
    end)
    connect(UserInputService.InputEnded, function(input)
        local drag = viewer.Drag
        if not drag then return end
        if (drag.IsMouse and input.UserInputType == Enum.UserInputType.MouseButton1) or (not drag.IsMouse and input == drag.Input) then
            viewer.Drag = nil
