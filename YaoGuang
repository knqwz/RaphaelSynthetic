local function applyTabVisualState(data, selected, animated)
    local button = data.Button
    if not button or not button.Parent then
        return
    end
    cancelTabVisualTweens(data)
    data.Gradient.Enabled = false
    data.Accent.Visible = false
    button.Rotation = 0
    local buttonProperties = {
        BackgroundTransparency = UI.SurfaceStyle.IdleTabTransparency,
        BackgroundColor3 = Theme.Surface,
        TextColor3 = Theme.Text
    }
    local iconProperties = {ImageColor3 = selected and Theme.Accent or Theme.SubText}
    local accentProperties = {BackgroundColor3 = Theme.Accent, BackgroundTransparency = 1}
    if animated then
        local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        data.ButtonTween = TweenService:Create(button, tweenInfo, buttonProperties)
        data.IconTween = TweenService:Create(data.Icon, tweenInfo, iconProperties)
        data.AccentTween = TweenService:Create(data.Accent, tweenInfo, accentProperties)
        data.ButtonTween:Play()
        data.IconTween:Play()
        data.AccentTween:Play()
    else
        for property, value in pairs(buttonProperties) do
            button[property] = value
        end
        data.Icon.ImageColor3 = iconProperties.ImageColor3
        data.Accent.BackgroundColor3 = accentProperties.BackgroundColor3
        data.Accent.BackgroundTransparency = accentProperties.BackgroundTransparency
        UI.Motion.Reset(button)
        for _, child in ipairs(button:GetChildren()) do
            if child.Name == "PremiumRipple" then
                child:Destroy()
            end
        end
    end
end

function Extensions.SelectTab(name)
    if not State.Running or not isCurrentRuntimeSession() or not ScreenGui or not ScreenGui.Parent then
        return false
    end
    purgeStaleInterfaces(ScreenGui)
    local selectedPage = Pages[name]
    if not selectedPage then
