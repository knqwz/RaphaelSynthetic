function Extensions.ExecuteJumpRequest()
    if not State.Running or not isCurrentRuntimeSession() then
        return
    end
    local now = os.clock()
    State.LastJumpRequest = now
    if not State.JumpEnabled and not State.InfiniteJump then
        return
    end
    if now - State.LastJumpExecution < 0.035 then
        return
    end
    local _, humanoid, root = getCharacter()
    if not humanoid or not root then
        return
    end
    local rememberFunction: any = rememberHumanoid
    local original: any = rememberFunction(humanoid)
    if not State.InfiniteJump and humanoid.FloorMaterial == Enum.Material.Air then
        return
    end
    State.LastJumpExecution = now
    pcall(function()
        humanoid.Jump = true
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end)
    if not State.InfiniteJump then
        if State.JumpEnabled and State.JumpMethod == "Velocity" then
            pcall(function()
                local velocity = root.AssemblyLinearVelocity
                root.AssemblyLinearVelocity = Vector3.new(velocity.X, State.JumpValue, velocity.Z)
            end)
        end
        return
    end
    local jumpVelocity
    if State.JumpEnabled then
        jumpVelocity = State.JumpMethod == "JumpHeight" and math.sqrt(math.max(2 * Workspace.Gravity * State.JumpValue, 0)) or State.JumpValue
    elseif original then
