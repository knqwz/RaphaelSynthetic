function Extensions.BuildSearchSuggestions(limit)
    local list = {}
    for _, entry in ipairs(State.FunctionSearchRecent) do
        if entry.Target and entry.Target.Parent and #list < limit then
            list[#list + 1] = entry
        end
    end
    State.FunctionSearchRecentShown = #list > 0
    if #list == 0 then
        for _, name in ipairs({"Movement", "Player", "ESP", "Info", "Misc", "World"}) do
            local page = Pages[name]
            if page and #list < limit then
                list[#list + 1] = {Name = name, Page = name, Section = "Tab", Kind = "tab", IsTab = true, Target = page, NameText = string.lower(name), SearchText = string.lower(name)}
            end
        end
    end
    return list
end

function Extensions.RefreshFunctionSearch(query: any)
    local container: any = State.FunctionSearchResults
    local panel: any = State.FunctionSearchPanel
    if not container or not panel then
        return
    end
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end
    table.clear(State.FunctionSearchMatches)
    local normalized = Extensions.NormalizeSearchText(query)
    local desktop = State.IsDesktop
    local rowStep = (desktop and 44 or 40) + 3
    local limit = math.clamp(math.floor((MainFrame.AbsoluteSize.Y - 150) / rowStep), 3, desktop and 8 or 5)
    local list: {any} = {}
    local total = 0
    local headingText = nil
    if normalized == "" then
        list = Extensions.BuildSearchSuggestions(limit)
        total = #list
        headingText = State.FunctionSearchRecentShown and "GẦN ĐÂY" or "ĐI NHANH TỚI TAB"
    else
        list, total = Extensions.RankSearchEntries(normalized, limit)
    end
    local extraHeight = 0
    local function note(text, order)
        local label = Instance.new("TextLabel")
        label.BackgroundTransparency = 1
        label.Size = UDim2.new(1, 0, 0, 16)
        label.Text = text
        label.TextColor3 = Theme.SubText
        label.Font = Enum.Font.GothamBold
        label.TextSize = 9
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.LayoutOrder = order
        label.ZIndex = 84
        label.Parent = container
        extraHeight = extraHeight + 19
    end
    if headingText then
        note(headingText, -1)
    end
    for index, entry in ipairs(list) do
        State.FunctionSearchMatches[index] = entry
        Extensions.CreateFunctionSearchResult(container, entry, index)
    end
    if normalized ~= "" and #list == 0 then
        note("Không có chức năng phù hợp · thử từ khóa khác (ví dụ: bay, esp, hop server)", 1)
    elseif normalized ~= "" and total > #list then
        note("+" .. tostring(total - #list) .. " kết quả nữa · gõ thêm để lọc", #list + 1)
    end
    State.FunctionSearchSelected = #list > 0 and 1 or 0
    Extensions.PaintFunctionSearchSelection()
    local height = 44
    if #list > 0 or extraHeight > 0 then
        height = 46 + #list * rowStep + extraHeight + 6
    end
    panel.Size = UDim2.fromOffset(Extensions.SearchPanelWidth, height)
end

function Extensions.QueueFunctionSearchRefresh(force)
    if State.FunctionSearchRefreshQueued then
        return
    end
    State.FunctionSearchRefreshQueued = true
    task.defer(function()
        State.FunctionSearchRefreshQueued = false
        local box = State.FunctionSearchBox
        if not box or not box.Parent then
            return
        end
        local query = box.Text
        if force or query ~= State.FunctionSearchLastQuery then
            State.FunctionSearchLastQuery = query
            Extensions.RefreshFunctionSearch(query)
        end
    end)
end

function Extensions.ToggleFunctionSearch(forceVisible)
    local panel = State.FunctionSearchPanel
    if not panel then
        return
    end
    local visible = forceVisible == nil and not State.FunctionSearchOpen or not not forceVisible
    State.FunctionSearchOpen = visible
    State.FunctionSearchFocusToken = State.FunctionSearchFocusToken + 1
    State.FunctionSearchPressing = false
    panel.Visible = visible
    Extensions.AnimateFunctionSearchButton(visible)
    if visible and State.FunctionSearchBox then
        State.FunctionSearchBox.Text = ""
        State.FunctionSearchLastQuery = nil
        State.FunctionSearchBox:CaptureFocus()
        Extensions.QueueFunctionSearchRefresh(true)
    elseif State.FunctionSearchBox then
        State.FunctionSearchBox:ReleaseFocus()
    end
end

