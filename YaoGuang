    local function splitMessage(text)
        local cleaned = string.gsub(tostring(text), "%s+", " ")
        cleaned = string.gsub(cleaned, "^%s*(.-)%s*$", "%1")
        local title, subtitle = string.match(cleaned, "^(.-)%s·%s(.+)$")
        if title and title ~= "" then
            return (string.gsub(title, "[%.;]+$", "")), subtitle
        end
        title, subtitle = string.match(cleaned, "^(.-)[%.;:]%s(.+)$")
        if title and #title >= 6 and #title <= 56 then
            return title, subtitle
        end
        if #cleaned > 44 then
            local cut = string.find(cleaned, " ", 30, true)
            if cut and cut < 58 then
                return string.sub(cleaned, 1, cut - 1), string.sub(cleaned, cut + 1)
            end
        end
        return (string.gsub(cleaned, "[%.;]+$", "")), ""
    end
    Island.SplitMessage = splitMessage

