function Extensions.NavigateFunctionSearch(entry)
    if not entry then
        return
    end
    if entry.IsTab then
        Extensions.ToggleFunctionSearch(false)
        Extensions.SelectTab(entry.Page)
        return
    end
    if not entry.Target or not entry.Target.Parent or not Extensions.SelectTab(entry.Page) then
        notify("Chức năng không còn khả dụng.", Theme.Warning)
        return
    end
    Extensions.RememberSearchEntry(entry)
    Extensions.ToggleFunctionSearch(false)
    local collapsible = Extensions.CollapsibleSections[entry.Target]
    if collapsible and collapsible.Collapsed then collapsible.Set(false) end
    task.spawn(function()
        local page = Pages[entry.Page]
        local target = entry.Target
        if not page or not target or not target.Parent then
            return
        end
        RunService.Heartbeat:Wait()
        RunService.Heartbeat:Wait()
        if not page.Parent or not target.Parent then
            return
        end
        local targetY: number = tonumber(target.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y - 8) or 0
        local maximumY: number = math.max(tonumber(page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y) or 0, 0)
        local desiredY: number = math.clamp(targetY, 0, maximumY)
        TweenService:Create(page, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            CanvasPosition = Vector2.new(0, desiredY)
        }):Play()
        task.wait(0.22)
        if not page.Parent or not target.Parent then
            return
        end
        targetY = tonumber(target.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y - 8) or 0
        maximumY = math.max(tonumber(page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y) or 0, 0)
        local finalY: number = math.clamp(tonumber(targetY) or 0, 0, tonumber(maximumY) or 0)
        page.CanvasPosition = Vector2.new(0, finalY)

        local focusScale = UI.Motion.GetScale(target)
        local focusToken = (target:GetAttribute("RaphaelSearchFocusToken") or 0) + 1
        target:SetAttribute("RaphaelSearchFocusToken", focusToken)
        if focusScale then
            focusScale.Scale = 1
            TweenService:Create(focusScale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.065}):Play()
        end
        task.delay(0.2, function()
            if target.Parent and target:GetAttribute("RaphaelSearchFocusToken") == focusToken and focusScale and focusScale.Parent then
                TweenService:Create(focusScale, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play()
            end
        end)
        notify("Đã mở: " .. entry.Name .. " · " .. entry.Page .. ".", Theme.Success)
    end)
end

