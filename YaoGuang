Extensions.AntiStunStrictClasses = {
    BodyVelocity = true, BodyAngularVelocity = true, BodyPosition = true, BodyGyro = true, BodyThrust = true, BodyForce = true,
    LinearVelocity = true, AngularVelocity = true, VectorForce = true, Torque = true, AlignPosition = true, AlignOrientation = true
}

function Extensions.IsAntiStunNameSuspicious(instance)
    if not instance then return false end
    if instance:GetAttribute("RaphaelOwned") then return false end
    if State.AntiStunOptions.Level == "Tối đa" and Extensions.AntiStunStrictClasses[instance.ClassName] then return true end
    local lowerName = string.lower(tostring(instance.Name))
    for _, hint in ipairs(State.AntiStunForceHints) do
        if string.find(lowerName, hint, 1, true) then return true end
    end
    return false
end

function Extensions.TriggerAntiStunRecovery(reason)
    local now = os.clock()
    State.AntiStunRecoveryUntil = math.max(State.AntiStunRecoveryUntil or 0, now + 0.55)
    if now - (State.AntiStunLastTrigger or 0) > 0.12 then
        State.AntiStunTriggerCount = (tonumber(State.AntiStunTriggerCount) or 0) + 1
    end
    State.AntiStunLastTrigger = now
    return reason
end

function Extensions.TrackAntiStunInstance(instance)
    if not instance or not instance.Parent then return end
    if instance:IsA("Motor6D") then
        State.AntiStunTrackedInstances[instance] = "Motor"
    elseif Extensions.AntiStunStrictClasses[instance.ClassName]
        or instance:IsA("BallSocketConstraint")
        or instance:IsA("HingeConstraint")
        or instance:IsA("BoolValue")
        or instance:IsA("StringValue")
        or instance:IsA("NumberValue")
        or instance:IsA("IntValue") then
        State.AntiStunTrackedInstances[instance] = "Candidate"
    end
end

function Extensions.NeutralizeAntiStunInstance(instance)
    if not instance or not instance.Parent or not Extensions.IsAntiStunNameSuspicious(instance) then return false end
    local active = false
    pcall(function()
        if instance:IsA("BodyVelocity") then
            active = instance.MaxForce.Magnitude > 0.01 and instance.Velocity.Magnitude > 2
        elseif instance:IsA("BodyAngularVelocity") then
            active = instance.MaxTorque.Magnitude > 0.01 and instance.AngularVelocity.Magnitude > 1
        elseif instance:IsA("BodyPosition") then
            active = instance.MaxForce.Magnitude > 0.01
        elseif instance:IsA("BodyGyro") then
            active = instance.MaxTorque.Magnitude > 0.01
        elseif instance:IsA("BodyThrust") or instance:IsA("BodyForce") then
            active = instance.Force.Magnitude > 0.01
        elseif instance:IsA("LinearVelocity") or instance:IsA("AngularVelocity") or instance:IsA("VectorForce") or instance:IsA("Torque") or instance:IsA("AlignPosition") or instance:IsA("AlignOrientation") or instance:IsA("BallSocketConstraint") or instance:IsA("HingeConstraint") then
            active = instance.Enabled
        elseif instance:IsA("BoolValue") then
            active = instance.Value == true
        elseif instance:IsA("StringValue") then
            active = instance.Value ~= ""
        elseif instance:IsA("NumberValue") or instance:IsA("IntValue") then
            active = tonumber(instance.Value) ~= nil and instance.Value > 0
        end
    end)
    if not active then return false end

    pcall(function()
        local backup = State.AntiStunInstanceBackup[instance]
        if not backup then
            backup = {}
            State.AntiStunInstanceBackup[instance] = backup
            if instance:IsA("BodyVelocity") then
                backup.Velocity = instance.Velocity
                backup.MaxForce = instance.MaxForce
            elseif instance:IsA("BodyAngularVelocity") then
                backup.AngularVelocity = instance.AngularVelocity
                backup.MaxTorque = instance.MaxTorque
            elseif instance:IsA("BodyPosition") then
                backup.MaxForce = instance.MaxForce
            elseif instance:IsA("BodyGyro") then
                backup.MaxTorque = instance.MaxTorque
            elseif instance:IsA("BodyThrust") or instance:IsA("BodyForce") then
                backup.Force = instance.Force
            elseif instance:IsA("LinearVelocity") or instance:IsA("AngularVelocity") or instance:IsA("VectorForce") or instance:IsA("Torque") or instance:IsA("AlignPosition") or instance:IsA("AlignOrientation") or instance:IsA("BallSocketConstraint") or instance:IsA("HingeConstraint") then
                backup.Enabled = instance.Enabled
            elseif instance:IsA("BoolValue") or instance:IsA("StringValue") or instance:IsA("NumberValue") or instance:IsA("IntValue") then
                backup.Value = instance.Value
            end
        end
        if instance:IsA("BodyVelocity") then
            instance.Velocity = Vector3.zero
            instance.MaxForce = Vector3.zero
        elseif instance:IsA("BodyAngularVelocity") then
            instance.AngularVelocity = Vector3.zero
            instance.MaxTorque = Vector3.zero
        elseif instance:IsA("BodyPosition") then
            instance.MaxForce = Vector3.zero
        elseif instance:IsA("BodyGyro") then
            instance.MaxTorque = Vector3.zero
        elseif instance:IsA("BodyThrust") or instance:IsA("BodyForce") then
            instance.Force = Vector3.zero
        elseif instance:IsA("LinearVelocity") or instance:IsA("AngularVelocity") or instance:IsA("VectorForce") or instance:IsA("Torque") or instance:IsA("AlignPosition") or instance:IsA("AlignOrientation") or instance:IsA("BallSocketConstraint") or instance:IsA("HingeConstraint") then
            instance.Enabled = false
        elseif instance:IsA("BoolValue") then
            instance.Value = false
        elseif instance:IsA("StringValue") then
            instance.Value = ""
        elseif instance:IsA("NumberValue") or instance:IsA("IntValue") then
            local lowerName = string.lower(instance.Name)
            instance.Value = string.find(lowerName, "slow", 1, true) and not string.find(lowerName, "time", 1, true) and 1 or 0
        end
    end)
    return true
end

function Extensions.RebuildAntiStunTracking(character)
