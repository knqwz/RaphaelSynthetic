connect(UserInputService.JumpRequest, function()
    State.LastJumpRequest = os.clock()
    if not State.JumpEnabled and not State.InfiniteJump then
        return
    end
    local _, humanoid, root = getCharacter()
    if not humanoid or not root then
        return
    end
    local original = rememberHumanoid(humanoid)
    local canApply = State.InfiniteJump or humanoid.FloorMaterial ~= Enum.Material.Air
    if not canApply then
        return
    end
    if not State.JumpEnabled then
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        if State.InfiniteJump and original then
            local velocity = root.AssemblyLinearVelocity
            local minimumVelocity = original.UseJumpPower and original.JumpPower or math.sqrt(math.max(2 * Workspace.Gravity * original.JumpHeight, 0))
            root.AssemblyLinearVelocity = Vector3.new(velocity.X, math.max(velocity.Y, minimumVelocity), velocity.Z)
        end
    elseif State.JumpMethod == "Velocity" then
        local velocity = root.AssemblyLinearVelocity
        root.AssemblyLinearVelocity = Vector3.new(velocity.X, State.JumpValue, velocity.Z)
    else
        humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        if State.InfiniteJump then
            local velocity = root.AssemblyLinearVelocity
            local minimumVelocity = State.JumpMethod == "JumpHeight" and math.sqrt(2 * Workspace.Gravity * State.JumpValue) or State.JumpValue
            root.AssemblyLinearVelocity = Vector3.new(velocity.X, math.max(velocity.Y, minimumVelocity), velocity.Z)
        end
    end
end)

