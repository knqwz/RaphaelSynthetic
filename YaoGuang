            notify("Đã dò và lập chỉ mục " .. foundCount .. " đối tượng khớp tên.", foundCount > 0 and Theme.Success or Theme.Warning)
        end
    end
    return foundCount
end

function Extensions.ResetUniversalScanCandidates()
    local candidates = State.UniversalScan.CandidateBuffer
    local pool = State.UniversalScan.CandidatePool
    for index = #candidates, 1, -1 do
        local candidate = candidates[index]
        candidate.Target = nil
        candidate.Root = nil
        candidates[index] = nil
        pool[#pool + 1] = candidate
    end
end

function Extensions.InsertUniversalScanCandidate(target, root, distanceSquared)
    local candidates = State.UniversalScan.CandidateBuffer
    local limit = State.UniversalScan.MaxTargets
    local count = #candidates
    if count >= limit and distanceSquared >= candidates[count].DistanceSquared then
        return
    end
    local candidate
    if count >= limit then
        candidate = candidates[count]
    else
        local pool = State.UniversalScan.CandidatePool
        candidate = pool[#pool]
        if candidate then
            pool[#pool] = nil
        else
            candidate = {}
        end
        count = count + 1
    end
    local insertIndex = count
    while insertIndex > 1 and candidates[insertIndex - 1].DistanceSquared > distanceSquared do
        candidates[insertIndex] = candidates[insertIndex - 1]
        insertIndex = insertIndex - 1
    end
    candidate.Target = target
    candidate.Root = root
    candidate.DistanceSquared = distanceSquared
    candidates[insertIndex] = candidate
end

function Extensions.GetUniversalScanObject(instance)
    if not instance or not instance.Parent then
        return nil
    end
    if instance:IsA("Tool") then
        return getAdorneeRoot(instance) and instance or nil
    elseif instance:IsA("Model") then
        return getAdorneeRoot(instance) and instance or nil
    elseif instance:IsA("BasePart") then
        if instance:FindFirstAncestorOfClass("Model") or instance:FindFirstAncestorOfClass("Tool") then
            return nil
        end
        return instance
    end
    return nil
end

function Extensions.IsUniversalScanExcluded(target)
    local mode = State.UniversalScan.ExcludeMode
    local excludePlayers = mode == "Loại trừ Player" or mode == "Loại trừ cả hai"
    local excludeMobs = mode == "Loại trừ Quái" or mode == "Loại trừ cả hai"
    if excludePlayers and isPlayerCharacterDescendant(target) then
        return true
    end
    if excludeMobs then
        local model = target:IsA("Model") and target or target:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") and not belongsToPlayerCharacter(model) then
            return true
        end
    end
    return false
end

function Extensions.RunUniversalScan()
    if State.UniversalScan.ScanRunning then
        notify("Quét Đa Năng đang chạy.", Theme.Warning)
        return
    end
    State.UniversalScan.ScanRunning = true
    Extensions.ResetUniversalScanCandidates()
    table.clear(State.UniversalScan.ResultNames)
    table.clear(State.UniversalScan.ResultNameSet)
    local _, _, localRoot = getCharacter()
    local origin = localRoot and localRoot.Position or Camera.CFrame.Position
    local totalObjects = 0
    local descendants = Workspace:GetDescendants()
    for index, instance in ipairs(descendants) do
        local target = Extensions.GetUniversalScanObject(instance)
        if target and not Extensions.IsUniversalScanExcluded(target) then
            local root = getAdorneeRoot(target)
            if root then
                totalObjects = totalObjects + 1
                local normalizedName = string.lower(target.Name)
                if not State.UniversalScan.ResultNameSet[normalizedName] then
                    State.UniversalScan.ResultNameSet[normalizedName] = true
                    State.UniversalScan.ResultNames[#State.UniversalScan.ResultNames + 1] = target.Name
                end
                local offset = root.Position - origin
                Extensions.InsertUniversalScanCandidate(target, root, offset:Dot(offset))
            end
        end
        if index % 180 == 0 then
            RunService.Heartbeat:Wait()
        end
    end
    table.clear(descendants)

    for target, visual in pairs(Visuals.Scan) do
        Extensions.ReleaseVisual("Scan", target, visual)
    end
    table.clear(State.UniversalScan.Cache)
    local candidates = State.UniversalScan.CandidateBuffer
    for index = 1, #candidates do
        local candidate = candidates[index]
        if candidate.Target and candidate.Target.Parent then
            State.UniversalScan.Cache[candidate.Target] = candidate.Root
        end
    end
    table.sort(State.UniversalScan.ResultNames, function(left, right)
        return string.lower(left) < string.lower(right)
    end)
    State.UniversalScan.Active = true
    if State.UniversalScan.ResultsBox and State.UniversalScan.ResultsBox.Parent then
        State.UniversalScan.ResultsBox.Text = table.concat(State.UniversalScan.ResultNames, "\n")
    end
    local visibleCount = #candidates
    Extensions.ResetUniversalScanCandidates()
    State.UniversalScan.ScanRunning = false
    notify("Quét Đa Năng tìm thấy " .. totalObjects .. " đối tượng và hiển thị " .. visibleCount .. " mục tiêu gần nhất.", visibleCount > 0 and Theme.Success or Theme.Warning)
end

function Extensions.CopyUniversalScanNames()
