local function hideVisual(visual)
    setDrawingVisible(visual.Box, false)
    setDrawingVisible(visual.Tracer, false)
    setDrawingVisible(visual.LookLine, false)
    if visual.Highlight then
        visual.Highlight.Enabled = false
    end
    if visual.InfoBillboard then
        visual.InfoBillboard.Enabled = false
    end
    if visual.LookBeam then
        visual.LookBeam.Enabled = false
    end
end
function Extensions.CullMobVisuals()
    Camera = Workspace.CurrentCamera or Camera
    for model, visual in pairs(Visuals.Mob) do
        local classification = MobCache[model]
        local detectorRoot = classification and classification.Root
        local visualAnchor = Extensions.GetMobVisualAnchor(model, detectorRoot)
        if not model or not model.Parent or not visualAnchor or not visualAnchor.Parent then
            hideVisual(visual)
        else
            local point, onScreen = Camera:WorldToViewportPoint(visualAnchor.Position)
            if not onScreen or point.Z <= 0 then
                hideVisual(visual)
            end
        end
    end
end

local function destroyVisual(visual)
    if not visual then
        return
    end
    destroyDrawing(visual.Box)
    destroyDrawing(visual.Tracer)
    destroyDrawing(visual.LookLine)
    if visual.Highlight then
        visual.Highlight:Destroy()
    end
    if visual.InfoBillboard then
        visual.InfoBillboard:Destroy()
    end
    if visual.LookBeam then
        visual.LookBeam:Destroy()
    end
    if visual.LookStart then
        visual.LookStart:Destroy()
    end
    if visual.LookEnd then
        visual.LookEnd:Destroy()
    end
end
removeAllVisuals = function(category)
    local categories = category and {category} or {"Player", "Mob", "Item"}
    for _, categoryName in ipairs(categories) do
        for key, visual in pairs(Visuals[categoryName]) do
            destroyVisual(visual)
            Visuals[categoryName][key] = nil
        end
    end
end

local function getAdorneeRoot(instance)
    if not instance or not instance.Parent then
        return nil
    end
    if instance:IsA("BasePart") then
        return instance
    end
    if instance:IsA("Tool") then
        return instance:FindFirstChild("Handle") or instance:FindFirstChildWhichIsA("BasePart", true)
    end
    if instance:IsA("Model") then
        return instance:FindFirstChild("HumanoidRootPart")
            or instance:FindFirstChild("UpperTorso")
            or instance:FindFirstChild("Torso")
            or instance:FindFirstChild("Head")
            or instance.PrimaryPart
            or instance:FindFirstChildWhichIsA("BasePart", true)
    end
    return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function getBoundingData(instance)
    if not instance or not instance.Parent then
        return nil, nil
    end
    if instance:IsA("Model") then
        local success, boundingCFrame, boundingSize = pcall(instance.GetBoundingBox, instance)
        if success then
            return boundingCFrame, boundingSize
        end
    elseif instance:IsA("BasePart") then
        return instance.CFrame, instance.Size
    elseif instance:IsA("Tool") then
        local handle = instance:FindFirstChild("Handle") or instance:FindFirstChildWhichIsA("BasePart", true)
        if handle then
            return handle.CFrame, handle.Size
        end
    end
    local root = getAdorneeRoot(instance)
    if root then
        return root.CFrame, root.Size
    end
    return nil, nil
end

local function getScreenBounds(instance)
    local boundingCFrame, size = getBoundingData(instance)
    if not boundingCFrame or not size then
        return nil
    end

    size = Vector3.new(math.max(size.X, 1), math.max(size.Y, 1), math.max(size.Z, 1))
    local minimumX = math.huge
    local minimumY = math.huge
    local maximumX = -math.huge
    local maximumY = -math.huge
    local positiveDepth = 0

    for x = -1, 1, 2 do
        for y = -1, 1, 2 do
            for z = -1, 1, 2 do
                local worldPoint = (boundingCFrame * CFrame.new(size.X * x * 0.5, size.Y * y * 0.5, size.Z * z * 0.5)).Position
                local screenPoint = Camera:WorldToViewportPoint(worldPoint)
                if screenPoint.Z > 0 then
                    positiveDepth = positiveDepth + 1
                    minimumX = math.min(minimumX, screenPoint.X)
                    minimumY = math.min(minimumY, screenPoint.Y)
                    maximumX = math.max(maximumX, screenPoint.X)
                    maximumY = math.max(maximumY, screenPoint.Y)
                end
            end
        end
    end

    if positiveDepth == 0 then
        return nil
    end

    local viewport = Camera.ViewportSize
    if maximumX < 0 or minimumX > viewport.X or maximumY < 0 or minimumY > viewport.Y then
        return nil
    end

    local width = math.clamp(maximumX - minimumX, 8, viewport.X * 1.5)
    local height = math.clamp(maximumY - minimumY, 12, viewport.Y * 1.5)
    return Vector2.new(minimumX, minimumY), Vector2.new(width, height)
end

function Extensions.GetStableMobScreenBounds(model, visualAnchor, anchorPoint)
    local topLeft, boxSize = getScreenBounds(model)
    if topLeft and boxSize then
        local margin = math.max(24, math.min(math.max(boxSize.X, boxSize.Y) * 0.35, 90))
        local containsAnchor = anchorPoint.X >= topLeft.X - margin
            and anchorPoint.X <= topLeft.X + boxSize.X + margin
            and anchorPoint.Y >= topLeft.Y - margin
            and anchorPoint.Y <= topLeft.Y + boxSize.Y + margin
        local viewport = Camera.ViewportSize
        local reasonableSize = boxSize.X <= viewport.X * 1.25 and boxSize.Y <= viewport.Y * 1.25
        if containsAnchor and reasonableSize then
            return topLeft, boxSize
        end
    end

    local depth = math.max(anchorPoint.Z, 1)
    local estimatedHeight = math.clamp(Camera.ViewportSize.Y * 4.5 / depth, 18, 170)
    local estimatedWidth = math.clamp(estimatedHeight * 0.58, 10, 105)
    local anchorIsHead = visualAnchor and visualAnchor.Name == "Head"
    local topOffset = anchorIsHead and estimatedHeight * 0.12 or estimatedHeight * 0.48
    return Vector2.new(anchorPoint.X - estimatedWidth * 0.5, anchorPoint.Y - topOffset), Vector2.new(estimatedWidth, estimatedHeight)
end

function Extensions.IsGenericInspectorName(name)
    local normalized = string.lower(tostring(name or ""))
    return normalized == ""
        or normalized == "part"
        or normalized == "meshpart"
        or normalized == "handle"
        or normalized == "hitbox"
        or normalized == "root"
        or normalized == "rootpart"
        or normalized == "humanoidrootpart"
        or normalized == "model"
        or normalized == "folder"
        or normalized == "pathblock"
        or normalized == "block"
        or normalized == "map"
        or normalized == "world"
        or normalized == "workspace"
end

function Extensions.GetInspectorMetadataText(instance)
    if not instance then
        return nil
    end
    local attributeNames = {"DisplayName", "ItemName", "EntityName", "MobName", "NPCName", "PickupName", "Title", "Label", "ObjectName"}
    local valueNames = {"DisplayName", "ItemName", "EntityName", "MobName", "NPCName", "PickupName", "Title", "Label", "ObjectName"}
    local current = instance
    local depth = 0
    while current and current ~= Workspace and depth < 8 do
        for _, attributeName in ipairs(attributeNames) do
            local value = current:GetAttribute(attributeName)
            if type(value) == "string" and value ~= "" and not Extensions.IsGenericInspectorName(value) then
                return value
            end
        end
        local prompt = current:FindFirstChildWhichIsA("ProximityPrompt", false)
        if prompt then
            if prompt.ObjectText ~= "" then
                return prompt.ObjectText
            end
            if prompt.ActionText ~= "" then
                return prompt.ActionText
            end
        end
        for _, valueName in ipairs(valueNames) do
            local valueObject = current:FindFirstChild(valueName)
            if valueObject and valueObject:IsA("StringValue") and valueObject.Value ~= "" and not Extensions.IsGenericInspectorName(valueObject.Value) then
                return valueObject.Value
            end
        end
        for _, tag in ipairs(CollectionService:GetTags(current)) do
            if not Extensions.IsGenericInspectorName(tag) then
                local lowerTag = string.lower(tag)
                if string.find(lowerTag, "item", 1, true)
                    or string.find(lowerTag, "mob", 1, true)
                    or string.find(lowerTag, "npc", 1, true)
                    or string.find(lowerTag, "enemy", 1, true)
                    or string.find(lowerTag, "pickup", 1, true)
                    or string.find(lowerTag, "loot", 1, true) then
                    return tag
                end
            end
        end
        current = current.Parent
        depth = depth + 1
    end
    return nil
end

function Extensions.ResolveInspectorTarget(instance)
    if not instance or not instance:IsDescendantOf(Workspace) or instance:GetAttribute("RaphaelOwned") then
        return nil, "", Theme.Accent, 0
    end
    local current = instance
    local candidate
    local itemCandidate
    local humanoidModel
    local mobClassification
    local depth = 0
    while current and current ~= Workspace and depth < 12 do
        if MobCache[current] then
            humanoidModel = current
            mobClassification = MobCache[current]
            break
        elseif ItemCache[current] then
            itemCandidate = current
        elseif current:IsA("Tool") and not itemCandidate then
            itemCandidate = current
        elseif current:IsA("Model") then
            if current:FindFirstChildOfClass("Humanoid") then
                humanoidModel = current
                break
            elseif not candidate and not Extensions.IsGenericInspectorName(current.Name) then
                candidate = current
            end
        end
        current = current.Parent
        depth = depth + 1
    end

    if humanoidModel then
        local player = Players:GetPlayerFromCharacter(humanoidModel)
        if player then
            return humanoidModel, player.DisplayName .. " (@" .. player.Name .. ")", Theme.Player, 3
        end
        local humanoid = humanoidModel:FindFirstChildOfClass("Humanoid")
        local displayName = mobClassification and mobClassification.DisplayName
            or humanoid and humanoid.DisplayName ~= "" and humanoid.DisplayName
            or Extensions.GetInspectorMetadataText(humanoidModel)
            or humanoidModel.Name
        return humanoidModel, displayName, Theme.Mob, 3
    end

    local target = itemCandidate or candidate or instance
    local metadata = Extensions.GetInspectorMetadataText(target)
    if itemCandidate then
        return itemCandidate, metadata or itemCandidate.Name, Theme.Item, 2
    end
    local prompt = target:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt then
        local promptTarget = prompt:FindFirstAncestorOfClass("Tool") or prompt:FindFirstAncestorOfClass("Model") or target
        local promptName = prompt.ObjectText ~= "" and prompt.ObjectText or metadata or prompt.ActionText ~= "" and prompt.ActionText or promptTarget.Name
        return promptTarget, promptName, Theme.Item, 2
    end
    if metadata then
        return target, metadata, Theme.Item, 2
    end

    local displayName = target.Name
    if Extensions.IsGenericInspectorName(displayName) then
        local ancestor = target.Parent
        local ancestorDepth = 0
        while ancestor and ancestor ~= Workspace and ancestorDepth < 6 do
            if not Extensions.IsGenericInspectorName(ancestor.Name) then
                displayName = ancestor.Name
                if ancestor:IsA("Model") then
                    target = ancestor
                end
                break
            end
            ancestor = ancestor.Parent
            ancestorDepth = ancestorDepth + 1
        end
    end
    return target, displayName .. " · " .. target.ClassName, Theme.Accent, 1
end

function Extensions.PurgeInspectorInstances()
    if ScreenGui and ScreenGui.Parent then
        for _, instance in ipairs(ScreenGui:GetDescendants()) do
            if instance.Name == "RaphaelInspectorCrosshair"
                or instance.Name == "RaphaelInspectorName"
                or instance.Name == "RaphaelInspectorBox" then
                instance:Destroy()
            end
        end
    end
    local highlight = Workspace:FindFirstChild("RaphaelInspectorHighlight")
    while highlight do
        highlight:Destroy()
        highlight = Workspace:FindFirstChild("RaphaelInspectorHighlight")
    end
end

