local ItemHints = {"item", "pickup", "drop", "loot", "collect", "coin", "chest", "fruit", "weapon", "key", "potion", "gem", "ore", "crate"}
ItemHints.Attributes = {"Item", "IsItem", "Pickup", "IsPickup", "Collectible", "Loot", "Drop"}

local function isCharacterDescendant(instance)
    local model = instance:IsA("Model") and instance or instance:FindFirstAncestorOfClass("Model")
    if not model then
        return false
    end
    if Players:GetPlayerFromCharacter(model) then
        return true
    end
    return model:FindFirstChildOfClass("Humanoid") ~= nil
end

local function isPlayerCharacterDescendant(instance)
    local current = instance
    local depth = 0
    while current and current ~= Workspace and depth < 12 do
        if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then
            return true
        end
        current = current.Parent
        depth = depth + 1
    end
    return false
end

local function findClosestNamedWorldObject(name)
    local normalized = string.lower((string.gsub(tostring(name or ""), "^%s*(.-)%s*$", "%1")))
    if normalized == "" then
        return nil, nil
    end

    local _, _, localRoot = getCharacter()
    local origin = localRoot and localRoot.Position or Camera.CFrame.Position
    local closestObject
    local closestRoot
    local closestDistance = math.huge
    local descendants = Workspace:GetDescendants()

    for index, instance in ipairs(descendants) do
        if string.lower(instance.Name) == normalized and (instance:IsA("Model") or instance:IsA("Tool") or instance:IsA("BasePart")) then
            if not isPlayerCharacterDescendant(instance) then
                local objectRoot = getAdorneeRoot(instance)
                if objectRoot then
                    local distance = (objectRoot.Position - origin).Magnitude
                    if distance < closestDistance then
                        closestDistance = distance
                        closestObject = instance
                        closestRoot = objectRoot
                    end
                end
            end
        end
        if index % 1800 == 0 then
            task.wait()
        end
    end
    return closestObject, closestRoot
end

local function hasItemMetadata(instance)
    if textHasHint(instance.Name, ItemHints) then
        return true
    end
    for _, name in ipairs(ItemHints.Attributes) do
        local value = instance:GetAttribute(name)
        if value == true or type(value) == "string" and textHasHint(value, ItemHints) then
            return true
        end
    end
    for _, tag in ipairs(CollectionService:GetTags(instance)) do
        if textHasHint(tag, ItemHints) then
            return true
        end
    end
    return false
end

local function findExactAncestor(part, exactLower)
    local current = part
    local depth = 0
    while current and current ~= Workspace and depth < 8 do
        if string.lower(current.Name) == exactLower and (current:IsA("Model") or current:IsA("Tool") or current:IsA("BasePart")) then
            return current
        end
        current = current.Parent
        depth = depth + 1
    end
    return nil
end

local function findAutomaticItem(part)
    local tool = part:FindFirstAncestorOfClass("Tool")
    if tool and tool:IsDescendantOf(Workspace) then
        return tool
    end

    if isCharacterDescendant(part) then
        return nil
    end

    local current = part
    local best
    local depth = 0
    while current and current ~= Workspace and depth < 6 do
        if current:IsA("Model") or current:IsA("BasePart") then
            if hasItemMetadata(current) then
                best = current
            end
            if current:FindFirstChildWhichIsA("ProximityPrompt", false) or current:FindFirstChildWhichIsA("ClickDetector", false) then
                best = current:IsA("BasePart") and (current:FindFirstAncestorOfClass("Model") or current) or current
            end
        end
        current = current.Parent
        depth = depth + 1
    end
    return best
end

connect(Workspace.DescendantAdded, function(instance)
    if State.RemoveEffects then
