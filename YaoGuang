function Extensions.SentinelEngine.NewTracker(now)
    return {
        Flags = {},
        Prev = nil,
        Window = {},
        VyHist = {},
        GraceUntil = now + Extensions.SentinelEngine.Config.SpawnGrace,
        AirTime = 0,
        WasAir = false,
        AirStartY = nil,
        HighJumpFlagged = false,
        BigT = nil,
        BigStreak = 0,
        PrevVy = nil
    }
end

function Extensions.SentinelEngine.CurrentScore(flag, now)
    local elapsed = math.max(0, now - flag.Last)
    return flag.Score * math.exp(-elapsed / Extensions.SentinelEngine.Config.Decay)
end

function Extensions.SentinelEngine.AddEvidence(tracker, name, points, reason, now)
    local flag = tracker.Flags[name]
    if not flag then
        flag = {Score = 0, Count = 0, Peak = 0, Last = now, First = now, Reason = ""}
        tracker.Flags[name] = flag
    end
    local before = Extensions.SentinelEngine.CurrentScore(flag, now)
    local wasActive = before >= Extensions.SentinelEngine.Config.Activate
    flag.Score = before + points
    flag.Last = now
    flag.Count = flag.Count + 1
    flag.Reason = reason
    if flag.Score > flag.Peak then
        flag.Peak = flag.Score
    end
    return flag.Score >= Extensions.SentinelEngine.Config.Activate and not wasActive
end

function Extensions.SentinelEngine.LevelOf(score)
    if score >= Extensions.SentinelEngine.Config.SureLevel then
        return 3, "Chắc chắn"
    elseif score >= Extensions.SentinelEngine.Config.HighLevel then
        return 2, "Cao"
    end
    return 1, "Nghi ngờ"
end

function Extensions.SentinelEngine.GetActive(tracker, now)
    local list = {}
    for name, flag in pairs(tracker.Flags) do
        local score = Extensions.SentinelEngine.CurrentScore(flag, now)
        if score >= Extensions.SentinelEngine.Config.Activate then
            local level, label = Extensions.SentinelEngine.LevelOf(score)
            table.insert(list, {Name = name, Score = score, Level = level, Label = label, Count = flag.Count, Reason = flag.Reason})
        end
    end
    table.sort(list, function(a, b)
        return a.Score > b.Score
    end)
    return list
end

function Extensions.SentinelEngine.GetHistory(tracker, now)
    local list = {}
    for name, flag in pairs(tracker.Flags) do
        local score = Extensions.SentinelEngine.CurrentScore(flag, now)
        if flag.Peak >= Extensions.SentinelEngine.Config.Activate and score < Extensions.SentinelEngine.Config.Activate then
            table.insert(list, {Name = name, Peak = flag.Peak, Count = flag.Count, Reason = flag.Reason})
        end
    end
    table.sort(list, function(a, b)
        return a.Peak > b.Peak
    end)
    return list
end

function Extensions.SentinelEngine.Step(tracker, s, hooks)
    local cfg = Extensions.SentinelEngine.Config
    local now = s.t
    local events = {}
    local function evidence(name, points, reason)
        if Extensions.SentinelEngine.AddEvidence(tracker, name, points, reason, now) then
            table.insert(events, name)
        end
    end
    local function rebase(graceSeconds)
        tracker.Prev = {t = now, x = s.x, y = s.y, z = s.z}
        tracker.Window = {}
        tracker.VyHist = {}
        tracker.AirTime = 0
        tracker.WasAir = false
        tracker.AirStartY = s.y
        tracker.HighJumpFlagged = false
        tracker.PrevVy = nil
        if graceSeconds and graceSeconds > 0 then
            tracker.GraceUntil = math.max(tracker.GraceUntil or 0, now + graceSeconds)
        end
    end
    if s.dead then
        rebase(cfg.SpawnGrace)
        return events
    end
    if s.seated then
        rebase(cfg.SeatGrace)
        return events
    end
    if now < (tracker.GraceUntil or 0) then
        rebase(0)
        return events
    end
    local prev = tracker.Prev
    if not prev then
        rebase(0)
        return events
    end
    local dt = now - prev.t
    if dt < cfg.MinDt then
        return events
    end
    if dt > cfg.MaxDt then
        rebase(0)
        return events
    end
    local ws = s.walkSpeed or 16
    local reported = s.linSpeed or 0
    local reportedHorizontal = s.hSpeed or reported
    local gvx = 0
    local gvz = 0
    if s.groundMoving then
        gvx = s.groundVx or 0
        gvz = s.groundVz or 0
    end
    local dx = (s.x - prev.x) - gvx * dt
    local dz = (s.z - prev.z) - gvz * dt
    local dy = s.y - prev.y
    local hd = math.sqrt(dx * dx + dz * dz)
    local vy = dy / dt
    local vup = math.max(dy, 0)
    local vdown = math.max(-dy - cfg.FallAllow * dt, 0)
    local td = math.sqrt(hd * hd + vup * vup + vdown * vdown)
    local limit = cfg.TeleportBase + (ws + cfg.TeleportMargin) * dt
    local big = td > limit and td > reported * dt * 2 + 10
    if big then
        local continuing = tracker.BigT ~= nil and (now - tracker.BigT) <= cfg.BigStepTimeout
        if continuing then
            tracker.BigStreak = tracker.BigStreak + 1
        else
            tracker.BigStreak = 1
        end
        tracker.BigT = now
        if tracker.BigStreak == 1 then
            local points = 4
            if td > 150 then
                points = 6
            end
            evidence("Teleport", points, string.format("nhảy %.0f studs trong %.2fs", td, dt))
        else
            evidence("Tween", 3, string.format("lướt %.0f studs/s liên tục", td / dt))
        end
        tracker.Prev = {t = now, x = s.x, y = s.y, z = s.z}
        tracker.Window = {}
        tracker.VyHist = {}
        tracker.PrevVy = nil
        return events
    elseif tracker.BigT ~= nil and (now - tracker.BigT) > cfg.BigStepTimeout then
        tracker.BigStreak = 0
    end
    local spinning = (s.angSpeed or 0) > cfg.SpinSpeed
    if not s.ragdoll then
        if spinning then
            evidence("SpinFling", 2, string.format("xoay %.0f rad/s", s.angSpeed))
        end
        if reported > cfg.FlingSpeed then
            evidence("SpinFling", 2, string.format("vận tốc %.0f studs/s", reported))
        end
    end
    local ux = 0
    local uz = 0
    if hd > 0.01 then
        ux = dx / hd
        uz = dz / hd
    end
    table.insert(tracker.Window, {hs = hd / dt, ux = ux, uz = uz, rep = reportedHorizontal})
    while #tracker.Window > cfg.WindowSize do
        table.remove(tracker.Window, 1)
    end
    if #tracker.Window >= 4 and not spinning and reported <= cfg.FlingSpeed and not s.ragdoll then
        local sum = 0
        local sx = 0
        local sz = 0
        local rep = 0
        for _, w in ipairs(tracker.Window) do
            sum = sum + w.hs
            sx = sx + w.ux
            sz = sz + w.uz
            rep = rep + w.rep
        end
        local n = #tracker.Window
        local avg = sum / n
        local straight = math.sqrt(sx * sx + sz * sz) / n
        if avg > ws * cfg.TweenFactor + cfg.TweenExtra and straight > 0.85 then
            evidence("Tween", 2.5, string.format("%.0f studs/s theo đường thẳng", avg))
        elseif avg > ws * cfg.SpeedFactor + cfg.SpeedExtra then
            local points = 1.5
            local reason = string.format("%.0f studs/s (cho phép %.0f)", avg, ws)
            if rep / n < avg * 0.35 then
                points = 2.2
                reason = reason .. ", dạng CFrame"
            end
            evidence("Speed", points, reason)
        end
    end
    if hooks and hooks.WallBetween and hd > 0.4 and td < cfg.WallDistanceMax then
        if hooks.WallBetween(prev, s) then
            evidence("Noclip", 2.5, "đi xuyên vật cản")
        end
    end
    table.insert(tracker.VyHist, vy)
    while #tracker.VyHist > 3 do
        table.remove(tracker.VyHist, 1)
    end
    local vySum = 0
    for _, value in ipairs(tracker.VyHist) do
        vySum = vySum + value
    end
    local avgVy = vySum / #tracker.VyHist
    local air = s.groundDist == nil or s.groundDist > cfg.AirThreshold
    if air then
        if not tracker.WasAir then
            tracker.AirTime = 0
            tracker.HighJumpFlagged = false
        end
        tracker.AirTime = tracker.AirTime + dt
        local falling = avgVy <= cfg.FallingVelocity
        if tracker.AirTime > cfg.FlyAirTime and not falling and not s.ragdoll and not s.climbing then
            local climbable = hooks and hooks.NearClimbable and hooks.NearClimbable(s.x, s.y, s.z)
            if not climbable then
                local points = 2
                if avgVy > 3 then
                    points = 2.5
                end
                evidence("Fly", points, string.format("lơ lửng %.1fs, vy=%.1f", tracker.AirTime, avgVy))
            end
        end
        local rise = s.y - (tracker.AirStartY or s.y)
        local jumpHeight = s.jumpHeight or cfg.JumpHeightDefault
        if rise > jumpHeight * 1.35 + cfg.HighJumpMargin and not tracker.HighJumpFlagged and not s.climbing then
            tracker.HighJumpFlagged = true
            evidence("HighJump", 3.5, string.format("lên cao %.1f (tối đa %.1f)", rise, jumpHeight))
        end
        if tracker.PrevVy and tracker.PrevVy < -2 and vy > cfg.AirJumpVelocity then
            evidence("AirJump", 3, "bật lên giữa không trung")
        end
    else
        tracker.AirTime = 0
        tracker.HighJumpFlagged = false
        tracker.AirStartY = s.y
    end
    tracker.WasAir = air
    tracker.PrevVy = vy
    tracker.Prev = {t = now, x = s.x, y = s.y, z = s.z}
    return events
end


