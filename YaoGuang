function Extensions.UpperUtf8(text)
    local pieces = {}
    for _, codepoint in utf8.codes(tostring(text or "")) do
        local mapped = codepoint
        if codepoint >= 97 and codepoint <= 122 then
            mapped = codepoint - 32
        elseif codepoint >= 0xE0 and codepoint <= 0xFE and codepoint ~= 0xF7 then
            mapped = codepoint - 32
        elseif codepoint == 0x103 or codepoint == 0x111 or codepoint == 0x129 or codepoint == 0x169 or codepoint == 0x1A1 or codepoint == 0x1B0 then
            mapped = codepoint - 1
        elseif codepoint >= 0x1EA1 and codepoint <= 0x1EF9 and codepoint % 2 == 1 then
            mapped = codepoint - 1
        end
        pieces[#pieces + 1] = utf8.char(mapped)
    end
    return table.concat(pieces)
end

function Extensions.MakeShortFunctionName(text, maximum)
    local source = tostring(text or "BTN")
    local compact = string.gsub(source, "[%c]+", " ")
    compact = string.gsub(compact, "^%s*(.-)%s*$", "%1")
    local limit = math.max(3, tonumber(maximum) or 9)
    local length = utf8.len(compact) or #compact
    if length > limit then
        local built = ""
        for word in string.gmatch(compact, "%S+") do
            local candidate = built == "" and word or (built .. " " .. word)
            if (utf8.len(candidate) or #candidate) <= limit then
                built = candidate
            else
                break
            end
        end
        if built == "" then
            local offset = utf8.offset(compact, limit + 1)
            built = offset and string.sub(compact, 1, offset - 1) or string.sub(compact, 1, limit)
        end
        compact = built
    end
    return Extensions.UpperUtf8(compact)
end

function Extensions.GetFunctionPresentation(text, page)
    local source = string.lower(tostring(text or ""))
    for _, rule in ipairs(Extensions.FunctionPresentationRules) do
        if string.find(source, rule[1], 1, true) then
            return rule[2], rule[3]
        end
    end
    local pageIcons = {
        Movement = "footprints", Player = "person-standing", ESP = "scan-eye", Info = "info",
        Misc = "settings-2", World = "sun"
    }
    return pageIcons[tostring(page)] or "mouse-pointer-click", Extensions.MakeShortFunctionName(text, 9)
end

function Extensions.GetExternalTone(tone)
    if tone == "active" then return Theme.Accent, Theme.Success end
    if tone == "warning" then return Theme.Warning, Theme.Warning end
    if tone == "danger" then return Theme.Danger, Theme.Danger end
    if tone == "accent" then return Theme.Accent2, nil end
    return nil, nil
end

function Extensions.ApplyExternalActionPresentation(button, text, iconName, shortName)
    if not button or not button:IsA("TextButton") then return nil end
    local resolvedIcon, resolvedShort = Extensions.GetFunctionPresentation(text, nil)
    iconName = iconName or resolvedIcon
    shortName = tostring(shortName or resolvedShort or "BTN")
    button:SetAttribute("RaphaelExtText", tostring(text or ""))
    button:SetAttribute("RaphaelExtIcon", iconName)
    button:SetAttribute("RaphaelExtShort", shortName)
    State.ExternalButtonSet[button] = true
    local style = State.ButtonStyle
    local size = style.Size
    local tone = button:GetAttribute("RaphaelTone")
    if not tone then tone = button:GetAttribute("RaphaelActive") and "active" or "idle" end
    local editing = button:GetAttribute("RaphaelEditing") == true
    local fill, signal = Extensions.GetExternalTone(tone)
    local lit = tone ~= "idle"
    for _, child in ipairs(button:GetChildren()) do
        local childName = tostring(child.Name)
        if child:IsA("UIGradient") then
            child.Enabled = false
        elseif child:IsA("UIStroke") then
            child.Enabled = childName == "RaphaelExtStroke"
        elseif string.sub(childName, 1, 16) == "RaphaelExternal" then
            child:Destroy()
        end
    end
    local labelSize = math.floor(math.clamp(size * 0.18, 10, 14))
    local iconSize = math.floor(math.clamp(size * 0.38, 18, 34))
    button.Size = UDim2.fromOffset(size, size)
    button.BackgroundColor3 = fill and fill:Lerp(Theme.Background, 0.5) or Color3.fromRGB(20, 19, 28)
    button.BackgroundTransparency = math.clamp(style.Opacity / 100 - (lit and 0.1 or 0), 0, 0.92)
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.ClipsDescendants = true
    button.Font = Enum.Font.GothamBold
    button.TextSize = labelSize
    button.TextColor3 = lit and Theme.Text or Theme.SubText
    button.TextXAlignment = Enum.TextXAlignment.Center
    button.TextYAlignment = Enum.TextYAlignment.Center
    button.TextWrapped = false
    button.Text = editing and "MOVE" or shortName

    local corner = button:FindFirstChildOfClass("UICorner")
    if not corner then
        corner = Instance.new("UICorner")
        corner.Parent = button
    end
    corner.CornerRadius = UDim.new(0, math.floor(size * 0.28))

    local stroke = button:FindFirstChild("RaphaelExtStroke")
    if not stroke then
        stroke = Instance.new("UIStroke")
        stroke.Name = "RaphaelExtStroke"
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = button
    end
    if editing then
        stroke.Color = Theme.Warning
        stroke.Transparency = 0.05
        stroke.Thickness = 2
    elseif lit then
        stroke.Color = signal or fill or Theme.Accent
        stroke.Transparency = 0.2
        stroke.Thickness = 1.6
    else
        stroke.Color = Color3.fromRGB(255, 255, 255)
        stroke.Transparency = 0.82
        stroke.Thickness = 1
    end

    local label = UI.ProtectButtonText(button, 0)
    if label then
        label.Visible = style.Labels
        label.AnchorPoint = Vector2.new(0.5, 1)
        label.Position = UDim2.new(0.5, 0, 1, -math.floor(size * 0.07))
        label.Size = UDim2.new(1, -8, 0, labelSize + 4)
        label.Text = button.Text
        label.TextSize = labelSize
        label.Font = Enum.Font.GothamBold
        label.TextColor3 = button.TextColor3
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.TextTruncate = Enum.TextTruncate.AtEnd
        label.TextWrapped = false
        label.ZIndex = button.ZIndex + 4
    end

    local icon = button:FindFirstChild("RaphaelFunctionIcon")
    if not icon then
        icon = UI.CreateIcon(button, iconName, iconSize, Theme.Text)
        icon.Name = "RaphaelFunctionIcon"
    else
        UI.SetIcon(icon, iconName)
    end
    icon.AnchorPoint = Vector2.new(0.5, 0.5)
    icon.Size = UDim2.fromOffset(iconSize, iconSize)
    icon.Position = UDim2.new(0.5, 0, style.Labels and 0.4 or 0.5, 0)
    icon.ImageColor3 = lit and (signal and Theme.Text or Theme.AccentSoft) or Theme.Text
    icon.ImageTransparency = lit and 0 or 0.12
    icon.ZIndex = button.ZIndex + 4

    local led = button:FindFirstChild("RaphaelExtLed")
    if not led then
        led = Instance.new("Frame")
        led.Name = "RaphaelExtLed"
        led.AnchorPoint = Vector2.new(1, 0)
        led.Size = UDim2.fromOffset(8, 8)
        led.BorderSizePixel = 0
        led.Parent = button
        Instance.new("UICorner", led).CornerRadius = UDim.new(1, 0)
    end
    led.Position = UDim2.new(1, -math.floor(size * 0.1), 0, math.floor(size * 0.1))
    led.Visible = signal ~= nil or editing
    led.BackgroundColor3 = editing and Theme.Warning or (signal or Theme.Success)
    led.ZIndex = button.ZIndex + 5
    return icon, label
end

function Extensions.RefreshExternalButtonStyle()
    for button in pairs(State.ExternalButtonSet) do
        if button and button.Parent then
            Extensions.ApplyExternalActionPresentation(button, button:GetAttribute("RaphaelExtText"), button:GetAttribute("RaphaelExtIcon"), button:GetAttribute("RaphaelExtShort"))
        else
            State.ExternalButtonSet[button] = nil
        end
    end
end

function Extensions.RegisterToggleControl(text, control, instance)
    if not control or type(control.Set) ~= "function" or type(control.Get) ~= "function" then return nil end
    local base = tostring(text or "Toggle")
    local count = (State.ToggleRegistryNameCounts[base] or 0) + 1
    State.ToggleRegistryNameCounts[base] = count
    local id = base .. (count > 1 and (" #" .. count) or "")
    local page = Extensions.GetControlPageName(instance)
    local iconName, shortName = Extensions.GetFunctionPresentation(base, page)
    local entry = {
        Id = id,
        Name = base,
        Page = page,
        Icon = iconName,
        ShortName = shortName,
        Control = control,
        Source = instance,
        Order = #State.ToggleRegistry + 1
    }
    State.ToggleRegistry[#State.ToggleRegistry + 1] = entry
    State.ToggleRegistryById[id] = entry
    return entry
end

