    glow.BackgroundColor3 = Theme.Accent2
    glow.BackgroundTransparency = defaultValue and 0.76 or 1
    glow.BorderSizePixel = 0
    glow.Parent = row
    Instance.new("UICorner", glow).CornerRadius = UDim.new(0, 13)

    local button = Instance.new("TextButton")
    button.Size = UDim2.fromOffset(32, 32)
    button.Position = UDim2.new(1, -35, 0.5, -16)
    button.BackgroundColor3 = defaultValue and Theme.Accent or Theme.SurfaceLight
    button.BackgroundTransparency = defaultValue and 0.08 or 0.28
    button.BorderSizePixel = 0
    button.Text = ""
    button.AutoButtonColor = false
    button.Rotation = defaultValue and 0 or -4
    button.Parent = row
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 10)

    local buttonGradient = Instance.new("UIGradient")
    buttonGradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.Accent2),
        ColorSequenceKeypoint.new(0.52, Theme.Accent:Lerp(Color3.fromRGB(255, 255, 255), 0.1)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(128, 213, 255))
    })
    buttonGradient.Rotation = 45
    buttonGradient.Enabled = defaultValue
    buttonGradient.Parent = button

    local stateIcon = UI.CreateIcon(button, defaultValue and "check" or "power", 15, defaultValue and Theme.Text or Theme.SubText)
    stateIcon.AnchorPoint = Vector2.new(0.5, 0.5)
    stateIcon.Position = UDim2.fromScale(0.5, 0.5)
    stateIcon.Rotation = defaultValue and 0 or -12
    stateIcon.ZIndex = button.ZIndex + 2
    UI.AddRipple(button, Theme.Text)

    local value = defaultValue
    local function setValue(newValue, invoke)
        value = not not newValue
        buttonGradient.Enabled = value
        stateIcon.Image = UI.GetIcon(value and "check" or "power")
        tween(button, {
            BackgroundColor3 = value and Theme.Accent or Theme.SurfaceLight,
            BackgroundTransparency = value and 0.08 or 0.28,
            Rotation = value and 0 or -4
        })
        tween(stateIcon, {
            ImageColor3 = value and Theme.Text or Theme.SubText,
            Rotation = value and 0 or -12
        })
        tween(glow, {BackgroundTransparency = value and 0.76 or 1})
        if invoke ~= false and callback then
            callback(value)
        end
    end

    connect(button.Activated, function()
        tween(button, {Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -33, 0.5, -14)}, 0.06)
        task.delay(0.07, function()
            if button.Parent then
                tween(button, {Size = UDim2.fromOffset(32, 32), Position = UDim2.new(1, -35, 0.5, -16)}, 0.1)
            end
        end)
        setValue(not value, true)
    end)

    return {
        Set = setValue,
        Get = function()
            return value
        end,
        Instance = row
    }
end

