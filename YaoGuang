Extensions.InstallAntiKick = function()
    local antiKick = State.AntiKick
    local guiService = game:GetService("GuiService")

    local function refreshCounter()
        local label = antiKick.CountLabel
        if label and label.Parent then
            label.Text = tostring(antiKick.BlockedCount) .. (antiKick.LastBlockedReason ~= "" and ("  ·  " .. antiKick.LastBlockedReason) or "")
        end
    end

    local function recordBlock(reason)
        antiKick.BlockedCount = antiKick.BlockedCount + 1
        antiKick.LastBlockedReason = reason
        antiKick.LastBlockedAt = os.clock()
        refreshCounter()
        notify("Anti Kick đã chặn · " .. reason, Theme.Warning)
        if State.ActivityLog.Enabled then
            Extensions.PushActivityLog("[ANTI KICK] " .. reason, "warn", true)
        end
    end
    Extensions.RecordAntiKickBlock = recordBlock

    Extensions.NamecallHandlers.Kick = function(self, method, fromExecutor, reason)
        if fromExecutor or not antiKick.Enabled or not antiKick.BlockKick or self ~= LocalPlayer then return false end
        local text = type(reason) == "string" and reason or "không rõ lý do"
        task.defer(recordBlock, "Kick(" .. text .. ")")
        return true, nil
    end
    Extensions.NamecallHandlers.kick = Extensions.NamecallHandlers.Kick
    Extensions.NamecallHandlers.Shutdown = function(self, method, fromExecutor)
        if fromExecutor or not antiKick.Enabled or not antiKick.BlockShutdown or self ~= game then return false end
        task.defer(recordBlock, "game:Shutdown()")
        return true, nil
    end

    function Extensions.InstallKickFunctionHook()
        if antiKick.FunctionHooked then return true end
        if type(hookfunction) ~= "function" then return false end
        local existing = RuntimeEnvironment.RaphaelKickSlot
        if type(existing) == "table" and type(existing.Original) == "function" then
            existing.AntiKick = antiKick
            antiKick.FunctionHooked = true
            return true
        end
        local wrapClosure = type(newcclosure) == "function" and newcclosure or function(callback) return callback end
        local readCaller = type(checkcaller) == "function" and checkcaller or function() return false end
        local slot = {Original = nil, AntiKick = antiKick}
        local success = pcall(function()
            slot.Original = hookfunction(LocalPlayer.Kick, wrapClosure(function(self, ...)
                local active = slot.AntiKick
                if self == LocalPlayer and active.Enabled and active.BlockKick and active.DeepHook and not readCaller() then
                    task.defer(Extensions.RecordAntiKickBlock, "Kick()")
                    return nil
                end
                return slot.Original(self, ...)
            end))
        end)
        if success and type(slot.Original) == "function" then
            RuntimeEnvironment.RaphaelKickSlot = slot
            antiKick.FunctionHooked = true
        end
        return antiKick.FunctionHooked
    end

    local function attemptRejoin(reason)
        if not antiKick.Enabled or not antiKick.AutoRejoin or not State.Running then return end
        local now = os.clock()
        local history = antiKick.RejoinHistory
        for index = #history, 1, -1 do
            if now - history[index] > 600 then table.remove(history, index) end
        end
        if #history >= 3 then return end
        history[#history + 1] = now
        antiKick.RejoinPending = true
        notify("Mất kết nối · " .. tostring(reason) .. " · tự vào lại server", Theme.Warning)
        task.delay(1.6, function()
            if not State.Running then return end
            pcall(function()
                if game.JobId ~= "" then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
                else
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end
            end)
        end)
    end

    function Extensions.GetAntiKickStatusText()
        local namecall = Extensions.NamecallState.Installed and "namecall ✓" or "namecall ✗"
        local direct = "hàm Kick · tắt"
        if antiKick.DeepHook then direct = antiKick.FunctionHooked and "hàm Kick ✓" or "hàm Kick ✗" end
        local idle = antiKick.IdleConnection and "chống idle ✓" or "chống idle ✗"
        return namecall .. "  ·  " .. direct .. "  ·  " .. idle
    end

    function Extensions.RefreshAntiKick()
        if antiKick.Enabled and antiKick.BlockKick then
            Extensions.InstallNamecallHook()
            if antiKick.DeepHook then Extensions.InstallKickFunctionHook() end
        end
        if antiKick.Enabled and antiKick.IdleGuard then
            if not antiKick.IdleConnection then
                antiKick.IdleConnection = LocalPlayer.Idled:Connect(function()
                    pcall(function()
                        VirtualUser:CaptureController()
                        VirtualUser:ClickButton2(Vector2.new(0, 0))
                    end)
                end)
            end
        elseif antiKick.IdleConnection then
            antiKick.IdleConnection:Disconnect()
            antiKick.IdleConnection = nil
        end
        if antiKick.Enabled and antiKick.AutoRejoin then
            if not antiKick.PromptConnection then
                pcall(function()
                    antiKick.PromptConnection = guiService.ErrorMessageChanged:Connect(function(message)
                        if type(message) == "string" and message ~= "" then
                            attemptRejoin(string.sub(message, 1, 40))
                        end
                    end)
                end)
            end
            if not antiKick.TeleportFailConnection then
                pcall(function()
                    antiKick.TeleportFailConnection = TeleportService.TeleportInitFailed:Connect(function()
                        if antiKick.RejoinPending and State.Running then
                            antiKick.RejoinPending = false
                            pcall(function() TeleportService:Teleport(game.PlaceId, LocalPlayer) end)
                        end
                    end)
                end)
            end
        else
            if antiKick.PromptConnection then
                antiKick.PromptConnection:Disconnect()
                antiKick.PromptConnection = nil
            end
            if antiKick.TeleportFailConnection then
                antiKick.TeleportFailConnection:Disconnect()
                antiKick.TeleportFailConnection = nil
            end
        end
        antiKick.Status = Extensions.GetAntiKickStatusText()
        if antiKick.StatusLabel and antiKick.StatusLabel.Parent then antiKick.StatusLabel.Text = antiKick.Status end
        local control = State.ConfigControls.AntiKickEnabled
        if control and control.Set then control.Set(antiKick.Enabled, false) end
        refreshCounter()
    end

    function Extensions.ShutdownAntiKick()
        for _, key in ipairs({"IdleConnection", "PromptConnection", "TeleportFailConnection"}) do
            if antiKick[key] then
                pcall(function() antiKick[key]:Disconnect() end)
                antiKick[key] = nil
            end
        end
        antiKick.Enabled = false
    end

    Extensions.RefreshAntiKick()
end

if not pcall(Extensions.InstallAntiKick) then
    warn("[Raphael] Anti Kick không khởi tạo được.")
end

