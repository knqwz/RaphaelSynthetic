function Extensions.RefreshAnomalyPanel()
    local monitor = State.AnomalyMonitor
    local players = Players:GetPlayers()
    table.sort(players, function(left, right) return string.lower(left.Name) < string.lower(right.Name) end)
    local rowCount, suspicious = 0, 0
    local signatureParts = {}
    for _, player in ipairs(players) do
        if player ~= LocalPlayer then
            rowCount = rowCount + 1
            local finding = monitor.Findings[player]
            local signature = finding and finding.Signature or ""
            local confidence = finding and tonumber(finding.Confidence) or 0
            if signature ~= "" then suspicious = suspicious + 1 end
            signatureParts[#signatureParts + 1] = tostring(player.UserId) .. ":" .. signature .. ":" .. tostring(math.floor(confidence / 4))
        end
    end
    if monitor.HeaderButton then monitor.HeaderButton.Text = "ANOMALY CHECKER  ·  " .. suspicious end
    if monitor.DrawerIcon then monitor.DrawerIcon.Rotation = monitor.Expanded and 0 or 180 end
    if monitor.ScanButton then
        monitor.ScanButton.Text = monitor.Enabled and "DỪNG QUÉT" or "BẬT QUÉT"
        monitor.ScanButton.BackgroundColor3 = monitor.Enabled and Theme.Danger or Theme.Accent
        monitor.ScanButton.BackgroundTransparency = monitor.Enabled and 0.28 or 0.38
    end
    if monitor.LogButton then
        monitor.LogButton.Text = State.ActivityLog.Enabled and "DỪNG LOG" or "BẬT LOG"
        monitor.LogButton.BackgroundColor3 = State.ActivityLog.Enabled and Theme.Danger or Theme.Accent2
        monitor.LogButton.BackgroundTransparency = State.ActivityLog.Enabled and 0.28 or 0.38
    end
    if monitor.Status then
        if monitor.Tab == "Self" then
            monitor.Status.Text = "Bản thân · Sentinel + thay đổi Humanoid/FOV/Gravity/CoreGui quan sát được"
        elseif monitor.Tab == "Log" then
            monitor.Status.Text = "Server Activity Log · chat, player, state, tool, client log và RemoteEvent nhận được"
        else
            monitor.Status.Text = "Sentinel quan sát " .. rowCount .. " player · " .. suspicious .. " vượt ngưỡng · chỉ dữ liệu replicate"
        end
    end
    if not monitor.Panel or not monitor.Expanded then return end
    if monitor.Tab == "Players" and monitor.List then
        local renderNow = os.clock()
        if monitor.PanelSignature and renderNow - (monitor.LastPlayerRender or 0) < 0.55 then return end
        monitor.LastPlayerRender = renderNow
        local panelSignature = table.concat(signatureParts, "|")
        if monitor.PanelSignature ~= panelSignature or #monitor.List:GetChildren() <= 2 then
            monitor.PanelSignature = panelSignature
            Extensions.ClearDrawerRows(monitor.List)
            local order = 0
            for _, player in ipairs(players) do
                if player ~= LocalPlayer then
                    order = order + 1
                    Extensions.CreateSentinelPlayerRow(monitor.List, player, order)
                end
            end
            monitor.List.CanvasSize = UDim2.fromOffset(0, order * 86)
        end
    elseif monitor.Tab == "Self" and monitor.SelfList then
        local renderNow = os.clock()
        if monitor.SelfSignature and renderNow - (monitor.LastSelfRender or 0) < 0.5 then return end
        monitor.LastSelfRender = renderNow
        local finding = monitor.Findings[LocalPlayer]
        local first = State.ActivityLog.SelfEntries[1]
        local signature = (finding and finding.Signature or "") .. ":" .. tostring(#State.ActivityLog.SelfEntries) .. ":" .. tostring(first and first.Time or "") .. ":" .. tostring(first and first.Text or "")
        if monitor.SelfSignature ~= signature or State.ActivityLog.SelfDirty then
            monitor.SelfSignature = signature
            State.ActivityLog.SelfDirty = false
            Extensions.RenderActivityEntries(monitor.SelfList, State.ActivityLog.SelfEntries, true)
        end
    elseif monitor.Tab == "Log" and monitor.LogList then
        local renderNow = os.clock()
        if monitor.LogSignature and renderNow - (monitor.LastLogRender or 0) < 0.8 then return end
        monitor.LastLogRender = renderNow
        local first = State.ActivityLog.Entries[1]
        local signature = tostring(#State.ActivityLog.Entries) .. ":" .. tostring(first and first.Time or "") .. ":" .. tostring(first and first.Text or "")
        if monitor.LogSignature ~= signature or State.ActivityLog.Dirty then
            monitor.LogSignature = signature
            State.ActivityLog.Dirty = false
            Extensions.RenderActivityEntries(monitor.LogList, State.ActivityLog.Entries, false)
        end
    end
end

function Extensions.IsRoutineActivityNoise(text, severity)
    if severity == "alert" or severity == "warn" or severity == "system" or severity == "chat" or severity == "remote" or severity == "join" or severity == "leave" then return false end
    local normalized = string.lower(tostring(text))
    if string.find(normalized, "[spawn]", 1, true) or string.find(normalized, "xuất hiện nhân vật", 1, true) then return true end
    if string.find(normalized, "[state]", 1, true) then
        for _, stateName in ipairs({"jumping", "freefall", "landed", "running", "runningnophysics", "gettingup", "fallingdown", "none"}) do
            if string.find(normalized, stateName, 1, true) then return true end
        end
    end
    return false
end

function Extensions.PushActivityLog(text, severity, selfEntry)
    local activity = State.ActivityLog
    text = tostring(text)
    severity = severity or "info"
    if Extensions.IsRoutineActivityNoise(text, severity) then return false end
    local duplicateKey = severity .. ":" .. text
    local now = os.clock()
    local previous = activity.RecentEvents[duplicateKey]
    activity.RecentEvents[duplicateKey] = now
    for key, timestamp in pairs(activity.RecentEvents) do
        if now - timestamp > 15 then activity.RecentEvents[key] = nil end
    end
    if previous and now - previous < 0.75 then return false end
    local entry = {Time = os.date("%H:%M:%S"), Text = text, Severity = severity}
    table.insert(activity.Entries, 1, entry)
    while #activity.Entries > activity.MaxEntries do table.remove(activity.Entries) end
    if selfEntry then
        table.insert(activity.SelfEntries, 1, entry)
        while #activity.SelfEntries > 120 do table.remove(activity.SelfEntries) end
        activity.SelfDirty = true
    end
    activity.Dirty = true
    if State.AnomalyMonitor.Panel and State.AnomalyMonitor.Expanded then Extensions.RefreshAnomalyPanel() end
end

function Extensions.TrackActivityConnection(connection)
    if connection then table.insert(State.ActivityLog.Connections, connection) end
    return connection
end

function Extensions.ClearActivityConnections()
    local activity = State.ActivityLog
    for _, connection in ipairs(activity.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(activity.Connections)
    activity.HookedPlayers = setmetatable({}, {__mode = "k"})
    activity.HookedRemotes = setmetatable({}, {__mode = "k"})
    activity.RemoteLastLog = setmetatable({}, {__mode = "k"})
    table.clear(activity.RecentEvents)
end

function Extensions.IsDuplicateActivityChat(player, message)
    local activity = State.ActivityLog
    local key = tostring(player and player.UserId or 0) .. ":" .. tostring(message)
    local now = os.clock()
    local previous = activity.RecentChat[key]
    activity.RecentChat[key] = now
    for savedKey, timestamp in pairs(activity.RecentChat) do
        if now - timestamp > 8 then activity.RecentChat[savedKey] = nil end
    end
    return previous ~= nil and now - previous < 1.2
end

function Extensions.LogActivityChat(player, message)
    if not State.ActivityLog.Enabled or Extensions.IsDuplicateActivityChat(player, message) then return end
    local author = player and (player.DisplayName .. " (@" .. player.Name .. ")") or "System"
    Extensions.PushActivityLog("[CHAT] " .. author .. ": " .. tostring(message), "chat", player == LocalPlayer)
end

function Extensions.FormatActivityValue(value)
    local kind = typeof(value)
    if kind == "Instance" then return value:GetFullName() end
    if kind == "Vector3" then return string.format("Vector3(%.1f, %.1f, %.1f)", value.X, value.Y, value.Z) end
    if kind == "CFrame" then
        local position = value.Position
        return string.format("CFrame(%.1f, %.1f, %.1f)", position.X, position.Y, position.Z)
    end
    if kind == "string" then
        local shortened = #value > 80 and string.sub(value, 1, 77) .. "..." or value
        return string.format("%q", shortened)
    end
    if kind == "table" then return "table" end
    return tostring(value)
end

function Extensions.HookActivityRemote(remote)
    local activity = State.ActivityLog
    if not activity.Enabled or activity.HookedRemotes[remote] or not remote:IsA("RemoteEvent") then return end
    activity.HookedRemotes[remote] = true
    Extensions.TrackActivityConnection(remote.OnClientEvent:Connect(function(...)
        if not activity.Enabled then return end
        local now = os.clock()
        if now - (activity.RemoteLastLog[remote] or 0) < 0.25 then return end
        activity.RemoteLastLog[remote] = now
        local values = {}
        for index = 1, math.min(select("#", ...), 5) do
            values[#values + 1] = Extensions.FormatActivityValue(select(index, ...))
        end
        local suffix = #values > 0 and (" · " .. table.concat(values, ", ")) or ""
        Extensions.PushActivityLog("[REMOTE→CLIENT] " .. remote:GetFullName() .. suffix, "remote", false)
    end))
end

function Extensions.CaptureSelfBaseline(character)
    local activity = State.ActivityLog
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local baseline = {
        WalkSpeed = humanoid.WalkSpeed,
        JumpPower = humanoid.JumpPower,
        JumpHeight = humanoid.JumpHeight,
        HipHeight = humanoid.HipHeight,
        MaxSlopeAngle = humanoid.MaxSlopeAngle,
        Gravity = Workspace.Gravity,
        FOV = (Workspace.CurrentCamera or Camera).FieldOfView,
    }
    activity.SelfBaseline = baseline
    activity.SelfLast = table.clone(baseline)
    table.clear(activity.SelfCanCollide)
    for _, name in ipairs({"HumanoidRootPart", "Head", "Torso", "UpperTorso", "LowerTorso"}) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then activity.SelfCanCollide[name] = part.CanCollide end
    end
    activity.SelfDirty = true
end

function Extensions.GetSelfChangeSeverity(name, value)
    local baseline = State.ActivityLog.SelfBaseline
    local original = baseline and baseline[name]
    if type(value) ~= "number" or type(original) ~= "number" then return "info" end
    if name == "WalkSpeed" and value >= original * 2 and value - original > 10 then return "alert" end
    if (name == "JumpPower" or name == "JumpHeight") and original > 0 and value >= original * 2 then return "alert" end
    if name == "HipHeight" and math.abs(value - original) > 2 then return "warn" end
    if name == "Gravity" and (value < original * 0.6 or value > original * 1.4) then return "alert" end
    if name == "FOV" and math.abs(value - original) > 25 then return "warn" end
    return "info"
end

function Extensions.ReportSelfChange(name, value)
    local activity = State.ActivityLog
    if not activity.Enabled or not activity.SelfBaseline then return end
    local old = activity.SelfLast[name]
    if old == value then return end
    activity.SelfLast[name] = value
    local severity = Extensions.GetSelfChangeSeverity(name, value)
    local function format(number)
        return type(number) == "number" and string.format("%.2f", number) or tostring(number)
    end
    Extensions.PushActivityLog("[SELF] " .. name .. ": " .. format(old) .. " → " .. format(value), severity, true)
end

function Extensions.HookActivityCharacter(player, character)
    if not State.ActivityLog.Enabled or not character then return end
    local isSelf = player == LocalPlayer
    Extensions.PushActivityLog((isSelf and "[SELF] " or "[SPAWN] ") .. player.DisplayName .. " xuất hiện nhân vật", "info", isSelf)
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
    if humanoid then
        local lastStateLog = 0
        Extensions.TrackActivityConnection(humanoid.StateChanged:Connect(function(_, state)
            if not State.ActivityLog.Enabled then return end
            local now = os.clock()
            local interesting = state == Enum.HumanoidStateType.Swimming or state == Enum.HumanoidStateType.Climbing or state == Enum.HumanoidStateType.Seated or state == Enum.HumanoidStateType.PlatformStanding
            if interesting and now - lastStateLog >= 1 then
                lastStateLog = now
                Extensions.PushActivityLog("[STATE] " .. player.Name .. " → " .. tostring(state):gsub("Enum.HumanoidStateType.", ""), "state", isSelf)
            end
        end))
        if isSelf then
            for _, property in ipairs({"WalkSpeed", "JumpPower", "JumpHeight", "HipHeight", "MaxSlopeAngle"}) do
                Extensions.TrackActivityConnection(humanoid:GetPropertyChangedSignal(property):Connect(function()
                    Extensions.ReportSelfChange(property, humanoid[property])
                end))
            end
            task.delay(1.2, function()
                if State.ActivityLog.Enabled and character.Parent then Extensions.CaptureSelfBaseline(character) end
            end)
        end
    end
    Extensions.TrackActivityConnection(character.DescendantAdded:Connect(function(instance)
        if not State.ActivityLog.Enabled then return end
        if instance:IsA("Tool") then
            Extensions.PushActivityLog("[TOOL] " .. player.Name .. " trang bị " .. instance.Name, "info", isSelf)
        elseif isSelf and (instance:IsA("BodyMover") or instance:IsA("LinearVelocity") or instance:IsA("AngularVelocity") or instance:IsA("AlignPosition") or instance:IsA("AlignOrientation") or instance:IsA("VectorForce")) then
            Extensions.PushActivityLog("[SELF] lực mới: " .. instance.ClassName .. " (" .. instance.Name .. ")", "warn", true)
        elseif isSelf and (instance:IsA("LocalScript") or instance:IsA("Script")) then
            Extensions.PushActivityLog("[SELF] script mới trong nhân vật: " .. instance.Name, "warn", true)
        end
    end))
end

function Extensions.HookActivityPlayer(player)
    local activity = State.ActivityLog
    if not activity.Enabled or activity.HookedPlayers[player] then return end
    activity.HookedPlayers[player] = true
    Extensions.TrackActivityConnection(player.Chatted:Connect(function(message)
        Extensions.LogActivityChat(player, message)
    end))
    Extensions.TrackActivityConnection(player.CharacterAdded:Connect(function(character)
        Extensions.HookActivityCharacter(player, character)
    end))
    Extensions.TrackActivityConnection(player:GetPropertyChangedSignal("Team"):Connect(function()
        Extensions.PushActivityLog("[TEAM] " .. player.Name .. " → " .. (player.Team and player.Team.Name or "không team"), "info", player == LocalPlayer)
    end))
    pcall(function()
        Extensions.TrackActivityConnection(player.AttributeChanged:Connect(function(attribute)
            Extensions.PushActivityLog("[ATTRIBUTE] " .. player.Name .. "." .. attribute .. " = " .. Extensions.FormatActivityValue(player:GetAttribute(attribute)), "info", player == LocalPlayer)
        end))
    end)
    if player.Character then Extensions.HookActivityCharacter(player, player.Character) end
end

function Extensions.CheckSelfActivity()
    local activity = State.ActivityLog
    if not activity.Enabled or os.clock() - activity.LastSelfCheck < 0.75 then return end
    activity.LastSelfCheck = os.clock()
    if activity.SelfBaseline then
        Extensions.ReportSelfChange("Gravity", Workspace.Gravity)
        Camera = Workspace.CurrentCamera or Camera
        Extensions.ReportSelfChange("FOV", Camera.FieldOfView)
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health > 0 then
            for name, baseline in pairs(activity.SelfCanCollide) do
                local part = character:FindFirstChild(name)
                if part and part:IsA("BasePart") and baseline == true and part.CanCollide == false then
                    activity.SelfCanCollide[name] = false
                    Extensions.PushActivityLog("[SELF] " .. name .. " mất va chạm (noclip?)", "alert", true)
                end
            end
        end
    end
    local currentCore = {}
    pcall(function()
        for _, child in ipairs(CoreGui:GetChildren()) do currentCore[child.Name] = true end
    end)
    if activity.CoreNames then
        for name in pairs(currentCore) do
            if not activity.CoreNames[name] then
                Extensions.PushActivityLog("[SELF] CoreGui có giao diện mới: " .. name, "warn", true)
            end
        end
    end
    activity.CoreNames = currentCore
end

function Extensions.SetActivityLogEnabled(enabled, silent)
    local activity = State.ActivityLog
    enabled = not not enabled
    if enabled == activity.Enabled then return true end
    Extensions.ClearActivityConnections()
    activity.Enabled = enabled
    if enabled then
        Extensions.PushActivityLog("Bắt đầu Server Activity Log · chỉ dữ liệu client nhìn thấy/được replicate.", "system", true)
        for _, player in ipairs(Players:GetPlayers()) do Extensions.HookActivityPlayer(player) end
        Extensions.TrackActivityConnection(Players.PlayerAdded:Connect(function(player)
            Extensions.PushActivityLog("[JOIN] " .. player.DisplayName .. " (@" .. player.Name .. ")", "join", false)
            Extensions.HookActivityPlayer(player)
        end))
        Extensions.TrackActivityConnection(Players.PlayerRemoving:Connect(function(player)
            Extensions.PushActivityLog("[LEAVE] " .. player.DisplayName .. " (@" .. player.Name .. ")", "leave", player == LocalPlayer)
        end))
        pcall(function()
            Extensions.TrackActivityConnection(TextChatService.MessageReceived:Connect(function(message)
                local source = message.TextSource
                local player = source and Players:GetPlayerByUserId(source.UserId) or nil
                Extensions.LogActivityChat(player, message.Text)
            end))
        end)
        Extensions.TrackActivityConnection(LogService.MessageOut:Connect(function(message, messageType)
            local typeName = tostring(messageType)
            local severity = string.find(typeName, "Error") and "alert" or string.find(typeName, "Warning") and "warn" or "console"
            Extensions.PushActivityLog("[CLIENT LOG] " .. tostring(message), severity, false)
        end))
        for _, descendant in ipairs(ReplicatedStorage:GetDescendants()) do Extensions.HookActivityRemote(descendant) end
        Extensions.TrackActivityConnection(ReplicatedStorage.DescendantAdded:Connect(Extensions.HookActivityRemote))
        if LocalPlayer.Character then task.defer(Extensions.CaptureSelfBaseline, LocalPlayer.Character) end
    else
        Extensions.PushActivityLog("Đã dừng Server Activity Log.", "system", true)
    end
    local control = State.ConfigControls.ActivityLog
    if control and control.Set then control.Set(enabled, false) end
    if State.AnomalyMonitor.LogButton then
        State.AnomalyMonitor.LogButton.Text = enabled and "DỪNG LOG" or "BẬT LOG"
        State.AnomalyMonitor.LogButton.BackgroundColor3 = enabled and Theme.Danger or Theme.Accent2
    end
    if not silent then notify(enabled and "Server Activity Log đã bật; chỉ ghi dữ liệu quan sát được từ client." or "Server Activity Log đã dừng.", enabled and Theme.Success or Theme.Warning) end
    Extensions.RefreshAnomalyPanel()
    return true
end

