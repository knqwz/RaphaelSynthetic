Extensions.SettingById = {}
Extensions.SettingDirtyCallbacks = {}

function Extensions.DefineSetting(definition)
    definition.Order = #Extensions.SettingDefs + 1
    Extensions.SettingDefs[definition.Order] = definition
    Extensions.SettingById[definition.Id] = definition
    return definition
end

function Extensions.ReadSetting(identifier)
    local definition = Extensions.SettingById[identifier]
    if not definition then return nil end
    return definition.Get()
end

function Extensions.NormalizeSettingValue(definition, value)
    if definition.Type == "number" then
        local numeric = tonumber(value)
        if not numeric then return nil end
        numeric = math.clamp(numeric, definition.Min, definition.Max)
        if definition.Integer then numeric = math.floor(numeric + 0.5) end
        if definition.Decimals and not definition.Integer then
            local scale = 10 ^ definition.Decimals
            numeric = math.floor(numeric * scale + 0.5) / scale
        end
        return numeric
    elseif definition.Type == "boolean" then
        return not not value
    elseif definition.Type == "choice" then
        if table.find(definition.Options, value) then return value end
        return nil
    elseif definition.Type == "color" then
        if typeof(value) == "Color3" then return value end
        return nil
    end
    return nil
end

function Extensions.WriteSetting(identifier, value, silent)
    local definition = Extensions.SettingById[identifier]
    if not definition then return false end
    local normalized = Extensions.NormalizeSettingValue(definition, value)
    if normalized == nil then return false end
    definition.Set(normalized)
    if definition.OnChange then
        local success, failure = pcall(definition.OnChange, normalized, silent == true)
        if not success then
            warn("[Raphael] OnChange " .. tostring(identifier) .. ": " .. tostring(failure))
        end
    end
    return true
end

function Extensions.BuildExtraConfig()
    local output = {}
    for _, definition in ipairs(Extensions.SettingDefs) do
        local success, value = pcall(definition.Get)
        if success and value ~= nil then
            if definition.Type == "color" then
                output[definition.Id] = Extensions.SerializeColor(value)
            else
                output[definition.Id] = value
            end
        end
    end
    return output
end

function Extensions.ApplyExtraConfig(source)
    if type(source) ~= "table" then return end
    for _, definition in ipairs(Extensions.SettingDefs) do
        local raw = source[definition.Id]
        if raw ~= nil then
            if definition.Type == "color" then
                raw = Extensions.DeserializeColor(raw, definition.Get())
            end
            if definition.Id == "MinimapRefreshSeconds" and tonumber(raw) == 12 then
                raw = 45
            end
            Extensions.WriteSetting(definition.Id, raw, true)
        end
    end
end

function Extensions.SyncSettingControls()
    for _, definition in ipairs(Extensions.SettingDefs) do
        local control = definition.Control
        if control then
            local success, value = pcall(definition.Get)
            if success and value ~= nil then
                if definition.Type == "number" and typeof(control) == "Instance" then
                    control.Text = Extensions.FormatSettingNumber(definition, value)
                elseif type(control) == "table" and control.Set then
                    control.Set(value, false)
                end
            end
        end
    end
end

function Extensions.FormatSettingNumber(definition, value)
    if definition.Integer then return tostring(math.floor(value + 0.5)) end
    local decimals = definition.Decimals or 2
    local text = string.format("%." .. decimals .. "f", value)
    text = string.gsub(text, "0+$", "")
    text = string.gsub(text, "%.$", "")
    return text
end

