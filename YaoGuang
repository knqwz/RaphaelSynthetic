function Extensions.NavigateFunctionSearch(entry)
    if not entry or not entry.Target or not entry.Target.Parent or not Extensions.SelectTab(entry.Page) then
        notify("Chức năng không còn khả dụng.", Theme.Warning)
        return
    end
    if State.FunctionSearchPanel then
        State.FunctionSearchPanel.Visible = false
    end
    if State.FunctionSearchBox then
        State.FunctionSearchBox:ReleaseFocus()
    end
    task.spawn(function()
        local page = Pages[entry.Page]
        local target = entry.Target
        if not page or not target or not target.Parent then
            return
        end
        RunService.Heartbeat:Wait()
        RunService.Heartbeat:Wait()
        if not page.Parent or not target.Parent then
            return
        end
        local targetY = target.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y - 8
        local maximumY = math.max(page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y, 0)
        local desiredY = math.clamp(targetY, 0, maximumY)
        TweenService:Create(page, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            CanvasPosition = Vector2.new(0, desiredY)
        }):Play()
        task.wait(0.22)
        if not page.Parent or not target.Parent then
            return
        end
        targetY = target.AbsolutePosition.Y - page.AbsolutePosition.Y + page.CanvasPosition.Y - 8
        maximumY = math.max(page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y, 0)
        page.CanvasPosition = Vector2.new(0, math.clamp(targetY, 0, maximumY))

        local focusScale = UI.Motion.GetScale(target)
        local focusToken = (target:GetAttribute("RaphaelSearchFocusToken") or 0) + 1
        target:SetAttribute("RaphaelSearchFocusToken", focusToken)
        if focusScale then
            focusScale.Scale = 1
            TweenService:Create(focusScale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1.065}):Play()
        end
        task.delay(0.2, function()
            if target.Parent and target:GetAttribute("RaphaelSearchFocusToken") == focusToken and focusScale and focusScale.Parent then
                TweenService:Create(focusScale, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Scale = 1}):Play()
            end
        end)
        notify("Đã mở: " .. entry.Name .. " · " .. entry.Page .. ".", Theme.Success)
    end)
end

function Extensions.RefreshFunctionSearch(query)
    local container = State.FunctionSearchResults
    local panel = State.FunctionSearchPanel
    if not container or not panel then
        return
    end
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("GuiObject") then
            child:Destroy()
        end
    end
    table.clear(State.FunctionSearchMatches)
    local normalized = Extensions.NormalizeSearchText(query)
    if normalized == "" then
        panel.Size = UDim2.fromOffset(264, 36)
        return
    end
    local matches = {}
    for _, entry in ipairs(State.FunctionSearchEntries) do
        if entry.Target and entry.Target.Parent then
            local position = string.find(entry.SearchText, normalized, 1, true)
            if position then
                local normalizedName = Extensions.NormalizeSearchText(entry.Name)
                local score = position + (string.sub(normalizedName, 1, #normalized) == normalized and 0 or 100) + #normalizedName * 0.01
                table.insert(matches, {Entry = entry, Score = score})
            end
        end
    end
    table.sort(matches, function(left, right)
        if left.Score == right.Score then
            if left.Entry.Name == right.Entry.Name then
                return (left.Entry.Section or left.Entry.Page) < (right.Entry.Section or right.Entry.Page)
            end
            return left.Entry.Name < right.Entry.Name
        end
        return left.Score < right.Score
    end)
    local resultCount = math.min(#matches, 4)
    for index = 1, resultCount do
        local entry = matches[index].Entry
        table.insert(State.FunctionSearchMatches, entry)
        local contextName = entry.Section or entry.Page
        if Extensions.NormalizeSearchText(contextName) == Extensions.NormalizeSearchText(entry.Name) then
            contextName = entry.Page
        end
        local resultButton = Instance.new("TextButton")
        resultButton.Name = "FunctionSearchResult"
        resultButton.Size = UDim2.new(1, 0, 0, 32)
        resultButton.BackgroundColor3 = Theme.SurfaceLight
        resultButton.BackgroundTransparency = 0.12
        resultButton.BorderSizePixel = 0
        resultButton.Text = entry.Name .. "  ·  " .. contextName
        resultButton.TextColor3 = Theme.Text
        resultButton.Font = Enum.Font.GothamMedium
        resultButton.TextSize = 10
        resultButton.TextXAlignment = Enum.TextXAlignment.Left
        resultButton.TextTruncate = Enum.TextTruncate.AtEnd
        resultButton.AutoButtonColor = false
        resultButton.LayoutOrder = index
        resultButton.ZIndex = 84
        resultButton:SetAttribute("RaphaelSearchResultButton", true)
        resultButton:SetAttribute("RaphaelButtonArtworkEnabled", true)
        resultButton:SetAttribute("RaphaelTextInset", 31)
        resultButton.Parent = container
        UI.ArtworkButtons[resultButton] = true
        Instance.new("UICorner", resultButton).CornerRadius = UDim.new(0, 7)
        local resultIcon = UI.CreateIcon(resultButton, UI.GetSectionIcon(contextName), 13, Theme.Text)
        resultIcon.AnchorPoint = Vector2.new(0, 0.5)
        resultIcon.Position = UDim2.new(0, 9, 0.5, 0)
        resultIcon.ZIndex = resultButton.ZIndex + 3
        UI.ApplyUnifiedButtonArtwork(resultButton)
        connect(resultButton.Activated, function()
            Extensions.NavigateFunctionSearch(entry)
        end)
    end
    panel.Size = UDim2.fromOffset(264, resultCount > 0 and 36 + resultCount * 36 or 36)
end

function Extensions.ToggleFunctionSearch(forceVisible)
    local panel = State.FunctionSearchPanel
    if not panel then
        return
    end
    panel.Visible = forceVisible == nil and not panel.Visible or not not forceVisible
    if panel.Visible and State.FunctionSearchBox then
        State.FunctionSearchBox:CaptureFocus()
        Extensions.RefreshFunctionSearch(State.FunctionSearchBox.Text)
    elseif State.FunctionSearchBox then
        State.FunctionSearchBox:ReleaseFocus()
    end
end

