function Extensions.NormalizeSearchText(text: any): string
    local normalized: string = tostring(text or "")
    local characters: {string} = {}
    local accentMap: any = Extensions.SearchAccentMap
    for _, codepoint: number in utf8.codes(normalized) do
        local character: string = utf8.char(codepoint)
        table.insert(characters, tostring(accentMap[character] or string.lower(character)))
    end
    normalized = table.concat(characters)
    normalized = string.gsub(normalized, "[^%w%s_]", " ")
    normalized = string.gsub(normalized, "%s+", " ")
    local trimmed = string.gsub(normalized, "^%s*(.-)%s*$", "%1")
    return trimmed
end

