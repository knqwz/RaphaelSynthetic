function Extensions.BindAntiStunCharacter(character, humanoid)
    Extensions.UnbindAntiStunCharacter()
    if not State.AntiStun or not character then return end
    State.AntiStunConnections.Added = character.DescendantAdded:Connect(function(descendant)
        if not State.AntiStun then return end
        Extensions.TrackAntiStunInstance(descendant)
        task.defer(function()
            if State.AntiStun and descendant.Parent and Extensions.NeutralizeAntiStunInstance(descendant) then
                Extensions.TriggerAntiStunRecovery("lực lạ")
            end
        end)
    end)
    if humanoid then
        State.AntiStunConnections.State = humanoid.StateChanged:Connect(function(_, newState)
            if not State.AntiStun or not State.AntiStunOptions.NoFall then return end
            if State.Flight.CharacterEnabled or State.ActiveTravelTween then return end
            if newState == Enum.HumanoidStateType.FallingDown or newState == Enum.HumanoidStateType.Ragdoll or newState == Enum.HumanoidStateType.Physics then
                task.defer(function()
                    if not State.AntiStun or not humanoid.Parent then return end
                    pcall(function()
                        humanoid.PlatformStand = false
                        humanoid:ChangeState(humanoid.FloorMaterial == Enum.Material.Air and Enum.HumanoidStateType.Freefall or Enum.HumanoidStateType.GettingUp)
                    end)
                    Extensions.TriggerAntiStunRecovery("té ngã")
                end)
            end
        end)
    end
end

function Extensions.RefreshAntiStunGhosts()
    local active = State.AntiStun and State.AntiStunOptions.GhostPlayers
    if not active then
        for part, originalValue in pairs(State.AntiStunGhostBackup) do
            if part and part.Parent then
                pcall(function() part.CanCollide = originalValue end)
            end
            State.AntiStunGhostBackup[part] = nil
        end
        return
    end
    for _, player in ipairs(Players:GetPlayers()) do
        local character = player ~= LocalPlayer and player.Character
        if character then
            for _, part in ipairs(character:GetChildren()) do
                if part:IsA("BasePart") and part.CanCollide then
                    if State.AntiStunGhostBackup[part] == nil then State.AntiStunGhostBackup[part] = true end
                    part.CanCollide = false
                end
            end
        end
    end
end

function Extensions.GetAntiStunFloorVelocity(root, character)
    local parameters = State.AntiStunRayParams
    parameters.FilterType = Enum.RaycastFilterType.Exclude
    parameters.FilterDescendantsInstances = {character}
    local result = Workspace:Raycast(root.Position, Vector3.new(0, -7, 0), parameters)
    if result and result.Instance then
        local floorVelocity = result.Instance.AssemblyLinearVelocity
        return Vector3.new(floorVelocity.X, 0, floorVelocity.Z)
    end
    return Vector3.zero
end

function Extensions.MaintainAntiStun(character, humanoid, root)
    if not State.AntiStun or not character or not humanoid or not root then return end
    local options = State.AntiStunOptions
    local now = os.clock()
    local original = rememberHumanoid(humanoid)
    local level = options.Level
    local strength = level == "Tối đa" and 3 or (level == "Mạnh" and 2 or 1)

    local speed = math.max(tonumber(original and original.WalkSpeed) or tonumber(humanoid.WalkSpeed) or 16, 0)
    if State.SpeedEnabled then
        speed = math.max(tonumber(State.SpeedValue) or speed, 0)
    end

    if now - (State.LastAntiStunMaintain or 0) >= 0.1 then
        State.LastAntiStunMaintain = now
        if options.NoFall then
            pcall(function()
                if humanoid:GetStateEnabled(Enum.HumanoidStateType.FallingDown) then humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false) end
                if humanoid:GetStateEnabled(Enum.HumanoidStateType.Ragdoll) then humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false) end
                if humanoid:GetStateEnabled(Enum.HumanoidStateType.Physics) then humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false) end
            end)
        end
        for descendant, kind in pairs(State.AntiStunTrackedInstances) do
            if not descendant or not descendant.Parent or not descendant:IsDescendantOf(character) then
                State.AntiStunTrackedInstances[descendant] = nil
            elseif kind == "Motor" then
                if not descendant.Enabled and options.NoFall then
                    Extensions.TriggerAntiStunRecovery("khớp bị tắt")
                    descendant.Enabled = true
                end
            elseif Extensions.NeutralizeAntiStunInstance(descendant) then
                Extensions.TriggerAntiStunRecovery("lực lạ")
            end
        end
        for _, object in ipairs({character, humanoid, root}) do
            for _, markerName in ipairs(State.AntiStunMarkerNames) do
                local attribute = object:GetAttribute(markerName)
                if attribute == true or type(attribute) == "number" and attribute > 0 then
                    Extensions.TriggerAntiStunRecovery("cờ trạng thái")
                    local lowerName = string.lower(markerName)
                    local neutral = string.find(lowerName, "slow", 1, true) and not string.find(lowerName, "time", 1, true) and 1 or 0
                    pcall(function()
                        object:SetAttribute(markerName, type(attribute) == "number" and neutral or false)
                    end)
                end
            end
        end
        if options.KeepSpeed and not State.SpeedEnabled and original then
            local baseWalk = tonumber(original.WalkSpeed) or 16
            local floorRatio = strength >= 3 and 0.75 or 0.15
            if baseWalk >= 8 and humanoid.WalkSpeed < baseWalk * floorRatio then
                humanoid.WalkSpeed = baseWalk
                Extensions.TriggerAntiStunRecovery("làm chậm")
            end
            if humanoid.UseJumpPower and original.UseJumpPower and (tonumber(original.JumpPower) or 0) > 10 and humanoid.JumpPower < 1 and not State.JumpEnabled then
                humanoid.JumpPower = original.JumpPower
            elseif not humanoid.UseJumpPower and not original.UseJumpPower and (tonumber(original.JumpHeight) or 0) > 1 and humanoid.JumpHeight < 0.2 and not State.JumpEnabled then
                humanoid.JumpHeight = original.JumpHeight
            end
        end
    end
    if options.GhostPlayers and now - (State.AntiStunLastGhostRefresh or 0) >= 0.12 then
        State.AntiStunLastGhostRefresh = now
        Extensions.RefreshAntiStunGhosts()
    end

    local velocity = root.AssemblyLinearVelocity
    if State.Flight.CharacterEnabled or State.ActiveTravelTween ~= nil then
        State.AntiStunLastStepVelocity = velocity
        return
    end
    local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
    local direction = humanoid.MoveDirection

    local jumpLimit
    if not State.JumpEnabled and original then
        jumpLimit = original.UseJumpPower and original.JumpPower or math.sqrt(math.max(2 * Workspace.Gravity * original.JumpHeight, 0))
    elseif State.JumpMethod == "JumpHeight" then
        jumpLimit = math.sqrt(math.max(2 * Workspace.Gravity * State.JumpValue, 0))
    else
        jumpLimit = State.JumpValue
    end
    jumpLimit = math.max(tonumber(jumpLimit) or 50, 20)

    local currentState = humanoid:GetState()
    local badState = options.NoFall and (humanoid.PlatformStand
        or humanoid.Sit and humanoid.SeatPart == nil
        or currentState == Enum.HumanoidStateType.FallingDown
        or currentState == Enum.HumanoidStateType.Ragdoll
        or currentState == Enum.HumanoidStateType.Physics)
    local jumpGrace = now - State.LastJumpRequest <= 0.7
    local horizontalLimit = math.max(speed * (strength == 1 and 2.35 or (strength == 2 and 1.7 or 1.3)), strength == 1 and 48 or (strength == 2 and 34 or 26))
    local upLimit = math.max(jumpLimit * (strength == 1 and 1.7 or (strength == 2 and 1.45 or 1.25)), strength == 1 and 62 or (strength == 2 and 52 or 46))
    local extremeHorizontal = options.NoFling and horizontal.Magnitude > horizontalLimit
    local extremeVertical = options.NoFling and (velocity.Y > upLimit and not jumpGrace or velocity.Y < -115)
    local last = State.AntiStunLastStepVelocity or velocity
    local deltaHorizontal = (horizontal - Vector3.new(last.X, 0, last.Z)).Magnitude
    local knockbackLimit = math.max(speed * (strength == 1 and 2.6 or (strength == 2 and 2.0 or 1.6)), strength == 1 and 42 or (strength == 2 and 30 or 24))
    local knocked = options.NoKnockback and deltaHorizontal > knockbackLimit
    local spinning = options.NoFling and root.AssemblyAngularVelocity.Magnitude > (strength == 1 and 18 or (strength == 2 and 9 or 5))
    local detected = badState or root.Anchored or extremeHorizontal or extremeVertical or knocked or spinning

    if detected then Extensions.TriggerAntiStunRecovery("trạng thái bất lợi") end
    local recovering = now < (State.AntiStunRecoveryUntil or 0)
    local correctedVelocity = velocity

    if recovering then
        if root.Anchored then root.Anchored = false end
        if options.NoFall then
            if humanoid.PlatformStand then humanoid.PlatformStand = false end
            if badState then
                humanoid.Sit = false
                pcall(function()
                    humanoid:ChangeState(humanoid.FloorMaterial == Enum.Material.Air and Enum.HumanoidStateType.Freefall or Enum.HumanoidStateType.Running)
                end)
            end
        end
        local correctedHorizontal = horizontal
        local wrongDirection = direction.Magnitude > 0.05 and horizontal.Magnitude > 1 and horizontal:Dot(direction.Unit) < -1
        if direction.Magnitude > 0.05 and (horizontal.Magnitude < math.max(speed * 0.22, 3) or extremeHorizontal or wrongDirection or knocked) then
            correctedHorizontal = direction.Unit * speed
        elseif extremeHorizontal or knocked then
            correctedHorizontal = Vector3.zero
        end
        local maximumUp = jumpGrace and math.max(jumpLimit * 1.3, 36) or math.max(jumpLimit, 42)
        local correctedY = math.clamp(velocity.Y, -90, maximumUp)
        correctedVelocity = Vector3.new(correctedHorizontal.X, correctedY, correctedHorizontal.Z)
        if (correctedVelocity - velocity).Magnitude > 0.5 then
            root.AssemblyLinearVelocity = correctedVelocity
        else
            correctedVelocity = velocity
        end
        if root.AssemblyAngularVelocity.Magnitude > 4 then
            root.AssemblyAngularVelocity = Vector3.zero
        end
    elseif options.NoSlide and direction.Magnitude < 0.05 and not humanoid.Sit and humanoid.FloorMaterial ~= Enum.Material.Air then
        local slideLimit = strength == 1 and 6 or (strength == 2 and 3.5 or 2)
        if horizontal.Magnitude > slideLimit then
            local floorVelocity = Extensions.GetAntiStunFloorVelocity(root, character)
            if (horizontal - floorVelocity).Magnitude > slideLimit then
                correctedVelocity = Vector3.new(floorVelocity.X, velocity.Y, floorVelocity.Z)
                root.AssemblyLinearVelocity = correctedVelocity
            end
        end
    end
    if not recovering and not detected then
        State.AntiStunLastHealthyVelocity = velocity
    end
    State.AntiStunLastStepVelocity = correctedVelocity
end

function Extensions.SetAntiStunEnabled(enabled, silent)
    State.AntiStun = not not enabled
    State.LastAntiStunMaintain = 0
    State.AntiStunRecoveryUntil = 0
    State.AntiStunLastTrigger = 0
    State.AntiStunTriggerCount = 0
    local character, humanoid, root = getCharacter()
    if State.AntiStun then
        State.AntiStunLastHealthyVelocity = root and root.AssemblyLinearVelocity or Vector3.zero
        State.AntiStunLastStepVelocity = root and root.AssemblyLinearVelocity or nil
        Extensions.RebuildAntiStunTracking(character)
        Extensions.BindAntiStunCharacter(character, humanoid)
        if humanoid and State.AntiStunOptions.NoFall then
            pcall(function()
                humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
            end)
        end
        Extensions.MaintainAntiStun(character, humanoid, root)
    else
        Extensions.UnbindAntiStunCharacter()
        if humanoid then
            local original = rememberHumanoid(humanoid)
            pcall(function()
                humanoid.PlatformStand = false
                humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, original and original.FallingDownEnabled or true)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, original and original.RagdollEnabled or true)
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, original and original.PhysicsEnabled or true)
            end)
        end
    end
    if not State.AntiStun then
        for instance, values in pairs(State.AntiStunInstanceBackup) do
            if instance and instance.Parent then
                for property, originalValue in pairs(values) do
                    pcall(function()
                        instance[property] = originalValue
                    end)
                end
            end
        end
        table.clear(State.AntiStunInstanceBackup)
        table.clear(State.AntiStunTrackedInstances)
    end
    Extensions.RefreshAntiStunGhosts()
    local control = State.ConfigControls.AntiStun
    if control and control.Set then
        control.Set(State.AntiStun, false)
    end
    if not silent then
        notify(State.AntiStun and ("Anti Stun nâng cao đã bật · cường độ " .. State.AntiStunOptions.Level .. ": chặn hất tung, trượt, đẩy lùi, té ngã.") or "Anti Stun đã tắt và đã khôi phục constraint.", State.AntiStun and Theme.Success or Theme.Warning)
    end
end

Extensions.ServerFetch = {
    Cache = {},
    LastNetworkAt = -100,
    Domains = {"games.roblox.com", "games.roproxy.com"},
    ActiveDomain = nil
}

function Extensions.GetHttpRequesters()
    local list = {}
    if type(request) == "function" then list[#list + 1] = request end
    if type(http_request) == "function" then list[#list + 1] = http_request end
    if type(syn) == "table" and type(syn.request) == "function" then list[#list + 1] = syn.request end
    if type(http) == "table" and type(http.request) == "function" then list[#list + 1] = http.request end
    if type(fluxus) == "table" and type(fluxus.request) == "function" then list[#list + 1] = fluxus.request end
    return list
end

function Extensions.DecodeServerPage(body)
    if type(body) ~= "string" or body == "" then return nil, "phản hồi rỗng", false end
    local decoded, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not decoded or type(data) ~= "table" then return nil, "phản hồi không phải JSON hợp lệ", false end
    if type(data.data) == "table" then return data, nil, false end
    local errors = type(data.errors) == "table" and data.errors[1] or nil
    local message = errors and tostring(errors.message or errors.code or "lỗi API") or "API không trả danh sách server"
    local limited = string.find(string.lower(message), "too many", 1, true) ~= nil or (errors and tonumber(errors.code) == 429) or false
    return nil, message, limited
end

function Extensions.RequestServerPage(url)
    local failure = "không rõ nguyên nhân"
    local limited = false
    local indexed, direct = pcall(function() return game.HttpGet end)
    local success, body
    if indexed and type(direct) == "function" then
        success, body = pcall(direct, game, url)
    else
        success, body = pcall(function() return game:HttpGet(url) end)
    end
    if success then
        local data, reason, wasLimited = Extensions.DecodeServerPage(body)
        if data then return data end
        failure = reason or failure
        limited = limited or wasLimited
    else
        local message = tostring(body)
        failure = "HttpGet: " .. string.sub(message, 1, 60)
        if string.find(message, "429", 1, true) or string.find(string.lower(message), "too many", 1, true) then limited = true end
    end
    for _, requester in ipairs(Extensions.GetHttpRequesters()) do
        local called, response = pcall(requester, {Url = url, Method = "GET", Headers = {["Accept"] = "application/json"}})
        if called and type(response) == "table" then
            local status = tonumber(response.StatusCode or response.Status)
            if status == 429 then
                limited = true
                failure = "HTTP 429"
            elseif status and (status < 200 or status >= 300) then
                failure = "HTTP " .. tostring(status)
            else
                local data, reason, wasLimited = Extensions.DecodeServerPage(response.Body)
                if data then return data end
                failure = reason or failure
                limited = limited or wasLimited
            end
        elseif not called then
            failure = "request: " .. string.sub(tostring(response), 1, 60)
        end
        if limited then break end
    end
    return nil, failure, limited
end

function Extensions.DescribeServerFailure(failure, limited)
    if limited then
        return "Roblox đang giới hạn tốc độ (HTTP 429) · chờ vài giây rồi bấm làm mới"
    end
    return "executor chặn HTTP hoặc API không phản hồi · " .. tostring(failure or "không rõ")
end

local function fetchServerCandidates(sortOrder, forceRefresh)
    local fetchState = Extensions.ServerFetch
    local cached = fetchState.Cache[sortOrder]
    if not forceRefresh and cached and os.clock() - cached.At < 45 and cached.JobId == game.JobId then
        local copy = {}
        for index, server in ipairs(cached.Servers) do copy[index] = server end
        return copy, nil
    end
    local wait = 2.2 - (os.clock() - fetchState.LastNetworkAt)
    if wait > 0 then task.wait(wait) end
    fetchState.LastNetworkAt = os.clock()
    local servers = {}
    local cursor = nil
    local failureReason = nil
    local domains = fetchState.Domains
    local domainIndex = 1
    if fetchState.ActiveDomain then
        for index, domain in ipairs(domains) do
            if domain == fetchState.ActiveDomain then domainIndex = index end
        end
    end
    for page = 1, 2 do
        local data, failure, limited
        local attempts = 0
        local tried = 0
        while true do
            local domain = domains[domainIndex]
            local url = "https://" .. domain .. "/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=" .. sortOrder .. "&excludeFullGames=true&limit=100"
            if cursor then
                url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
            end
            data, failure, limited = Extensions.RequestServerPage(url)
            if data then
                fetchState.ActiveDomain = domain
                break
            end
            attempts = attempts + 1
            if limited and attempts < 3 then
                task.wait(2 + attempts * 2)
            elseif page == 1 and tried < #domains - 1 then
                tried = tried + 1
                attempts = 0
                domainIndex = domainIndex % #domains + 1
            else
                break
            end
        end
        if not data then
            failureReason = Extensions.DescribeServerFailure(failure, limited)
            break
        end
        for _, server in ipairs(data.data or {}) do
            local playing = tonumber(server.playing)
            local maximum = tonumber(server.maxPlayers)
            if type(server.id) == "string" and server.id ~= game.JobId and playing and maximum and playing < maximum then
                table.insert(servers, server)
            end
        end
        cursor = data.nextPageCursor
        if not cursor or #servers >= 60 then
            break
        end
        task.wait(0.4)
    end
    if #servers > 0 then
        fetchState.Cache[sortOrder] = {At = os.clock(), JobId = game.JobId, Servers = servers}
        failureReason = nil
    end
    return servers, failureReason
end

local function clearGuiChildren(container)
