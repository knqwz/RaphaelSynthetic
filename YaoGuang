function Extensions.ActivateRegisteredToggle(id)
    local entry = State.ToggleRegistryById[id]
    if not entry or not entry.Control then return false end
    local control = entry.Control
    control.Set(not control.Get(), true)
    return true
end

function Extensions.RefreshDesktopBindingLabel(id)
    local label = State.DesktopBindingLabels[id]
    if not label or not label.Parent then return end
    local binding = State.DesktopBindings[id]
    label.Text = binding and tostring(binding) or "CHƯA GÁN"
    label.TextColor3 = binding and Theme.Text or Theme.SubText
end

function Extensions.SetDesktopBinding(id, keyName)
    if keyName then
        for otherId, otherKey in pairs(State.DesktopBindings) do
            if otherId ~= id and otherKey == keyName then
                State.DesktopBindings[otherId] = nil
                Extensions.RefreshDesktopBindingLabel(otherId)
            end
        end
        State.DesktopBindings[id] = keyName
    else
        State.DesktopBindings[id] = nil
    end
    Extensions.RefreshDesktopBindingLabel(id)
end

