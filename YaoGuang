UI.Motion = {
    Fast = 0.07,
    Normal = 0.16,
    Slow = 0.24
}

function UI.Motion.GetScale(instance)
    if not instance or not instance.Parent then
        return nil
    end
    local scale = instance:FindFirstChild("RaphaelMotionScale")
    if not scale then
        scale = Instance.new("UIScale")
        scale.Name = "RaphaelMotionScale"
        scale.Scale = 1
        scale.Parent = instance
    end
    return scale
end

function UI.Motion.Press(instance)
    local scale = UI.Motion.GetScale(instance)
    if not scale then
        return
    end
    local token = (instance:GetAttribute("RaphaelMotionToken") or 0) + 1
    instance:SetAttribute("RaphaelMotionToken", token)
    TweenService:Create(scale, TweenInfo.new(UI.Motion.Fast, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Scale = 0.93}):Play()
    task.delay(UI.Motion.Fast, function()
        if instance.Parent and instance:GetAttribute("RaphaelMotionToken") == token then
            TweenService:Create(scale, TweenInfo.new(UI.Motion.Normal, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
        end
    end)
end

function UI.Motion.Pop(instance)
    local scale = UI.Motion.GetScale(instance)
    if not scale then
        return
    end
    instance:SetAttribute("RaphaelHideToken", (instance:GetAttribute("RaphaelHideToken") or 0) + 1)
    instance.Rotation = 0
    scale.Scale = 0.88
    TweenService:Create(scale, TweenInfo.new(UI.Motion.Slow, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
end

function UI.Motion.Hide(instance, completion)
    local scale = UI.Motion.GetScale(instance)
    if not scale then
        if completion then
            completion()
        end
        return
    end
    local token = (instance:GetAttribute("RaphaelHideToken") or 0) + 1
    instance:SetAttribute("RaphaelHideToken", token)
    instance.Rotation = 0
    TweenService:Create(scale, TweenInfo.new(UI.Motion.Normal, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Scale = 0.82}):Play()
    task.delay(UI.Motion.Normal, function()
        if instance.Parent and instance:GetAttribute("RaphaelHideToken") == token then
            instance.Visible = false
            instance.Rotation = 0
            scale.Scale = 1
            if completion then
                completion()
            end
        end
    end)
end

function UI.Motion.Shake(instance)
    if not instance or not instance.Parent then
        return
    end
    local token = (instance:GetAttribute("RaphaelShakeToken") or 0) + 1
    local originalRotation = instance.Rotation
    instance:SetAttribute("RaphaelShakeToken", token)
    TweenService:Create(instance, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {Rotation = originalRotation - 3}):Play()
    task.delay(0.05, function()
        if instance.Parent and instance:GetAttribute("RaphaelShakeToken") == token then
            TweenService:Create(instance, TweenInfo.new(0.07, Enum.EasingStyle.Linear), {Rotation = originalRotation + 3}):Play()
        end
    end)
    task.delay(0.12, function()
        if instance.Parent and instance:GetAttribute("RaphaelShakeToken") == token then
            TweenService:Create(instance, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = originalRotation}):Play()
        end
    end)
end

