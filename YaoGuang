        shade.Active = false
        shade.ZIndex = button.ZIndex + 1
        shade.Parent = button
        Instance.new("UICorner", shade).CornerRadius = UDim.new(0, 8)
    end

    local protectedText = UI.ProtectButtonText(button, button:GetAttribute("RaphaelTextInset") or 0)
    if protectedText then
        protectedText.Font = Enum.Font.Gotham
        protectedText.TextColor3 = Theme.Text
        protectedText.TextStrokeTransparency = 0.72
