function Extensions.CreateMobileToggleButton(id)
    local entry = State.ToggleRegistryById[id]
    if not entry then return nil end
    local existing = State.MobileButtons[id]
    if existing and existing.Parent then return existing end
    local settings = State.MobileButtonSettings[id]
    if type(settings) ~= "table" then
        settings = {}
        State.MobileButtonSettings[id] = settings
    end
    local index = entry.Order - 1
    settings.Visible = true
    if settings.Locked == nil then settings.Locked = true end
    if settings.Editing == nil then settings.Editing = false end
    if settings.XScale == nil then settings.XScale = 0 end
    if settings.XOffset == nil then settings.XOffset = 18 + index % 4 * 76 end
    if settings.YScale == nil then settings.YScale = 0 end
    if settings.YOffset == nil then settings.YOffset = 120 + math.floor(index / 4) % 5 * 70 end
    local button = Instance.new("TextButton")
    button.Name = "MobileToggle_" .. tostring(entry.Order)
    button.Size = UDim2.fromOffset(68, 58)
    button.Position = UDim2.new(tonumber(settings.XScale) or 0, tonumber(settings.XOffset) or 18, tonumber(settings.YScale) or 0, tonumber(settings.YOffset) or 120)
    button.BackgroundColor3 = Theme.SurfaceLight
    button.BackgroundTransparency = 0.58
    button.BorderSizePixel = 0
    button.TextColor3 = Theme.Text
    button.Font = Enum.Font.GothamBold
    button.TextSize = 8
    button.TextWrapped = true
    button.AutoButtonColor = false
    button.ZIndex = 96
    button:SetAttribute("RaphaelButtonArtworkExempt", true)
    button.Parent = Overlay
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 12)
    local stroke = Instance.new("UIStroke")
    stroke.Name = "StateStroke"
    stroke.Color = Theme.GlassBorder
    stroke.Transparency = 0.62
    stroke.Thickness = 1
    stroke.Parent = button
    UI.AddSmoothGradient(button, Theme.Background, Theme.SurfaceLight, 15)
    Extensions.ApplyExternalActionPresentation(button, entry.Name, entry.Icon, entry.ShortName)
    UI.AddRipple(button, Theme.Text)
    State.MobileButtons[id] = button

    connect(button.InputBegan, function(input)
        if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and settings.Editing and not settings.Locked then
            settings.SuppressActivation = false
            State.MobileDrag = {
                Button = button,
                Settings = settings,
                Input = input,
                StartInput = input.Position,
                StartPosition = button.Position
            }
        end
    end)
    connect(button.Activated, function()
        if settings.SuppressActivation then
            settings.SuppressActivation = false
            return
        end
        if settings.Editing then
            notify(settings.Locked and "Nút đang khóa; mở khóa trong Misc → Edit Button Studio." or "Đang ở chế độ di chuyển; kéo nút đến vị trí mong muốn.", Theme.Warning)
            return
        end
        Extensions.ActivateRegisteredToggle(id)
    end)
    Extensions.RefreshMobileToggleButton(id)
    return button
end

function Extensions.UpdateMobileButtonDrag(input)
    local drag = State.MobileDrag
    if not drag or not drag.Button or not drag.Button.Parent then
        State.MobileDrag = nil
        return
    end
    if input.UserInputType ~= Enum.UserInputType.Touch and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
    if input.UserInputType == Enum.UserInputType.Touch and drag.Input ~= input then return end
    local delta = input.Position - drag.StartInput
    if delta.Magnitude > 3 then drag.Settings.SuppressActivation = true end
    local startPosition = drag.StartPosition
    local parentSize = Overlay.AbsoluteSize
    local startX = startPosition.X.Scale * parentSize.X + startPosition.X.Offset
    local startY = startPosition.Y.Scale * parentSize.Y + startPosition.Y.Offset
    local x = math.clamp(startX + delta.X, 0, math.max(parentSize.X - drag.Button.AbsoluteSize.X, 0))
    local y = math.clamp(startY + delta.Y, 0, math.max(parentSize.Y - drag.Button.AbsoluteSize.Y, 0))
    drag.Button.Position = UDim2.fromOffset(x, y)
end

function Extensions.EndMobileButtonDrag(input)
    local drag = State.MobileDrag
    if not drag then return end
    local endsTouch = input.UserInputType == Enum.UserInputType.Touch and drag.Input == input
    local endsMouse = input.UserInputType == Enum.UserInputType.MouseButton1
    if not endsTouch and not endsMouse then return end
    local button = drag.Button
    local settings = drag.Settings
    if button and button.Parent then
        settings.XScale = button.Position.X.Scale
        settings.XOffset = button.Position.X.Offset
        settings.YScale = button.Position.Y.Scale
        settings.YOffset = button.Position.Y.Offset
    end
    State.MobileDrag = nil
end

function Extensions.SetMobileToggleVisible(id, visible)
    local settings = State.MobileButtonSettings[id]
    if type(settings) ~= "table" then
        settings = {}
        State.MobileButtonSettings[id] = settings
    end
    settings.Visible = not not visible
    if settings.Locked == nil then settings.Locked = true end
    if visible then
        Extensions.CreateMobileToggleButton(id)
    else
        local button = State.MobileButtons[id]
        if State.MobileDrag and State.MobileDrag.Button == button then State.MobileDrag = nil end
        if button then button:Destroy() end
        State.MobileButtons[id] = nil
        settings.Editing = false
    end
    Extensions.RefreshMobileControlRow(id)
end

function Extensions.SetMobileToggleEditing(id, editing)
    local settings = State.MobileButtonSettings[id]
    if type(settings) ~= "table" then
        settings = {}
        State.MobileButtonSettings[id] = settings
    end
    if not settings.Visible then Extensions.SetMobileToggleVisible(id, true) end
    settings.Editing = not not editing
    if editing then settings.Locked = false end
    Extensions.RefreshMobileControlRow(id)
    Extensions.RefreshMobileToggleButton(id)
end

function Extensions.SetMobileToggleLocked(id, locked)
    local settings = State.MobileButtonSettings[id]
    if type(settings) ~= "table" then
        settings = {}
        State.MobileButtonSettings[id] = settings
    end
    settings.Locked = not not locked
    if locked then
        settings.Editing = false
        local button = State.MobileButtons[id]
        if State.MobileDrag and State.MobileDrag.Button == button then State.MobileDrag = nil end
    end
    Extensions.RefreshMobileControlRow(id)
    Extensions.RefreshMobileToggleButton(id)
end

function Extensions.RestoreConfiguredMobileButtons()
    for id, settings in pairs(State.MobileButtonSettings) do
        if type(settings) == "table" and settings.Visible and State.ToggleRegistryById[id] then
            Extensions.CreateMobileToggleButton(id)
            Extensions.SetMobileToggleLocked(id, settings.Locked ~= false)
        end
    end
end

