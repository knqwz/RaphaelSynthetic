function Extensions.SetVisualTargetColor(key, color)
    if key == "AimbotFOV" then
        State.Aimbot.FOVColor = color
        Extensions.UpdateAimbotFOV()
        return
    end
    if key == "Flant" then
        State.FlantColor = color
        if State.FlantPlatform then State.FlantPlatform.Color = color end
        return
    end
    if key == "InspectorHighlight" then
        State.Inspector.HighlightColor = color
        local crosshair: any = State.Inspector.CrosshairFrame
        if crosshair then
            local stroke: any = crosshair:FindFirstChildOfClass("UIStroke")
            if stroke then stroke.Color = color end
        end
        return
    end
    if key == "InspectorName" then
        State.Inspector.NameColor = color
        if State.Inspector.NameLabel then
            State.Inspector.NameLabel.TextColor3 = Theme.Text
            State.Inspector.NameLabel.TextStrokeColor3 = color
            State.Inspector.NameLabel.TextStrokeTransparency = 0
            local stroke = State.Inspector.NameLabel:FindFirstChildOfClass("UIStroke")
            if stroke then stroke.Color = color end
        end
        return
    end
    local config: any = State.PlayerESP
    if string.sub(key, 1, 3) == "Mob" then config = State.MobESP end
    if string.sub(key, 1, 4) == "Item" then config = State.ItemESP end
    if string.sub(key, 1, 13) == "UniversalScan" then config = State.UniversalScan end
    local channel: string? = nil
    if string.find(key, "Box", 1, true) then channel = "Box" end
    if string.find(key, "Name", 1, true) then channel = "Name" end
    if string.find(key, "Tracer", 1, true) then channel = "Tracer" end
    if string.find(key, "Look", 1, true) then channel = "LookDirection" end
    if channel then
        Extensions.EnsureESPColorChannels(config)[channel] = color
    else
        Extensions.SetESPColorGroup(config, color)
    end
end

function Extensions.MatchesVisualColorSearch(searchText: string, normalizedQuery: string): boolean
    if string.find(searchText, normalizedQuery, 1, true) then return true end
    for token in string.gmatch(normalizedQuery, "%S+") do
        local found = false
        for candidate in string.gmatch(searchText, "%S+") do
            if string.sub(candidate, 1, #token) == token or string.find(candidate, token, 1, true) then
                found = true
                break
            end
        end
        if not found then return false end
    end
    return true
end

function Extensions.FindVisualColorTarget(query: any)
    local normalized: string = tostring(Extensions.NormalizeSearchText(query))
    local targets: any = Extensions.GetVisualColorTargets()
    if normalized == "" then
        for _, target in ipairs(targets) do
            if target.Key == State.VisualColor.TargetKey then return target end
        end
        return targets[1]
    end
    local exact: any = nil
    local matches: {any} = {}
    for _, target: any in ipairs(targets) do
        if string.lower(tostring(target.Key)) == string.lower(tostring(query)) then return target end
        local name: string = tostring(Extensions.NormalizeSearchText(target.Name))
        local searchText: string = name .. " " .. tostring(Extensions.NormalizeSearchText(target.Search))
        if name == normalized then
            exact = target
            break
        elseif string.sub(name, 1, #normalized) == normalized or Extensions.MatchesVisualColorSearch(searchText, normalized) then
            matches[#matches + 1] = target
        end
    end
    if exact then return exact end
    if #matches == 1 then return matches[1] end
    return nil, matches
end

function Extensions.ApplyVisualPickerColor()
    local picker = State.VisualColor
    local target: any = Extensions.FindVisualColorTarget(picker.TargetKey)
    if not target then return end
    local color: any = Color3.fromHSV(picker.HueValue, picker.Saturation, picker.Value)
    Extensions.SetVisualTargetColor(target.Key, color)
    if picker.Preview then picker.Preview.BackgroundColor3 = color end
    if picker.SV then picker.SV.BackgroundColor3 = Color3.fromHSV(picker.HueValue, 1, 1) end
    if picker.SVMarker then picker.SVMarker.Position = UDim2.fromScale(picker.Saturation, 1 - picker.Value) end
    if picker.HueMarker then picker.HueMarker.Position = UDim2.new(picker.HueValue, 0, 0.5, 0) end
    if picker.Panel then
        local stroke = picker.Panel:FindFirstChild("PickerStroke")
        if stroke then stroke.Color = Color3.fromRGB(255, 255, 255) end
    end
    if picker.ResultLabel then
        local red = math.floor((tonumber(color.R) or 0) * 255 + 0.5)
        local green = math.floor((tonumber(color.G) or 0) * 255 + 0.5)
        local blue = math.floor((tonumber(color.B) or 0) * 255 + 0.5)
        local defaultColor: any = target.Default or color
        local defaultRed = math.floor((tonumber(defaultColor.R) or 0) * 255 + 0.5)
        local defaultGreen = math.floor((tonumber(defaultColor.G) or 0) * 255 + 0.5)
        local defaultBlue = math.floor((tonumber(defaultColor.B) or 0) * 255 + 0.5)
        picker.ResultLabel.Text = string.format("%s · Hiện tại #%02X%02X%02X · Mặc định #%02X%02X%02X", tostring(target.Name), red, green, blue, defaultRed, defaultGreen, defaultBlue)
    end
end

function Extensions.SelectVisualColorTarget(target)
    if not target then return false end
    local picker = State.VisualColor
    picker.TargetKey = target.Key
    local hue, saturation, value = Color3.toHSV(Extensions.GetVisualTargetColor(target.Key))
    picker.HueValue = hue
    picker.Saturation = saturation
    picker.Value = value
    if picker.SearchBox and picker.SearchBox.Text ~= target.Name then picker.SearchBox.Text = target.Name end
    Extensions.ApplyVisualPickerColor()
    return true
end

function Extensions.ResolveVisualColorSearch(text)
    local target, matches = Extensions.FindVisualColorTarget(text)
    if target then
        Extensions.SelectVisualColorTarget(target)
        return
    end
    if State.VisualColor.ResultLabel then
        if matches and #matches > 1 then
            local names = {}
            for index = 1, math.min(#matches, 4) do names[#names + 1] = matches[index].Name end
            State.VisualColor.ResultLabel.Text = "Có nhiều kết quả: " .. table.concat(names, ", ")
        else
            State.VisualColor.ResultLabel.Text = "Không tìm thấy visual phù hợp."
        end
    end
end

function Extensions.UpdateVisualColorFromPoint(mode, position)
    local picker = State.VisualColor
    local targetFrame = mode == "SV" and picker.SV or picker.Hue
    if not targetFrame or targetFrame.AbsoluteSize.X <= 0 then return end
    local x = math.clamp((position.X - targetFrame.AbsolutePosition.X) / targetFrame.AbsoluteSize.X, 0, 1)
    if mode == "SV" then
        local y = math.clamp((position.Y - targetFrame.AbsolutePosition.Y) / targetFrame.AbsoluteSize.Y, 0, 1)
        picker.Saturation = x
        picker.Value = 1 - y
    else
        picker.HueValue = x
    end
    Extensions.ApplyVisualPickerColor()
end

