    if State.NoclipTrackedCharacter ~= character then
        table.clear(OriginalCollision)
        State.NoclipTrackedCharacter = character
    end
    if not character then
        return
    end
    local descendants: any = character:GetDescendants()
    local trackPart: any = rawget(Extensions, "TrackNoclipPart")
    for _, descendant: any in ipairs(descendants) do
        if trackPart then trackPart(descendant) end
    end
end

