local function rotateVector(offsetX, offsetY, degrees)
    local radians = math.rad(degrees)
    local cosine, sine = math.cos(radians), math.sin(radians)
    return offsetX * cosine - offsetY * sine, offsetX * sine + offsetY * cosine
end

local function currentCameraYaw()
    Camera = Workspace.CurrentCamera or Camera
    local look = Camera.CFrame.LookVector
    return math.deg(math.atan2(look.X, -look.Z))
end

function Extensions.ApplyMinimapView(force)
    local canvas = minimap.Canvas
    local built = minimap.BuiltPlan
    if not canvas or not canvas.Parent or not minimap.Inner then return end
    local side = effectiveSide()
    local yaw = currentCameraYaw()
    local anchorRoot = minimapRoot()
    local keyX = anchorRoot and anchorRoot.Position.X or 0
    local keyZ = anchorRoot and anchorRoot.Position.Z or 0
    if not force and minimap.ViewKeyX == keyX and minimap.ViewKeyZ == keyZ and minimap.ViewKeyYaw == yaw and minimap.ViewKeySide == side and minimap.ViewKeyBuilt == built and minimap.ViewKeyReady == minimap.Ready then
        return
    end
    minimap.ViewKeyX = keyX
    minimap.ViewKeyZ = keyZ
    minimap.ViewKeyYaw = yaw
    minimap.ViewKeySide = side
    minimap.ViewKeyBuilt = built
    minimap.ViewKeyReady = minimap.Ready
    minimap.CameraYaw = yaw
    local rotation = 0
    if built and built.Rotate then rotation = -yaw end
    if minimap.SelfArrow then
        minimap.SelfArrow.Rotation = built and built.Rotate and 0 or yaw
    end
    if minimap.CompassLabel then
        local radius = side * 0.5 - (side < 130 and 9 or 11)
        local compassX, compassY = rotateVector(0, -radius, rotation)
        minimap.CompassLabel.Position = UDim2.new(0.5, compassX, 0.5, compassY)
    end
    if not built or not minimap.Ready then
        canvas.Visible = false
        return
    end
    local root = minimapRoot()
    if not root then return end
    local ratio = built.ViewRadius / math.max(minimap.ViewRadius, 1)
    local cellPixels = (side / built.Resolution) * ratio
    local canvasSize = built.Window * cellPixels
    local position = root.Position
    local playerCellX = position.X / built.CellSize - minimap.WindowX
    local playerCellZ = position.Z / built.CellSize - minimap.WindowZ
    local fromCenterX = playerCellX * cellPixels - canvasSize * 0.5
    local fromCenterY = playerCellZ * cellPixels - canvasSize * 0.5
    local rotatedX, rotatedY = rotateVector(fromCenterX, fromCenterY, rotation)
    canvas.Visible = true
    canvas.AnchorPoint = Vector2.new(0.5, 0.5)
    canvas.Size = UDim2.fromOffset(canvasSize, canvasSize)
    canvas.Position = UDim2.new(0.5, -rotatedX, 0.5, -rotatedY)
    canvas.Rotation = rotation
    minimap.CellPixels = cellPixels
    if minimap.InfoLabel then
        local plan = minimap.Plan or built
        local text = string.format("%d studs · %d ô", minimap.ViewRadius, plan.Resolution)
        if plan.Resolution < plan.Requested then text = text .. " ↓" end
        if minimap.InfoLabel.Text ~= text then minimap.InfoLabel.Text = text end
    end
end

function Extensions.BuildMinimapGrid(plan, layer)
    if not layer then return end
    for _, child in ipairs(layer:GetChildren()) do child:Destroy() end
    local target = (2 * plan.ViewRadius) / 6
    local spacing = 1000
    for _, candidate in ipairs({25, 50, 100, 200, 500, 1000}) do
        if candidate >= target then
            spacing = candidate
            break
        end
    end
    local firstX = math.ceil(minimap.WindowX * plan.CellSize / spacing)
    local lastX = math.floor((minimap.WindowX + plan.Window) * plan.CellSize / spacing)
    local firstZ = math.ceil(minimap.WindowZ * plan.CellSize / spacing)
    local lastZ = math.floor((minimap.WindowZ + plan.Window) * plan.CellSize / spacing)
    for index = firstX, math.min(lastX, firstX + 60) do
        local line = Instance.new("Frame")
        line.BorderSizePixel = 0
        line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        line.BackgroundTransparency = index == 0 and 0.55 or 0.82
        line.Position = UDim2.new(((index * spacing) / plan.CellSize - minimap.WindowX) / plan.Window, 0, 0, 0)
        line.Size = UDim2.new(0, 1, 1, 0)
        line.ZIndex = 6
        line.Parent = layer
    end
    for index = firstZ, math.min(lastZ, firstZ + 60) do
        local line = Instance.new("Frame")
        line.BorderSizePixel = 0
        line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        line.BackgroundTransparency = index == 0 and 0.55 or 0.82
        line.Position = UDim2.new(0, 0, ((index * spacing) / plan.CellSize - minimap.WindowZ) / plan.Window, 0)
        line.Size = UDim2.new(1, 0, 0, 1)
        line.ZIndex = 6
        line.Parent = layer
    end
end

function Extensions.RunMinimapScan(token)
    minimap.Scanning = true
    local startedAt = os.clock()
    local function alive()
        return token == minimap.ScanToken and minimap.Enabled
    end
    local function budget()
        local base = isDesktop and 0.0035 or 0.0022
        if minimap.FrameEMA > 1 / 38 then base = base * 0.55 end
        return base
    end
    local function status(text)
        if not minimap.Status then return end
        if text == "" or not minimap.Ready then minimap.Status.Text = text end
    end
    local root = minimapRoot()
    while not root and alive() do
        RunService.Heartbeat:Wait()
        root = minimapRoot()
    end
    if not alive() then
        if token == minimap.ScanToken then minimap.Scanning = false end
        return
    end
    local plan = computePlan()
    minimap.Plan = plan
    local position = root.Position
    local signature = string.format("%d|%.3f|%d", plan.Resolution, plan.CellSize, minimap.RayHeight)
    if signature ~= minimap.CacheSignature or math.abs((minimap.CacheAnchorY or position.Y) - position.Y) > 30 or minimap.CacheCount > plan.Window * plan.Window * 2 then
        Extensions.MinimapInvalidate()
        minimap.CacheSignature = signature
    end
    minimap.CacheAnchorY = position.Y
    local forceFresh = minimap.ForceFresh
    minimap.ForceFresh = false
    local centerX = math.floor(position.X / plan.CellSize)
    local centerZ = math.floor(position.Z / plan.CellSize)
    local originX = centerX - plan.Half
    local originZ = centerZ - plan.Half
    local window = plan.Window
    if not minimap.GeometryEnabled then
        minimap.TileLayer = nil
        if minimap.TilePool then
            for _, entry in ipairs(minimap.TilePool.Layers) do entry.Frame.Visible = false end
            minimap.TilePool.Active = nil
        end
        minimap.WindowX = originX
        minimap.WindowZ = originZ
        minimap.BuiltPlan = plan
        Extensions.BuildMinimapGrid(plan, minimap.GridLayer)
        if minimap.GridLayer then minimap.GridLayer.Visible = true end
        minimap.BuiltAnchor = position
        minimap.LastBuildAt = os.clock()
        minimap.LastBuildDuration = 0.2
        minimap.Ready = true
        minimap.Scanning = false
        status("")
        Extensions.ApplyMinimapView(true)
        return
    end
    local topY = position.Y + minimap.RayHeight
    local depth = minimap.RayHeight + 900
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.IgnoreWater = false
    pcall(function() params.RespectCanCollide = true end)
    local ignored = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then ignored[#ignored + 1] = player.Character end
    end
    for model in pairs(MobCache) do
        if model and model.Parent and #ignored < 120 then ignored[#ignored + 1] = model end
    end
    params.FilterDescendantsInstances = ignored
    local cache = minimap.Cache
    local deadline = os.clock() + budget()
    local processed = 0
    local total = window * window
    status("Đang quét bản đồ · 0%")
    for row = 0, window - 1 do
        for column = 0, window - 1 do
            local key = latticeKey(originX + column, originZ + row)
            local entry = cache[key]
            if not entry or forceFresh and entry[6] < startedAt then
                local worldX = (originX + column + 0.5) * plan.CellSize
                local worldZ = (originZ + row + 0.5) * plan.CellSize
                local sampled = sampleCell(worldX, worldZ, topY, depth, params, ignored)
                if sampled then
                    sampled[6] = startedAt
                    if not entry then minimap.CacheCount = minimap.CacheCount + 1 end
                    cache[key] = sampled
                elseif entry then
                    cache[key] = nil
                    minimap.CacheCount = minimap.CacheCount - 1
                end
            end
            processed = processed + 1
            if processed % 24 == 0 and os.clock() >= deadline then
                RunService.Heartbeat:Wait()
                if not alive() then
                    if token == minimap.ScanToken then minimap.Scanning = false end
                    return
                end
                deadline = os.clock() + budget()
                status(string.format("Đang quét bản đồ · %d%%", math.floor(processed / total * 60)))
            end
        end
    end

    local relief = minimap.Relief / 100
    local outline = minimap.Outline
    local edgeLimit = math.max(2.5, plan.CellSize * 1.25)
    local playerY = position.Y
    local shadedRed, shadedGreen, shadedBlue = table.create(total, 0), table.create(total, 0), table.create(total, 0)
    local present = table.create(total, false)
    local index = 0
    for row = 0, window - 1 do
        for column = 0, window - 1 do
            index = index + 1
            local entry = cache[latticeKey(originX + column, originZ + row)]
            if entry then
                local height = entry[4]
                local left = cache[latticeKey(originX + column - 1, originZ + row)]
                local right = cache[latticeKey(originX + column + 1, originZ + row)]
                local up = cache[latticeKey(originX + column, originZ + row - 1)]
                local down = cache[latticeKey(originX + column, originZ + row + 1)]
                local shade = shadeFactor(height, left and left[4] or height, right and right[4] or height, up and up[4] or height, down and down[4] or height, plan.CellSize, relief, outline and entry[5] == 0, edgeLimit)
                if entry[5] == 1 then
                    shade = 0.92 + (shade - 0.8) * 0.15
                    if outline and (left and left[5] ~= 1 or right and right[5] ~= 1 or up and up[5] ~= 1 or down and down[5] ~= 1) then shade = shade * 0.82 end
                end
                local relative = (height - playerY) / 70
                if relative > 1 then relative = 1 elseif relative < -1 then relative = -1 end
                shade = shade * (1 + relative * 0.1)
                shadedRed[index] = entry[1] * shade
                shadedGreen[index] = entry[2] * shade
                shadedBlue[index] = entry[3] * shade
                present[index] = true
            end
        end
        if row % 8 == 0 and os.clock() >= deadline then
            RunService.Heartbeat:Wait()
            if not alive() then
                if token == minimap.ScanToken then minimap.Scanning = false end
                return
            end
            deadline = os.clock() + budget()
            status(string.format("Đang tô địa hình · %d%%", 60 + math.floor(row / window * 20)))
        end
    end

    local maximumTiles = isDesktop and 2400 or 1400
    local step = 10
    local rectangles
    local packed = table.create(total, -1)
    local function yieldCheck()
        if os.clock() >= deadline then
            RunService.Heartbeat:Wait()
            if not alive() then return false end
            deadline = os.clock() + budget()
        end
        return true
    end
    for _ = 1, 6 do
        for cellIndex = 1, total do
            if present[cellIndex] then
                packed[cellIndex] = quantizeChannel(shadedRed[cellIndex], step) * 65536 + quantizeChannel(shadedGreen[cellIndex], step) * 256 + quantizeChannel(shadedBlue[cellIndex], step)
            else
                packed[cellIndex] = -1
            end
        end
        rectangles = buildRectangles(packed, window, window, yieldCheck)
        if not rectangles then
            if token == minimap.ScanToken then minimap.Scanning = false end
            return
        end
        if #rectangles <= maximumTiles or step >= 64 then break end
        step = math.floor(step * 1.5 + 0.5)
    end

    local pool = minimap.TilePool
    if not pool then
        pool = {Layers = {}, Active = nil}
        minimap.TilePool = pool
    end
    local target
    for _, candidate in ipairs(pool.Layers) do
        if candidate ~= pool.Active and candidate.Frame.Parent == minimap.Canvas then target = candidate end
    end
    if not target then
        local frame = Instance.new("Frame")
        frame.Name = "TileLayer"
        frame.Size = UDim2.fromScale(1, 1)
        frame.BackgroundTransparency = 1
        frame.ZIndex = 3
        frame.Visible = false
        frame.Parent = minimap.Canvas
        target = {Frame = frame, Tiles = {}, Used = 0}
        pool.Layers[#pool.Layers + 1] = target
    end
    local layer = target.Frame
    layer.Visible = false
    local created = 0
    for rectangleIndex, rectangle in ipairs(rectangles) do
        local value = rectangle.Value
        local tile = target.Tiles[rectangleIndex]
        if not tile then
            tile = Instance.new("Frame")
            tile.BorderSizePixel = 0
            tile.ZIndex = 3
            tile.Parent = layer
            target.Tiles[rectangleIndex] = tile
        end
        tile.BackgroundColor3 = Color3.fromRGB(math.floor(value / 65536) % 256, math.floor(value / 256) % 256, value % 256)
        tile.Position = UDim2.fromScale((rectangle.X - 1) / window, (rectangle.Y - 1) / window)
        tile.Size = UDim2.new(rectangle.Width / window, 1, rectangle.Height / window, 1)
        tile.Visible = true
        created = created + 1
        if created % 60 == 0 and os.clock() >= deadline then
            RunService.Heartbeat:Wait()
            if not alive() then
                if token == minimap.ScanToken then minimap.Scanning = false end
                return
            end
            deadline = os.clock() + budget()
            status(string.format("Đang dựng ảnh · %d%%", 80 + math.floor(rectangleIndex / #rectangles * 20)))
        end
    end
    for index = #rectangles + 1, target.Used do
        target.Tiles[index].Visible = false
    end
    target.Used = #rectangles

    local oldActive = pool.Active
    minimap.WindowX = originX
    minimap.WindowZ = originZ
    minimap.BuiltPlan = plan
    minimap.TileLayer = layer
    pool.Active = target
    layer.Visible = true
    if oldActive then oldActive.Frame.Visible = false end
    Extensions.BuildMinimapGrid(plan, minimap.GridLayer)
    if minimap.GridLayer then minimap.GridLayer.Visible = minimap.ShowGrid end
    minimap.BuiltAnchor = position
    minimap.LastBuildAt = os.clock()
    minimap.LastBuildDuration = math.max(os.clock() - startedAt, 0.2)
    minimap.Ready = true
    minimap.Scanning = false
    status("")
    Extensions.ApplyMinimapView(true)
end

function Extensions.QueueMinimapScan()
    minimap.QueueToken = (minimap.QueueToken or 0) + 1
    local token = minimap.QueueToken
    task.delay(0.35, function()
        if token == minimap.QueueToken and State.Running then Extensions.StartMinimapScan(true) end
    end)
end

function Extensions.StartMinimapScan(force)
    if not minimap.Enabled then
        if force then minimap.Ready = false end
        return
    end
    if not minimap.Panel then Extensions.EnsureMinimap() end
    minimap.ScanToken = minimap.ScanToken + 1
    local token = minimap.ScanToken
    minimap.Scanning = true
    task.spawn(function()
        local success, failure = pcall(Extensions.RunMinimapScan, token)
        if not success and token == minimap.ScanToken then
            minimap.Scanning = false
            if minimap.Status then minimap.Status.Text = "Không thể quét map" end
            warn("[Raphael Mini Map] " .. tostring(failure))
        end
    end)
end

