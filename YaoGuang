function Extensions.UpdateAvatarViewerStats()
    local viewer = State.AvatarViewer
    if not viewer.StatsLabel or not viewer.StatsLabel.Parent then return end
    local parts = {}
    if viewer.PreviewUserId then parts[#parts + 1] = "ID " .. tostring(viewer.PreviewUserId) end
    local player = viewer.PreviewPlayer
    if player and player.Parent == Players then
        parts[#parts + 1] = tostring(player.AccountAge) .. " ngày"
        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            parts[#parts + 1] = "HP " .. tostring(math.floor(humanoid.Health + 0.5)) .. "/" .. tostring(math.floor(humanoid.MaxHealth + 0.5))
        end
        local _, _, localRoot = getCharacter()
        local targetRoot = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart)
        if localRoot and targetRoot and player ~= LocalPlayer then
            parts[#parts + 1] = string.format("%.0f m", (targetRoot.Position - localRoot.Position).Magnitude * 0.28)
        end
        parts[#parts + 1] = player.Team and player.Team.Name or "No Team"
    elseif viewer.PreviewUserId then
        parts[#parts + 1] = "Ngoài server"
    end
    viewer.StatsLabel.Text = table.concat(parts, "  ·  ")
end

function Extensions.UpdateAvatarViewerActions()
    local viewer = State.AvatarViewer
    local hasUser = type(viewer.PreviewUsername) == "string" and viewer.PreviewUsername ~= ""
    local player = viewer.PreviewPlayer
    local inServer = player ~= nil and player.Parent == Players and player ~= LocalPlayer
    local function paint(button, enabled)
        if button and button.Parent then
            local base = button:GetAttribute("BaseTransparency") or 0.2
            button.BackgroundTransparency = enabled and base or math.max(base, 0.78)
            local label = button:FindFirstChild("LuxuryButtonText")
            if label then label.TextTransparency = enabled and 0 or 0.55 end
        end
    end
    paint(viewer.CopyButton, hasUser)
    paint(viewer.CopyIdButton, hasUser)
    paint(viewer.TeleButton, inServer)
    paint(viewer.SpectateButton, inServer)
    if viewer.SpectateButton and viewer.SpectateButton.Parent then
        viewer.SpectateButton.Text = (inServer and State.SpectatingPlayer == player) and "Huỷ theo dõi" or "Theo dõi"
    end
    if viewer.SearchButton then viewer.SearchButton.Text = viewer.Loading and "…" or "Xem" end
end

function Extensions.LoadAvatarViewerUser(userId, username, displayName, sourceCharacter, sourcePlayer)
    local viewer = State.AvatarViewer
    if not viewer.Viewport then return end
    viewer.Generation = viewer.Generation + 1
    local generation = viewer.Generation
    viewer.Loading = true
    viewer.PreviewUserId = tonumber(userId)
    viewer.PreviewUsername = tostring(username or userId or "")
    viewer.PreviewDisplayName = tostring(displayName or username or userId or "")
    viewer.PreviewPlayer = sourcePlayer
    viewer.PreviewHint.Text = "Đang dựng mô hình 3D…"
    viewer.PreviewName.Text = viewer.PreviewDisplayName .. "\n@" .. viewer.PreviewUsername
    if viewer.PreviewAvatar then viewer.PreviewAvatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=150&h=150" end
    Extensions.UpdateAvatarViewerActions()
    Extensions.UpdateAvatarViewerStats()
    task.spawn(function()
        local model
        if sourceCharacter and sourceCharacter.Parent then
            local archivable = sourceCharacter.Archivable
            sourceCharacter.Archivable = true
            local success, clone = pcall(sourceCharacter.Clone, sourceCharacter)
            sourceCharacter.Archivable = archivable
            if success then model = clone end
        end
        if not model then pcall(function() model = Players:CreateHumanoidModelFromUserId(tonumber(userId)) end) end
        if not model then
            pcall(function()
                local description = Players:GetHumanoidDescriptionFromUserId(tonumber(userId))
                model = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
            end)
        end
        if generation ~= viewer.Generation or not viewer.Viewport or not viewer.Viewport.Parent then
            if model then model:Destroy() end
            return
        end
        viewer.Loading = false
        Extensions.ClearAvatarViewerViewport()
        if not model then
            viewer.PreviewHint.Text = "Không tải được mô hình của username này."
            Extensions.UpdateAvatarViewerActions()
            return
        end
        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("BasePart") then
                descendant.Anchored = true
                descendant.CanCollide = false
                descendant.CastShadow = false
            elseif descendant:IsA("Script") or descendant:IsA("LocalScript") then
                descendant:Destroy()
            end
        end
        local world = Instance.new("WorldModel")
        world.Name = "AvatarWorld"
        world.Parent = viewer.Viewport
        model.Parent = world
        model:PivotTo(CFrame.new(0, 0, 0))
        local camera = Instance.new("Camera")
        camera.FieldOfView = 34
        camera.Parent = viewer.Viewport
        viewer.Viewport.CurrentCamera = camera
        viewer.PreviewCamera = camera
        viewer.ViewportModel = model
        viewer.PreviewCenter, viewer.PreviewSize = computeViewerFrame(model)
        Extensions.ResetAvatarViewerView()
        viewer.PreviewHint.Text = State.IsDesktop and "Kéo để xoay · cuộn để zoom · nhấp đúp để căn lại" or "Kéo xoay · chụm zoom · chạm đúp căn lại"
        Extensions.UpdateAvatarViewerActions()
        Extensions.UpdateAvatarViewerStats()
    end)
end

local function selectAvatarViewerRow(row)
    local viewer = State.AvatarViewer
    viewer.SelectedRow = row
    if not viewer.PlayerList then return end
    for _, child in ipairs(viewer.PlayerList:GetChildren()) do
        if child:IsA("TextButton") then
            local selected = child == row
            child.BackgroundColor3 = selected and Luxury.Palette.CellRaised or Luxury.Palette.Cell
            child.BackgroundTransparency = selected and 0.05 or 0.3
            local stroke = child:FindFirstChild("ViewerSelectionStroke")
            if stroke then
                stroke.Color = selected and Luxury.Palette.Accent or Luxury.Palette.Hairline
                stroke.Transparency = selected and 0.25 or 0.92
            end
            local badge = child:FindFirstChild("SelectionBadge")
            if badge then badge.Visible = selected end
        end
    end
end

function Extensions.SelectAvatarViewerPlayer(player, row)
    if not player then return end
    if not row and State.AvatarViewer.PlayerList then
        for _, candidate in ipairs(State.AvatarViewer.PlayerList:GetChildren()) do
            if candidate:IsA("TextButton") and candidate:GetAttribute("RaphaelViewerUserId") == player.UserId then
                row = candidate
                break
            end
        end
    end
    if row then selectAvatarViewerRow(row) end
    Extensions.LoadAvatarViewerUser(player.UserId, player.Name, player.DisplayName, player.Character, player)
end

function Extensions.SearchAvatarViewerUsername(text)
    local query = string.gsub(tostring(text or ""), "^%s*@?%s*(.-)%s*$", "%1")
    if query == "" then
        notify("Hãy nhập username cần xem.", Theme.Warning)
        return
    end
    local currentPlayer = Extensions.ResolveUniquePlayer(query, true)
    if currentPlayer then
        Extensions.SelectAvatarViewerPlayer(currentPlayer)
        return
    end
    local viewer = State.AvatarViewer
    viewer.Loading = true
    viewer.PreviewHint.Text = "Đang tìm @" .. query .. "…"
    Extensions.UpdateAvatarViewerActions()
    task.spawn(function()
        local success, resolvedUserId = pcall(Players.GetUserIdFromNameAsync, Players, query)
        if not success or not resolvedUserId then
            viewer.Loading = false
            viewer.PreviewHint.Text = "Không tìm thấy username @" .. query
            Extensions.UpdateAvatarViewerActions()
            notify("Không tìm thấy username @" .. query .. ".", Theme.Danger)
            return
        end
        local resolvedName = query
        pcall(function() resolvedName = Players:GetNameFromUserIdAsync(resolvedUserId) end)
        Extensions.LoadAvatarViewerUser(resolvedUserId, resolvedName, resolvedName, nil, nil)
    end)
end

function Extensions.RefreshAvatarViewerPlayers()
    local viewer = State.AvatarViewer
