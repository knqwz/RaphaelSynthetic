function Extensions.ToggleVisualColorPanel(visible)
    local panel = Extensions.EnsureVisualColorPanel()
    local picker = State.VisualColor
    if not panel or not picker.Sheet then return end
    local opened = picker.Sheet.Backdrop.Visible
    visible = visible == nil and not opened or not not visible
    if visible then
        if State.ServerBrowser.Sheet then Extensions.OverlayLuxury.Hide(State.ServerBrowser.Sheet, true) end
        if State.AvatarViewer.Sheet then Extensions.OverlayLuxury.Hide(State.AvatarViewer.Sheet, true) end
        if State.Minimap.SettingsSheet then Extensions.OverlayLuxury.Hide(State.Minimap.SettingsSheet, true) end
        Extensions.OverlayLuxury.Show(picker.Sheet)
        local target = Extensions.FindVisualColorTarget(picker.TargetKey)
        Extensions.SelectVisualColorTarget(target)
    else
        picker.DragMode = nil
        if picker.SearchBox then picker.SearchBox:ReleaseFocus() end
        Extensions.OverlayLuxury.Hide(picker.Sheet)
    end
end


