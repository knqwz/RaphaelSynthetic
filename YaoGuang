function Extensions.MaintainAntiStun(character, humanoid, root)
    if not State.AntiStun or not character or not humanoid or not root then
        return
    end

    local currentState = humanoid:GetState()
    if humanoid.PlatformStand
        or humanoid.Sit
        or currentState == Enum.HumanoidStateType.FallingDown
        or currentState == Enum.HumanoidStateType.Ragdoll
        or currentState == Enum.HumanoidStateType.Physics then
        humanoid.PlatformStand = false
        humanoid.Sit = false
        pcall(function()
            humanoid:ChangeState(humanoid.FloorMaterial == Enum.Material.Air and Enum.HumanoidStateType.Freefall or Enum.HumanoidStateType.Running)
        end)
    end

    if root.Anchored then
        root.Anchored = false
    end

    local original = rememberHumanoid(humanoid)
    local velocity = root.AssemblyLinearVelocity
    local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
    local direction = humanoid.MoveDirection
    local speed = math.max(State.SpeedEnabled and State.SpeedValue or original and original.WalkSpeed or humanoid.WalkSpeed, 0)
    local now = os.clock()
    local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
    local correctedHorizontal = horizontal

    if grounded then
        if direction.Magnitude <= 0.01 then
            correctedHorizontal = Vector3.zero
        elseif State.SpeedMethod ~= "CFrame" then
            correctedHorizontal = direction.Unit * speed
        elseif horizontal.Magnitude > math.max(speed * 1.6, 32) or horizontal:Dot(direction.Unit) < -1 then
            correctedHorizontal = direction.Unit * speed
        end
    elseif direction.Magnitude <= 0.01 and horizontal.Magnitude > 3 then
        correctedHorizontal = Vector3.zero
    elseif horizontal.Magnitude > math.max(speed * 1.6, 36) or direction.Magnitude > 0.01 and horizontal:Dot(direction.Unit) < -1 then
        correctedHorizontal = direction.Magnitude > 0.01 and direction.Unit * speed or Vector3.zero
    end

    local jumpLimit
    if not State.JumpEnabled and original then
        jumpLimit = original.UseJumpPower and original.JumpPower or math.sqrt(math.max(2 * Workspace.Gravity * original.JumpHeight, 0))
    elseif State.JumpMethod == "JumpHeight" then
        jumpLimit = math.sqrt(math.max(2 * Workspace.Gravity * State.JumpValue, 0))
    else
        jumpLimit = State.JumpValue
    end
    local jumpGrace = now - State.LastJumpRequest <= 0.65
    local verticalLimit = jumpGrace and math.max(jumpLimit * 1.25, 30) or 12
    local vertical = math.min(velocity.Y, verticalLimit)
    root.AssemblyLinearVelocity = Vector3.new(correctedHorizontal.X, vertical, correctedHorizontal.Z)
    root.AssemblyAngularVelocity = Vector3.zero

    if now - State.LastAntiStunMaintain < 0.18 then
        return
    end
    State.LastAntiStunMaintain = now
    pcall(function()
        humanoid.PlatformStand = false
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
    end)

    for _, descendant in ipairs(character:GetDescendants()) do
        if descendant:IsA("Motor6D") and not descendant.Enabled then
            descendant.Enabled = true
        else
            local lowerName = string.lower(descendant.Name)
            local suspicious = false
            for _, hint in ipairs(State.AntiStunForceHints) do
                if string.find(lowerName, hint, 1, true) then
                    suspicious = true
                    break
                end
            end
            if suspicious then
                pcall(function()
                    local backup = State.AntiStunInstanceBackup[descendant]
                    if not backup then
                        backup = {}
                        State.AntiStunInstanceBackup[descendant] = backup
                        if descendant:IsA("BodyVelocity") then
                            backup.Velocity = descendant.Velocity
                            backup.MaxForce = descendant.MaxForce
                        elseif descendant:IsA("BodyAngularVelocity") then
                            backup.AngularVelocity = descendant.AngularVelocity
                            backup.MaxTorque = descendant.MaxTorque
                        elseif descendant:IsA("LinearVelocity") or descendant:IsA("AngularVelocity") or descendant:IsA("VectorForce") or descendant:IsA("Torque") or descendant:IsA("BallSocketConstraint") or descendant:IsA("HingeConstraint") then
                            backup.Enabled = descendant.Enabled
                        elseif descendant:IsA("BoolValue") or descendant:IsA("NumberValue") or descendant:IsA("IntValue") then
                            backup.Value = descendant.Value
                        end
                    end
                    if descendant:IsA("BodyVelocity") then
                        descendant.Velocity = Vector3.zero
                        descendant.MaxForce = Vector3.zero
                    elseif descendant:IsA("BodyAngularVelocity") then
                        descendant.AngularVelocity = Vector3.zero
                        descendant.MaxTorque = Vector3.zero
                    elseif descendant:IsA("LinearVelocity") or descendant:IsA("AngularVelocity") or descendant:IsA("VectorForce") or descendant:IsA("Torque") or descendant:IsA("BallSocketConstraint") or descendant:IsA("HingeConstraint") then
                        descendant.Enabled = false
                    elseif descendant:IsA("BoolValue") then
                        descendant.Value = false
                    elseif descendant:IsA("NumberValue") or descendant:IsA("IntValue") then
                        descendant.Value = string.find(lowerName, "slow", 1, true) and 1 or 0
                    end
                end)
            end
        end
    end

    for _, object in ipairs({character, humanoid, root}) do
        for _, markerName in ipairs(State.AntiStunMarkerNames) do
            local attribute = object:GetAttribute(markerName)
            if attribute == true or type(attribute) == "number" and attribute > 0 then
                local neutral = string.lower(markerName) == "slow" and 1 or 0
                pcall(function()
                    object:SetAttribute(markerName, type(attribute) == "number" and neutral or false)
                end)
            end
        end
    end

end

