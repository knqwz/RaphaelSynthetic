        State.FPSBoostApplied = true
        local workspaceDescendants = Workspace:GetDescendants()
        for index, instance in ipairs(workspaceDescendants) do
            Extensions.ApplyFPSOptimization(instance)
            if index % 900 == 0 then
                task.wait()
            end
        end
        if not silent then
            notify("Fast Mode đã bật: bỏ texture và vật liệu nặng nhưng giữ màu gốc của từng vật thể.", Theme.Success)
        end
    else
        if not State.FPSBoostApplied then
            return
        end
        State.FPSBoostApplied = false
        Extensions.RestoreFPSOptimizations()
        if not silent then
            notify("Fast Mode đã tắt và toàn bộ vật liệu đã được khôi phục.", Theme.Success)
        end
    end
end

