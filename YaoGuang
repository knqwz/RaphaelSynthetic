                if success and enabled then
                    list[#list + 1] = {Id = entry.Id, Name = info[1], Icon = info[2]}
                end
            end
        end
        if State.BunnyHop then
            list[#list + 1] = {Id = "custom:bunnyhop", Name = "Bunny Hop", Icon = "rabbit", Toggle = function() Extensions.SetBunnyHopEnabled(false, true) end}
        end
        if State.SpectatingPlayer then
            list[#list + 1] = {Id = "custom:spectate", Name = "Theo dõi", Icon = "telescope", Toggle = function() setSpectating(nil) end}
        end
        if State.Boombox and State.Boombox.Playing then
            list[#list + 1] = {Id = "custom:boombox", Name = "Boombox", Icon = "zap", Toggle = function() Extensions.StopBoombox(true) end}
        end
        return list
    end

    local function activitySignature(list)
