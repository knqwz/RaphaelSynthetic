            end
        end
    end
    for item in pairs(found) do
        ItemCache[item] = true
    end
    State.ItemESP.TrackedCount = foundCount
    State.ItemScanRunning = false

    if forceNotification then
        if #State.ItemESP.SearchTerms == 0 then
