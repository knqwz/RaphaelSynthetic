function Extensions.ApplyConfig(config, silent)
    if type(config) ~= "table" then
        if not silent then notify("Config không hợp lệ.", Theme.Danger) end
        return false
    end

    Extensions.SetAimbotEnabled(false, nil, true)
    Extensions.SetGodModeEnabled(false, true)
    Extensions.SetFlantEnabled(false, true)
    resetSpeedSideEffects()
    Extensions.ResetJumpSideEffects()

    local function booleanValue(source, key, fallback)
        if type(source[key]) == "boolean" then
            return source[key]
        end
        return fallback
    end
    local function allowed(value, options, fallback)
        return table.find(options, value) and value or fallback
    end

    local movement = type(config.Movement) == "table" and config.Movement or {}
    State.SpeedEnabled = booleanValue(movement, "SpeedEnabled", false)
    State.SpeedValue = math.clamp(tonumber(movement.SpeedValue) or State.SpeedValue, 0, 1000)
    State.SpeedMethod = allowed(movement.SpeedMethod, {"WalkSpeed", "Velocity", "CFrame"}, State.SpeedMethod)
    State.JumpEnabled = booleanValue(movement, "JumpEnabled", false)
    State.JumpValue = math.clamp(tonumber(movement.JumpValue) or State.JumpValue, 0, 1000)
    State.JumpMethod = allowed(movement.JumpMethod, {"JumpPower", "JumpHeight", "Velocity"}, State.JumpMethod)
    State.InfiniteJump = booleanValue(movement, "InfiniteJump", State.InfiniteJump)
    State.FlantEnabled = booleanValue(movement, "FlantEnabled", false)
    State.FlantY = math.clamp(tonumber(movement.FlantY) or State.FlantY, -100000, 100000)
    State.FlantYConfigured = booleanValue(movement, "FlantYConfigured", movement.FlantY ~= nil)
    State.Noclip = booleanValue(movement, "Noclip", State.Noclip)
    State.NoclipMethod = allowed(movement.NoclipMethod, {"Toàn thân", "Chỉ Root", "State + Parts"}, State.NoclipMethod)
    State.GravityEnabled = booleanValue(movement, "GravityEnabled", false)
    State.GravityValue = math.clamp(tonumber(movement.GravityValue) or State.GravityValue, 0, 1000)

    if type(config.Misc) == "table" then
        State.SmartSearchEnabled = booleanValue(config.Misc, "SmartSearch", State.SmartSearchEnabled)
    end

    local function applyESP(target, source, includeRadius)
        if type(source) ~= "table" then return end
        target.Enabled = booleanValue(source, "Enabled", target.Enabled)
        target.Tracer = booleanValue(source, "Tracer", target.Tracer)
        target.TracerOrigin = allowed(source.TracerOrigin, {"Trên", "Giữa", "Dưới"}, target.TracerOrigin)
        target.Box = booleanValue(source, "Box", target.Box)
        target.BoxMode = allowed(source.BoxMode, {"2D", "3D", "Skin"}, target.BoxMode)
        if target.BoxMode == "Skin" then target.BoxMode = "3D" end
        target.Name = booleanValue(source, "Name", target.Name)
        if target.Health ~= nil then
            target.Health = booleanValue(source, "Health", target.Health)
        end
        target.Distance = booleanValue(source, "Distance", target.Distance)
        if source.MaxDistanceMeters ~= nil then
            target.MaxDistanceMeters = math.clamp(tonumber(source.MaxDistanceMeters) or target.MaxDistanceMeters, 1, 10000)
        end
        if target.LookDirection ~= nil then
            target.LookDirection = booleanValue(source, "LookDirection", target.LookDirection)
            target.LookLength = math.clamp(tonumber(source.LookLength) or target.LookLength, 1, 500)
        end
        if includeRadius and source.RadiusMeters ~= nil then
            target.RadiusMeters = math.clamp(tonumber(source.RadiusMeters) or target.RadiusMeters, 1, 10000)
        end
    end
    applyESP(State.PlayerESP, config.PlayerESP, false)
    applyESP(State.MobESP, config.MobESP, false)
    applyESP(State.ItemESP, config.ItemESP, true)
    if type(config.PlayerESP) == "table" then
        State.PlayerESP.ManualFilterEnabled = booleanValue(config.PlayerESP, "ManualFilterEnabled", State.PlayerESP.ManualFilterEnabled)
        Extensions.ParsePlayerESPFilter(tostring(config.PlayerESP.ManualFilterText or State.PlayerESP.ManualFilterText or ""))
    end
    if type(config.MobESP) == "table" then
        State.MobESP.MaxTargets = math.clamp(tonumber(config.MobESP.MaxTargets) or State.MobESP.MaxTargets, 1, 150)
    end
    if type(config.ItemESP) == "table" then
        State.ItemESP.ExactName = tostring(config.ItemESP.ExactName or "")
        Extensions.ParseItemSearchTerms(State.ItemESP.ExactName)
    end
    local universal = type(config.UniversalScan) == "table" and config.UniversalScan or {}
    State.UniversalScan.ExcludeMode = allowed(universal.ExcludeMode, {"Không loại trừ", "Loại trừ Player", "Loại trừ Quái", "Loại trừ cả hai"}, State.UniversalScan.ExcludeMode)
    State.UniversalScan.Box = booleanValue(universal, "Box", State.UniversalScan.Box)
    State.UniversalScan.BoxMode = allowed(universal.BoxMode, {"2D", "3D"}, State.UniversalScan.BoxMode)
    State.UniversalScan.Name = booleanValue(universal, "Name", State.UniversalScan.Name)
    State.UniversalScan.Tracer = booleanValue(universal, "Tracer", State.UniversalScan.Tracer)
    State.UniversalScan.TracerOrigin = allowed(universal.TracerOrigin, {"Trên", "Giữa", "Dưới"}, State.UniversalScan.TracerOrigin)
    State.MobManualFilterEnabled = false
    local inspector = type(config.Inspector) == "table" and config.Inspector or {}
    State.Inspector.Enabled = booleanValue(inspector, "Enabled", State.Inspector.Enabled)
    State.Inspector.ScreenRadius = math.clamp(tonumber(inspector.ScreenRadius) or State.Inspector.ScreenRadius, 12, 120)

    local aimbot = type(config.Aimbot) == "table" and config.Aimbot or {}
    local applySavedAimbot = booleanValue(aimbot, "Enabled", false)
    State.Aimbot.Mode = allowed(aimbot.Mode, {"Silent Aim (Góc 3)", "Aim truyền thống (Góc 1)"}, State.Aimbot.Mode)
    State.Aimbot.TargetType = allowed(aimbot.TargetType, {"Player", "NPC"}, State.Aimbot.TargetType)
    State.Aimbot.FOVRadius = math.floor(math.clamp(tonumber(aimbot.FOVRadius) or State.Aimbot.FOVRadius, 30, 1000))
    State.Aimbot.AimPart = allowed(aimbot.AimPart, {"Đầu", "Thân"}, State.Aimbot.AimPart)
    State.Aimbot.WallCheck = booleanValue(aimbot, "WallCheck", State.Aimbot.WallCheck)
    State.Aimbot.TeamCheck = booleanValue(aimbot, "TeamCheck", State.Aimbot.TeamCheck)
    State.Aimbot.StickyEnabled = booleanValue(aimbot, "StickyEnabled", State.Aimbot.StickyEnabled)
    State.Aimbot.StickyUsername = Extensions.CompletePlayerSearchText(tostring(aimbot.StickyUsername or State.Aimbot.StickyUsername or ""), false)
    State.Aimbot.StickyPlayer = nil
    Extensions.ParseAimbotBlacklist(tostring(aimbot.BlacklistText or State.Aimbot.BlacklistText or ""))
    State.Aimbot.ReleaseButtonVisible = booleanValue(aimbot, "ReleaseButtonVisible", State.Aimbot.ReleaseButtonVisible)

    local vision = type(config.Vision) == "table" and config.Vision or {}
    State.ClockTime = type(vision.ClockTime) == "number" and math.clamp(vision.ClockTime, 1, 24) or nil
    State.RemoveEffects = booleanValue(vision, "FullBrightEnabled", State.RemoveEffects)
    State.FullBrightLevel = State.RemoveEffects and math.clamp(tonumber(vision.FullBrightLevel) or 0, 0, 20) or nil
    State.XRay = booleanValue(vision, "XRay", State.XRay)
    State.XRayMethod = allowed(vision.XRayMethod, {"Hybrid", "Outline", "Wall Transparency"}, State.XRayMethod)
    State.XRayWallTransparency = math.clamp(tonumber(vision.XRayWallTransparency) or State.XRayWallTransparency, 0.1, 0.95)
    State.CameraFov = math.clamp(tonumber(vision.CameraFov) or State.CameraFov, 1, 120)
    State.UnlockZoom = booleanValue(vision, "UnlockZoom", State.UnlockZoom)
    State.ScreenBlankEnabled = booleanValue(vision, "ScreenBlankEnabled", State.ScreenBlankEnabled)
    State.ScreenBlankColor = allowed(vision.ScreenBlankColor, {"Đen", "Trắng"}, State.ScreenBlankColor)

    local travel = type(config.Travel) == "table" and config.Travel or {}
    State.TelePlayerMode = allowed(travel.TelePlayerMode, {"Instant", "Fly"}, State.TelePlayerMode)
    State.TeleItemMode = allowed(travel.TeleItemMode, {"Instant", "Fly"}, State.TeleItemMode)
    State.TravelSpeed = math.clamp(tonumber(travel.TravelSpeed) or State.TravelSpeed, 10, 1000)
    State.SavedButtonName = tostring(travel.SavedButtonName or State.SavedButtonName)

    local filter = type(config.MobFilter) == "table" and config.MobFilter or {}
    State.MobManualFilterEnabled = false
    State.MobFilterText = tostring(filter.Text or State.MobFilterText or "")
    State.MobFilterScanRadiusMeters = math.clamp(tonumber(filter.ScanRadiusMeters) or State.MobFilterScanRadiusMeters, 10, 5000)
    parseMobManualNames(State.MobFilterText)

    local misc = type(config.Misc) == "table" and config.Misc or {}
    local previousFPSBoost = State.FPSBoost
    State.NoVoid = booleanValue(misc, "NoVoid", State.NoVoid)
    State.NoVoidMargin = math.clamp(tonumber(misc.NoVoidMargin) or State.NoVoidMargin, 5, 200)
    State.AntiAFK = booleanValue(misc, "AntiAFK", State.AntiAFK)
    State.AntiStun = booleanValue(misc, "AntiStun", booleanValue(misc, "AntiRagdoll", State.AntiStun))
    State.GodMode = booleanValue(misc, "GodMode", State.GodMode)
    State.SmartSearchEnabled = booleanValue(misc, "SmartSearch", State.SmartSearchEnabled)
    State.FPSBoost = booleanValue(misc, "FastMode", booleanValue(misc, "FPSBoost", State.FPSBoost))
    State.ESPRefreshMode = allowed(misc.ESPRefreshMode, {"Adaptive", "25 FPS", "15 FPS", "10 FPS"}, State.ESPRefreshMode)
    if type(config.AutoLoad) == "boolean" then
        State.ConfigAutoLoad = config.AutoLoad
    end

    Extensions.SyncConfigControls()
    if not State.SpeedEnabled then
        resetSpeedSideEffects()
    end
    if not State.JumpEnabled then
        Extensions.ResetJumpSideEffects()
    end
    Extensions.SetFlantEnabled(State.FlantEnabled, true)
    Extensions.SetScreenBlank(State.ScreenBlankEnabled, true)
    Extensions.SetInspectorEnabled(State.Inspector.Enabled, true)
    Extensions.SetAimbotReleaseButtonVisible(State.Aimbot.ReleaseButtonVisible, true)
    if not State.Noclip then
        restoreCollisions()
    end
    LocalPlayer.CameraMinZoomDistance = State.UnlockZoom and 0.5 or OriginalCamera.MinZoom
    LocalPlayer.CameraMaxZoomDistance = State.UnlockZoom and 10000 or OriginalCamera.MaxZoom
    Extensions.SetAntiAFKEnabled(State.AntiAFK, true)
    Extensions.SetAntiStunEnabled(State.AntiStun, true)
    Extensions.SetGodModeEnabled(State.GodMode, true)
    Workspace.Gravity = State.GravityEnabled and State.GravityValue or OriginalGravity
    Camera = Workspace.CurrentCamera or Camera
    Camera.FieldOfView = State.CameraFov
    removeAllVisuals()
    if State.RemoveEffects then
        State.LastVisionDeepScan = 0
        applyNoEffects()
        applyFullBright()
        task.spawn(Extensions.DeepSuppressVision)
    else
        restoreEffects()
        restoreLightingVisuals()
    end
    if not State.XRay then
        restoreXRayOccluders()
    end
    if previousFPSBoost ~= State.FPSBoost then
        setFPSBoost(State.FPSBoost, true)
    end
    if State.MobESP.Enabled or State.XRay then
        if next(MobCache) == nil then
            task.spawn(rescanMobs)
        end
    end
    if State.ItemESP.Enabled or State.XRay then
        task.spawn(function()
            scanItems(false)
        end)
    end
    if applySavedAimbot then
        Extensions.SetAimbotEnabled(true, nil, true)
    end
    if not silent then
        notify("Đã áp dụng config chính thức.", Theme.Success)
    end
    return true
end

function Extensions.ReadConfig(silent)
    if not readfile or not isfile then
        if not silent then notify("DeltaX không cung cấp readfile/isfile.", Theme.Danger) end
        return nil
    end
    local path = isfile(Extensions.ConfigPath) and Extensions.ConfigPath
        or isfile(Extensions.LegacyConfigPath) and Extensions.LegacyConfigPath
        or isfile(Extensions.OriginalLegacyConfigPath) and Extensions.OriginalLegacyConfigPath
        or nil
    if not path then
        if not silent then notify("Chưa có config đã lưu.", Theme.Warning) end
        return nil
    end
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if not success or type(result) ~= "table" then
        if not silent then notify("Không đọc được config: " .. tostring(result), Theme.Danger) end
        return nil
    end
    return result
end

function Extensions.SaveConfig()
    if not writefile then
        notify("DeltaX không cung cấp writefile.", Theme.Danger)
        return false
    end
    local success, result = pcall(function()
        if makefolder and (not isfolder or not isfolder(Extensions.ConfigFolder)) then
            makefolder(Extensions.ConfigFolder)
        end
        writefile(Extensions.ConfigPath, HttpService:JSONEncode(Extensions.BuildConfig()))
    end)
    if success then
        notify("Đã lưu config vào " .. Extensions.ConfigPath, Theme.Success)
        return true
    end
    notify("Lưu config thất bại: " .. tostring(result), Theme.Danger)
    return false
end

function Extensions.LoadConfig(silent)
    local config = Extensions.ReadConfig(silent)
    if not config then return false end
    return Extensions.ApplyConfig(config, silent)
end

function Extensions.DeleteConfig()
    if not delfile or not isfile then
        notify("DeltaX không cung cấp delfile/isfile.", Theme.Danger)
        return false
    end
    local success, result = pcall(function()
        for _, path in ipairs({Extensions.ConfigPath, Extensions.LegacyConfigPath, Extensions.OriginalLegacyConfigPath}) do
            if isfile(path) then
                delfile(path)
            end
        end
    end)
    if success then
        notify("Đã xoá config đã lưu.", Theme.Success)
        return true
    end
    notify("Xoá config thất bại: " .. tostring(result), Theme.Danger)
    return false
end

