function Extensions.BuildAutoExecutorDispatcher()
    return string.format([==[
local settingsPath = %q
local dispatcherPath = %q
if not game:IsLoaded() then game.Loaded:Wait() end
local HttpService = game:GetService("HttpService")
if not readfile or not isfile or not isfile(settingsPath) then return end
local ok, settings = pcall(function() return HttpService:JSONDecode(readfile(settingsPath)) end)
if not ok or type(settings) ~= "table" or settings.Enabled ~= true then return end
local queueFunction = queue_on_teleport or queueonteleport
pcall(function() queueFunction = queueFunction or syn.queue_on_teleport end)
pcall(function() queueFunction = queueFunction or fluxus.queue_on_teleport end)
if type(queueFunction) == "function" and isfile(dispatcherPath) then
    pcall(queueFunction, readfile(dispatcherPath))
end
local environment = getgenv and getgenv() or _G
environment.RaphaelAutoDispatcherQueued = true
local scope = tostring(settings.Scope or "Mọi map")
local allowed = scope == "Mọi map" or (game.PlaceId == tonumber(settings.PlaceId) and game.Name == tostring(settings.MapName))
if not allowed then return end
local loaderPath = tostring(settings.LoaderPath or "Raphael_Sovereign_Official.txt")
if not isfile(loaderPath) then
    warn("[Raphael Auto Executor] Không tìm thấy file: " .. loaderPath)
    return
end
environment.RaphaelAutoLoadConfigOverride = settings.AutoLoadConfig ~= false
local source = readfile(loaderPath)
local compileOk, chunk = pcall(loadstring, source)
if not compileOk or type(chunk) ~= "function" then
    warn("[Raphael Auto Executor] Không biên dịch được loader: " .. tostring(chunk))
    return
end
local runOk, runError = pcall(chunk)
if not runOk then warn("[Raphael Auto Executor] " .. tostring(runError)) end
]==], Extensions.AutoExecutorSettingsPath, Extensions.AutoExecutorDispatcherPath)
end

function Extensions.WriteAutoExecutorFiles()
    if not writefile or not readfile or not isfile then
        return false, "executor thiếu writefile/readfile/isfile"
    end
    local success, result = pcall(function()
        if makefolder and (not isfolder or not isfolder(Extensions.ConfigFolder)) then makefolder(Extensions.ConfigFolder) end
        writefile(Extensions.AutoExecutorSettingsPath, HttpService:JSONEncode(Extensions.BuildAutoExecutorSettings()))
        writefile(Extensions.AutoExecutorDispatcherPath, Extensions.BuildAutoExecutorDispatcher())
    end)
    return success, result
end

function Extensions.LoadAutoExecutorSettings()
    if not readfile or not isfile or not isfile(Extensions.AutoExecutorSettingsPath) then return false end
    local success, settings = pcall(function()
        return HttpService:JSONDecode(readfile(Extensions.AutoExecutorSettingsPath))
    end)
    if not success or type(settings) ~= "table" then return false end
    local auto = State.AutoExecutor
    auto.Enabled = settings.Enabled == true
    auto.Scope = settings.Scope == "Chỉ map này" and "Chỉ map này" or "Mọi map"
    auto.LoaderPath = tostring(settings.LoaderPath or auto.LoaderPath)
    auto.PlaceId = tonumber(settings.PlaceId) or auto.PlaceId
    auto.MapName = tostring(settings.MapName or auto.MapName)
    auto.AutoLoadConfig = settings.AutoLoadConfig ~= false
    return true
end

function Extensions.QueueAutoExecutorDispatcher(silent, force)
    local auto = State.AutoExecutor
    local queueFunction = Extensions.GetQueueOnTeleport()
    if not queueFunction then
        if not silent then notify("Executor không hỗ trợ queue_on_teleport.", Theme.Danger) end
        return false
    end
    if not isfile or not isfile(auto.LoaderPath) then
        if not silent then notify("Không tìm thấy file Raphael tại: " .. auto.LoaderPath, Theme.Danger) end
        return false
    end
    local wrote, writeError = Extensions.WriteAutoExecutorFiles()
    if not wrote then
        if not silent then notify("Không tạo được Auto Executor: " .. tostring(writeError), Theme.Danger) end
        return false
    end
    if force or RuntimeEnvironment.RaphaelAutoDispatcherQueued ~= true then
        local queued, queueError = pcall(queueFunction, readfile(Extensions.AutoExecutorDispatcherPath))
        if not queued then
            if not silent then notify("Queue Auto Executor thất bại: " .. tostring(queueError), Theme.Danger) end
            return false
        end
        RuntimeEnvironment.RaphaelAutoDispatcherQueued = true
    end
    if not silent then notify("Đã queue Raphael cho lần teleport tiếp theo.", Theme.Success) end
    return true
end

function Extensions.RefreshAutoExecutorControls()
    local auto = State.AutoExecutor
    local controls = State.ConfigControls
    if controls.AutoExecutorEnabled and controls.AutoExecutorEnabled.Set then controls.AutoExecutorEnabled.Set(auto.Enabled, false) end
    if controls.AutoExecutorScope and controls.AutoExecutorScope.Set then controls.AutoExecutorScope.Set(auto.Scope, false) end
    if controls.AutoExecutorPath then controls.AutoExecutorPath.Text = auto.LoaderPath end
    if controls.AutoExecutorAutoLoad and controls.AutoExecutorAutoLoad.Set then controls.AutoExecutorAutoLoad.Set(auto.AutoLoadConfig, false) end
end

function Extensions.UpdateAutoExecutorSettings(silent)
    local wrote, result = Extensions.WriteAutoExecutorFiles()
    if not wrote and not silent then notify("Không lưu được Auto Executor: " .. tostring(result), Theme.Danger) end
    return wrote
end

function Extensions.SetAutoExecutorEnabled(enabled, silent)
    local auto = State.AutoExecutor
    enabled = not not enabled
    if enabled == auto.Enabled then
        Extensions.RefreshAutoExecutorControls()
        return true
    end
    auto.Enabled = enabled
    if enabled then
        auto.PlaceId = game.PlaceId
        auto.MapName = game.Name
        local wrote, result = Extensions.WriteAutoExecutorFiles()
        if not wrote then
            auto.Enabled = false
            if not silent then notify("Không bật được Auto Executor: " .. tostring(result), Theme.Danger) end
            Extensions.RefreshAutoExecutorControls()
            return false
        end
        if not Extensions.QueueAutoExecutorDispatcher(silent) then
            auto.Enabled = false
            Extensions.WriteAutoExecutorFiles()
            Extensions.RefreshAutoExecutorControls()
            return false
        end
    else
        Extensions.WriteAutoExecutorFiles()
        if not silent then notify("Đã hủy Auto Executor; dispatcher đã queue sẽ đọc trạng thái tắt.", Theme.Warning) end
    end
    Extensions.RefreshAutoExecutorControls()
    return true
end

Extensions.LoadAutoExecutorSettings()
if State.AutoExecutor.Enabled and RuntimeEnvironment.RaphaelAutoDispatcherQueued ~= true then
    task.defer(Extensions.QueueAutoExecutorDispatcher, true)
end


function Extensions.SerializeColor(color)
    return {
        R = math.floor(math.clamp(color.R, 0, 1) * 255 + 0.5),
        G = math.floor(math.clamp(color.G, 0, 1) * 255 + 0.5),
        B = math.floor(math.clamp(color.B, 0, 1) * 255 + 0.5)
    }
end

function Extensions.DeserializeColor(value, fallback)
    if type(value) ~= "table" then return fallback end
    local red = tonumber(value.R)
    local green = tonumber(value.G)
    local blue = tonumber(value.B)
    if not red or not green or not blue then return fallback end
    return Color3.fromRGB(math.clamp(red, 0, 255), math.clamp(green, 0, 255), math.clamp(blue, 0, 255))
end

