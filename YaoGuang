function Extensions.ParseAimbotBlacklist(text: any)
    local blacklist: {[string]: boolean} = {}
    local completed: {string} = {}
    local ambiguous = 0
    local source: string = tostring(text or "")
    for entry in string.gmatch(source, "[^,;\n]+") do
        local trimmed = string.gsub(entry, "^%s*@?%s*(.-)%s*$", "%1")
        if trimmed ~= "" then
            local resolved = trimmed
            if State.SmartSearchEnabled then
                local player, status = Extensions.ResolveUniquePlayer(trimmed, false)
                if player then
                    resolved = player.Name
                elseif status == "Ambiguous" then
                    ambiguous = ambiguous + 1
                end
            end
            local normalized = string.lower(tostring(resolved))
            if not blacklist[normalized] then
                blacklist[normalized] = true
                table.insert(completed, tostring(resolved))
            end
        end
    end
    State.Aimbot.BlacklistNames = blacklist
    State.Aimbot.BlacklistText = table.concat(completed, ", ")
    return State.Aimbot.BlacklistText, ambiguous
end

function Extensions.IsAimbotPlayerBlacklisted(player)
    return player ~= nil and State.Aimbot.BlacklistNames[string.lower(tostring(player.Name))] == true
end

Extensions.TeamEvidenceNames = {
    team = true, teamname = true, teamid = true,
    faction = true, factionname = true, factionid = true,
    squad = true, squadid = true, side = true, sideid = true,
    party = true, partyid = true
}

function Extensions.NormalizeTeamEvidence(value)
    if value == nil then return nil end
    if typeof(value) == "Instance" then
        return string.lower(tostring(value.Name or value))
    end
    local valueType = type(value)
    if valueType == "string" or valueType == "number" or valueType == "boolean" then
        local normalized = string.lower(string.gsub(tostring(value), "^%s*(.-)%s*$", "%1"))
        return normalized ~= "" and normalized or nil
    end
    if typeof(value) == "BrickColor" or typeof(value) == "Color3" then
        return string.lower(tostring(value))
    end
    return nil
end

function Extensions.GetPlayerTeamEvidence(player)
    local evidence = {}
    if not player then return evidence end
    local cache = State.Aimbot.TeamEvidenceCache[player]
    local now = os.clock()
    if cache and cache.Character == player.Character and now < cache.Expires then return cache.Evidence end
    if player.Team then evidence.robloxteam = "instance:" .. tostring(player.Team) end
    if not player.Neutral then evidence.teamcolor = string.lower(tostring(player.TeamColor)) end

    local function collect(container)
        if not container then return end
        for name, value in pairs(container:GetAttributes()) do
            local key = string.lower(tostring(name)):gsub("[^%w]", "")
            if Extensions.TeamEvidenceNames[key] then
                local normalized = Extensions.NormalizeTeamEvidence(value)
                if normalized then evidence[key] = normalized end
            end
        end
        for _, child in ipairs(container:GetChildren()) do
            local key = string.lower(tostring(child.Name)):gsub("[^%w]", "")
            if Extensions.TeamEvidenceNames[key] and (child:IsA("StringValue") or child:IsA("IntValue") or child:IsA("NumberValue") or child:IsA("BoolValue") or child:IsA("ObjectValue")) then
                local normalized = Extensions.NormalizeTeamEvidence(child.Value)
                if normalized then evidence[key] = normalized end
            end
        end
    end

    collect(player)
    collect(player.Character)
    collect(player:FindFirstChild("leaderstats"))
    for _, container in ipairs({player, player.Character}) do
        if container then
            for _, child in ipairs(container:GetChildren()) do
                local childName = string.lower(child.Name)
                if (child:IsA("Folder") or child:IsA("Configuration")) and (childName == "data" or childName == "stats" or childName == "profile" or childName == "values") then
                    collect(child)
                end
            end
        end
    end
    State.Aimbot.TeamEvidenceCache[player] = {Evidence = evidence, Character = player.Character, Expires = now + 0.45}
    return evidence
end

function Extensions.ComparePlayerTeams(leftPlayer, rightPlayer)
    if not leftPlayer or not rightPlayer then return false, false, "missing" end
    if leftPlayer == rightPlayer then return true, true, "self" end
    if leftPlayer.Team and rightPlayer.Team then
        return leftPlayer.Team == rightPlayer.Team, true, "Roblox Team"
    end
    if not leftPlayer.Neutral and not rightPlayer.Neutral then
        return leftPlayer.TeamColor == rightPlayer.TeamColor, true, "TeamColor"
    end

    local leftEvidence = Extensions.GetPlayerTeamEvidence(leftPlayer)
    local rightEvidence = Extensions.GetPlayerTeamEvidence(rightPlayer)
    local foundComparable = false
    for key, leftValue in pairs(leftEvidence) do
        local rightValue = rightEvidence[key]
        if rightValue ~= nil then
            foundComparable = true
            if leftValue == rightValue then return true, true, key end
        end
    end
    if foundComparable then return false, true, "custom faction" end
    return false, false, "unknown"
end

function Extensions.IsAimbotTeammate(player)
    if not State.Aimbot.TeamCheck or not player or player == LocalPlayer then return false end
    local sameTeam, known = Extensions.ComparePlayerTeams(LocalPlayer, player)
    return known and sameTeam or false
end

function Extensions.RefreshAimbotTeamStatus(showNotification)
    local teammateCount = 0
    local opponentCount = 0
    local unknownCount = 0
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local sameTeam, known = Extensions.ComparePlayerTeams(LocalPlayer, player)
            if known and sameTeam then
                teammateCount = teammateCount + 1
            elseif known then
                opponentCount = opponentCount + 1
            else
                unknownCount = unknownCount + 1
            end
        end
    end
    local summary = string.format("%d đồng đội · %d đối thủ · %d chưa rõ → coi là đối thủ", teammateCount, opponentCount, unknownCount)
    local statusValue = State.Aimbot.TeamStatusValue
    if statusValue and statusValue.Parent then
        statusValue.Text = summary
        statusValue.TextColor3 = unknownCount > 0 and Theme.Warning or Theme.Text
    end
    if showNotification then
        notify(summary, unknownCount > 0 and Theme.Warning or Theme.Success)
    end
    return teammateCount, opponentCount, unknownCount
end

function Extensions.ResolveStickyPlayer()
    local stickyText: string = tostring(State.Aimbot.StickyUsername or "")
    local cleanedStickyText: string = string.gsub(stickyText, "^%s*@?%s*(.-)%s*$", "%1")
    local normalized: string = string.lower(cleanedStickyText)
    if normalized == "" then
        State.Aimbot.StickyPlayer = nil
        return nil
    end
    local cached = State.Aimbot.StickyPlayer
    if cached and cached.Parent == Players and string.lower(tostring(cached.Name)) == normalized then
        return cached
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and string.lower(player.Name) == normalized then
            State.Aimbot.StickyPlayer = player
            return player
        end
    end
    State.Aimbot.StickyPlayer = nil
    return nil
end

function Extensions.IsAimbotPartInFOV(aimPart, scale)
    if not aimPart or not aimPart.Parent then
        return false, math.huge
    end
    Camera = Workspace.CurrentCamera or Camera
    local viewportPoint, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
    if not onScreen or viewportPoint.Z <= 0 then
        return false, math.huge
    end
    local difference = Vector2.new(viewportPoint.X, viewportPoint.Y) - Camera.ViewportSize * 0.5
    local distanceSquared = difference:Dot(difference)
    local radius = State.Aimbot.FOVRadius * (scale or 1)
    return distanceSquared <= radius * radius, distanceSquared
end

function Extensions.AimbotRayClear(origin, position, parameters, model)
    local direction = position - origin
    if direction.Magnitude <= 0.05 then
        return true
    end
    local result = Workspace:Raycast(origin, direction, parameters)
    if result == nil then return true end
    local instance = result.Instance
    if instance and instance:IsDescendantOf(model) then return true end
    if instance and instance ~= Workspace.Terrain and instance.Transparency >= 0.85 then return true end
    return false
end

function Extensions.HasAimbotLineOfSight(model, aimPart)
    if not State.Aimbot.WallCheck then
        return true
    end
    if not model or not aimPart or not aimPart.Parent then
        return false
    end
    Camera = Workspace.CurrentCamera or Camera
    local origin = Camera.CFrame.Position
    local parameters = State.Aimbot.RaycastParams
    local filter = State.Aimbot.RaycastFilterBuffer
    table.clear(filter)
    if LocalPlayer.Character then
        filter[1] = LocalPlayer.Character
    end
    parameters.FilterType = Enum.RaycastFilterType.Exclude
    parameters.FilterDescendantsInstances = filter
    parameters.IgnoreWater = false
    if Extensions.AimbotRayClear(origin, aimPart.Position, parameters, model) then
        return true
    end
    for _, name in ipairs(Extensions.AimbotLineNames) do
        local part = model:FindFirstChild(name)
        if part and part ~= aimPart and part:IsA("BasePart") and Extensions.AimbotRayClear(origin, part.Position, parameters, model) then
            return true
        end
    end
    return false
end

function Extensions.FindAimbotTarget()
    local aimbot = State.Aimbot
    if aimbot.ReleasedUntil > 0 and os.clock() >= aimbot.ReleasedUntil then
        aimbot.ReleasedModel = nil
        aimbot.ReleasedPlayer = nil
        aimbot.ReleasedUntil = 0
    end
    local bestModel
    local bestPlayer
    local bestHumanoid
    local bestPart
    local bestLabel
    local bestScore = math.huge
    local _, _, localRoot = getCharacter()
    local maximumStuds = aimbot.MaxDistanceMeters > 0 and aimbot.MaxDistanceMeters / 0.28 or math.huge
    local priority = aimbot.LowHealthPriority and "Máu thấp nhất" or aimbot.Priority

    local function consider(model: any, player: any, humanoid: any, label: any)
        if not model or not humanoid or (tonumber(humanoid.Health) or 0) <= 0 then
            return
        end
        if player and (Extensions.IsAimbotPlayerBlacklisted(player) or Extensions.IsAimbotTeammate(player)) then
            return
        end
        if model == aimbot.ReleasedModel or player == aimbot.ReleasedPlayer then
            return
        end
        if aimbot.IgnoreForceField and model:FindFirstChildOfClass("ForceField") then
            return
        end
        local aimPart = Extensions.GetAimbotPart(model)
        if not aimPart then
            return
        end
        local insideFOV, rawDistanceSquared = Extensions.IsAimbotPartInFOV(aimPart)
        if not insideFOV then
            return
        end
        local studsDistance = localRoot and (aimPart.Position - localRoot.Position).Magnitude or 0
        if studsDistance > maximumStuds then
            return
        end
        if not Extensions.HasAimbotLineOfSight(model, aimPart) then
            return
        end
        local distanceSquared = tonumber(rawDistanceSquared) or math.huge
        local score = distanceSquared
        if priority == "Gần nhân vật nhất" then
            score = studsDistance
        elseif priority == "Máu thấp nhất" then
            local maximum = math.max(tonumber(humanoid.MaxHealth) or 0, 1)
            local healthRatio = math.clamp((tonumber(humanoid.Health) or maximum) / maximum, 0, 1)
            score = healthRatio * 1000000000 + distanceSquared
        end
        if score < bestScore then
            bestScore = score
            bestModel = model
            bestPlayer = player
            bestHumanoid = humanoid
            bestPart = aimPart
            bestLabel = label
        end
    end

    if aimbot.TargetType == "Player" then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local character = player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                consider(character, player, humanoid, player.DisplayName .. " (@" .. player.Name .. ")")
            end
        end
    else
        for model, classification in pairs(MobCache) do
            if model and model.Parent and type(classification) == "table" and isMobAllowedByManualFilter(model, classification) then
                local humanoid = classification.Humanoid
                if not humanoid or not humanoid.Parent then
                    humanoid = model:FindFirstChildOfClass("Humanoid")
                end
                if humanoid and not belongsToPlayerCharacter(model) then
                    consider(model, nil, humanoid, classification.DisplayName or model.Name)
                end
            end
        end
    end

    return bestModel, bestPlayer, bestHumanoid, bestPart, bestLabel
end

function Extensions.AcquireAimbotTarget()
    local model, player, humanoid, aimPart, label = Extensions.FindAimbotTarget()
    if not model then
        return false
    end
    State.Aimbot.TargetModel = model
    State.Aimbot.TargetPlayer = player
    State.Aimbot.TargetHumanoid = humanoid
    State.Aimbot.TargetPart = aimPart
    local targetLabel = tostring(label or model.Name)
    Extensions.UpdateAimbotStatus("Đã khóa: " .. targetLabel, Theme.Success)
    Extensions.UpdateAimbotTargetESP()
    if State.Aimbot.NotifyTargetChanges then notify("Đang Aim: " .. targetLabel, Theme.Success) end
    return true
end

function Extensions.ReleaseAimbotTarget(silent)
    if not State.Aimbot.Enabled then
        if not silent then
            notify("Aimbot hiện không hoạt động.", Theme.Warning)
        end
        return false
    end
    if not State.Aimbot.TargetModel then
        if not silent then
            notify("Aimbot đang chờ mục tiêu khác trong FOV.", Theme.Warning)
        end
        return false
    end
    State.Aimbot.ReleasedModel = State.Aimbot.TargetModel
    State.Aimbot.ReleasedPlayer = State.Aimbot.TargetPlayer
    State.Aimbot.ReleasedUntil = os.clock() + 0.65
    Extensions.ClearAimbotTarget(false, "bỏ thủ công", silent)
    Extensions.UpdateAimbotStatus("Đã bỏ mục tiêu; đang chờ mục tiêu khác", Theme.Warning)
    return true
end

function Extensions.TryStickyAimbotOverride(now)
    if not State.Aimbot.StickyEnabled or State.Aimbot.TargetType ~= "Player" or now - State.Aimbot.LastStickyCheck < 0.08 then
        return false
    end
    State.Aimbot.LastStickyCheck = now
    local player = Extensions.ResolveStickyPlayer()
    if not player or player == State.Aimbot.TargetPlayer or Extensions.IsAimbotPlayerBlacklisted(player) or Extensions.IsAimbotTeammate(player) or player == State.Aimbot.ReleasedPlayer then
        return false
    end
    local character = player.Character
    if not character or character == State.Aimbot.ReleasedModel then
        return false
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local aimPart = Extensions.GetAimbotPart(character)
    if not humanoid or humanoid.Health <= 0 or not aimPart then
        return false
    end
    local insideFOV = Extensions.IsAimbotPartInFOV(aimPart)
    if not insideFOV or not Extensions.HasAimbotLineOfSight(character, aimPart) then
        return false
    end
    Extensions.ClearAimbotTarget(false, "chuyển sang mục tiêu Aim Dính", false)
    State.Aimbot.TargetModel = character
    State.Aimbot.TargetPlayer = player
    State.Aimbot.TargetHumanoid = humanoid
    State.Aimbot.TargetPart = aimPart
    local stickyLabel = player.DisplayName .. " (@" .. player.Name .. ")"
    Extensions.UpdateAimbotStatus("Aim Dính: " .. stickyLabel, Theme.Success)
    Extensions.UpdateAimbotTargetESP()
    if State.Aimbot.NotifyTargetChanges then notify("Đang Aim: " .. stickyLabel, Theme.Success) end
    return true
end

function Extensions.IsAimbotTargetValid()
    local model: any = State.Aimbot.TargetModel
    local humanoid: any = State.Aimbot.TargetHumanoid
    local aimPart: any = State.Aimbot.TargetPart
    if not model or not model.Parent or not model:IsDescendantOf(Workspace) then return false end
    if not humanoid or not humanoid.Parent or (tonumber(humanoid.Health) or 0) <= 0 then return false end
    if not aimPart or not aimPart.Parent or not aimPart:IsDescendantOf(model) then return false end
    local targetPlayer: any = State.Aimbot.TargetPlayer
    if targetPlayer and Extensions.IsAimbotTeammate(targetPlayer) then return false end
    return true
end

