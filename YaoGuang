function Extensions.RefreshInfoView()
    if ActiveTab ~= "Info" or not State.InterfaceVisible then
        notify("Hãy mở tab Info trước khi quét.", Theme.Warning)
        return
    end
    if State.InfoScanRunning then
        notify("Đang quét thông tin; vui lòng chờ hoàn tất.", Theme.Warning)
        return
    end
    State.InfoScanRunning = true
    State.InfoSnapshotTaken = true
    if rebuildPlayerList then
        rebuildPlayerList()
    end
    if refreshInfo then
        refreshInfo()
    end
    FPSValue.Text = "Đang đo..."
    if not State.GameInfoLoaded and not State.GameInfoLoading then
        State.GameInfoLoading = true
        task.spawn(function()
            local success, productInfo = pcall(function()
                return MarketplaceService:GetProductInfo(game.PlaceId)
            end)
            if success and productInfo then
                GameNameValue.Text = productInfo.Name
            else
                GameNameValue.Text = game.Name
            end
            State.GameInfoLoaded = true
            State.GameInfoLoading = false
        end)
    end
    task.spawn(function()
        local started = os.clock()
        local frames = 0
        while State.Running and os.clock() - started < 0.45 do
            RunService.RenderStepped:Wait()
            frames = frames + 1
        end
        local elapsed = math.max(os.clock() - started, 0.001)
        if FPSValue and FPSValue.Parent then
            FPSValue.Text = tostring(math.floor(frames / elapsed + 0.5))
        end
        State.InfoScanRunning = false
        notify("Đã chụp thông tin; dữ liệu sẽ được giữ nguyên đến lần quét tiếp theo.", Theme.Success)
    end)
end

