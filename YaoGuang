local function getItemHealthText(item)
    local current
    local maximum

    for _, name in ipairs(State.ItemHealthCurrentNames) do
        local attribute = item:GetAttribute(name)
        if type(attribute) == "number" then
            current = attribute
            break
        end
        local valueObject = item:FindFirstChild(name, true)
        if valueObject and (valueObject:IsA("NumberValue") or valueObject:IsA("IntValue")) then
            current = valueObject.Value
            break
        end
    end

    for _, name in ipairs(State.ItemHealthMaximumNames) do
        local attribute = item:GetAttribute(name)
        if type(attribute) == "number" then
