function Extensions.ApplyGodMode(humanoid)
    if not State.GodMode or not humanoid or not humanoid.Parent then
        return
    end
    if not State.GodBackup[humanoid] then
        State.GodBackup[humanoid] = {
            MaxHealth = humanoid.MaxHealth,
            Health = humanoid.Health,
            BreakJointsOnDeath = humanoid.BreakJointsOnDeath,
            RequiresNeck = humanoid.RequiresNeck,
            DeadEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Dead)
        }
    end
    pcall(function()
        humanoid.BreakJointsOnDeath = false
        humanoid.RequiresNeck = false
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
        if humanoid.MaxHealth < State.GodHealthValue then
            humanoid.MaxHealth = State.GodHealthValue
        end
        if humanoid.Health < State.GodHealthValue * 0.98 then
            humanoid.Health = State.GodHealthValue
        end
    end)
end

function Extensions.BindGodModeHumanoid(humanoid)
    if State.GodHealthConnection then
        State.GodHealthConnection:Disconnect()
        State.GodHealthConnection = nil
    end
    if not State.GodMode or not humanoid then
        return
    end
    Extensions.ApplyGodMode(humanoid)
    State.GodHealthConnection = humanoid.HealthChanged:Connect(function(health)
        if State.GodMode and humanoid.Parent and health < State.GodHealthValue * 0.98 then
            Extensions.ApplyGodMode(humanoid)
        end
    end)
end

function Extensions.RestoreGodMode()
    if State.GodHealthConnection then
        State.GodHealthConnection:Disconnect()
        State.GodHealthConnection = nil
    end
    for humanoid, backup in pairs(State.GodBackup) do
        if humanoid and humanoid.Parent then
            pcall(function()
                humanoid.MaxHealth = backup.MaxHealth
                humanoid.Health = math.min(math.max(backup.Health, 1), backup.MaxHealth)
                humanoid.BreakJointsOnDeath = backup.BreakJointsOnDeath
                humanoid.RequiresNeck = backup.RequiresNeck
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, backup.DeadEnabled)
            end)
        end
    end
    table.clear(State.GodBackup)
end

