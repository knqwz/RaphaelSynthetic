local DrawingLibrary = rawget(RuntimeEnvironment, "Drawing") or rawget(_G, "Drawing")
local DrawingSupported = DrawingLibrary and type(DrawingLibrary.new) == "function"

local function newDrawing(className)
    if not DrawingSupported then
        return nil
    end
    local success, object = pcall(function()
        return DrawingLibrary.new(className)
    end)
    if success then
        return object
    end
    DrawingSupported = false
    return nil
end

local function destroyDrawing(object)
    if object then
        pcall(function()
            object:Remove()
        end)
    end
end

local function setDrawingVisible(object, visible)
    if object and State.DrawingVisibility[object] ~= visible then
        State.DrawingVisibility[object] = visible
        pcall(function()
            object.Visible = visible
        end)
    end
end

local function getCategoryConfig(category)
    if category == "Player" then
        return State.PlayerESP
    elseif category == "Mob" then
        return State.MobESP
    end
    return State.ItemESP
end

function Extensions.ParsePlayerESPFilter(text)
    State.PlayerESP.ManualFilterText = tostring(text or "")
    table.clear(State.PlayerESP.ManualFilterNames)
    local count = 0
    for entry in string.gmatch(State.PlayerESP.ManualFilterText, "[^,;\n]+") do
        local trimmed = string.gsub(entry, "^%s*(.-)%s*$", "%1")
        local withoutAt = string.gsub(trimmed, "^@", "")
        local normalized = string.lower(withoutAt)
        if normalized ~= "" and not State.PlayerESP.ManualFilterNames[normalized] then
            State.PlayerESP.ManualFilterNames[normalized] = true
            count = count + 1
        end
    end
    return count
end

function Extensions.IsPlayerESPAllowed(player)
    if not State.PlayerESP.ManualFilterEnabled then
        return true
    end
    return player ~= nil and State.PlayerESP.ManualFilterNames[string.lower(player.Name)] == true
end

function Extensions.GetMobVisualAnchor(model, fallbackRoot)
    if model and model.Parent then
        local head = model:FindFirstChild("Head")
        if head and head:IsA("BasePart") then
            return head
        end
        local upperTorso = model:FindFirstChild("UpperTorso")
        if upperTorso and upperTorso:IsA("BasePart") then
            return upperTorso
        end
        local torso = model:FindFirstChild("Torso")
        if torso and torso:IsA("BasePart") then
            return torso
        end
    end
    if fallbackRoot and fallbackRoot.Parent and fallbackRoot:IsA("BasePart") then
        return fallbackRoot
    end
    if model and model.Parent then
        local humanoidRoot = model:FindFirstChild("HumanoidRootPart")
        if humanoidRoot and humanoidRoot:IsA("BasePart") then
            return humanoidRoot
        end
    end
    return nil
end

function Extensions.GetMobWorldPosition(model, visualAnchor)
    local anchorPosition = visualAnchor and visualAnchor.Position or nil
    if model and model.Parent then
        local success, pivotCFrame = pcall(model.GetPivot, model)
        if success and pivotCFrame then
            local pivotPosition = pivotCFrame.Position
            if not anchorPosition or (pivotPosition - anchorPosition).Magnitude <= 100 then
                return pivotPosition
            end
        end
    end
    return anchorPosition
end

