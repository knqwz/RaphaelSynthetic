function Extensions.RefreshInfoView()
    if ActiveTab ~= "Info" or not State.InterfaceVisible then
        notify("Hãy mở tab Info trước khi quét.", Theme.Warning)
        return
    end
    if State.InfoScanRunning then
        notify("Đang quét thông tin; vui lòng chờ hoàn tất.", Theme.Warning)
        return
    end
    State.InfoScanRunning = true
    State.InfoSnapshotTaken = true
    if rebuildPlayerList then
        rebuildPlayerList()
    end
    if refreshInfo then
        refreshInfo()
    end
    FPSValue.Text = "Đang đo..."
    if not State.GameInfoLoaded and not State.GameInfoLoading then
        State.GameInfoLoading = true
        task.spawn(function()
            local success, productInfo = pcall(function()
                return MarketplaceService:GetProductInfo(game.PlaceId)
            end)
            if success and productInfo then
                GameNameValue.Text = productInfo.Name
            else
                GameNameValue.Text = game.Name
            end
            State.GameInfoLoaded = true
            State.GameInfoLoading = false
        end)
    end
    task.spawn(function()
        local started = os.clock()
        local frames = 0
        while State.Running and os.clock() - started < 0.45 do
            RunService.RenderStepped:Wait()
            frames = frames + 1
        end
        local elapsed = math.max(os.clock() - started, 0.001)
        if FPSValue and FPSValue.Parent then
            FPSValue.Text = tostring(math.floor(frames / elapsed + 0.5))
        end
        State.InfoScanRunning = false
        notify("Đã chụp thông tin; dữ liệu sẽ được giữ nguyên đến lần quét tiếp theo.", Theme.Success)
    end)
end

function Extensions.PlayerFromDeathValue(value)
    if typeof(value) == "Instance" then
        if value:IsA("Player") then return value end
        if value:IsA("Model") then return Players:GetPlayerFromCharacter(value) end
        if value:IsA("BasePart") then
            local model = value:FindFirstAncestorOfClass("Model")
            return model and Players:GetPlayerFromCharacter(model) or nil
        end
    elseif type(value) == "number" then
        for _, player in ipairs(Players:GetPlayers()) do
            if player.UserId == value then return player end
        end
    elseif type(value) == "string" and value ~= "" then
        local numeric = tonumber(value)
        local normalized = string.lower(value)
        local uniqueDisplay = nil
        local displayMatches = 0
        for _, player in ipairs(Players:GetPlayers()) do
            if string.lower(player.Name) == normalized or numeric and player.UserId == numeric then return player end
            if string.lower(player.DisplayName) == normalized then
                uniqueDisplay = player
                displayMatches = displayMatches + 1
            end
        end
        if displayMatches == 1 then return uniqueDisplay end
    end
    return nil
end

function Extensions.ResolveObservableKiller(victim, character, humanoid)
    local accepted = {
        creator = true,
        killer = true,
        killertag = true,
        lastdamager = true,
        lastattacker = true,
        lasthitby = true,
        attacker = true,
        damageowner = true,
    }
    local function keyAccepted(name)
        return accepted[string.lower(tostring(name)):gsub("[^%w]", "")] == true
    end
    for _, container in ipairs({humanoid, character}) do
        if container then
            for _, child in ipairs(container:GetChildren()) do
                if keyAccepted(child.Name) and (child:IsA("ObjectValue") or child:IsA("StringValue") or child:IsA("IntValue") or child:IsA("NumberValue")) then
                    local killer = Extensions.PlayerFromDeathValue(child.Value)
                    if killer then return killer, child.Name end
                end
            end
            for attribute, value in pairs(container:GetAttributes()) do
                if keyAccepted(attribute) then
                    local killer = Extensions.PlayerFromDeathValue(value)
                    if killer then return killer, attribute end
                end
            end
        end
    end
    if victim then
        for attribute, value in pairs(victim:GetAttributes()) do
            if keyAccepted(attribute) then
                local killer = Extensions.PlayerFromDeathValue(value)
                if killer then return killer, attribute end
            end
        end
    end
    return nil, nil
end

function Extensions.NotifyPlayerDeath(victim, character, humanoid)
    local killer, source = Extensions.ResolveObservableKiller(victim, character, humanoid)
    local victimLabel = victim.DisplayName .. " (@" .. victim.Name .. ")"
    local text
    if killer then
        local killerLabel = killer.DisplayName .. " (@" .. killer.Name .. ")"
        text = "☠ " .. victimLabel .. " đã chết · Killer: " .. killerLabel
        if killer == victim then text = "☠ " .. victimLabel .. " đã chết · Tự gây sát thương" end
    else
        text = "☠ " .. victimLabel .. " đã chết"
    end
    if State.DeathNotifications.Enabled then
        notify(text, killer and Theme.Danger or Theme.Warning)
    end
    if State.ActivityLog.Enabled then
        Extensions.PushActivityLog("[DEATH] " .. text .. (source and (" · nguồn: " .. source) or ""), "warn", victim == LocalPlayer)
    end
end

function Extensions.HookDeathNotificationCharacter(player, character)
    local tracker = State.DeathNotifications
    if not character or tracker.HookedCharacters[character] then return end
    tracker.HookedCharacters[character] = true
    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 8)
        if not State.Running or not humanoid or not humanoid.Parent then return end
        local reported = false
        connect(humanoid.Died, function()
            if reported then return end
            reported = true
            local immediateKiller = Extensions.ResolveObservableKiller(player, character, humanoid)
            if immediateKiller then
                Extensions.NotifyPlayerDeath(player, character, humanoid)
            else
                task.delay(0.12, function()
                    if State.Running then Extensions.NotifyPlayerDeath(player, character, humanoid) end
                end)
            end
        end)
    end)
end

