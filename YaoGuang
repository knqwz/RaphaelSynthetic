function Extensions.MakeSectionCollapsible(section, collapsed)
    local titleHolder
    local chrome = {}
    for _, child in ipairs(section:GetChildren()) do
        chrome[child] = true
        if not titleHolder and child:IsA("Frame") then titleHolder = child end
    end
    if not titleHolder then return nil end
    local control = {Collapsed = not not collapsed}
    local hit = Instance.new("TextButton")
    hit.Name = "CollapseHit"
    hit:SetAttribute("RaphaelButtonArtworkExempt", true)
    hit.Size = UDim2.fromScale(1, 1)
