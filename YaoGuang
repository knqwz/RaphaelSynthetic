        if circle then
            pcall(function()
                circle.Filled = false
                circle.NumSides = 64
                circle.Thickness = 2
                circle.Transparency = 0.9
                circle.Color = Theme.Accent
                circle.Visible = false
            end)
            State.Aimbot.FOVDrawing = circle
            return
        end
    end

    local circleFrame = Instance.new("Frame")
    circleFrame.Name = "AimbotFOVCircle"
    circleFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    circleFrame.BackgroundTransparency = 1
    circleFrame.BorderSizePixel = 0
    circleFrame.ZIndex = 80
    circleFrame.Visible = false
    circleFrame.Parent = Overlay
    Instance.new("UICorner", circleFrame).CornerRadius = UDim.new(1, 0)
    local stroke = Instance.new("UIStroke")
    stroke.Name = "FOVStroke"
    stroke.Color = Theme.Accent
    stroke.Thickness = 2
    stroke.Transparency = 0.1
    stroke.Parent = circleFrame
    State.Aimbot.FOVGui = circleFrame
end

function Extensions.UpdateAimbotFOV()
    if not State.Aimbot.Enabled and not State.Aimbot.FOVDrawing and not State.Aimbot.FOVGui then
        return
    end
    Extensions.EnsureAimbotFOV()
    Camera = Workspace.CurrentCamera or Camera
    local center = Camera.ViewportSize * 0.5
    local radius = State.Aimbot.FOVRadius
    local locked = State.Aimbot.TargetModel ~= nil
    local circleColor = locked and Theme.Success or Theme.Accent
    local drawingCircle = State.Aimbot.FOVDrawing
    if drawingCircle then
        pcall(function()
            drawingCircle.Position = center
            drawingCircle.Radius = radius
            drawingCircle.Color = circleColor
            drawingCircle.Visible = State.Aimbot.Enabled
        end)
    end
    local guiCircle = State.Aimbot.FOVGui
    if guiCircle and guiCircle.Parent then
        guiCircle.Position = UDim2.fromOffset(center.X, center.Y)
        guiCircle.Size = UDim2.fromOffset(radius * 2, radius * 2)
        guiCircle.Visible = State.Aimbot.Enabled
        local stroke = guiCircle:FindFirstChild("FOVStroke")
        if stroke then
            stroke.Color = circleColor
        end
    end
end

