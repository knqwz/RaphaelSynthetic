function Extensions.GetQueueOnTeleport()
    local queueFunction: any = queue_on_teleport or queueonteleport
    pcall(function() queueFunction = queueFunction or syn.queue_on_teleport end)
    pcall(function() queueFunction = queueFunction or fluxus.queue_on_teleport end)
    return type(queueFunction) == "function" and queueFunction or nil
end

