scanItems = function(forceNotification)
    if State.ItemScanRunning then
        return 0
    end
    State.ItemScanRunning = true
    Extensions.ParseItemSearchTerms(State.ItemESP.ExactName)
    local found = State.ItemFoundBuffer
    table.clear(found)
    local foundCount = 0
    local totalMatches = 0

    if #State.ItemESP.SearchTerms > 0 then
        local descendants = Workspace:GetDescendants()
        for index, instance in ipairs(descendants) do
            if Extensions.IsItemSearchMatch(instance) and not isCharacterDescendant(instance) then
                totalMatches = totalMatches + 1
                if foundCount < State.ItemESP.MaxTargets then
                    found[instance] = true
                    foundCount = foundCount + 1
                end
            end
            if index % 180 == 0 then
                RunService.Heartbeat:Wait()
            end
        end
        table.clear(descendants)
    end

    for item in pairs(ItemCache) do
        if not found[item] then
            ItemCache[item] = nil
            local visual = Visuals.Item[item]
            if visual then
                Extensions.ReleaseVisual("Item", item, visual)
            end
        end
    end
    for item in pairs(found) do
        ItemCache[item] = true
    end
    State.ItemESP.TrackedCount = foundCount
    State.ItemESP.RenderShard = 0
    State.ItemScanRunning = false

    if forceNotification then
        if #State.ItemESP.SearchTerms == 0 then
            notify("Hãy nhập ít nhất một phần tên rồi nhấn Enter để dò Workspace.", Theme.Warning)
        elseif totalMatches > foundCount then
            notify("Tìm thấy " .. totalMatches .. " đối tượng; đang hiển thị giới hạn " .. foundCount .. " kết quả để giữ FPS.", Theme.Warning)
        else
            notify("Đã dò và lập chỉ mục " .. foundCount .. " đối tượng khớp tên.", foundCount > 0 and Theme.Success or Theme.Warning)
        end
    end
    return foundCount
end

function Extensions.ResetUniversalScanCandidates()
    local candidates = State.UniversalScan.CandidateBuffer
    local pool = State.UniversalScan.CandidatePool
    for index = #candidates, 1, -1 do
        local candidate = candidates[index]
        candidate.Target = nil
        candidate.Root = nil
        candidates[index] = nil
        pool[#pool + 1] = candidate
    end
end

function Extensions.InsertUniversalScanCandidate(target, root, distanceSquared)
    local candidates = State.UniversalScan.CandidateBuffer
    local limit = State.UniversalScan.MaxTargets
    local count = #candidates
    if count >= limit and distanceSquared >= candidates[count].DistanceSquared then
        return
    end
    local candidate
    if count >= limit then
        candidate = candidates[count]
    else
        local pool = State.UniversalScan.CandidatePool
        candidate = pool[#pool]
        if candidate then
            pool[#pool] = nil
        else
            candidate = {}
        end
        count = count + 1
    end
    local insertIndex = count
    while insertIndex > 1 and candidates[insertIndex - 1].DistanceSquared > distanceSquared do
        candidates[insertIndex] = candidates[insertIndex - 1]
        insertIndex = insertIndex - 1
    end
    candidate.Target = target
    candidate.Root = root
    candidate.DistanceSquared = distanceSquared
    candidates[insertIndex] = candidate
end

function Extensions.GetUniversalScanObject(instance)
    if not instance or not instance.Parent then
        return nil
    end
    if instance:IsA("Tool") then
        return getAdorneeRoot(instance) and instance or nil
    elseif instance:IsA("Model") then
        return getAdorneeRoot(instance) and instance or nil
    elseif instance:IsA("BasePart") then
        if instance:FindFirstAncestorOfClass("Model") or instance:FindFirstAncestorOfClass("Tool") then
            return nil
        end
        return instance
    end
    return nil
end

function Extensions.IsUniversalScanExcluded(target)
    local mode = State.UniversalScan.ExcludeMode
    local excludePlayers = mode == "Loại trừ Player" or mode == "Loại trừ cả hai"
    local excludeMobs = mode == "Loại trừ Quái" or mode == "Loại trừ cả hai"
    if excludePlayers and isPlayerCharacterDescendant(target) then
        return true
    end
    if excludeMobs then
        local model = target:IsA("Model") and target or target:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") and not belongsToPlayerCharacter(model) then
            return true
        end
    end
    return false
end

function Extensions.BuildUniversalScanLines(names, itemLimit, maximumCharacters, truncateLength)
    local lines = {}
    local currentLine = ""
    local limit = math.min(#names, math.max(0, itemLimit or #names))
    local lineLimit = math.max(24, maximumCharacters or 80)
    for index = 1, limit do
        local name = string.gsub(tostring(names[index] or ""), "%s+", " ")
        if truncateLength then
            local characterCount = utf8.len(name)
            if characterCount and characterCount > truncateLength then
                local cutPosition = utf8.offset(name, math.max(2, truncateLength - 2))
                if cutPosition then
                    name = string.sub(name, 1, cutPosition - 1) .. "..."
                end
            end
        end
        local candidate = currentLine == "" and name or currentLine .. ", " .. name
        if currentLine ~= "" and #candidate > lineLimit then
            lines[#lines + 1] = currentLine .. ","
            currentLine = name
        else
            currentLine = candidate
        end
    end
    if currentLine ~= "" then
        lines[#lines + 1] = currentLine
    end
    return lines, limit
end

function Extensions.FormatUniversalScanDisplay(names)
    local total = #names
    if total == 0 then
        return "Không tìm thấy tên phù hợp."
    end
    local visibleLimit = math.min(total, 36)
    local lines
    while visibleLimit > 0 do
        lines = Extensions.BuildUniversalScanLines(names, visibleLimit, 68, 26)
        if #lines <= 5 then
            break
        end
        visibleLimit = visibleLimit - 1
    end
    local hiddenCount = total - visibleLimit
    if hiddenCount > 0 then
        lines[#lines + 1] = "... và " .. hiddenCount .. " tên khác; dùng Sao chép tất cả."
    end
    return total .. " tên duy nhất:\n" .. table.concat(lines, "\n")
end

function Extensions.FormatUniversalScanClipboard(names)
    local lines = Extensions.BuildUniversalScanLines(names, #names, 100, nil)
    return table.concat(lines, "\n")
end

function Extensions.RunUniversalScan()
    if State.UniversalScan.ScanRunning then
        notify("Quét Đa Năng đang chạy.", Theme.Warning)
        return
    end
    State.UniversalScan.ScanRunning = true
    Extensions.ResetUniversalScanCandidates()
    table.clear(State.UniversalScan.ResultNames)
    table.clear(State.UniversalScan.ResultNameSet)
    if State.UniversalScan.ResultsBox and State.UniversalScan.ResultsBox.Parent then
        State.UniversalScan.ResultsBox.Text = "Đang lập chỉ mục Workspace..."
    end
    setStatusText("Quét Đa Năng đang chạy · 0%", Theme.Warning)

    local totalObjects = 0
    local visibleCount = 0
    local success, failure = pcall(function()
        local _, _, localRoot = getCharacter()
        local origin = localRoot and localRoot.Position or Camera.CFrame.Position
        local descendants = Workspace:GetDescendants()
        local descendantCount = #descendants
        for index, instance in ipairs(descendants) do
            local target = Extensions.GetUniversalScanObject(instance)
            if target and not Extensions.IsUniversalScanExcluded(target) then
                local root = getAdorneeRoot(target)
                if root then
                    totalObjects = totalObjects + 1
                    local normalizedName = string.lower(tostring(target.Name))
                    if not State.UniversalScan.ResultNameSet[normalizedName] then
                        State.UniversalScan.ResultNameSet[normalizedName] = true
                        State.UniversalScan.ResultNames[#State.UniversalScan.ResultNames + 1] = target.Name
                    end
                    local offset = root.Position - origin
                    Extensions.InsertUniversalScanCandidate(target, root, offset:Dot(offset))
                end
            end
            if index % 900 == 0 then
                local progress = descendantCount > 0 and math.floor(index / descendantCount * 100 + 0.5) or 100
                setStatusText("Quét Đa Năng đang chạy · " .. math.min(progress, 99) .. "%", Theme.Warning)
                if State.UniversalScan.ResultsBox and State.UniversalScan.ResultsBox.Parent then
                    State.UniversalScan.ResultsBox.Text = #State.UniversalScan.ResultNames .. " tên tạm thời · đang quét " .. index .. "/" .. descendantCount
                end
                RunService.Heartbeat:Wait()
            end
        end
        table.clear(descendants)

        for target, visual in pairs(Visuals.Scan) do
            Extensions.ReleaseVisual("Scan", target, visual)
        end
        table.clear(State.UniversalScan.Cache)
        local candidates = State.UniversalScan.CandidateBuffer
        visibleCount = #candidates
        for index = 1, visibleCount do
            local candidate = candidates[index]
            if candidate.Target and candidate.Target.Parent then
                State.UniversalScan.Cache[candidate.Target] = candidate.Root
            end
        end
        table.sort(State.UniversalScan.ResultNames, function(left, right)
            return string.lower(left) < string.lower(right)
        end)
        State.UniversalScan.Active = true
    end)

    Extensions.ResetUniversalScanCandidates()
    State.UniversalScan.ScanRunning = false
    local summary = Extensions.FormatUniversalScanDisplay(State.UniversalScan.ResultNames)
    if State.UniversalScan.ResultsBox and State.UniversalScan.ResultsBox.Parent then
        State.UniversalScan.ResultsBox.Text = (success and "HOÀN TẤT" or "DỪNG AN TOÀN") .. " · " .. summary
        State.UniversalScan.ResultsBox.CursorPosition = 1
    end
    if success then
        setStatusText("Quét Đa Năng hoàn tất · " .. #State.UniversalScan.ResultNames .. " tên · " .. visibleCount .. " visual", Theme.Success)
        notify("Quét Đa Năng đã hoàn tất · " .. #State.UniversalScan.ResultNames .. " tên, " .. totalObjects .. " đối tượng, " .. visibleCount .. " visual.", visibleCount > 0 and Theme.Success or Theme.Warning)
    else
        State.UniversalScan.Active = next(State.UniversalScan.Cache) ~= nil
        setStatusText("Quét Đa Năng dừng an toàn · giữ " .. #State.UniversalScan.ResultNames .. " tên", Theme.Danger)
        notify("Quét Đa Năng dừng an toàn; đã giữ " .. #State.UniversalScan.ResultNames .. " tên. " .. tostring(failure), Theme.Danger)
    end
end

