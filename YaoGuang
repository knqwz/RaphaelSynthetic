local materialTone = {}
for _, entry in ipairs({
    {"Grass", 88, 142, 70}, {"LeafyGrass", 96, 150, 72}, {"Sand", 204, 184, 124}, {"Sandstone", 196, 164, 118},
    {"Concrete", 152, 152, 156}, {"Pavement", 120, 120, 124}, {"Asphalt", 72, 74, 80}, {"Brick", 156, 84, 72},
