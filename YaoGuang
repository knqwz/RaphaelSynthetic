function Extensions.NormalizeSearchText(text)
    local normalized = tostring(text or "")
    local characters = {}
    for _, codepoint in utf8.codes(normalized) do
        local character = utf8.char(codepoint)
        table.insert(characters, Extensions.SearchAccentMap[character] or string.lower(character))
    end
    normalized = table.concat(characters)
    normalized = string.gsub(normalized, "[^%w%s_]", " ")
    normalized = string.gsub(normalized, "%s+", " ")
    local trimmed = string.gsub(normalized, "^%s*(.-)%s*$", "%1")
    return trimmed
end

function Extensions.RegisterFunctionSearch(name, description, target)
    if not target then
        return
    end
    local current = target
    local pageName
    local sectionName
    while current do
        if not sectionName then
            sectionName = current:GetAttribute("RaphaelSearchSection")
        end
        if current:IsA("ScrollingFrame") then
            pageName = string.match(current.Name, "^(.-)Page$")
            if pageName then
                break
            end
        end
        current = current.Parent
    end
    if not pageName then
        return
    end
    sectionName = tostring(sectionName or pageName)
    table.insert(State.FunctionSearchEntries, {
        Name = tostring(name or "Chức năng"),
        Description = tostring(description or ""),
        Page = pageName,
        Section = sectionName,
        Target = target,
        SearchText = Extensions.NormalizeSearchText(tostring(name or "") .. " " .. tostring(description or "") .. " " .. sectionName .. " " .. pageName)
    })
end

local function formatDuration(totalSeconds)
    local seconds = math.max(0, math.floor(totalSeconds))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local remaining = seconds % 60
    return string.format("%02d:%02d:%02d", hours, minutes, remaining)
end

local function notify(text, color)
    if StatusLabel and StatusLabel.Parent then
        StatusLabel.Text = text
        StatusLabel.TextColor3 = color or Theme.SubText
        if color == Theme.Warning or color == Theme.Danger then
            UI.Motion.Shake(StatusLabel)
        end
    end
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Raphael Sovereign",
            Text = text,
            Duration = 3
        })
    end)
end

local function getCharacter()
    local character = LocalPlayer.Character
    if not character then
        return nil, nil, nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart
    return character, humanoid, root
end

local function rememberHumanoid(humanoid)
    if humanoid and not HumanoidOriginals[humanoid] then
        HumanoidOriginals[humanoid] = {
            WalkSpeed = humanoid.WalkSpeed,
            UseJumpPower = humanoid.UseJumpPower,
            JumpPower = humanoid.JumpPower,
            JumpHeight = humanoid.JumpHeight,
            FallingDownEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.FallingDown),
            RagdollEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Ragdoll),
            PhysicsEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Physics)
        }
    end
    return humanoid and HumanoidOriginals[humanoid] or nil
end

local function restoreHumanoid(humanoid)
    local original = humanoid and HumanoidOriginals[humanoid]
    if humanoid and original then
        pcall(function()
            humanoid.WalkSpeed = original.WalkSpeed
            humanoid.UseJumpPower = original.UseJumpPower
            humanoid.JumpPower = original.JumpPower
            humanoid.JumpHeight = original.JumpHeight
            humanoid.PlatformStand = false
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, original.FallingDownEnabled)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, original.RagdollEnabled)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, original.PhysicsEnabled)
        end)
    end
end

