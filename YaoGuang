function Extensions.UpdateAimbotTargetESP()
    local aimbot = State.Aimbot
    local aimStyle = State.AimESP
    local enabled = aimbot.Enabled and aimbot.ShowTargetESP and Extensions.IsAimbotTargetValid()
    if enabled then Extensions.EnsureAimbotTargetESP() end
    local boxVisible = enabled and aimStyle.Box
    if aimbot.TargetESPHighlight then
        aimbot.TargetESPHighlight.Adornee = boxVisible and aimbot.TargetModel or nil
        aimbot.TargetESPHighlight.Enabled = boxVisible and true or false
    end
    local tracerVisible = enabled and aimStyle.Tracer
    if tracerVisible then
        local line = aimbot.TargetESPTracer
        if not line or not line.Parent then
            line = Instance.new("Frame")
            line.Name = "RaphaelAimTracer"
            line.AnchorPoint = Vector2.new(0.5, 0.5)
            line.BackgroundColor3 = Theme.Danger:Lerp(Color3.fromRGB(255, 255, 255), 0.08)
            line.BorderSizePixel = 0
            line.Visible = false
            line.ZIndex = 41
            line:SetAttribute("RaphaelOwned", true)
            line.Parent = Overlay
            Instance.new("UICorner", line).CornerRadius = UDim.new(1, 0)
            aimbot.TargetESPTracer = line
        end
        local anchorPart = aimbot.TargetPart or aimbot.TargetModel.PrimaryPart
        Camera = Workspace.CurrentCamera or Camera
        local projected, onScreen = Camera:WorldToViewportPoint(anchorPart.Position)
        if onScreen and projected.Z > 0 then
            local origin = Extensions.GetTracerOriginPoint(aimStyle)
            local target = Vector2.new(projected.X, projected.Y)
            local delta = target - origin
            local length = delta.Magnitude
            line.Position = UDim2.fromOffset((origin.X + target.X) * 0.5, (origin.Y + target.Y) * 0.5)
            line.Size = UDim2.fromOffset(length, State.ESPStyle.TracerThickness)
            line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
            line.Visible = length > 1
        else
            line.Visible = false
        end
    elseif aimbot.TargetESPTracer then
        aimbot.TargetESPTracer.Visible = false
    end
    if aimbot.TargetESPBillboard then
        local showLabel = enabled and (aimStyle.Name or aimStyle.Health or aimStyle.Distance)
        local anchor = showLabel and (aimbot.TargetModel:FindFirstChild("Head") or aimbot.TargetPart) or nil
        aimbot.TargetESPBillboard.Adornee = anchor
        aimbot.TargetESPBillboard.Enabled = anchor ~= nil
        if anchor and aimbot.TargetESPLabel then
            local style = State.ESPStyle
            local apply = style.ApplyToAimbot
            local nameSize = apply and style.NameSize or 14
            local detailSize = apply and style.HealthSize or 12
            local fontFace = apply and Extensions.GetESPFont() or Enum.Font.GothamBold
            local strokeValue = apply and style.TextStroke or 0
            local humanoid = aimbot.TargetHumanoid
            local hasHealth = humanoid and humanoid.MaxHealth > 0
            local ratio = hasHealth and math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) or 0
            local player = aimbot.TargetPlayer
            local name = player and (player.DisplayName .. " (@" .. player.Name .. ")") or tostring(aimbot.TargetModel.Name)
            local parts = {}
            if aimStyle.Health and hasHealth then
                parts[#parts + 1] = string.format("HP %d/%d", math.max(math.floor(humanoid.Health + 0.5), 0), math.max(math.floor(humanoid.MaxHealth + 0.5), 0))
            end
            if aimStyle.Distance then
                local _, _, localRoot = getCharacter()
                if localRoot and aimbot.TargetPart then
                    parts[#parts + 1] = string.format("%.0f m", (aimbot.TargetPart.Position - localRoot.Position).Magnitude * 0.28)
                end
            end
            local showName = aimStyle.Name
            local showDetail = #parts > 0
            local showBar = aimStyle.Health and hasHealth and aimStyle.HealthMode ~= "Chữ"
            local titleHeight = showName and (nameSize + 5) or 0
            local detailHeight = showDetail and (detailSize + 5) or 0
            local barWidth = apply and style.BarWidth or 150
            local barHeight = apply and style.BarHeight or 8
            local label = aimbot.TargetESPLabel
            local detail = aimbot.TargetESPDetail
            label.Visible = showName
            label.Text = "AIM · " .. name
            label.TextSize = nameSize
            label.Font = fontFace
            label.TextStrokeTransparency = strokeValue
            label.Size = UDim2.new(1, 0, 0, titleHeight)
            detail.Visible = showDetail
            detail.Text = table.concat(parts, "  ·  ")
            detail.TextSize = detailSize
            detail.Font = fontFace
            detail.TextStrokeTransparency = strokeValue
            detail.Position = UDim2.fromOffset(0, titleHeight)
            detail.Size = UDim2.new(1, 0, 0, detailHeight)
            local bar = aimbot.TargetESPBar
            bar.Visible = showBar
            bar.Position = UDim2.new(0.5, 0, 0, titleHeight + detailHeight + 3)
            bar.Size = UDim2.fromOffset(barWidth, barHeight)
            aimbot.TargetESPBarFill.Size = UDim2.fromScale(ratio, 1)
            aimbot.TargetESPBarFill.BackgroundColor3 = (apply and style.BarColorMode == "Màu ESP") and Theme.Danger or Color3.fromHSV(ratio * 0.33, 0.88, 1)
            local width = math.clamp(math.max(280, barWidth + 24, nameSize * 18), 280, 620)
            local height = titleHeight + detailHeight + (showBar and (barHeight + 8) or 4)
            aimbot.TargetESPBillboard.Size = UDim2.fromOffset(width, height)
        end
    end
end

