local function findClosestNamedWorldObject(name)
    local normalized = string.lower((string.gsub(tostring(name or ""), "^%s*(.-)%s*$", "%1")))
    if normalized == "" then
        return nil, nil, nil, "Empty", 0
    end

    local _, _, localRoot = getCharacter()
    local origin = localRoot and localRoot.Position or Camera.CFrame.Position
    local prefixMatches = {}
    local partialMatches = {}
    local descendants = Workspace:GetDescendants()

    for index, instance in ipairs(descendants) do
        if instance:IsA("Model") or instance:IsA("Tool") or instance:IsA("BasePart") then
            local lowerName = string.lower(instance.Name)
            local prefix = State.SmartSearchEnabled and string.sub(lowerName, 1, #normalized) == normalized
            local partial = State.SmartSearchEnabled and string.find(lowerName, normalized, 1, true) ~= nil
            if (lowerName == normalized or prefix or partial) and not isPlayerCharacterDescendant(instance) then
                local objectRoot = getAdorneeRoot(instance)
                if objectRoot then
                    local distance = (objectRoot.Position - origin).Magnitude
                    local record = {Object = instance, Root = objectRoot, Name = instance.Name, Distance = distance}
                    if lowerName == normalized then
                        local current = prefixMatches[lowerName]
                        if not current or distance < current.Distance then
                            prefixMatches[lowerName] = record
                        end
                    elseif prefix then
                        local current = prefixMatches[lowerName]
                        if not current or distance < current.Distance then
                            prefixMatches[lowerName] = record
                        end
                    else
                        local current = partialMatches[lowerName]
                        if not current or distance < current.Distance then
                            partialMatches[lowerName] = record
                        end
                    end
                end
            end
        end
        if index % 1800 == 0 then
            task.wait()
        end
    end

    local exact = prefixMatches[normalized]
    if exact then
        return exact.Object, exact.Root, exact.Name, "Exact", 1
    end
    local matches = next(prefixMatches) and prefixMatches or partialMatches
    local uniqueRecord
    local matchCount = 0
    for _, record in pairs(matches) do
        uniqueRecord = record
        matchCount = matchCount + 1
    end
    if matchCount == 1 then
        return uniqueRecord.Object, uniqueRecord.Root, uniqueRecord.Name, "Unique", 1
    elseif matchCount > 1 then
        return nil, nil, nil, "Ambiguous", matchCount
    end
    return nil, nil, nil, "Missing", 0
end

local function hasItemMetadata(instance)
    if textHasHint(instance.Name, ItemHints) then
        return true
    end
    for _, name in ipairs(ItemHints.Attributes) do
        local value = instance:GetAttribute(name)
        if value == true or type(value) == "string" and textHasHint(value, ItemHints) then
            return true
        end
    end
    for _, tag in ipairs(CollectionService:GetTags(instance)) do
        if textHasHint(tag, ItemHints) then
            return true
        end
    end
    return false
end

local function findExactAncestor(part, exactLower)
    local current = part
    local depth = 0
    while current and current ~= Workspace and depth < 8 do
        if string.lower(current.Name) == exactLower and (current:IsA("Model") or current:IsA("Tool") or current:IsA("BasePart")) then
            return current
        end
        current = current.Parent
        depth = depth + 1
    end
    return nil
end

local function findAutomaticItem(part)
    local tool = part:FindFirstAncestorOfClass("Tool")
    if tool and tool:IsDescendantOf(Workspace) then
        return tool
    end

    if isCharacterDescendant(part) then
        return nil
    end

    local current = part
    local best
    local depth = 0
    while current and current ~= Workspace and depth < 6 do
        if current:IsA("Model") or current:IsA("BasePart") then
            if hasItemMetadata(current) then
                best = current
            end
            if current:FindFirstChildWhichIsA("ProximityPrompt", false) or current:FindFirstChildWhichIsA("ClickDetector", false) then
                best = current:IsA("BasePart") and (current:FindFirstAncestorOfClass("Model") or current) or current
            end
        end
        current = current.Parent
        depth = depth + 1
    end
    return best
end

