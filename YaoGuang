    function Island.RenderCompact(withPop)
        if Island.Mode ~= "Compact" then return end
        local now = os.clock()
        local text, color
        local fixedWidth = nil
        if now < Island.StatusUntil and Island.StatusText ~= "" then
            text = Island.StatusText
            color = Island.StatusColor
        elseif islandState.ShowStats then
            text = string.format("Raphael · %d FPS · %d ms", math.floor(Island.DisplayFrameRate + 0.5), math.floor(Island.Ping + 0.5))
            color = Theme.Success
            fixedWidth = 190
        else
            text = "Raphael · sẵn sàng"
            color = Theme.Success
        end
        local signature = tostring(text) .. "|" .. tostring(color)
        if signature == Island.CompactSignature and not withPop then return end
        Island.CompactSignature = signature

        compactDot.Visible = true
        compactDot.BackgroundColor3 = color or Theme.Success
        local labelX = 32
        local textWidth = measure(text, compactLabel.TextSize, compactLabel.Font)
        local width = labelX + textWidth + 16
        width = math.floor(math.clamp(math.max(width, fixedWidth or 0), 112, getMaxWidth()))
        compactLabel.Text = text
        compactLabel.Position = UDim2.fromOffset(labelX, 0)
        compactLabel.Size = UDim2.new(0, math.max(width - labelX - 14, 20), 1, 0)
        rootStroke.Color = Color3.fromRGB(255, 255, 255)
        rootStroke.Transparency = 0.9
        if width ~= Island.CompactWidth or Island.RootHeight ~= compactHeight or withPop then
            Island.CompactWidth = width
            Island.RootHeight = compactHeight
            tweenRoot(width, compactHeight, math.floor(compactHeight / 2), 0.32)
        end
        if withPop then pop() end
    end

    function Island.ShowCompact()
        Island.Current = nil
        Island.NoticeToken = Island.NoticeToken + 1
        setMode("Compact")
        Island.CompactSignature = ""
        Island.RenderCompact(false)
    end

    function Island.ShowNotice(entry)
        Island.Current = entry
        Island.NoticeToken = Island.NoticeToken + 1
        local token = Island.NoticeToken
        local now = os.clock()
        Island.NoticeStarted = now
        Island.NoticeUntil = now + entry.Duration
        setMode("Notice")
        local hasSubtitle = entry.Subtitle ~= nil and entry.Subtitle ~= ""
        local height = hasSubtitle and noticeHeightWithSubtitle or noticeHeightPlain
        local tileSize = hasSubtitle and 40 or 32
        noticeTile.Size = UDim2.fromOffset(tileSize, tileSize)
        noticeTile.BackgroundColor3 = entry.Color
        noticeTileStroke.Color = entry.Color
        noticeIcon.ImageColor3 = Color3.fromRGB(255, 255, 255)
        UI.SetIcon(noticeIcon, entry.Icon)
        noticeIcon.Size = UDim2.fromOffset(hasSubtitle and 22 or 18, hasSubtitle and 22 or 18)
        noticeTitle.Text = entry.Title
        noticeSubtitle.Text = entry.Subtitle or ""
        noticeSubtitle.Visible = hasSubtitle
        noticeTitle.Position = UDim2.fromOffset(tileSize + 20, hasSubtitle and 9 or 0)
        noticeTitle.Size = UDim2.new(1, -(tileSize + 20) - (entry.Tag and 66 or 16), 0, hasSubtitle and 22 or height)
        noticeSubtitle.Position = UDim2.fromOffset(tileSize + 20, 31)
        noticeSubtitle.Size = UDim2.new(1, -(tileSize + 20) - (entry.Tag and 66 or 16), 0, 18)
        noticeTag.Visible = entry.Tag ~= nil
        if entry.Tag then
            noticeTag.Text = entry.Tag
            noticeTag.BackgroundColor3 = entry.Color
            local tagWidth = math.max(40, measure(entry.Tag, 11, Enum.Font.GothamBold) + 18)
            noticeTag.Size = UDim2.fromOffset(tagWidth, 22)
        end
        noticeBar.BackgroundColor3 = entry.Color
        noticeBar.Size = UDim2.fromScale(1, 1)
        local titleWidth = measure(entry.Title, noticeTitle.TextSize, noticeTitle.Font)
        local subtitleWidth = hasSubtitle and measure(entry.Subtitle, noticeSubtitle.TextSize, noticeSubtitle.Font) or 0
        local width = tileSize + 20 + math.max(titleWidth, subtitleWidth) + (entry.Tag and 70 or 22)
        width = math.floor(math.clamp(width, 230, getMaxWidth() + 40))
        rootStroke.Color = entry.Color
        rootStroke.Transparency = 0.62
        tweenRoot(width, height, hasSubtitle and 26 or math.floor(height / 2), 0.4)
        pop()
        TweenService:Create(noticeBar, TweenInfo.new(entry.Duration, Enum.EasingStyle.Linear), {Size = UDim2.fromScale(0, 1)}):Play()
        task.delay(entry.Duration + 0.25, function()
            if token == Island.NoticeToken and Island.Mode == "Notice" and State.Running then
                Island.Advance()
            end
        end)
    end

    function Island.Advance()
        if #Island.Queue > 0 then
            Island.ShowNotice(table.remove(Island.Queue, 1))
