local function updateVisual(category, key, target, root, displayName, healthText, distanceStuds)
    local config = getCategoryConfig(category)
    local espEnabled = config.Enabled and (category ~= "Player" or Extensions.IsPlayerESPAllowed(key))
    local xrayEnabled = State.XRay
    local existing = Visuals[category][key]
    if (not espEnabled and not xrayEnabled) or not target or not root then
        if existing then
            existing.Active = false
            hideVisual(existing)
        end
        return
    end

    local distanceMeters = distanceStuds * 0.28
    local maximumMeters = category == "Item"
        and (State.ItemESP.ExactName ~= "" and math.huge or config.RadiusMeters)
        or config.MaxDistanceMeters
    if distanceMeters > maximumMeters then
        if existing then
            existing.Active = false
            hideVisual(existing)
        end
        return
    end

    local visual = existing or createVisual(category, key)
    visual.Active = true
    visual.ESPPermitted = espEnabled
    visual.Target = target
    visual.Root = root
    visual.InfoAnchor = target:IsA("Model") and (target:FindFirstChild("Head") or root) or root
    visual.DisplayName = displayName
    visual.HealthText = healthText
    visual.DistanceStuds = distanceStuds

    local outlineXRay = xrayEnabled and State.XRayMethod ~= "Wall Transparency"
    local skinEnabled = espEnabled and config.Box and config.BoxMode == "Skin"
    local highlightEnabled = skinEnabled or outlineXRay or (espEnabled and config.Box and not DrawingSupported)
    local highlightTarget = target
    if not target:IsA("Model") and not target:IsA("BasePart") then
        highlightTarget = root
    end
    if visual.Highlight.Parent ~= Workspace then
        visual.Highlight.Parent = Workspace
    end
    visual.Highlight.Adornee = highlightTarget
    visual.Highlight.FillColor = config.Color
    visual.Highlight.OutlineColor = config.Color:Lerp(Color3.fromRGB(255, 255, 255), 0.12)
    visual.Highlight.DepthMode = (skinEnabled or outlineXRay) and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
    visual.Highlight.FillTransparency = skinEnabled and 0.65 or (outlineXRay and 0.72 or 1)
    visual.Highlight.OutlineTransparency = highlightEnabled and 0 or 1
    visual.Highlight.Enabled = highlightEnabled

    local lineCount = 0
    local showName = espEnabled and config.Name
    local showHealth = espEnabled and config.Health and healthText ~= nil
    local showDistance = espEnabled and config.Distance

    visual.InfoName.Text = displayName
    visual.InfoName.TextStrokeColor3 = config.Color
    visual.InfoName.Visible = showName
    if showName then
        visual.InfoName.Position = UDim2.fromOffset(0, lineCount * 19)
        visual.InfoName.Size = UDim2.new(1, 0, 0, 19)
        lineCount = lineCount + 1
    end

    visual.InfoHealth.Text = healthText or ""
    visual.InfoHealth.TextStrokeColor3 = config.Color
    visual.InfoHealth.Visible = showHealth
    if showHealth then
        visual.InfoHealth.Position = UDim2.fromOffset(0, lineCount * 19)
        visual.InfoHealth.Size = UDim2.new(1, 0, 0, 19)
        lineCount = lineCount + 1
    end

    visual.InfoDistance.Text = string.format("[ %d studs | %.1f m ]", math.floor(distanceStuds + 0.5), distanceMeters)
    visual.InfoDistance.TextColor3 = config.Color:Lerp(Color3.fromRGB(255, 255, 255), 0.58)
    visual.InfoDistance.TextStrokeColor3 = config.Color
    visual.InfoDistance.Visible = showDistance
    if showDistance then
        visual.InfoDistance.Position = UDim2.fromOffset(0, lineCount * 19)
        visual.InfoDistance.Size = UDim2.new(1, 0, 0, 19)
        lineCount = lineCount + 1
    end

    visual.InfoBillboard.Size = UDim2.fromOffset(230, math.max(24, lineCount * 19))
    visual.InfoBillboard.Adornee = visual.InfoAnchor
    visual.InfoEnabled = espEnabled and lineCount > 0

    Extensions.UpdateDynamicVisual(visual)
end
local function restoreXRayOccluders(keepSet)
    for part, originalTransparency in pairs(XRayOccluders) do
        if not keepSet or not keepSet[part] then
            if part and part.Parent then
                pcall(function()
                    part.LocalTransparencyModifier = originalTransparency
                end)
            end
            XRayOccluders[part] = nil
        end
    end
end

local function updateXRayOcclusion()
    if not State.XRay or State.XRayMethod == "Outline" then
        restoreXRayOccluders()
        return
    end

    Camera = Workspace.CurrentCamera or Camera
    local cameraPosition = Camera.CFrame.Position
    local candidates = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local root = getAdorneeRoot(player.Character)
            if root then
                local offset = root.Position - cameraPosition
                table.insert(candidates, {Target = player.Character, Root = root, DistanceSquared = offset:Dot(offset)})
            end
        end
    end

    for model, classification in pairs(MobCache) do
        if model and model.Parent and type(classification) == "table" then
            local detectorRoot = classification.Root
            local visualAnchor = Extensions.GetMobVisualAnchor(model, detectorRoot)
            local worldPosition = Extensions.GetMobWorldPosition(model, visualAnchor)
            if visualAnchor and visualAnchor.Parent and worldPosition then
                local offset = worldPosition - cameraPosition
                table.insert(candidates, {Target = model, Root = visualAnchor, DistanceSquared = offset:Dot(offset)})
            end
        end
    end

    for item in pairs(ItemCache) do
        if item and item.Parent then
            local root = getAdorneeRoot(item)
            if root then
                local offset = root.Position - cameraPosition
                table.insert(candidates, {Target = item, Root = root, DistanceSquared = offset:Dot(offset)})
            end
        end
    end

    table.sort(candidates, function(left, right)
        return left.DistanceSquared < right.DistanceSquared
    end)

    local castPoints = {}
    local ignored = {}
    local localCharacter = LocalPlayer.Character
    if localCharacter then
        table.insert(ignored, localCharacter)
    end
    local candidateLimit = math.min(#candidates, 24)
    for index = 1, candidateLimit do
        local candidate = candidates[index]
        table.insert(castPoints, candidate.Root.Position)
        table.insert(ignored, candidate.Target)
    end

    local currentOccluders = {}
    if #castPoints > 0 then
        local success, obscuringParts = pcall(function()
            return Camera:GetPartsObscuringTarget(castPoints, ignored)
        end)
        if success and type(obscuringParts) == "table" then
            for _, part in ipairs(obscuringParts) do
                if part and part:IsA("BasePart") then
                    if XRayOccluders[part] == nil then
                        XRayOccluders[part] = part.LocalTransparencyModifier
                    end
                    currentOccluders[part] = true
                    part.LocalTransparencyModifier = State.XRayWallTransparency
                end
            end
        end
    end

    restoreXRayOccluders(currentOccluders)
end

local GenericMobNames = {model = true, npc = true, enemy = true, mob = true, rig = true, dummy = true}

local function textHasHint(text, hints)
    local lower = string.lower(tostring(text or ""))
    for _, hint in ipairs(hints) do
        if string.find(lower, hint, 1, true) then
            return true
        end
    end
    return false
end

local function belongsToPlayerCharacter(model)
    local current = model
    local depth = 0
    while current and current ~= Workspace and depth < 12 do
        if current:IsA("Model") and Players:GetPlayerFromCharacter(current) then
            return true
        end
        current = current.Parent
        depth = depth + 1
    end
    return false
end

local function getMobDisplayName(model, humanoid)
    for _, attributeName in ipairs(State.MobDisplayAttributeNames) do
        local value = model:GetAttribute(attributeName)
        if type(value) == "string" and value ~= "" then
            return value
        end
    end

    if humanoid and humanoid.DisplayName and humanoid.DisplayName ~= "" then
        local lowerDisplayName = string.lower(humanoid.DisplayName)
        if lowerDisplayName ~= "humanoid" and not GenericMobNames[lowerDisplayName] then
            return humanoid.DisplayName
        end
    end

    if not GenericMobNames[string.lower(model.Name)] then
        return model.Name
    end

    local ancestor = model.Parent
    local depth = 0
    while ancestor and ancestor ~= Workspace and depth < 4 do
        local lowerName = string.lower(ancestor.Name)
        local genericContainer = lowerName == "workspace" or lowerName == "folder" or lowerName == "entities" or lowerName == "characters" or lowerName == "map"
        if not GenericMobNames[lowerName] and not genericContainer then
            return ancestor.Name
        end
        ancestor = ancestor.Parent
        depth = depth + 1
    end
    return model.Name
end

local function classifyMob(model)
    if not model or not model:IsA("Model") or not model:IsDescendantOf(Workspace) then
        return nil
    end
    if model == LocalPlayer.Character or belongsToPlayerCharacter(model) then
        return nil
    end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 or humanoid.MaxHealth <= 0 then
        return nil
    end
    local root = model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
    if not root or not root:IsA("BasePart") then
        return nil
    end
    return {
        Humanoid = humanoid,
        Root = root,
        DisplayName = getMobDisplayName(model, humanoid),
        LastValidated = os.clock()
    }
end

local function parseMobManualNames(text)
    local parsed = {}
    local count = 0
    for entry in string.gmatch(tostring(text or ""), "[^,]+") do
        local trimmed = string.gsub(entry, "^%s*(.-)%s*$", "%1")
        if trimmed ~= "" then
            local key = string.lower(trimmed)
            if not parsed[key] then
                parsed[key] = true
                count = count + 1
            end
        end
    end
    State.MobManualNames = parsed
    State.MobFilterText = tostring(text or "")
    return count
end

local function isMobAllowedByManualFilter(model, classification)
    if not State.MobManualFilterEnabled then
        return true
    end
    local names = State.MobManualNames
    if names[string.lower(model.Name)] then
        return true
    end
    if classification and classification.DisplayName and names[string.lower(classification.DisplayName)] then
        return true
    end
    local humanoid = classification and classification.Humanoid
    if humanoid and humanoid.DisplayName and names[string.lower(humanoid.DisplayName)] then
        return true
    end
    return false
end

local function collectMobNamesInRadius()
    local _, _, localRoot = getCharacter()
    if not localRoot then
        return {}, 0
    end
    local maximumStuds = State.MobFilterScanRadiusMeters / 0.28
    local uniqueNames = {}
    local names = {}
    for model, classification in pairs(MobCache) do
        if model and model.Parent and type(classification) == "table" then
            local detectorRoot = classification.Root
            local visualAnchor = Extensions.GetMobVisualAnchor(model, detectorRoot)
            local worldPosition = Extensions.GetMobWorldPosition(model, visualAnchor)
            if visualAnchor and visualAnchor.Parent and worldPosition and (worldPosition - localRoot.Position).Magnitude <= maximumStuds then
                local displayName = classification.DisplayName or model.Name
                local key = string.lower(displayName)
                if displayName ~= "" and not uniqueNames[key] then
                    uniqueNames[key] = true
                    table.insert(names, displayName)
                end
            end
        end
    end
    table.sort(names, function(left, right)
        return string.lower(left) < string.lower(right)
    end)
    return names, #names
end

local function removeMobFromCache(model)
    MobCache[model] = nil
    local visual = Visuals.Mob[model]
    if visual then
        destroyVisual(visual)
        Visuals.Mob[model] = nil
    end
end

local function considerMob(instance)
    local model
    if instance:IsA("Model") then
        model = instance
    elseif instance:IsA("Humanoid") or instance:IsA("AnimationController") then
        model = instance.Parent
    else
        model = instance:FindFirstAncestorOfClass("Model")
    end
    if not model or not model:IsA("Model") then
        return
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid and not State.MobHumanoidConnections[humanoid] then
        State.MobHumanoidConnections[humanoid] = {
            Health = connect(humanoid.HealthChanged, function()
                if State.Running and model.Parent then
                    task.defer(considerMob, model)
                end
            end),
            Maximum = connect(humanoid:GetPropertyChangedSignal("MaxHealth"), function()
                if State.Running and model.Parent then
                    task.defer(considerMob, model)
                end
            end)
        }
    end

    local classification = classifyMob(model)
    if classification then
        MobCache[model] = classification
    elseif MobCache[model] then
        removeMobFromCache(model)
    end
end

