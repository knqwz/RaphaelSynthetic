function Extensions.TrackAntiStunInstance(instance)
    if not instance or not instance.Parent then
        return
    end
    if instance:IsA("Motor6D") then
        State.AntiStunTrackedInstances[instance] = "Motor"
    elseif instance:IsA("BodyVelocity")
        or instance:IsA("BodyAngularVelocity")
        or instance:IsA("LinearVelocity")
        or instance:IsA("AngularVelocity")
        or instance:IsA("VectorForce")
        or instance:IsA("Torque")
        or instance:IsA("BallSocketConstraint")
        or instance:IsA("HingeConstraint")
        or instance:IsA("BoolValue")
        or instance:IsA("NumberValue")
        or instance:IsA("IntValue") then
        State.AntiStunTrackedInstances[instance] = "Candidate"
    end
end

function Extensions.RebuildAntiStunTracking(character)
    table.clear(State.AntiStunTrackedInstances)
    if not character then
        return
    end
    for _, descendant in ipairs(character:GetDescendants()) do
        Extensions.TrackAntiStunInstance(descendant)
    end
end

function Extensions.MaintainAntiStun(character, humanoid, root)
    if not State.AntiStun or not character or not humanoid or not root then
        return
    end

    local currentState = humanoid:GetState()
    if humanoid.PlatformStand
        or humanoid.Sit
        or currentState == Enum.HumanoidStateType.FallingDown
        or currentState == Enum.HumanoidStateType.Ragdoll
        or currentState == Enum.HumanoidStateType.Physics then
        humanoid.PlatformStand = false
        humanoid.Sit = false
        pcall(function()
            humanoid:ChangeState(humanoid.FloorMaterial == Enum.Material.Air and Enum.HumanoidStateType.Freefall or Enum.HumanoidStateType.Running)
        end)
    end

    if root.Anchored then
        root.Anchored = false
    end

    local original = rememberHumanoid(humanoid)
    local velocity = root.AssemblyLinearVelocity
    local horizontal = Vector3.new(velocity.X, 0, velocity.Z)
    local direction = humanoid.MoveDirection
    local speed = math.max(State.SpeedEnabled and State.SpeedValue or original and original.WalkSpeed or humanoid.WalkSpeed, 0)
    local now = os.clock()
    local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
    local correctedHorizontal = horizontal

    if grounded then
        if direction.Magnitude <= 0.01 then
            correctedHorizontal = Vector3.zero
        elseif State.SpeedMethod ~= "CFrame" then
            correctedHorizontal = direction.Unit * speed
        elseif horizontal.Magnitude > math.max(speed * 1.6, 32) or horizontal:Dot(direction.Unit) < -1 then
            correctedHorizontal = direction.Unit * speed
        end
    elseif direction.Magnitude <= 0.01 and horizontal.Magnitude > 3 then
        correctedHorizontal = Vector3.zero
    elseif horizontal.Magnitude > math.max(speed * 1.6, 36) or direction.Magnitude > 0.01 and horizontal:Dot(direction.Unit) < -1 then
        correctedHorizontal = direction.Magnitude > 0.01 and direction.Unit * speed or Vector3.zero
    end

    local jumpLimit
    if not State.JumpEnabled and original then
        jumpLimit = original.UseJumpPower and original.JumpPower or math.sqrt(math.max(2 * Workspace.Gravity * original.JumpHeight, 0))
    elseif State.JumpMethod == "JumpHeight" then
        jumpLimit = math.sqrt(math.max(2 * Workspace.Gravity * State.JumpValue, 0))
    else
        jumpLimit = State.JumpValue
    end
    local jumpGrace = now - State.LastJumpRequest <= 0.65
    local verticalLimit = jumpGrace and math.max(jumpLimit * 1.25, 30) or 12
    local vertical = math.min(velocity.Y, verticalLimit)
    root.AssemblyLinearVelocity = Vector3.new(correctedHorizontal.X, vertical, correctedHorizontal.Z)
    root.AssemblyAngularVelocity = Vector3.zero

    if now - State.LastAntiStunMaintain < 0.18 then
        return
    end
    State.LastAntiStunMaintain = now
    pcall(function()
        humanoid.PlatformStand = false
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
    end)

    for descendant, kind in pairs(State.AntiStunTrackedInstances) do
        if not descendant or not descendant.Parent or not descendant:IsDescendantOf(character) then
            State.AntiStunTrackedInstances[descendant] = nil
        elseif kind == "Motor" then
            if not descendant.Enabled then
                descendant.Enabled = true
            end
        else
            local lowerName = string.lower(descendant.Name)
            local suspicious = false
            for _, hint in ipairs(State.AntiStunForceHints) do
                if string.find(lowerName, hint, 1, true) then
                    suspicious = true
                    break
                end
            end
            if suspicious then
                pcall(function()
                    local backup = State.AntiStunInstanceBackup[descendant]
                    if not backup then
                        backup = {}
                        State.AntiStunInstanceBackup[descendant] = backup
                        if descendant:IsA("BodyVelocity") then
                            backup.Velocity = descendant.Velocity
                            backup.MaxForce = descendant.MaxForce
                        elseif descendant:IsA("BodyAngularVelocity") then
                            backup.AngularVelocity = descendant.AngularVelocity
                            backup.MaxTorque = descendant.MaxTorque
                        elseif descendant:IsA("LinearVelocity") or descendant:IsA("AngularVelocity") or descendant:IsA("VectorForce") or descendant:IsA("Torque") or descendant:IsA("BallSocketConstraint") or descendant:IsA("HingeConstraint") then
                            backup.Enabled = descendant.Enabled
                        elseif descendant:IsA("BoolValue") or descendant:IsA("NumberValue") or descendant:IsA("IntValue") then
                            backup.Value = descendant.Value
                        end
                    end
                    if descendant:IsA("BodyVelocity") then
                        descendant.Velocity = Vector3.zero
                        descendant.MaxForce = Vector3.zero
                    elseif descendant:IsA("BodyAngularVelocity") then
                        descendant.AngularVelocity = Vector3.zero
                        descendant.MaxTorque = Vector3.zero
                    elseif descendant:IsA("LinearVelocity") or descendant:IsA("AngularVelocity") or descendant:IsA("VectorForce") or descendant:IsA("Torque") or descendant:IsA("BallSocketConstraint") or descendant:IsA("HingeConstraint") then
                        descendant.Enabled = false
                    elseif descendant:IsA("BoolValue") then
                        descendant.Value = false
                    elseif descendant:IsA("NumberValue") or descendant:IsA("IntValue") then
                        descendant.Value = string.find(lowerName, "slow", 1, true) and 1 or 0
                    end
                end)
            end
        end
    end

    for _, object in ipairs({character, humanoid, root}) do
        for _, markerName in ipairs(State.AntiStunMarkerNames) do
            local attribute = object:GetAttribute(markerName)
            if attribute == true or type(attribute) == "number" and attribute > 0 then
                local neutral = string.lower(markerName) == "slow" and 1 or 0
                pcall(function()
                    object:SetAttribute(markerName, type(attribute) == "number" and neutral or false)
                end)
            end
        end
    end

end

function Extensions.SetAntiStunEnabled(enabled, silent)
    State.AntiStun = not not enabled
    State.LastAntiStunMaintain = 0
    local character, humanoid, root = getCharacter()
    if State.AntiStun then
        Extensions.RebuildAntiStunTracking(character)
        Extensions.MaintainAntiStun(character, humanoid, root)
    elseif humanoid then
        local original = rememberHumanoid(humanoid)
        pcall(function()
            humanoid.PlatformStand = false
            humanoid.Sit = false
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, original and original.FallingDownEnabled or true)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, original and original.RagdollEnabled or true)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Physics, original and original.PhysicsEnabled or true)
        end)
    end
    if not State.AntiStun then
        for instance, values in pairs(State.AntiStunInstanceBackup) do
            if instance and instance.Parent then
                for property, originalValue in pairs(values) do
                    pcall(function()
                        instance[property] = originalValue
                    end)
                end
            end
        end
        table.clear(State.AntiStunInstanceBackup)
        table.clear(State.AntiStunTrackedInstances)
    end
    local control = State.ConfigControls.AntiStun
    if control and control.Set then
        control.Set(State.AntiStun, false)
    end
    if not silent then
        notify(State.AntiStun and "Anti Stun nâng cao đã bật: chặn marker, ragdoll, force bất lợi và khôi phục Motor6D." or "Anti Stun đã tắt và đã khôi phục constraint.", State.AntiStun and Theme.Success or Theme.Warning)
    end
end

local function fetchServerCandidates(sortOrder)
    local servers = {}
    local cursor = nil
    for _ = 1, 4 do
        local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=" .. sortOrder .. "&excludeFullGames=true&limit=100"
        if cursor then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end
        local success, response = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        if not success or type(response) ~= "table" then
            break
        end
        for _, server in ipairs(response.data or {}) do
            if server.id ~= game.JobId and server.playing < server.maxPlayers then
                table.insert(servers, server)
            end
        end
        cursor = response.nextPageCursor
        if not cursor then
            break
        end
    end
    return servers
end

local function hopServer(preferFew)
    task.spawn(function()
        notify(preferFew and "Đang tìm server ít người..." or "Đang tìm server đông người...", Theme.Warning)
        local servers = fetchServerCandidates(preferFew and "Asc" or "Desc")
        if #servers == 0 then
            notify("Không tìm thấy server phù hợp.", Theme.Danger)
            return
        end
        table.sort(servers, function(left, right)
            if preferFew then
                return left.playing < right.playing
            end
            return left.playing > right.playing
        end)
        local chosen = servers[1]
        notify("Đang vào server " .. chosen.playing .. "/" .. chosen.maxPlayers .. " người.", Theme.Success)
        TeleportService:TeleportToPlaceInstance(game.PlaceId, chosen.id, LocalPlayer)
    end)
end

local function setFPSBoost(enabled, silent)
    State.FPSBoost = not not enabled
    if State.FPSBoost then
        if State.FPSBoostApplied then
            return
        end
        State.FPSBoostApplied = true
        local workspaceDescendants = Workspace:GetDescendants()
        for index, instance in ipairs(workspaceDescendants) do
            Extensions.ApplyFPSOptimization(instance)
            if index % 900 == 0 then
                task.wait()
            end
        end
        if not silent then
            notify("Fast Mode đã bật: bỏ texture và vật liệu nặng nhưng giữ màu gốc của từng vật thể.", Theme.Success)
        end
    else
        if not State.FPSBoostApplied then
            return
        end
        State.FPSBoostApplied = false
        Extensions.RestoreFPSOptimizations()
        if not silent then
            notify("Fast Mode đã tắt và toàn bộ vật liệu đã được khôi phục.", Theme.Success)
        end
    end
end

