    value.TextSize = 10
    value.TextXAlignment = Enum.TextXAlignment.Right
    value.TextTruncate = Enum.TextTruncate.AtEnd
    value.Parent = row

    local lastActivation = 0
    row.Activated:Connect(function()
        local now = os.clock()
        if now - lastActivation <= 0.38 then
            local copied = false
            if setclipboard then
                copied = pcall(setclipboard, value.Text)
            end
            notify(copied and ("Đã copy " .. keyText .. ".") or (keyText .. ": " .. value.Text), copied and Theme.Success or Theme.Warning)
            lastActivation = 0
        else
            lastActivation = now
            tween(row, {BackgroundTransparency = 0.88}, 0.08)
            task.delay(0.18, function()
                if row.Parent then
                    tween(row, {BackgroundTransparency = 1}, 0.15)
                end
            end)
        end
    end)

    return value
end

