    SpeedFactor = 1.4,
    SpeedExtra = 5,
    TweenFactor = 3.2,
    TweenExtra = 40,
    WindowSize = 6,
    AirThreshold = 7,
    FlyAirTime = 1.6,
    FallingVelocity = -12,
    JumpHeightDefault = 7.2,
    HighJumpMargin = 4,
