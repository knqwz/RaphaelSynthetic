local function createSelector(parent, labelText, options, defaultValue, callback)
    local holder = Instance.new("Frame")
    holder.Size = UDim2.new(1, 0, 0, 55)
    holder.BackgroundTransparency = 1
    holder.Parent = parent

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 17)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Theme.SubText
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = holder

    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 34)
    button.Position = UDim2.fromOffset(0, 20)
    button.BackgroundColor3 = Theme.Input
    button.BackgroundTransparency = 0.2
    button.BorderSizePixel = 0
    button.TextColor3 = Theme.Text
    button.Font = Enum.Font.GothamMedium
    button.TextSize = 12
    button.AutoButtonColor = false
    button.Parent = holder
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)
    UI.AddSmoothGradient(button, Theme.Input:Lerp(Theme.Background, 0.18), Theme.SurfaceLight:Lerp(Theme.Input, 0.52), 0)

    local chevronIcon = UI.CreateIcon(button, "chevron-down", 14, Theme.SubText)
    chevronIcon.AnchorPoint = Vector2.new(1, 0.5)
    chevronIcon.Position = UDim2.new(1, -10, 0.5, 0)
    chevronIcon.ZIndex = button.ZIndex + 2
    UI.AddRipple(button, Theme.Accent)

    local index = table.find(options, defaultValue) or 1
    button.Text = options[index]

    connect(button.Activated, function()
        index = index % #options + 1
        button.Text = options[index]
        chevronIcon.Rotation = 180
        tween(chevronIcon, {Rotation = 0}, 0.2)
        tween(button, {BackgroundColor3 = Theme.SurfaceLight}, 0.08)
        task.delay(0.09, function()
            if button.Parent then
                tween(button, {BackgroundColor3 = Theme.Input}, 0.12)
            end
        end)
        if callback then
            callback(options[index])
        end
    end)

    return {
        Get = function()
            return options[index]
        end,
        Set = function(value, invoke)
            local found = table.find(options, value)
            if found then
                index = found
                button.Text = options[index]
                if invoke ~= false and callback then
                    callback(options[index])
                end
            end
        end
    }
end

local function createInfoRow(parent, keyText, valueText)
    local row = Instance.new("TextButton")
    row.Size = UDim2.new(1, 0, 0, 24)
    row.BackgroundColor3 = Theme.Accent
    row.BackgroundTransparency = 1
    row.BorderSizePixel = 0
    row.Text = ""
    row.AutoButtonColor = false
    row.Parent = parent
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local key = Instance.new("TextLabel")
    key.Size = UDim2.new(0.38, 0, 1, 0)
    key.BackgroundTransparency = 1
    key.Text = keyText
    key.TextColor3 = Theme.SubText
    key.Font = Enum.Font.Gotham
    key.TextSize = 10
    key.TextXAlignment = Enum.TextXAlignment.Left
    key.Parent = row

    local value = Instance.new("TextLabel")
    value.Position = UDim2.new(0.38, 0, 0, 0)
    value.Size = UDim2.new(0.62, 0, 1, 0)
    value.BackgroundTransparency = 1
    value.Text = valueText
