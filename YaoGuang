function UI.ProtectButtonText(button, leftInset)
    if not button or not button:IsA("TextButton") or button:FindFirstChild("RaphaelButtonText") then
        return button and button:FindFirstChild("RaphaelButtonText") or nil
    end
    local inset = math.max(0, tonumber(leftInset) or 0)
    local label = Instance.new("TextLabel")
    label.Name = "RaphaelButtonText"
    label.Position = UDim2.fromOffset(inset, 0)
    label.Size = UDim2.new(1, -inset, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = button.Text
    label.TextColor3 = button.TextColor3
    label.TextTransparency = 0
    label.TextStrokeColor3 = Theme.Background
    label.TextStrokeTransparency = 0.78
    label.Font = button.Font
    label.TextSize = button.TextSize
    label.TextWrapped = button.TextWrapped
    label.TextXAlignment = button.TextXAlignment
    label.TextYAlignment = button.TextYAlignment
    label.Active = false
    label.Selectable = false
    label.ZIndex = button.ZIndex + 3
    label.Parent = button
    button.TextTransparency = 1

    local function synchronizeText()
        if label.Parent and button.Parent then
            label.Text = button.Text
            label.TextColor3 = button.TextColor3
            label.Font = button.Font
            label.TextSize = button.TextSize
            label.TextWrapped = button.TextWrapped
            label.TextXAlignment = button.TextXAlignment
            label.TextYAlignment = button.TextYAlignment
        end
    end
    button:GetPropertyChangedSignal("Text"):Connect(synchronizeText)
    button:GetPropertyChangedSignal("TextColor3"):Connect(synchronizeText)
    button:GetPropertyChangedSignal("Font"):Connect(synchronizeText)
    button:GetPropertyChangedSignal("TextSize"):Connect(synchronizeText)
    return label
end

function UI.AddSmoothGradient(instance, startColor, endColor, rotation)
    if instance:IsA("TextBox") then
        return nil
    end
    local firstColor = startColor or Theme.Accent2
    local lastColor = endColor or Theme.Accent
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, firstColor),
        ColorSequenceKeypoint.new(0.52, firstColor:Lerp(lastColor, 0.48):Lerp(Color3.fromRGB(255, 255, 255), 0.08)),
        ColorSequenceKeypoint.new(1, lastColor)
    })
    gradient.Rotation = rotation or 18
    gradient.Parent = instance
    if instance:IsA("TextButton") and instance.Text ~= "" then
        UI.ProtectButtonText(instance, instance:GetAttribute("RaphaelTextInset") or 0)
    end
    return gradient
end

function UI.ApplyExternalButtonArtwork(button, image)
    if not button or not button:IsA("GuiButton") then
        return nil
    end
    button.ClipsDescendants = true
    local artwork = button:FindFirstChild("RaphaelExternalArtwork")
    if not artwork then
        artwork = Instance.new("ImageLabel")
        artwork.Name = "RaphaelExternalArtwork"
        artwork.Size = UDim2.fromScale(1, 1)
        artwork.BackgroundTransparency = 1
        artwork.BorderSizePixel = 0
        artwork.ImageColor3 = Color3.fromRGB(255, 255, 255)
        artwork.ScaleType = Enum.ScaleType.Crop
        artwork.Active = false
        artwork.ZIndex = button.ZIndex + 1
        artwork.Parent = button
        Instance.new("UICorner", artwork).CornerRadius = UDim.new(0, 10)
    end
    artwork.Image = image or ""

    local shade = button:FindFirstChild("RaphaelExternalShade")
    if not shade then
        shade = Instance.new("Frame")
        shade.Name = "RaphaelExternalShade"
        shade.Size = UDim2.fromScale(1, 1)
        shade.BackgroundColor3 = Theme.Background
        shade.BackgroundTransparency = 0
        shade.BorderSizePixel = 0
        shade.Active = false
        shade.ZIndex = button.ZIndex + 2
        shade.Parent = button
        Instance.new("UICorner", shade).CornerRadius = UDim.new(0, 10)
        local shadeGradient = Instance.new("UIGradient")
        shadeGradient.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0.86),
            NumberSequenceKeypoint.new(0.58, 0.75),
            NumberSequenceKeypoint.new(1, 0.38)
        })
        shadeGradient.Rotation = 90
        shadeGradient.Parent = shade
    end

    local protectedText = button:FindFirstChild("RaphaelButtonText")
    if protectedText then
        protectedText.Position = UDim2.new(0, 4, 1, -20)
        protectedText.Size = UDim2.new(1, -8, 0, 16)
        protectedText.TextSize = 9
        protectedText.TextWrapped = true
        protectedText.TextStrokeTransparency = 0.35
        protectedText.ZIndex = button.ZIndex + 3
    end
    return artwork
end

function UI.CreateIcon(parent, name, size, color)
    local icon = Instance.new("ImageLabel")
    icon.Name = "Icon_" .. tostring(name)
    icon.Size = UDim2.fromOffset(size or 18, size or 18)
    icon.BackgroundTransparency = 1
    icon.Image = UI.GetIcon(name)
    icon.ImageColor3 = color or Theme.Text
    icon.ScaleType = Enum.ScaleType.Fit
    icon.Parent = parent
    return icon
end

function UI.AddRipple(button, color)
    button.ClipsDescendants = true
    button.Activated:Connect(function()
        if not button.Parent then
            return
        end
        UI.Motion.Press(button)
        local diameter = math.max(button.AbsoluteSize.X, button.AbsoluteSize.Y) * 1.35
        local ripple = Instance.new("Frame")
        ripple.Name = "PremiumRipple"
        ripple.AnchorPoint = Vector2.new(0.5, 0.5)
        ripple.Position = UDim2.fromScale(0.5, 0.5)
        ripple.Size = UDim2.fromOffset(0, 0)
        ripple.BackgroundColor3 = color or Theme.Text
        ripple.BackgroundTransparency = 0.76
        ripple.BorderSizePixel = 0
        ripple.ZIndex = button.ZIndex + 4
        ripple.Parent = button
        Instance.new("UICorner", ripple).CornerRadius = UDim.new(1, 0)
        TweenService:Create(ripple, TweenInfo.new(0.34, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(diameter, diameter),
            BackgroundTransparency = 1
        }):Play()
        task.delay(0.36, function()
            if ripple then
                ripple:Destroy()
            end
        end)
    end)
end

