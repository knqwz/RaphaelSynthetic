function Extensions.RepairInterfaceGeometry()
    MainFrame.Rotation = 0
    MainFrame.ClipsDescendants = true
    Content.Rotation = 0
    Content.ClipsDescendants = true
    Sidebar.Rotation = 0
    Sidebar.ClipsDescendants = true
    Sidebar.ElasticBehavior = Enum.ElasticBehavior.Never
    Sidebar.CanvasSize = UDim2.fromOffset(0, SidebarLayout.AbsoluteContentSize.Y + 16)
    for _, page in pairs(Pages) do
        page.Rotation = 0
        page.ClipsDescendants = true
        page.ElasticBehavior = Enum.ElasticBehavior.Never
        local layout = page:FindFirstChildOfClass("UIListLayout")
        if layout then
            page.CanvasSize = UDim2.fromOffset(0, layout.AbsoluteContentSize.Y + 8)
        end
        local pageScale = page:FindFirstChild("RaphaelMotionScale")
        if pageScale then
            pageScale.Scale = 1
        end
        pcall(function()
            local maximumY = math.max(page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y, 0)
            page.CanvasPosition = Vector2.new(0, math.clamp(page.CanvasPosition.Y, 0, maximumY))
        end)
    end
end

function Extensions.SetInterfaceVisible(visible)
    visible = not not visible
    State.InterfaceVisible = visible
    if not visible and State.FunctionSearchPanel then
        Extensions.ToggleFunctionSearch(false)
    end
    Extensions.RepairInterfaceGeometry()
    if visible then
        MainFrame:SetAttribute("RaphaelHideToken", (MainFrame:GetAttribute("RaphaelHideToken") or 0) + 1)
        MainFrame.Rotation = 0
        MainFrame.Visible = true
        MainShadow.Visible = true
        RestoreOrb.Visible = false
        UI.Motion.Pop(MainFrame)
        task.defer(Extensions.RepairInterfaceGeometry)
        return
    end
    if not MainFrame.Visible then
        MainShadow.Visible = false
        RestoreOrb.Visible = true
        return
    end
    RestoreOrb.Visible = false
    UI.Motion.Hide(MainFrame, function()
        if State.Running and not State.InterfaceVisible then
