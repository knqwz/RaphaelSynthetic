function Extensions.ResolveBrandArtwork()
    local customAsset = getcustomasset or getsynasset
    if not customAsset or not writefile then
        return ""
    end
    local folder = "Raphael_Assets"
    local path = folder .. "/Raphael_Brand_Official_F647.jpg"
    if isfolder and makefolder and not isfolder(folder) then
        pcall(makefolder, folder)
    end
    if isfile and isfile(path) then
        local cacheSuccess, cacheData = pcall(readfile, path)
        if cacheSuccess and type(cacheData) == "string" and #cacheData >= 128 then
            local assetSuccess, cachedAsset = pcall(customAsset, path)
            if assetSuccess and cachedAsset then
                return cachedAsset
            end
        end
    end
    local imageData = Extensions.DecodeBase64(Extensions.BrandImageFallbackBase64)
    if type(imageData) ~= "string" or #imageData < 128 then
        return ""
    end
    local writeSuccess = pcall(writefile, path, imageData)
    if not writeSuccess then
        return ""
    end
    local assetSuccess, assetPath = pcall(customAsset, path)
    if assetSuccess and assetPath then
        return assetPath
    end
    return ""
end

