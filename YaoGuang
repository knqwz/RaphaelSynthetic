function Extensions.GetSharedESPConfig(): any
    if State.SharedESPCategory == "Quái" then
        return State.MobESP, "Mob"
    elseif State.SharedESPCategory == "Item" then
        return State.ItemESP, "Item"
    end
    return State.PlayerESP, "Player"
end

function Extensions.SetSharedESPValue(name: string, value: any)
    if State.SharedESPSyncing then
        return
    end
    local config = Extensions.GetSharedESPConfig()
    config[name] = value
end

function Extensions.SyncSharedESPControls()
    local controls: any = State.SharedESPControls
    if not controls.Tracer then
        return
    end
    local config = Extensions.GetSharedESPConfig()
    State.SharedESPSyncing = true
    controls.Tracer.Set(config.Tracer, false)
    controls.TracerOrigin.Set(config.TracerOrigin, false)
    controls.Box.Set(config.Box, false)
    controls.BoxMode.Set(config.BoxMode == "Skin" and "3D" or config.BoxMode, false)
    controls.Name.Set(config.Name, false)
    controls.Health.Set(config.Health == true, false)
    controls.Distance.Set(config.Distance, false)
    controls.MaxDistance.Text = tostring(config.MaxDistanceMeters or 10000)
    controls.LookDirection.Set(config.LookDirection == true, false)
    controls.LookLength.Text = tostring(config.LookLength or 15)
    State.SharedESPSyncing = false
end

