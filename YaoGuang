        end
        pcall(restoreEffects)
        pcall(restoreLightingVisuals)
        pcall(function()
            Lighting.ClockTime = OriginalLighting.ClockTime
            Workspace.Gravity = OriginalGravity
            Camera = Workspace.CurrentCamera or Camera
            Camera.FieldOfView = OriginalCamera.FieldOfView
            LocalPlayer.CameraMinZoomDistance = OriginalCamera.MinZoom
            LocalPlayer.CameraMaxZoomDistance = OriginalCamera.MaxZoom
        end)

        local _, humanoid = getCharacter()
        State.SpectatingPlayer = nil
        State.AntiAFK = false
        State.LastAntiAFKPulse = 0
        pcall(function()
            Camera.CameraType = OriginalCamera.Type
            Camera.CameraSubject = humanoid or OriginalCamera.Subject
        end)
        pcall(Extensions.SetGodModeEnabled, false, true)
        pcall(Extensions.SetAntiStunEnabled, false, true)
        pcall(Extensions.ShutdownAntiKick)
        pcall(Extensions.ReleaseNamecallHandlers)
        pcall(restoreHumanoid, humanoid)
    end

    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(Connections)

    if RuntimeEnvironment.RaphaelSovereignCleanup == cleanup then
        RuntimeEnvironment.RaphaelSovereignCleanup = nil
    end
    if RuntimeEnvironment.RaphaelSovereignSession == RuntimeSessionToken then
        RuntimeEnvironment.RaphaelSovereignSession = nil
    end
    pcall(function()
        if ScreenGui then
            ScreenGui:Destroy()
        end
    end)
    purgeStaleInterfaces(nil)
end

RuntimeEnvironment.RaphaelSovereignCleanup = cleanup

task.spawn(function()
    local imageObjects = {}
    for _, instance in ipairs(ScreenGui:GetDescendants()) do
        if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
            if instance.Image ~= "" then
                table.insert(imageObjects, instance)
            end
        end
    end
    pcall(function()
        ContentProvider:PreloadAsync(imageObjects)
    end)
end)

notify("Raphael Sovereign chính thức đã khởi động. RightShift để ẩn/hiện.", Theme.Success)

task.defer(function()
    local config = Extensions.ReadConfig(true)
    local override = RuntimeEnvironment.RaphaelAutoLoadConfigOverride
    local shouldAutoLoad = override ~= nil and override == true or override == nil and config and config.AutoLoad == true
    if config and shouldAutoLoad and State.Running then
        Extensions.ApplyConfig(config, true)
        notify("Đã tự áp dụng config chính thức.", Theme.Success)
    end
end)
